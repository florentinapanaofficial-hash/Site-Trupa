    <!-- Oprește audio/video când utilizatorul pleacă de pe pagină -->
    <script is:inline>
    (function(){
      if(window.__fpStopMediaInit) return;
      window.__fpStopMediaInit = true;

      function stopAllMedia(){
        document.querySelectorAll('audio, video').forEach(function(el){
          if(!el.paused){ el.pause(); el.currentTime=0; }
        });
        /* Oprește și iframe-urile YouTube (postMessage API) */
        document.querySelectorAll('iframe[src*="youtube"]').forEach(function(f){
          try{ f.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}','*'); }catch(_){}
        });
      }
      document.addEventListener('visibilitychange',function(){ if(document.hidden) stopAllMedia(); });
      window.addEventListener('pagehide', stopAllMedia);
      window.addEventListener('beforeunload', stopAllMedia);
    })();
    </script>

    <!-- Calculează înălțimea header-ului și sincronizează --mob-nav-h -->
    <script is:inline>
    (function(){
      if(window.__fpMobileHeaderHeightInit) return;
      window.__fpMobileHeaderHeightInit = true;

      if(!window.matchMedia('(max-width:767px)').matches) return;
      /* Fix forced reflow: separăm READ (offsetHeight) de orice WRITE anterior
         cu requestAnimationFrame, ca browserul să folosească layout-ul deja
         calculat în loc să-l recalculeze sincron. */
      function sync(){
        requestAnimationFrame(function(){
          var nav=document.querySelector('.top-header');
          if(!nav) return;
          var h=nav.offsetHeight;
          if(h>0) document.documentElement.style.setProperty('--mob-nav-h',h+'px');
        });
      }
      var resizeTimer;
      function debouncedSync(){ clearTimeout(resizeTimer); resizeTimer=setTimeout(sync,200); }
      sync();
      document.addEventListener('astro:page-load',sync);
      window.addEventListener('resize',debouncedSync,{passive:true});
    })();
    </script>

    <!-- Hamburger pulse: activează animația după 5s, oprește la click -->
    <script is:inline data-astro-rerun>
    (function(){
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if(!window.matchMedia('(max-width: 767px)').matches) return;
      var btn = document.querySelector('[data-top-menu-toggle]');
      if(!btn) return;
      var icon = btn.querySelector('.pulse-icon');
      if(!icon) return;
      var timer = setTimeout(function(){ icon.classList.add('pulse-animation'); }, 2000);
      btn.addEventListener('click', function(){
        clearTimeout(timer);
        icon.classList.remove('pulse-animation');
      }, { once: false });
      document.addEventListener('astro:before-swap', function(){
        clearTimeout(timer);
        icon.classList.remove('pulse-animation');
      }, { once: true });
    })();
    </script>

    <!-- IntersectionObserver — Text Reveal cu efect cascadă (staggered) -->
    <script is:inline data-astro-rerun>
    (function(){
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      /* Paginile secundare folosesc aceleași intrări graduale ca homepage-ul,
         fără a suprascrie reveal-urile custom ale paginii Acasă. */
      if(!document.body.classList.contains('is-homepage')) {
        document.querySelectorAll('main#continut > section > .section-container > *, main#continut > .section-container > *').forEach(function(el){
          if(!el.classList.contains('text-reveal')) el.classList.add('page-reveal');
        });
      }

      /* Selectează subtitlurile de secțiune + elementele marcate manual */
      var targets = document.querySelectorAll('.section-title, .section-copy, .text-reveal, .page-reveal');
      if(!targets.length) return;

      /* Pe mobil reducem delay-ul cascadă de la 120ms la 50ms — minimizează
         senzația de „pagina sare în sus" când utilizatorul oprește scroll-ul
         lângă un titlu. Pe desktop păstrăm efectul cinematic de 120ms. */
      var isMobile = window.matchMedia('(max-width: 767px)').matches;
      var STAGGER_MS = isMobile ? 50 : 120;

      /* Adaugă clasa .text-reveal pe titluri/copii dacă nu o au deja */
      targets.forEach(function(el){
        if(!el.classList.contains('text-reveal')) el.classList.add('text-reveal');
      });

      /* Grupează elementele pe secțiune/container comun
         pentru a calcula delay-ul cascadă (staggered) corect */
      var observed = new Map(); /* parent → index counter */

      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(!entry.isIntersecting) return;

          var el = entry.target;
          var parent = el.parentElement || document.body;

          /* Increment delay staggered per grup de vecini */
          if(!observed.has(parent)) observed.set(parent, 0);
          var idx = observed.get(parent);
          observed.set(parent, idx + 1);

          var delay = (idx * STAGGER_MS) + 'ms';
          el.style.setProperty('--reveal-delay', delay);
          el.style.setProperty('--page-reveal-delay', delay);
          el.classList.add('is-visible');
          io.unobserve(el);
        });
      }, {
        /* Pe mobil declanșăm mai devreme (rootMargin pozitiv) ca animația
           să se termine înainte ca utilizatorul să ajungă cu privirea acolo. */
        rootMargin: isMobile ? '0px 0px 80px 0px' : '0px 0px -60px 0px',
        threshold: isMobile ? 0.01 : 0.15
      });

      targets.forEach(function(el){ io.observe(el); });
      document.addEventListener('astro:before-swap', function(){
        io.disconnect();
      }, { once: true });
    })();
    </script>
    <!-- Magnetic Button — efect discret desktop (CTA-uri de conversie) -->
    <script is:inline data-astro-rerun>
    (function(){
      var controller = new AbortController();
      /* Doar pe desktop cu mouse și fără preferință reduce-motion */
      if(window.matchMedia('(max-width: 767px)').matches) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if(!window.matchMedia('(hover: hover)').matches) return;

      var PROXIMITY = 30;  /* px — distanța de activare */
      var MAX_SHIFT  = 8;  /* px — deplasare maximă */
      var SEL = '.hero-cta-primary, .hero-cta-secondary, .btn-solid, .btn-outline, .btn-whatsapp';
      var btns = document.querySelectorAll(SEL);
      if(!btns.length) return;

      /* ── Fix forced reflow: cache-uim viewport rects pe scroll/resize
           și evităm să citim getBoundingClientRect în bucla de mousemove.
           Reads și writes sunt complet separate (read-phase apoi write-phase). ── */
      var rects = []; /* {btn, cx, cy, radius} în coordonate viewport */
      var rectsDirty = true;

      function cacheRects(){
        rects = [];
        btns.forEach(function(btn){
          var r = btn.getBoundingClientRect();
          rects.push({
            btn: btn,
            cx: r.left + r.width / 2,
            cy: r.top  + r.height / 2,
            radius: Math.sqrt(r.width * r.width + r.height * r.height) / 2 + PROXIMITY
          });
        });
        rectsDirty = false;
      }

      function invalidateRects(){ rectsDirty = true; }
      window.addEventListener('scroll', invalidateRects, { passive: true, signal: controller.signal });
      window.addEventListener('resize', invalidateRects, { passive: true, signal: controller.signal });

      var rafId = 0;
      var mouseX = 0, mouseY = 0;
      var active = null; /* butonul cel mai apropiat */

      document.addEventListener('mousemove', function(e){
        mouseX = e.clientX;
        mouseY = e.clientY;
        if(!rafId) rafId = requestAnimationFrame(tick);
      }, { passive: true, signal: controller.signal });

      function tick(){
        rafId = 0;
        if(rectsDirty) cacheRects();

        /* ── READ-only phase: calculăm transformările, fără scrieri DOM ── */
        var closest = null;
        var closestDist = Infinity;
        var pending = []; /* {btn, transform} */

        for(var i = 0; i < rects.length; i++){
          var item = rects[i];
          var dx = mouseX - item.cx;
          var dy = mouseY - item.cy;
          var dist = Math.sqrt(dx * dx + dy * dy);

          if(dist < item.radius){
            var factor = Math.max(0, 1 - dist / item.radius);
            var shiftX = dx * factor * MAX_SHIFT / item.radius;
            var shiftY = dy * factor * MAX_SHIFT / item.radius;
            pending.push({ btn: item.btn, transform: 'translate(' + shiftX.toFixed(1) + 'px,' + shiftY.toFixed(1) + 'px)' });
            if(dist < closestDist){ closest = item.btn; closestDist = dist; }
          } else {
            pending.push({ btn: item.btn, transform: '' });
          }
        }

        /* ── WRITE-only phase: aplicăm toate transformările în bloc ── */
        for(var j = 0; j < pending.length; j++){
          pending[j].btn.style.transform = pending[j].transform;
        }

        if(active && active !== closest) active.style.transform = '';
        active = closest;
      }

      /* Reset pe mouseleave global */
      document.addEventListener('mouseleave', function(){
        btns.forEach(function(b){ b.style.transform = ''; });
        active = null;
      }, { signal: controller.signal });
      document.addEventListener('astro:before-swap', function(){
        controller.abort();
        cancelAnimationFrame(rafId);
        btns.forEach(function(b){ b.style.transform = ''; });
      }, { once: true });
    })();
    </script>

