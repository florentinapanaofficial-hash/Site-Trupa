---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkyBackground from '../components/SkyBackground.astro';
import CookieBanner from '../components/CookieBanner.astro';
import siteContent from '../data/siteContent.json';
import seoContent from '../data/seo-content.json';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}

const { title, description, ogType = 'website' } = Astro.props as Props;

const SITE_FALLBACK = 'https://www.florentinapanaofficial.ro';
const site = Astro.site?.toString().replace(/\/$/, '') ?? SITE_FALLBACK;

// Canonical URL — normalizat cu trailing slash pentru consistență cu sitemap + hreflang
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalPath = rawPath === '' ? '/' : `${rawPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? SITE_FALLBACK);
const canonical = canonicalURL.href;

// OG image: transformă calea relativă în URL absolut
// TODO: creează fișierul fizic public/images/og-default-1200x630.jpg (1200×630px)
const rawOgImage = Astro.props.ogImage ?? '/images/og-default-1200x630.jpg';
const ogImage = rawOgImage.startsWith('http') ? rawOgImage : `${site}${rawOgImage}`;

const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;

const { navigation } = siteContent;

const jsonLd = {
  ...seoContent.schema,
  url: site || seoContent.schema.url,
  logo: `${site}/images/logo-fp-stage.svg`,
  foundingDate: '2014',
};

// Schema LocalBusiness + MusicGroup — SEO local, Google Maps, Knowledge Panel
const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "MusicGroup"],
  "name": seoContent.schema.name,
  "legalName": "Pană Claudiu-Gheorghe Întreprindere Individuală",
  "alternateName": seoContent.schema.alternateName,
  "description": seoContent.schema.description,
  "url": site,
  "telephone": seoContent.schema.telephone,
  "email": seoContent.schema.email,
  "image": `${site}/images/logo-fp-stage.svg`,
  "logo": `${site}/images/logo-fp-stage.svg`,
  "foundingDate": "2014",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calea Craiovei nr. 152, Bl. TG1, Sc. B, Et. 6, Ap. 24",
    "addressLocality": "Pitești",
    "addressRegion": "Argeș",
    "postalCode": "110005",
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.8565,
    "longitude": 24.8692
  },
  "priceRange": "$$",
  "currenciesAccepted": "RON",
  "paymentAccepted": "Cash, Transfer bancar",
  "areaServed": seoContent.schema.areaServed,
  "genre": seoContent.schema.genre,
  "sameAs": seoContent.schema.sameAs
};

const isHomePage = Astro.url.pathname === '/';
const hasYouTube = ['/galerie-video', '/aparitii-tv', '/video/', '/colaboratori/', '/comunitate'].some(p => Astro.url.pathname.startsWith(p));
const sectionLink = (anchor: string) => (isHomePage ? anchor : `/${anchor}`);

// JSON-LD: WebPage — fiecare pagină primește schema WebPage
const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonical,
  "inLanguage": "ro",
  "isPartOf": {
    "@type": "WebSite",
    "name": siteContent.brand.name,
    "url": site
  },
  "author": {
    "@type": "MusicGroup",
    "name": "Formația Florentina Pană",
    "url": site
  },
  "publisher": {
    "@type": "Organization",
    "name": "Pană Claudiu-Gheorghe Întreprindere Individuală",
    "url": site,
    "logo": {
      "@type": "ImageObject",
      "url": `${site}/images/logo-fp-stage.svg`
    }
  },
  "datePublished": "2024-01-15",
  "dateModified": new Date().toISOString().split('T')[0]
};

// JSON-LD: BreadcrumbList — navigare ierarhică pentru Google
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Acasă", item: site }
];
const breadcrumbLabels: Record<string, string> = {
  'despre': 'Despre noi',
  'membri': 'Membri',
  'galerie-video': 'Galerie Video',
  'galerie-foto': 'Galerie Foto',
  'momente-cu-mirii': 'Momente cu mirii',
  'comunitate': 'Comunitate',
  'aparitii-tv': 'Apariții TV',
  'contact': 'Contact',
  'blog': 'Blog',
  'termeni-conditii': 'Termeni și condiții',
  'politica-confidentialitate': 'Politica de confidențialitate',
  'politica-cookie': 'Politica de cookie-uri',
};
let breadcrumbPath = site;
pathSegments.forEach((seg, i) => {
  breadcrumbPath += `/${seg}`;
  breadcrumbItems.push({
    "@type": "ListItem",
    position: i + 2,
    name: breadcrumbLabels[seg] || seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    item: breadcrumbPath
  });
});
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

const sideMenuTopItems = [
  { href: '/', label: 'Acasă', color: 'cyan', icon: 'home' },
  { href: '/despre/', label: 'Despre', color: 'cyan', icon: 'info' },
  { href: '/membri/', label: 'Membri', color: 'cyan', icon: 'users' },
  { href: '/galerie-video/', label: 'Galerie Video', color: 'cyan', icon: 'video' },
  { href: '/galerie-foto/', label: 'Galerie Foto', color: 'cyan', icon: 'camera' },
  { href: '/comunitate/', label: 'Comunitate', color: 'cyan', icon: 'people' },
  { href: '/aparitii-tv/', label: 'Apariții TV', color: 'cyan', icon: 'tv' },
  { href: '/contact/', label: 'Contact', color: 'cyan', icon: 'mail' },
];

const sideMenuBottomItems = [];

const { socialLinks: socialLinksData } = siteContent;
const sidebarSocialLinks = {
  youtube: socialLinksData?.youtube || null,
  facebook: socialLinksData?.facebook || null,
  instagram: socialLinksData?.instagram || null,
};

// Lista completă pentru nav-ul mobil — ordine logică, corespunde cu swipe-ul stânga→dreapta
const mobileNavAllItems = [
  { href: '/', label: 'Acasă', color: 'cyan' },
  { href: '/despre/', label: 'Despre', color: 'cyan' },
  { href: '/membri/', label: 'Membri', color: 'cyan' },
  { href: '/galerie-video/', label: 'Galerie Video', color: 'cyan' },
  { href: '/galerie-foto/', label: 'Galerie Foto', color: 'cyan' },
  { href: '/comunitate/', label: 'Comunitate', color: 'cyan' },
  { href: '/aparitii-tv/', label: 'Apariții TV', color: 'cyan' },
  { href: '/contact/', label: 'Contact', color: 'cyan' },
];
---

<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0c0f1f" />
    <meta name="author" content="Formația Florentina Pană" />
    <!-- SEO local: județ Argeș, codul ISO RO-AG recunoscut de Google Maps -->
    <meta name="geo.region" content="RO-AG" />
    <meta name="geo.placename" content="Pitești, Argeș" />
    <link rel="canonical" href={canonical} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} – Formația Florentina Pană`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={siteContent.brand.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- [DE_COMPLETAT] Înlocuiește @florentinapana cu contul real X/Twitter -->
    <meta name="twitter:site" content="@florentinapana" />
    <meta name="twitter:creator" content="@florentinapana" />

    <!-- Preconnect YouTube — doar pe paginile cu embed-uri video -->
    {hasYouTube && <link rel="preconnect" href="https://www.youtube-nocookie.com" />}
    {hasYouTube && <link rel="preconnect" href="https://img.youtube.com" />}
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Fonturi self-hosted — Inter + Oswald, preload latin + latin-ext -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oswald-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oswald-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/images/logo-fp-stage.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {isHomePage && <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
    {!isHomePage && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <slot name="head" />
    {/* GA4 NU se încarcă în <head> — se injectează dinamic DUPĂ consimțământul
        utilizatorului prin CookieBanner, conform Rec. 30 & 32 RGPD / ePrivacy */}
  </head>
  <body class={`page-shell${isHomePage ? ' is-homepage' : ''}`}>
    <a href="#continut" class="skip-link">Sari la conținut</a>
    <SkyBackground />
    <Header />

    <!-- ══ MOBIL: nav plutitor (ascuns pe desktop via CSS) ══ -->
    <nav class="mob-nav" aria-label="Navigare mobilă">
      <div class="mob-nav-track">
        {mobileNavAllItems.map((item) => (
          <a href={item.href} class="mob-nav-btn" data-mb={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>

    <div class="layout-content-shell">
      <aside class="left-side-menu" aria-label="Navigare principală">
        <!-- Logo + nume formație (vizibil doar pe desktop via CSS) -->
        <a href={isHomePage ? '#acasa' : '/'} class="sidebar-brand" aria-label="Acasă">
          <img src="/images/logo-fp-stage.svg" alt="Logo Formația Florentina Pană" width="42" height="42" loading="eager" decoding="async" />
          <span class="sidebar-brand-text">
            <span class="sidebar-brand-name">{siteContent.brand.name}</span>
            <span class="sidebar-brand-sub">Live Band Premium</span>
          </span>
        </a>

        {sideMenuTopItems.map((item) => (
          <a href={item.href} class={`left-side-link nav-btn-${item.color}`} data-nav-link>
            <span class="nav-icon" aria-hidden="true">
              {item.icon === 'home' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>}
              {item.icon === 'info' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>}
              {item.icon === 'users' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {item.icon === 'video' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>}
              {item.icon === 'camera' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>}
              {item.icon === 'heart' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
              {item.icon === 'people' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {item.icon === 'tv' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>}
              {item.icon === 'mail' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>}
            </span>
            {item.label}
          </a>
        ))}

        {sideMenuBottomItems.map((item) => (
          <a href={item.href} class={`left-side-link nav-btn-${item.color}`} data-nav-link>{item.label}</a>
        ))}

        <!-- Spacer flexibil — împinge social media la baza sidebarului -->
        <div class="sidebar-spacer"></div>

        <!-- Social media (vizibil doar pe desktop via CSS) -->
        <div class="sidebar-social">
          {sidebarSocialLinks.youtube && (
            <a href={sidebarSocialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube"
              class="social-btn social-btn--yt">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="13" rx="4" fill="#fff"/><polygon points="9.5,9.5 9.5,15.5 16.5,12.5" fill="#FF0000"/></svg>
              <span class="sr-only">YouTube Formația Florentina Pană</span>
            </a>
          )}
          {sidebarSocialLinks.facebook && (
            <a href={sidebarSocialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
              class="social-btn social-btn--fb">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M13.5 21V14.3H16l.4-2.85H13.5V9.7c0-.82.38-1.2 1.38-1.2H16.5V5.85C16.05 5.77 15.1 5.7 14 5.7c-2.65 0-4.05 1.4-4.05 4.15v1.6H8v2.85h1.95V21H13.5z" fill="#fff"/></svg>
              <span class="sr-only">Facebook Formația Florentina Pană</span>
            </a>
          )}
          {sidebarSocialLinks.instagram && (
            <a href={sidebarSocialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
              class="social-btn social-btn--ig">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="#fff" stroke-width="2.1"/><circle cx="12" cy="12" r="4.3" stroke="#fff" stroke-width="2"/><circle cx="17.5" cy="6.6" r="1.4" fill="#fff"/></svg>
              <span class="sr-only">Instagram Formația Florentina Pană</span>
            </a>
          )}
        </div>
        <small class="sidebar-copy">© 2026 Formația Florentina Pană</small>
      </aside>

      <main id="continut" class="flex-1 min-w-0 pt-40 sm:pt-44">
        <slot />
      </main>
    </div>
    <Footer />

    {/* Banner consimțământ cookie – GA4 pornit doar după accept */}
    <CookieBanner ga4Id={ga4Id} />

    <script is:inline>
    (() => {
        function initScrollProgress() {
            const root = document.documentElement;
            let ticking = false;
            let scrollableHeight = 0;
            const cacheHeight = () => {
                scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
            };
            const updateScrollProgress = () => {
                const progress = scrollableHeight > 0 ? Math.min(Math.max(window.scrollY / scrollableHeight, 0), 1) : 0;
                root.style.setProperty('--scroll-progress', progress.toFixed(4));
            };
            const onScroll = () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => { updateScrollProgress(); ticking = false; });
            };
            cacheHeight();
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', () => { cacheHeight(); updateScrollProgress(); });
            updateScrollProgress();
        }
        if ('requestIdleCallback' in window) {
            requestIdleCallback(initScrollProgress);
        } else {
            setTimeout(initScrollProgress, 1);
        }
    })();
    </script>

    <script is:inline>
    (() => {
        const menu = document.querySelector('.left-side-menu');
        if (!menu) return;
        const links = Array.from(menu.querySelectorAll('.left-side-link'));
        const sectionToHref = { 'acasa': '/', 'video': '/galerie-video', 'galerie': '/galerie-foto', 'membri': '/membri' };
        function setActive(href) {
            menu.classList.remove('has-active');
            links.forEach(l => l.classList.remove('is-active'));
            const match = links.find(l => l.getAttribute('href') === href);
            if (match) { match.classList.add('is-active'); menu.classList.add('has-active'); }
        }
        function currentHref() {
            const path = location.pathname.replace(/\/$/, '') || '/';
            const hash = location.hash;
            const full = path + hash;
            if (links.some(l => l.getAttribute('href') === full)) return full;
            if (links.some(l => l.getAttribute('href') === path)) return path;
            if (path === '' || path === '/') return '/';
            return path;
        }
        setActive(currentHref());
        links.forEach(l => { l.addEventListener('click', () => { setTimeout(() => setActive(l.getAttribute('href')), 80); }); });
        const sections = Array.from(document.querySelectorAll('section[id]'));
        if (!sections.length) return;
        const visibleSet = new Set();
        let lastActiveId = '';
        const obs = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) visibleSet.add(entry.target.id); else visibleSet.delete(entry.target.id); });
            if (!visibleSet.size) return;
            const topSection = sections.find(s => visibleSet.has(s.id));
            if (!topSection || topSection.id === lastActiveId) return;
            lastActiveId = topSection.id;
            const path = location.pathname.replace(/\/$/, '') || '/';
            if (path === '/') { const href = sectionToHref[topSection.id]; if (href) setActive(href); }
            else { const anchorHref = path + '#' + topSection.id; if (links.some(l => l.getAttribute('href') === anchorHref)) setActive(anchorHref); }
        }, { rootMargin: '-8% 0px -45% 0px', threshold: 0 });
        sections.forEach(s => obs.observe(s));
    })();
    </script>

    <!-- ══ MOBIL: săgeți hint swipe (ascunse pe desktop via CSS) ══ -->
    <div class="mob-swipe-hints" aria-hidden="true">
      <button type="button" class="mob-arrow mob-arrow--prev" id="mob-arrow-prev" aria-label="Secțiunea anterioară">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="mob-arrow mob-arrow--next" id="mob-arrow-next" aria-label="Secțiunea următoare">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <script is:inline src="/js/mobile-swipe.js" defer></script>

    <!-- Oprește audio/video când utilizatorul pleacă de pe pagină -->
    <script is:inline>
    (function(){
      function stopAllMedia(){
        document.querySelectorAll('audio, video').forEach(function(el){
          if(!el.paused){ el.pause(); el.currentTime=0; }
        });
        /* Oprește și iframe-urile YouTube (postMessage API) */
        document.querySelectorAll('iframe[src*="youtube"]').forEach(function(f){
          try{ f.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}','*'); }catch(_){}
        });
      }
      document.addEventListener('visibilitychange',function(){ if(document.hidden) stopAllMedia(); });
      window.addEventListener('pagehide', stopAllMedia);
      window.addEventListener('beforeunload', stopAllMedia);
    })();
    </script>

    <!-- Calculează înălțimea header-ului și sincronizează --mob-nav-h -->
    <script is:inline>
    (function(){
      if(!window.matchMedia('(max-width:767px)').matches) return;
      function sync(){
        var nav=document.querySelector('.top-header');
        if(!nav) return;
        var h=nav.offsetHeight;
        if(h>0) document.documentElement.style.setProperty('--mob-nav-h',h+'px');
      }
      var resizeTimer;
      function debouncedSync(){ clearTimeout(resizeTimer); resizeTimer=setTimeout(sync,200); }
      if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',sync);}else{sync();}
      window.addEventListener('resize',debouncedSync,{passive:true});
    })();
    </script>

    <!-- IntersectionObserver — Text Reveal cu efect cascadă (staggered) -->
    <script is:inline>
    (function(){
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      /* Selectează subtitlurile de secțiune + elementele marcate manual */
      var targets = document.querySelectorAll('.section-title, .section-copy, .text-reveal');
      if(!targets.length) return;

      /* Adaugă clasa .text-reveal pe titluri/copii dacă nu o au deja */
      targets.forEach(function(el){
        if(!el.classList.contains('text-reveal')) el.classList.add('text-reveal');
      });

      /* Grupează elementele pe secțiune/container comun
         pentru a calcula delay-ul cascadă (staggered) corect */
      var observed = new Map(); /* parent → index counter */

      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(!entry.isIntersecting) return;

          var el = entry.target;
          var parent = el.parentElement || document.body;

          /* Increment delay staggered per grup de vecini */
          if(!observed.has(parent)) observed.set(parent, 0);
          var idx = observed.get(parent);
          observed.set(parent, idx + 1);

          el.style.setProperty('--reveal-delay', (idx * 120) + 'ms');
          el.classList.add('is-visible');
          io.unobserve(el);
        });
      }, {
        rootMargin: '0px 0px -60px 0px',
        threshold: 0.15
      });

      targets.forEach(function(el){ io.observe(el); });
    })();
    </script>
    <!-- Magnetic Button — efect discret desktop (CTA-uri de conversie) -->
    <script is:inline>
    (function(){
      /* Doar pe desktop cu mouse și fără preferință reduce-motion */
      if(window.matchMedia('(max-width: 767px)').matches) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if(!window.matchMedia('(hover: hover)').matches) return;

      var PROXIMITY = 30;  /* px — distanța de activare */
      var MAX_SHIFT  = 8;  /* px — deplasare maximă */
      var SEL = '.hero-cta-primary, .hero-cta-secondary, .btn-solid, .btn-outline, .btn-whatsapp';
      var btns = document.querySelectorAll(SEL);
      if(!btns.length) return;

      var rafId = 0;
      var mouseX = 0, mouseY = 0;
      var active = null; /* butonul cel mai apropiat */

      document.addEventListener('mousemove', function(e){
        mouseX = e.clientX;
        mouseY = e.clientY;
        if(!rafId) rafId = requestAnimationFrame(tick);
      }, { passive: true });

      function tick(){
        rafId = 0;
        var closest = null;
        var closestDist = Infinity;

        btns.forEach(function(btn){
          var r = btn.getBoundingClientRect();
          /* Centrul butonului */
          var cx = r.left + r.width / 2;
          var cy = r.top  + r.height / 2;
          /* Distanța mouse → centru */
          var dx = mouseX - cx;
          var dy = mouseY - cy;
          var dist = Math.sqrt(dx * dx + dy * dy);
          /* Raza de activare = jumătatea diagonalei + PROXIMITY */
          var radius = Math.sqrt(r.width * r.width + r.height * r.height) / 2 + PROXIMITY;

          if(dist < radius && dist < closestDist){
            closest = btn;
            closestDist = dist;
            /* Intensitate inversă cu distanța */
            var factor = Math.max(0, 1 - dist / radius);
            var shiftX = dx * factor * MAX_SHIFT / radius;
            var shiftY = dy * factor * MAX_SHIFT / radius;
            btn.style.transform = 'translate(' + shiftX.toFixed(1) + 'px,' + shiftY.toFixed(1) + 'px)';
          } else {
            btn.style.transform = '';
          }
        });

        if(active && active !== closest) active.style.transform = '';
        active = closest;
      }

      /* Reset pe mouseleave global */
      document.addEventListener('mouseleave', function(){
        btns.forEach(function(b){ b.style.transform = ''; });
        active = null;
      });
    })();
    </script>

  </body>
</html>

