---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkyBackground from '../components/SkyBackground.astro';
import CookieBanner from '../components/CookieBanner.astro';
import siteContent from '../data/siteContent.json';
import seoContent from '../data/seo-content.json';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  ogVideoUrl?: string;
  ogVideoSecureUrl?: string;
  ogVideoType?: string;
  ogVideoWidth?: string;
  ogVideoHeight?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  hideFooter?: boolean;
}

const { title, description, ogType = 'website', ogVideoUrl, ogVideoSecureUrl, ogVideoType = 'text/html', ogVideoWidth = '1280', ogVideoHeight = '720', datePublished, dateModified, noindex = false, hideFooter = false } = Astro.props as Props;

const SITE_FALLBACK = 'https://www.florentinapanaofficial.ro';
const site = Astro.site?.toString().replace(/\/$/, '') ?? SITE_FALLBACK;

// Canonical URL — normalizat cu trailing slash pentru consistență cu sitemap + hreflang
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalPath = rawPath === '' ? '/' : `${rawPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? SITE_FALLBACK);
const canonical = canonicalURL.href;
const MUSIC_GROUP_ID = `${site}/#music-group`;
const isAboutPage = Astro.url.pathname === '/despre/';
const isMembersPage = Astro.url.pathname === '/membri/';

// OG image: transformă calea relativă în URL absolut + encode spații
const rawOgImage = Astro.props.ogImage ?? '/images/og-default-1200x630.jpg';
const ogImageAbsolute = rawOgImage.startsWith('http') ? rawOgImage : `${site}${rawOgImage}`;
const ogImage = encodeURI(decodeURI(ogImageAbsolute));
const compactSeoText = (value: string, maxLength: number) => {
  if (value.length <= maxLength) return value;
  const shortened = value.slice(0, maxLength - 1).replace(/\s+\S*$/, '').trim();
  return `${shortened}…`;
};
const seoTitle = compactSeoText(title, 60);
const seoDescription = compactSeoText(description, 160);

const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const tiktokPixelId = import.meta.env.PUBLIC_TIKTOK_PIXEL_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const telHref = `tel:${siteContent.contact.phoneRaw}`;
const waFloatHref = `https://wa.me/${siteContent.contact.phoneRaw.replace('+', '')}?text=Bun%C4%83!%20Vreau%20o%20ofert%C4%83%20pentru%20Forma%C8%9Bia%20Florentina%20Pan%C4%83.`;
const logoPngUrl = `${site}/images/logo-512.png`;

const jsonLd = {
  ...seoContent.schema,
  '@id': MUSIC_GROUP_ID,
  url: site || seoContent.schema.url,
  logo: {
    "@type": "ImageObject",
    "url": logoPngUrl,
    "width": 512,
    "height": 512
  },
  image: logoPngUrl,
  foundingDate: '2014',
};

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": seoContent.schema.name,
  "url": site,
  "logo": {
    "@type": "ImageObject",
    "url": logoPngUrl,
    "width": 512,
    "height": 512
  },
  "sameAs": seoContent.schema.sameAs
};

// Schema LocalBusiness + MusicGroup — SEO local, Google Maps, Knowledge Panel
const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "EntertainmentBusiness"],
  "@id": `${site}/#local-business`,
  "name": seoContent.schema.name,
  "legalName": "Pană Claudiu-Gheorghe Întreprindere Individuală",
  "alternateName": seoContent.schema.alternateName,
  "description": seoContent.schema.description,
  "url": site,
  "performer": {
    "@type": "MusicGroup",
    "@id": MUSIC_GROUP_ID
  },
  "telephone": seoContent.schema.telephone,
  "email": seoContent.schema.email,
  "image": logoPngUrl,
  "logo": {
    "@type": "ImageObject",
    "url": logoPngUrl,
    "width": 512,
    "height": 512
  },
  "foundingDate": "2014",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calea Craiovei nr. 152, Bl. TG1, Sc. B, Et. 6, Ap. 24",
    "addressLocality": "Pitești",
    "addressRegion": "Argeș",
    "postalCode": "110005",
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.8565,
    "longitude": 24.8692
  },
  "priceRange": "$$",
  "currenciesAccepted": "RON",
  "paymentAccepted": "Cash, Transfer bancar",
  "serviceType": ["Muzică live pentru nunți", "Muzică live pentru botezuri", "Muzică de petrecere pentru evenimente private"],
  "areaServed": seoContent.schema.areaServed,
  "genre": ["Muzica Greceasca", "Muzica Arabeasca", "Muzica Latino", "Muzica Machedoneasca", "Manele", "Muzica Populara de Petrecere"],
  "knowsAbout": seoContent.schema.knowsAbout,
  "sameAs": seoContent.schema.sameAs
};

const webSiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": seoContent.schema.name,
  "url": site,
  "inLanguage": "ro-RO"
};

const serviceCatalogItems = (siteContent.services ?? []).map((service, index) => {
  const serviceUrl = `${site}/contact/`;

  return {
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.description,
      serviceType: service.title,
      areaServed: seoContent.schema.areaServed,
      provider: {
        '@type': 'MusicGroup',
        name: seoContent.schema.name,
        url: site,
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl,
        availableLanguage: ['ro', 'en'],
      },
      offers: {
        '@type': 'Offer',
        url: serviceUrl,
        availability: 'https://schema.org/InStock',
        priceCurrency: 'RON',
        category: 'Serviciu muzică live',
      },
    },
  };
});

const offerCatalogLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Pachete și servicii muzică live',
  url: `${site}/contact/`,
  itemListElement: serviceCatalogItems,
};

const commercialServiceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Servicii muzică live pentru evenimente',
  description: seoContent.schema.description,
  provider: {
    '@type': 'MusicGroup',
    name: seoContent.schema.name,
    url: site,
  },
  areaServed: seoContent.schema.areaServed,
  serviceType: [
    'Formație nuntă',
    'Muzică live la botez',
    'Evenimente corporate cu muzică live',
    'Program muzical personalizat pentru evenimente private',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: offerCatalogLd.name,
    url: offerCatalogLd.url,
  },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${site}/contact/`,
    availableLanguage: ['ro', 'en'],
  },
  offers: {
    '@type': 'Offer',
    url: `${site}/oferta-premium/`,
    availability: 'https://schema.org/InStock',
    priceCurrency: 'RON',
    category: 'Ofertă formație nuntă și evenimente',
  },
};

const repertoireItemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Genuri muzicale interpretate',
  itemListElement: (siteContent.repertoire ?? []).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    description: item.details,
  })),
};

const isHomePage = Astro.url.pathname === '/';
const hasYouTube = ['/galerie-video', '/aparitii-tv', '/video/', '/colaboratori/', '/comunitate', '/live'].some(p => Astro.url.pathname.startsWith(p));
const isCommunityDetailPage = /^\/comunitate\/[^/]+\/$/.test(Astro.url.pathname);

// JSON-LD: WebPage — fiecare pagină primește schema WebPage
const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "inLanguage": "ro",
  "isPartOf": {
    "@type": "WebSite",
    "name": siteContent.brand.name,
    "url": site
  },
  "author": {
    "@type": "MusicGroup",
    "@id": MUSIC_GROUP_ID,
    "name": "Formația Florentina Pană",
    "url": site
  },
  "publisher": {
    "@type": "Organization",
    "name": "Pană Claudiu-Gheorghe Întreprindere Individuală",
    "url": site,
    "logo": {
      "@type": "ImageObject",
      "url": logoPngUrl,
      "width": 512,
      "height": 512
    }
  },
  ...(datePublished ? { "datePublished": datePublished } : {}),
  ...(dateModified ? { "dateModified": dateModified } : {})
};

// JSON-LD: BreadcrumbList — navigare ierarhică pentru Google
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Acasă", item: site }
];
const breadcrumbLabels: Record<string, string> = {
  'cauti-formatie-nunta': 'Cauți formație?',
  'despre': 'Despre noi',
  'membri': 'Membri',
  'galerie-video': 'Galerie Video',
  'galerie-foto': 'Galerie Foto',
  'shorts': 'Reels',
  'muzica-non-stop': 'Bibliotecă Audio',
  'momente-cu-mirii': 'Momente cu mirii',
  'comunitate': 'Comunitate',
  'aparitii-tv': 'Apariții TV',
  'live': 'Live cu Florentina Pană',
  'replay': 'Replay',
  'contact': 'Contact',
  'blog': 'Blog',
  'termeni-conditii': 'Termeni și condiții',
  'politica-confidentialitate': 'Politica de confidențialitate',
  'politica-cookie': 'Politica de cookie-uri',
};
let breadcrumbPath = site;
pathSegments.forEach((seg, i) => {
  breadcrumbPath += `/${seg}`;
  breadcrumbItems.push({
    "@type": "ListItem",
    position: i + 2,
    name: breadcrumbLabels[seg] || seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    item: breadcrumbPath
  });
});
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

---

<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <ClientRouter />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#1346a8" />
    <meta name="author" content="Formația Florentina Pană" />
    <!-- SEO local: județ Argeș, codul ISO RO-AG recunoscut de Google Maps -->
    <meta name="geo.region" content="RO-AG" />
    <meta name="geo.placename" content="Pitești, Argeș" />
    <link rel="canonical" href={canonical} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} – Formația Florentina Pană`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogVideoUrl && <meta property="og:video" content={ogVideoUrl} />}
    {ogVideoSecureUrl && <meta property="og:video:secure_url" content={ogVideoSecureUrl} />}
    {ogVideoType && <meta property="og:video:type" content={ogVideoType} />}
    {ogVideoWidth && <meta property="og:video:width" content={ogVideoWidth} />}
    {ogVideoHeight && <meta property="og:video:height" content={ogVideoHeight} />}
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={siteContent.brand.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />
    <!-- [DE_COMPLETAT] Înlocuiește @florentinapana cu contul real X/Twitter -->
    <meta name="twitter:site" content="@florentinapana" />
    <meta name="twitter:creator" content="@florentinapana" />

    <!-- Preconnect YouTube — doar pe paginile cu embed-uri video -->
    {hasYouTube && <link rel="preconnect" href="https://www.youtube-nocookie.com" />}
    {hasYouTube && <link rel="preconnect" href="https://img.youtube.com" />}
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />

    {/* LCP image preload (din pagină) — ÎNAINTE de fonturi pentru prioritate maximă */}
    <slot name="head" />

            <!-- Preload pentru subseturile folosite de Hero: elimină font swap-ul care
              deplasa H1-ul și producea CLS pe mobil. -->
            <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/fonts/oswald-latin.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/fonts/oswald-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo-fp-stage.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" data-schema="music-group" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" data-schema="organization" set:html={JSON.stringify(organizationLd)} />
    <script is:inline type="application/ld+json" data-schema="website" set:html={JSON.stringify(webSiteLd)} />
    {isHomePage && <script is:inline type="application/ld+json" data-schema="local-business" set:html={JSON.stringify(localBusinessLd)} />}
    {isHomePage && <script is:inline type="application/ld+json" data-schema="commercial-service" set:html={JSON.stringify(commercialServiceLd)} />}
    {isHomePage && <script is:inline type="application/ld+json" data-schema="offer-catalog" set:html={JSON.stringify(offerCatalogLd)} />}
    {isHomePage && <script is:inline type="application/ld+json" data-schema="repertoire-item-list" set:html={JSON.stringify(repertoireItemListLd)} />}
    <script is:inline type="application/ld+json" data-schema="webpage" set:html={JSON.stringify(webPageLd)} />
    {!isHomePage && <script is:inline type="application/ld+json" data-schema="breadcrumb" set:html={JSON.stringify(breadcrumbLd)} />}
    {/* GA4, Meta Pixel și TikTok Pixel NU se încarcă direct în <head> — se injectează dinamic
        DUPĂ consimțământul utilizatorului (CookieBanner) prin FPTracking, conform Rec. 30 & 32
        RGPD / ePrivacy. Retrimise la fiecare navigare client-side prin astro:page-load. */}
    <script is:inline define:vars={{ ga4Id, metaPixelId, tiktokPixelId }}>
      window.__FP_TRACKING_IDS__ = { ga4Id: ga4Id, metaPixelId: metaPixelId, tiktokPixelId: tiktokPixelId };
    </script>
    <script is:inline src="/js/tracking-pixels.js" defer></script>
    {/* ── Fix ecran gol la Back pe mobil (ClientRouter + scroll restoration nativă) ──
        1) Dezactivăm restaurarea automată de scroll a browserului: fără asta,
           browserul poate aplica poziția de scroll adâncă a paginii anterioare
           înainte ca noul DOM să fie complet randat, lăsând vizibil doar fundalul.
        2) La finalul swap-ului (astro:after-swap), dacă am AJUNS pe Acasă printr-o
           navigare înainte (link/click), forțăm scroll la top. La Back/Forward
           (data-astro-transition="back") NU suprascriem — ClientRouter restaurează
           deja poziția exactă de scroll salvată în history.state. */}
    <script is:inline>
      (function () {
        if (window.__fpScrollRestorationInit) return;
        window.__fpScrollRestorationInit = true;
        var unstickTimer = 0;

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        /* Elimină orice stare vizuală „blocată" (is-navigating, opacity inline pe
           #continut) și forțează reveal pe elementele care ar putea rămâne
           opacity:0 dacă IntersectionObserver-ul nu a apucat să le observe încă
           (ex. poziție de scroll restaurată adânc pe pagină la Back). */
        function unstickPage() {
          document.documentElement.classList.remove('is-navigating');
          var main = document.getElementById('continut');
          if (main) {
            main.style.opacity = '';
            main.style.transition = '';
          }
          document.querySelectorAll('.reveal-on-scroll, .text-reveal, .page-reveal').forEach(function (el) {
            el.classList.add('is-visible');
          });
        }

        document.addEventListener('astro:before-preparation', function () {
          document.documentElement.classList.add('is-navigating');
        });
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.remove('is-navigating');
          var direction = document.documentElement.getAttribute('data-astro-transition');
          if (location.pathname === '/' && direction !== 'back') {
            window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
          }
          var main = document.getElementById('continut');
          if (main) {
            main.style.opacity = '';
            main.style.transition = '';
          }
          /* Fallback: dacă la 1.5s după swap tot mai există elemente ascunse
             (observer-ul de reveal nu a apucat să le prindă), le arătăm forțat
             în loc să lăsăm ecranul gol/parțial gol. */
          window.clearTimeout(unstickTimer);
          unstickTimer = window.setTimeout(unstickPage, 1500);
        });
        document.addEventListener('astro:before-swap', function () {
          window.clearTimeout(unstickTimer);
        });

        /* Fallback pentru restaurare din bfcache (Back/Forward pe unele mobile
           browsers pot restaura pagina din bfcache fără să treacă prin
           ciclul ClientRouter astro:after-swap) — curățăm imediat orice stare
           vizuală rămasă blocată. */
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) unstickPage();
        });
      })();
    </script>
  </head>
  <body class={`page-shell${isHomePage ? ' is-homepage' : ''}${isCommunityDetailPage ? ' is-community-detail' : ''}${isAboutPage ? ' is-about-page' : ''}`}>
    <div class="nav-loading-bar" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#continut" class="skip-link">Sari la conținut</a>
    <SkyBackground />
    <Header />

    <div class="layout-content-shell">
      <main id="continut" class="flex-1 min-w-0 pt-40 sm:pt-44 lg:pt-0 flex flex-col min-h-[100dvh]">
        <slot />
        {!hideFooter && <div class="flex-1" aria-hidden="true"></div>}
        {!hideFooter && <Footer />}
      </main>
    </div>

    {/* Banner consimțământ cookie – GA4/Meta/TikTok pornite doar după accept (vezi FPTracking) */}
    <CookieBanner />

    <!-- ══ Mutual Exclusion: YouTube Player Pause on Active ══ 
         Pauzează TOȚI playerele YouTube de pe pagină atunci când se porneşte playback pe oricare dintre ele.
         Necesită enablejsapi=1 pe iframe-uri și funcționează prin postMessage cu YouTube API.
    ═════════════════════════════════════════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        if (window.__ytMutualExclusionInit) return;
        window.__ytMutualExclusionInit = true;

        var YT_PAUSE = JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] });
        var YT_ORIGINS = ['https://www.youtube-nocookie.com', 'https://www.youtube.com'];

        function postYouTubeMessage(targetWindow, payload) {
          if (!targetWindow) return;
          var serialized = typeof payload === 'string' ? payload : JSON.stringify(payload);
          YT_ORIGINS.forEach(function (origin) {
            try { targetWindow.postMessage(serialized, origin); } catch (_) {}
          });
          try { targetWindow.postMessage(serialized, '*'); } catch (_) {}
        }

        function pauseNativeMediaExcept(activeMedia) {
          document.querySelectorAll('audio, video').forEach(function (media) {
            if (media !== activeMedia && !media.paused) {
              media.pause();
            }
          });
        }

        /**
         * Pauzează TOȚI playerele YouTube de pe pagină mai puțin cel activ
         * @param {Window} activeSource - contentWindow-ul playerului care face playback
         */
        function pauseAllExcept(activeSource) {
          document.querySelectorAll('iframe[src*="youtube"]').forEach(function (iframe) {
            try {
              if (iframe.contentWindow && iframe.contentWindow !== activeSource) {
                postYouTubeMessage(iframe.contentWindow, YT_PAUSE);
              }
            } catch (err) {
              console.warn('Error pausing YouTube player:', err);
            }
          });
        }

        /**
         * Reacționează la mesajele YouTube Player API
         * Când un player start playback (playerState === 1), pauza toți ceilalți
         */
        window.addEventListener('message', function (e) {
          if (!e.data || !e.source) return;
          if (YT_ORIGINS.indexOf(e.origin) === -1) return;

          var data;
          try {
            data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
          } catch (err) {
            return;
          }

          // YouTube trimite playerState: 1 (playing) prin evenimentul infoDelivery
          if (data.event === 'infoDelivery' && data.info && data.info.playerState === 1) {
            pauseAllExcept(e.source);
            pauseNativeMediaExcept(null);
          }

          if (data.event === 'onStateChange' && Number(data.info) === 1) {
            pauseAllExcept(e.source);
            pauseNativeMediaExcept(null);
          }
        });

        // Când pornește un audio/video HTML5, îl punem exclusiv.
        document.addEventListener('play', function (event) {
          var active = event.target;
          if (!active || (active.tagName !== 'AUDIO' && active.tagName !== 'VIDEO')) return;
          pauseNativeMediaExcept(active);
          pauseAllExcept(null);
        }, true);
      })();
    </script>

    <script is:inline data-astro-rerun>
    (() => {
      const controller = new AbortController();
      let progressRaf = 0;
        function initScrollProgress() {
            const root = document.documentElement;
            let ticking = false;
            let scrollableHeight = 0;
            const cacheHeight = () => {
                scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
            };
            const updateScrollProgress = () => {
                const progress = scrollableHeight > 0 ? Math.min(Math.max(window.scrollY / scrollableHeight, 0), 1) : 0;
                root.style.setProperty('--scroll-progress', progress.toFixed(4));
            };
            const onScroll = () => {
                if (ticking) return;
                ticking = true;
                progressRaf = requestAnimationFrame(() => { updateScrollProgress(); ticking = false; });
            };
            cacheHeight();
              window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
              window.addEventListener('resize', () => { cacheHeight(); updateScrollProgress(); }, { signal: controller.signal });
            updateScrollProgress();
        }
            initScrollProgress();
            document.addEventListener('astro:before-swap', () => {
              controller.abort();
              cancelAnimationFrame(progressRaf);
            }, { once: true });
    })();
    </script>

