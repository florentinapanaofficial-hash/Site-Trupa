    <style>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: max(0%, calc(var(--scroll-progress, 0) * 100%));
        z-index: 999;
        background: linear-gradient(90deg, #0bbcd6 0%, #ffd700 48%, #f5a623 100%);
        box-shadow: 0 0 14px rgba(245, 166, 35, 0.45);
        pointer-events: none;
      }

      /* ── Bară de încărcare navigare (ClientRouter) ──
         Feedback vizual continuu în timpul fetch-ului de pagină (inclusiv
         Back/Forward), ca ecranul să nu pară „înghețat”/gol pe conexiuni lente. */
      .nav-loading-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 100%;
        z-index: 1000;
        pointer-events: none;
        transform: scaleX(0);
        transform-origin: left center;
        opacity: 0;
        background: linear-gradient(90deg, #0bbcd6 0%, #ffd700 48%, #f5a623 100%);
        transition: opacity 0.15s ease;
      }
      html.is-navigating .nav-loading-bar {
        opacity: 1;
        animation: nav-loading-sweep 1.1s ease-in-out infinite;
      }
      @keyframes nav-loading-sweep {
        0% { transform: scaleX(0); transform-origin: left center; }
        50% { transform: scaleX(0.75); transform-origin: left center; }
        50.001% { transform-origin: right center; }
        100% { transform: scaleX(0); transform-origin: right center; }
      }
      @media (prefers-reduced-motion: reduce) {
        html.is-navigating .nav-loading-bar { animation: none; opacity: 1; transform: scaleX(1); }
      }

      /* ── WhatsApp Floating Button ── */
      .wa-float {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 2px 6px rgba(0, 0, 0, 0.25);
        text-decoration: none;
        transition: transform 200ms ease, box-shadow 200ms ease;
        animation: wa-pulse 2.5s ease-in-out infinite;
      }

      .wa-float:hover,
      .wa-float:focus-visible {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.55), 0 3px 10px rgba(0, 0, 0, 0.3);
        animation: none;
      }

      .wa-float:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }

      @keyframes wa-pulse {
        0%, 100% { box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 0 0 0 rgba(37, 211, 102, 0.4); }
        50%       { box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 0 0 10px rgba(37, 211, 102, 0); }
      }

      /* Pe mobil: poziționare optimizată — fără suprapunere cu elementele galeriei */
      @media (max-width: 767px) {
        .wa-float {
          bottom: 5.5rem;
          right: 1rem;
          width: 3rem;
          height: 3rem;
        }
        .wa-float svg {
          width: 24px;
          height: 24px;
        }
      }

      .quick-dock {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        bottom: calc(env(safe-area-inset-bottom, 0px) + 0.65rem);
        z-index: 920;
        display: none;
        gap: 0.6rem;
        width: min(95vw, 520px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 1.1rem;
        padding: 0.42rem;
        background:
          linear-gradient(120deg, rgba(8, 16, 38, 0.84), rgba(10, 21, 45, 0.86)),
          radial-gradient(circle at 80% 0%, rgba(11, 188, 214, 0.2), transparent 42%);
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35), 0 0 22px rgba(11, 188, 214, 0.14);
        animation: quick-dock-rise 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .quick-dock-btn {
        flex: 1;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 0.74rem;
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-size: 0.76rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 700;
        transition: transform 180ms ease, filter 180ms ease, box-shadow 180ms ease;
      }

      .quick-dock-btn svg {
        width: 16px;
        height: 16px;
      }

      .quick-dock-btn--call {
        color: #d8ecff;
        border: 1px solid rgba(11, 188, 214, 0.42);
        background: rgba(11, 188, 214, 0.16);
      }

      .quick-dock-btn--wa {
        color: #0f2719;
        border: 1px solid rgba(55, 207, 120, 0.45);
        background: linear-gradient(135deg, #38de8a 0%, #28be72 100%);
      }

      .quick-dock-btn--offer {
        color: #2c1700;
        border: 1px solid rgba(245, 166, 35, 0.44);
        background: linear-gradient(135deg, #ffd166 0%, #f5a623 100%);
      }

      .quick-dock-btn:hover,
      .quick-dock-btn:focus-visible {
        transform: translateY(-1px);
        filter: saturate(1.04) brightness(1.03);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      }

      .quick-dock-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }

      @media (max-width: 767px) {
        .quick-dock {
          display: flex;
        }

        body.is-about-page .wa-float {
          display: none;
        }
      }

      body.mobile-menu-open .quick-dock {
        opacity: 0;
        pointer-events: none;
      }

      @keyframes quick-dock-rise {
        from {
          opacity: 0;
          transform: translate(-50%, 8px);
        }

        to {
          opacity: 1;
          transform: translate(-50%, 0);
        }
      }

      /* Respectă preferința reduce-motion */
      @media (prefers-reduced-motion: reduce) {
        .wa-float { animation: none; }
        .quick-dock { animation: none; }
      }

      body.is-community-detail .wa-float,
      body.is-community-detail .quick-dock {
        display: none !important;
      }
    </style>

  </body>
</html>

