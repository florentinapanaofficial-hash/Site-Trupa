    <style>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: max(0%, calc(var(--scroll-progress, 0) * 100%));
        z-index: 999;
        background: linear-gradient(90deg, #0bbcd6 0%, #ffd700 48%, #f5a623 100%);
        box-shadow: 0 0 14px rgba(245, 166, 35, 0.45);
        pointer-events: none;
      }

      /* ── WhatsApp Floating Button ── */
      .wa-float {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 2px 6px rgba(0, 0, 0, 0.25);
        text-decoration: none;
        transition: transform 200ms ease, box-shadow 200ms ease;
        animation: wa-pulse 2.5s ease-in-out infinite;
      }

      .wa-float:hover,
      .wa-float:focus-visible {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.55), 0 3px 10px rgba(0, 0, 0, 0.3);
        animation: none;
      }

      .wa-float:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }

      @keyframes wa-pulse {
        0%, 100% { box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 0 0 0 rgba(37, 211, 102, 0.4); }
        50%       { box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 0 0 10px rgba(37, 211, 102, 0); }
      }

      /* Pe mobil: poziționare optimizată — fără suprapunere cu elementele galeriei */
      @media (max-width: 767px) {
        .wa-float {
          bottom: 5.5rem;
          right: 1rem;
          width: 3rem;
          height: 3rem;
        }
        .wa-float svg {
          width: 24px;
          height: 24px;
        }
      }

      .quick-dock {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        bottom: 0.85rem;
        z-index: 920;
        display: none;
        gap: 0.6rem;
        width: min(94vw, 420px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 1rem;
        padding: 0.45rem;
        background: rgba(8, 16, 38, 0.82);
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
      }

      .quick-dock-btn {
        flex: 1;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 0.8rem;
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .quick-dock-btn svg {
        width: 16px;
        height: 16px;
      }

      .quick-dock-btn--call {
        color: #d8ecff;
        border: 1px solid rgba(11, 188, 214, 0.42);
        background: rgba(11, 188, 214, 0.16);
      }

      .quick-dock-btn--wa {
        color: #0f2719;
        border: 1px solid rgba(55, 207, 120, 0.45);
        background: linear-gradient(135deg, #38de8a 0%, #28be72 100%);
      }

      .quick-dock-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }

      @media (max-width: 767px) {
        .quick-dock {
          display: flex;
        }
      }

      /* Respectă preferința reduce-motion */
      @media (prefers-reduced-motion: reduce) {
        .wa-float { animation: none; }
      }
    </style>

