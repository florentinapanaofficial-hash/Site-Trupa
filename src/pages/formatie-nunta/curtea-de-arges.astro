---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteContent from '../../data/siteContent.json';
import BackButton from '../../components/BackButton.astro';

const { contact, brand } = siteContent;

/* ──────────────────────────────────────────────────────────
   Variabilele de mai jos sunt înlocuite automat de
   scripts/programmatic-seo/generate-pages.js
   NU edita manual — regenerează cu:
     node scripts/programmatic-seo/generate-pages.js
   ────────────────────────────────────────────────────────── */

const ORAS           = 'Curtea de Argeș';
const JUDET          = 'Argeș';
const KEYWORD        = 'Formație Nuntă Curtea de Argeș';
const SLUG           = 'curtea-de-arges';
const LAT            = 45.1386;
const LNG            = 24.6814;
const INTRO          = 'Curtea de Argeș — orașul Mănăstirii și al tradițiilor — este unul dintre locurile noastre preferate pentru evenimente live. Formația Florentina Pană aduce Show Live 100% la nunțile din această zonă pitorească a județului Argeș.';
const PARAGRAF2      = 'Știm ce înseamnă o nuntă cu adevărat românească: horă la intrarea mirilor, muzică de petrecere, momente emoționante și dans până în zori. Repertoriul nostru include muzică populară de petrecere, grecească, arăbească, machedonească, latino, muzică românească și manele, într-un program live fără pauze, fără DJ sau MC.';
const PARAGRAF3      = 'Zonele montane din jurul Curții de Argeș oferă locații de nuntă spectaculoase. Noi ne ocupăm de tot ce ține de muzică — sonorizare, lumini și un program muzical pe gustul vostru, discutat cu cel puțin două săptămâni înainte de eveniment.';
const CONTENT_INTRO    = 'Curtea de Argeș este un loc special pentru noi. Am cântat la zeci de nunți memorabile aici și știm exact cum să facem ca fiecare eveniment să fie unic. Formația Florentina Pană — muzică live care se simte.';
const CONTENT_SERVICES = 'Suntem recunoscuți ca top formații nuntă Curtea de Argeș datorită energiei de pe scenă și atenției la detalii. Pentru fiecare eveniment construim programe artistice alternate, cu repertoriu complet: populară de petrecere, grecească, arăbească, machedonească, latino, românească și manele, 100% live fără DJ sau MC.';
const CONTENT_OUTRO    = 'Nu lăsa muzica pe ultimul loc — este ingredientul care leagă totul. Contactează-ne astăzi pentru disponibilitate în Curtea de Argeș și hai să planificăm împreună coloana sonoră perfectă pentru nunta ta.';
const LOCATII_POP    = ["Conacul Manasia","Complex Marami","Hanul Posada"];
const ZONE_ACOPERITE = ["Curtea de Argeș","Câmpulung","Domnești","Corbeni","Arefu"];
const FAQ_ITEMS      = [{"question":"Cât costă o formație de nuntă în Curtea de Argeș?","answer":"Calculăm oferta după data evenimentului, formula artistică, durata programului și locație. Trimite-ne detaliile nunții pentru o propunere adaptată în Curtea de Argeș."},{"question":"Asigurați echipamentul pentru nunți în Curtea de Argeș?","answer":"Da. Venim cu sonorizare profesională, lumini de atmosferă și microfoane wireless, potrivite atât pentru saloane, cât și pentru locații de evenimente din zona montană."},{"question":"Ce muzică live cântați la nunțile din Curtea de Argeș?","answer":"Programul combină muzică populară de petrecere, repertoriu românesc și internațional, grecesc, arăbesc și latino, cu momente alese împreună cu mirii."},{"question":"Vă deplasați în localitățile din nordul Argeșului?","answer":"Da, acoperim Curtea de Argeș, Câmpulung, Domnești, Corbeni, Arefu și localitățile apropiate din județul Argeș."}];
const META_DESC      = 'Formație nuntă Curtea de Argeș cu show band live și repertoriu variat. Sonorizare proprie, program personalizat și ofertă clară pentru evenimentul tău!';
const KEYWORDS_SCHEMA: string[] = [];

const SEO_TITLE = 'Formație Nuntă Curtea de Argeș | Florentina Pană' || `${KEYWORD} | ${brand.name}`;
const SEO_DESC  = META_DESC || `${KEYWORD} cu show band live în ${ORAS}. Repertoriu variat, sonorizare proprie și ofertă personalizată. Cere disponibilitatea!`;

const whatsappNumber = contact.phoneRaw.replace(/\\D/g, '');
const whatsappText   = encodeURIComponent(`Bună ziua! Aș dori să rezerv formația pentru un eveniment în ${ORAS}.`);
const whatsappLink   = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;

const faqItems = FAQ_ITEMS;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "EntertainmentBusiness"],
  "@id": `https://www.florentinapanaofficial.ro/formatie-nunta/${SLUG}/#local-business`,
  "name": brand.name,
  "description": `${KEYWORD} — Formație Nuntă & Cover Band Live, Show Live 100% cu repertoriu complet: muzică populară de petrecere, grecească, arăbească, machedonească, latino, muzică românească și manele în ${ORAS}. Fără DJ sau MC.`,
  "url": `https://www.florentinapanaofficial.ro/formatie-nunta/${SLUG}/`,
  "performer": {
    "@type": "MusicGroup",
    "@id": "https://www.florentinapanaofficial.ro/#music-group"
  },
  "telephone": contact.phoneRaw,
  "image": "https://www.florentinapanaofficial.ro/images/sigla-fp-band.webp",
  "priceRange": "$$",
  "genre": ["Muzica Greceasca", "Muzica Arabeasca", "Muzica Latino", "Muzica Machedoneasca", "Manele", "Muzica Populara de Petrecere"],
  "knowsAbout": [
    "Muzică populară de petrecere",
    "Muzică grecească",
    "Muzică arăbească",
    "Muzică machedonească",
    "Muzică latino",
    "Muzică românească",
    "Manele"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": ORAS,
    "addressRegion": JUDET,
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": LAT,
    "longitude": LNG
  },
  "areaServed": ZONE_ACOPERITE.map((z: string) => ({ "@type": "City", "name": z })),
  ...(KEYWORDS_SCHEMA.length > 0 && { "keywords": KEYWORDS_SCHEMA.join(', ') }),
  "sameAs": [
    "https://www.youtube.com/@FlorentinaPanaPitesti/videos",
    "https://www.facebook.com/florentinapanaofficial/",
    "https://www.instagram.com/florentinaformatie/"
  ]
};
---

<BaseLayout title={SEO_TITLE} description={SEO_DESC}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <section class="section-container py-16">
    <div class="mb-8"><BackButton href="/" label="Acasă" /></div>

    <header class="section-head mx-auto text-center">
      <p class="kicker">{KEYWORD}</p>
      <h1 class="section-title">{KEYWORD} — Muzică Live Premium</h1>
      <p class="section-copy">{INTRO}</p>
    </header>

    {/* ═══ Secțiunea 1: De ce noi ═══ */}
    <div class="mt-12 rounded-2xl border border-white/20 bg-white/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">De ce să alegi Formația Florentina Pană în {ORAS}?</h2>
      <p class="text-sm text-white/90 leading-relaxed mb-4">{PARAGRAF2}</p>
      <p class="text-sm text-white/90 leading-relaxed">{PARAGRAF3}</p>
    </div>

    {/* ═══ Secțiunea 1.5: Content Blocks (conținut unic anti-duplicat) ═══ */}
    <div class="mt-8 rounded-2xl border border-white/20 bg-white/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">Experiența Muzicală în {ORAS}</h2>
      <p class="text-sm text-white/90 leading-relaxed mb-4">{CONTENT_INTRO}</p>
      <p class="text-sm text-white/90 leading-relaxed mb-4">{CONTENT_SERVICES}</p>
      <p class="text-sm text-white/90 leading-relaxed">{CONTENT_OUTRO}</p>
    </div>

    <div class="mt-8 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">Show band pentru nunți în {ORAS}</h2>
      <p class="text-sm text-white/90 leading-relaxed">
        Oferim un show band live complet în {ORAS}: soliști și instrumentiști experimentați,
        repertoriu adaptat invitaților, sonorizare proprie și momente artistice construite pentru
        ritmul fiecărui eveniment.
      </p>
    </div>

    {/* ═══ Secțiunea 1.7: Prețuri & Ofertă ═══ */}
    <div class="mt-8 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">💰 Prețuri Formație Nuntă {ORAS} — Ofertă Early Booking 2027</h2>
      <p class="text-sm text-white/90 leading-relaxed mb-4">Calendarul 2027 pentru evenimente în {ORAS} și județele limitrofe se completează rapid — cuplurile care semnează acum beneficiază de tarif Early Booking blocat contractual, la nivelul sezonului 2026.</p>
      <p class="text-sm text-white/90 leading-relaxed mb-4">Ce primești: formație live cu 5-6 artiști, sonorizare profesională premium, program muzical personalizat, alternanță artistică după specificul evenimentului și garanție scrisă pe echipament backup. Cântăm fără pauze, fără DJ sau MC. Zero playback, 100% live pe scenă.</p>
      <div class="mt-4 rounded-xl bg-white/5 p-4 border border-white/10">
        <p class="text-xs text-white/70 mb-2">📞 Contactează-ne pentru ofertă personalizată:</p>
        <div class="flex flex-wrap gap-2">
          <a href={`tel:${contact.phoneRaw}`} class="btn-solid text-xs" onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'pricing-cta'})">
            Sună: {contact.phoneDisplay}
          </a>
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-xs" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'pricing-cta'})">
            WhatsApp: Verifică disponibilitate
          </a>
        </div>
      </div>
    </div>

    {/* ═══ Secțiunea 2: Locații populare ═══ */}
    <div class="mt-8 rounded-2xl border border-white/20 bg-white/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">Locații populare de nunți în {ORAS}</h2>
      <p class="text-sm text-white/90 mb-4">Am cântat cu succes la multe dintre cele mai apreciate locații din zonă:</p>
      <ul class="grid gap-2 sm:grid-cols-2">
        {LOCATII_POP.map((loc: string) => (
          <li class="flex items-center gap-2 text-sm text-white/90">
            <span class="text-amber-400" aria-hidden="true">★</span> {loc}
          </li>
        ))}
      </ul>
    </div>

    {/* ═══ Secțiunea 3: Zone acoperite ═══ */}
    <div class="mt-8 rounded-2xl border border-white/20 bg-white/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">Zone acoperite în {JUDET}</h2>
      <div class="flex flex-wrap gap-2">
        {ZONE_ACOPERITE.map((zona: string) => (
          <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white/90">{zona}</span>
        ))}
      </div>
    </div>

    {/* ═══ FAQ ═══ */}
    <div class="mt-8 rounded-2xl border border-white/20 bg-white/10 p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-white mb-4">Întrebări Frecvente — {KEYWORD}</h2>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group rounded-xl border border-white/10 bg-white/5 p-4 open:bg-white/10">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-3 text-sm font-semibold text-white">
              {item.question}
              <span class="text-amber-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm text-white/80 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>

    {/* ═══ CTA Final ═══ */}
    <div class="mt-12 text-center">
      <h2 class="text-lg font-extrabold text-white mb-4">Rezervă Formația pentru Evenimentul Tău în {ORAS}</h2>
      <p class="text-sm text-white/90 mb-6">Contactează-ne acum pentru disponibilitate și ofertă personalizată.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="btn-solid" href={`tel:${contact.phoneRaw}`}
           onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'programmatic-seo'})">
          Sună: {contact.phoneDisplay}
        </a>
        <a class="btn-whatsapp" href={whatsappLink} target="_blank" rel="noopener noreferrer"
           onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'programmatic-seo'})">
          WhatsApp
        </a>
        <a class="btn-outline" href="/contact/">Formular de Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
