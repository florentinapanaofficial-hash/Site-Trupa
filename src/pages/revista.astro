---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Revista Formației Florentina Pană — apare în curând';
const description = 'Pregătim o revistă digitală cu poveștile din spatele scenei, momente de la nunți și interviuri cu echipa. Reveniți curând sau scrieți-ne pe contact.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="section-container" aria-labelledby="revista-title">
    <div class="mx-auto max-w-3xl py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-amber-300">În pregătire</p>
      <h1 id="revista-title" class="mb-6 text-4xl font-bold text-white sm:text-5xl">Revista Formației Florentina Pană</h1>
      <p class="mb-8 text-lg text-white/80">
        Aici vom construi pagina de preview pentru revista noastră.
      </p>
      <a href="/contact/" class="btn-solid">Scrieți-ne</a>
    </div>
  </section>
</BaseLayout>
