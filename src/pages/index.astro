---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import heroImg from '../assets/card-1-panoramica.jpg';

const optimizedHero = await getImage({ src: heroImg, format: 'webp', width: 320, height: 213 });

const { acasa } = seo;
const { contact } = siteContent;
const faqItems = acasa.faq;
import { sanitizeUrl } from '../lib/sanitize-url';

const socialLinks = {
  youtube:   siteContent.socialLinks?.youtube ? sanitizeUrl(siteContent.socialLinks.youtube) : null,
  facebook:  siteContent.socialLinks?.facebook ? sanitizeUrl(siteContent.socialLinks.facebook) : null,
  instagram: siteContent.socialLinks?.instagram ? sanitizeUrl(siteContent.socialLinks.instagram) : null,
  tiktok:    siteContent.socialLinks?.tiktok ? sanitizeUrl(siteContent.socialLinks.tiktok) : null,
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: acasa.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const waHref = `https://wa.me/${contact.phoneRaw.replace('+', '')}?text=Bun%C4%83%20ziua!%20A%C8%99%20dori%20s%C4%83%20rezerv%20Forma%C8%9Bia%20Florentina%20Pan%C4%83%20pentru%20evenimentul%20meu.`;
---

<BaseLayout title={acasa.meta.title} description={acasa.meta.description} ogImage={siteContent.seo.ogImage}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={optimizedHero.src} type="image/webp" fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  {/* ═══════════════════════════════════════════
      HERO — Scenă, titlu mare, CTA-uri
  ═══════════════════════════════════════════ */}
  <section id="acasa" class="hero-stage hero-fullscreen hp-hero-wrap" aria-label="Secțiunea principală">
    <div class="hero-stage-inner">

      <span class="kicker-badge anim-hero-load anim-hero-d1" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11.3 1.046A1 1 0 0 1 12 2v5h4a1 1 0 0 1 .82 1.573l-7 10A1 1 0 0 1 8 18v-5H4a1 1 0 0 1-.82-1.573l7-10a1 1 0 0 1 1.12-.38Z"/></svg>
        {acasa.hero.kicker}
      </span>

      {/* Card foto — vizibil doar pe mobil, colțuri rotunjite */}
      <div class="hero-photo-card anim-hero-load anim-hero-d2">
        <Image
          src={heroImg}
          alt="Formația Florentina Pană — spectacol live pe scenă"
          class="hero-photo-img anim-img-hover"
          format="webp"
          width={320}
          height={213}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <h1 class="hero-title-xl anim-hero-load anim-hero-d2">
        <span class="hero-kicker-text">Formația</span><br/>
        <span class="hero-title-gold">Florentina Pană</span>
      </h1>

      <p class="hero-lead anim-hero-load anim-hero-d3">
        {acasa.hero.descriere}
      </p>

      {/* CTA-uri hero */}
      <div class="hero-cta-row anim-hero-load anim-hero-d4">
        <a href={`tel:${contact.phoneRaw}`} class="hero-cta-primary" onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'hero'})">
          <svg xmlns="http://www.w3.org/2000/svg" class="hero-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Sună Acum
        </a>
        <a href="/galerie-video/" class="hero-cta-secondary">
          Ascultă live
        </a>
      </div>

      {/* Stat pills */}
      <div class="hero-stats anim-hero-load anim-hero-d4" aria-label="Statistici formație">
        <div class="hero-stat-pill">
          <span class="hero-stat-num">10+</span>
          <span class="hero-stat-label">ani experiență</span>
        </div>
        <div class="hero-stat-pill">
          <span class="hero-stat-num">500+</span>
          <span class="hero-stat-label">evenimente</span>
        </div>
        <div class="hero-stat-pill">
          <span class="hero-stat-num">100%</span>
          <span class="hero-stat-label">live</span>
        </div>
      </div>

      {/* Social media icons — vizibile doar pe mobil, umplu spațiul gol */}
      <div class="hero-social-row" aria-label="Rețele sociale">
        <span class="hero-social-label">Urmărește-ne</span>
        <div class="hero-social-icons">
          {socialLinks.youtube && (
            <a href={socialLinks.youtube} class="hero-social-btn hero-social-btn--yt"
              target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="6" width="20" height="13" rx="4" fill="#fff"/>
                <polygon points="9.5,9.5 9.5,15.5 16.5,12.5" fill="#FF0000"/>
              </svg>
              <span>YouTube</span>
            </a>
          )}
          {socialLinks.facebook && (
            <a href={socialLinks.facebook} class="hero-social-btn hero-social-btn--fb"
              target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5" fill="#1877F2"/>
                <path d="M13.5 21V14.3H16l.4-2.85H13.5V9.7c0-.82.38-1.2 1.38-1.2H16.5V5.85C16.05 5.77 15.1 5.7 14 5.7c-2.65 0-4.05 1.4-4.05 4.15v1.6H8v2.85h1.95V21H13.5z" fill="#fff"/>
              </svg>
              <span>Facebook</span>
            </a>
          )}
          {socialLinks.instagram && (
            <a href={socialLinks.instagram} class="hero-social-btn hero-social-btn--ig"
              target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5.5"
                  fill="url(#ig-grad-hero)"/>
                <defs>
                  <radialGradient id="ig-grad-hero" cx="30%" cy="110%" r="140%">
                    <stop offset="0%" stop-color="#ffd676"/>
                    <stop offset="25%" stop-color="#f46f30"/>
                    <stop offset="55%" stop-color="#e1306c"/>
                    <stop offset="80%" stop-color="#833ab4"/>
                    <stop offset="100%" stop-color="#405de6"/>
                  </radialGradient>
                </defs>
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="#fff" stroke-width="2"/>
                <circle cx="12" cy="12" r="4.3" stroke="#fff" stroke-width="2"/>
                <circle cx="17.5" cy="6.6" r="1.4" fill="#fff"/>
              </svg>
              <span>Instagram</span>
            </a>
          )}
          {socialLinks.tiktok && (
            <a href={socialLinks.tiktok} class="hero-social-btn hero-social-btn--tt"
              target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5" fill="#010101"/>
                <path transform="translate(-0.5,-0.4)" d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#25f4ee"/>
                <path transform="translate(0.5,0.4)" d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#fe2c55"/>
                <path d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#fff"/>
              </svg>
              <span>TikTok</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      EARLY BOOKING — Link intern la articol preț
  ═══════════════════════════════════════════ */}
  <section class="hp-early-booking section-container py-8 sm:py-12" aria-label="Oferte Early Booking">
    <div class="rounded-2xl border border-amber-500/20 bg-gradient-to-r from-amber-500/10 to-orange-500/10 p-6 sm:p-8 text-center">
      <p class="text-xs sm:text-sm font-semibold text-amber-300 mb-2">⏰ Ofertă Limitată</p>
      <h2 class="text-lg sm:text-xl font-extrabold text-white mb-3">Early Booking 2027 — Tarif Blocat pentru Data Ta</h2>
      <p class="text-sm text-white/90 mb-4">
        Calendarul se umple rapid. Cuplurile care rezervă acum beneficiază de tarif Early Booking blocat contractual, 
        indiferent de evoluția costurilor pe piață. Zero surprize, doar profesionalism.
      </p>
      <a href="/blog/pret-formatie-nunta-2026/" class="btn-solid inline-block" onclick="window.gtag&&window.gtag('event','click_early_booking',{event_category:'homepage',event_label:'pricing-link'})">
        Detalii Prețuri & Ofertă →
      </a>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      DESPRE FORMAȚIE — text SEO + H3 subtitluri
  ═══════════════════════════════════════════ */}
  <section id="despre-formatie" class="hp-seo-section" aria-label="Despre formația noastră">
    <h2 class="hp-seo-title anim-on-scroll">Peste 10 ani de pasiune pe scenă</h2>

    <div class="hp-seo-grid">
      <div class="hp-seo-block anim-on-scroll anim-d1">
        <h3 class="hp-seo-subtitle">Din inima Argeșului, pe scenele întregii țări</h3>
        <p class="hp-seo-text">
          Din 2014, misiunea noastră a fost simplă: să aducem emoție și bucurie la fiecare
          eveniment. Am pornit din Pitești și am ajuns să cântăm în cele mai frumoase
          locații din România — nunți, botezuri, aniversări și gale corporate. Echipa noastră
          reunește soliști vocali cu experiență, instrumentiști profesioniști și sonorizare de calitate.
        </p>
      </div>
      <div class="hp-seo-block anim-on-scroll anim-d2">
        <h3 class="hp-seo-subtitle">Repertoriu live adaptat stilului vostru</h3>
        <p class="hp-seo-text">
          Repertoriul nostru acoperă muzică populară românească, piese ușoare, hituri
          pop și internaționale, dance și momente speciale personalizate. De la dansul
          mirilor și valsul de deschidere până la hora mare și petrecerea de noapte —
          ne adaptăm stilului și dorințelor fiecărui cuplu.
        </p>
        <p class="hp-seo-text hp-seo-text--link">
          Inspiră-te din jurnalul nostru de evenimente și descoperă <a href="/publicatii/" class="hp-inline-link">recomandările noastre de locații din Argeș</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      DE CE SĂ NE ALEGEȚI — beneficii + H3
  ═══════════════════════════════════════════ */}
  <section id="de-ce-noi" class="hp-seo-section" aria-label="De ce să ne alegeți">
    <h2 class="hp-seo-title anim-on-scroll">De ce să ne alegeți</h2>

    <div class="hp-seo-grid">
      <div class="hp-seo-block anim-on-scroll anim-d1">
        <h3 class="hp-seo-subtitle">Profesionalism și punctualitate la fiecare eveniment</h3>
        <p class="hp-seo-text">
          Comunicăm transparent din prima discuție, respectăm orarul convenit și venim
          pregătiți la fiecare eveniment. Echipamentul nostru de sunet și lumini este
          verificat înainte de orice spectacol, iar artiștii repetă programul stabilit
          cu fiecare client în parte.
        </p>
      </div>
      <div class="hp-seo-block anim-on-scroll anim-d2">
        <h3 class="hp-seo-subtitle">Program muzical live adaptat evenimentului</h3>
        <p class="hp-seo-text">
          Nu avem un program standard pe care îl repetăm la fiecare nuntă. Stabilim
          împreună lista de piese, momentele speciale și ritmul serii. Fie că căutați o
          trupă muzicală în Muntenia cu muzică populară autentică, hituri moderne
          sau un mix echilibrat — programul muzical este construit în jurul viziunii voastre.
        </p>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      TIPURI DE EVENIMENTE — servicii + H3
  ═══════════════════════════════════════════ */}
  <section id="tipuri-evenimente" class="hp-seo-section" aria-label="Tipuri de evenimente">
    <h2 class="hp-seo-title anim-on-scroll">Ce evenimente acoperim</h2>

    <div class="hp-seo-grid hp-seo-grid--3">
      <div class="hp-seo-block anim-on-scroll anim-d1">
        <h3 class="hp-seo-subtitle">Nunți</h3>
        <p class="hp-seo-text">
          Știm că muzica este sufletul petrecerii. Ne ocupăm de toate momentele
          cheie: de la primirea elegantă a invitaților, dansul mirilor, momente
          dedicate părinților, până la „ora de foc" a petrecerii pe ringul de dans.
          Colaborăm cu fiecare cuplu pentru o atmosferă unică.
        </p>
      </div>
      <div class="hp-seo-block anim-on-scroll anim-d2">
        <h3 class="hp-seo-subtitle">Botezuri și aniversări</h3>
        <p class="hp-seo-text">
          Adaptăm ritmul pentru toate generațiile. Îmbinăm tradiția cu modernitatea,
          asigurându-ne că atât bunicii, cât și cei mai tineri se simt excelent.
          Repertoriu echilibrat, de la piese populare la hituri moderne.
        </p>
      </div>
      <div class="hp-seo-block anim-on-scroll anim-d3">
        <h3 class="hp-seo-subtitle">Evenimente corporate și private</h3>
        <p class="hp-seo-text">
          Show profesionist pentru gale, seri de team-building, lansări
          de produse sau petreceri de Crăciun. Muzică de fundal elegantă în timpul
          cinei, moment live de show și repertoriu rafinat.
        </p>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      FAQ — Întrebări frecvente (vizibile pe pagină)
  ═══════════════════════════════════════════ */}
  <section id="intrebari-frecvente" class="hp-seo-section" aria-label="Întrebări frecvente">
    <h2 class="hp-seo-title anim-on-scroll">Întrebări frecvente</h2>

    <div class="hp-faq-list anim-on-scroll anim-d1">
      {faqItems.map((item) => (
        <details class="hp-faq-item">
          <summary class="hp-faq-question">
            <h3 class="hp-faq-q-text">{item.question}</h3>
            <svg class="hp-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p class="hp-faq-answer">{item.answer}</p>
        </details>
      ))}
      <details class="hp-faq-item">
        <summary class="hp-faq-question">
          <h3 class="hp-faq-q-text">Oferiți și sonorizare proprie?</h3>
          <svg class="hp-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <p class="hp-faq-answer">Da, dispunem de echipament profesional de sunet și lumini, inclus în oferta noastră pentru un spectacol complet.</p>
      </details>
      <details class="hp-faq-item">
        <summary class="hp-faq-question">
          <h3 class="hp-faq-q-text">Cum putem rezerva formația?</h3>
          <svg class="hp-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <p class="hp-faq-answer">Ne puteți contacta telefonic la 0767 369 658, pe WhatsApp sau prin formularul de contact de pe site. Verificăm disponibilitatea și revenim cu o ofertă personalizată.</p>
      </details>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      HIGHLIGHTS — 2 carduri clickabile
  ═══════════════════════════════════════════ */}
  <section id="highlights" class="hp-highlights" aria-label="Descoperă mai mult">

    <a href="/despre/" class="hp-card hp-card--story anim-on-scroll anim-d1 anim-card-hover">
      <div class="hp-card-overlay" aria-hidden="true"></div>
      <div class="hp-card-content">
        <span class="hp-card-kicker">Cine suntem</span>
        <h2 class="hp-card-title">Povestea noastră</h2>
        <p class="hp-card-text">10 ani de muzică, emoție și scenă</p>
        <span class="hp-card-cta">
          Descoperă
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <div class="hp-card hp-card--book anim-on-scroll anim-d2 anim-card-hover">
      {/* Stretched link acoperă tot cardul — navigare spre /contact */}
      <a href="/contact/" class="hp-card-link" aria-label="Rezervă acum — pagina de contact"></a>
      <div class="hp-card-overlay" aria-hidden="true"></div>
      <div class="hp-card-content">
        <span class="hp-card-kicker">Disponibilitate</span>
        <h2 class="hp-card-title">Rezervă acum</h2>
        <p class="hp-card-text">Suntem disponibili pentru evenimentul tău</p>
        <a
          href={waHref}
          class="hp-whatsapp-btn anim-cta-pulse"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Rezervă pe WhatsApp: ${contact.phoneDisplay}`}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.556 4.122 1.528 5.854L0 24l6.335-1.508A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 0 1-4.964-1.342l-.356-.211-3.765.896.953-3.671-.232-.376A9.785 9.785 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
          {contact.phoneDisplay}
        </a>
        <span class="hp-card-cta">
          Contactează-ne
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </div>

  </section>

</BaseLayout>



<style>

  /* ✅ SEO: text ascuns vizual, vizibil pentru motoarele de căutare */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ════════════════════════════════════════════════════════════════
     HTML / BODY — transparent peste cerul din SkyBackground
  ════════════════════════════════════════════════════════════════ */
  html, body {
    background: transparent !important;
    background-color: transparent !important;
    margin: 0; padding: 0; overflow-x: hidden;
  }

  /* ════════════════════════════════════════════════════════════════
     HERO STAGE — glassmorphism
  ════════════════════════════════════════════════════════════════ */
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem);
    text-align: center;
    background: transparent;
  }

  .hero-stage::before {
    display: none;
  }

  /* ════════════════════════════════════════════════════════════════
     CONTAINER INTERIOR
  ════════════════════════════════════════════════════════════════ */
  .hero-stage-inner {
    max-width: 680px;
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 5;
    /* Min-height previne CLS la încărcarea fonturilor Inter/Oswald */
    min-height: 520px;
  }

  @media (max-width: 767px) {
    .hero-stage-inner {
      min-height: 600px;
    }
  }

  @media (max-width: 374px) {
    .hero-stage-inner {
      min-height: 560px;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     TIPOGRAFIE HERO — simplificată
  ════════════════════════════════════════════════════════════════ */
  .kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-title-xl {
    margin: 0;
    line-height: 1.1;
    text-align: center;
  }

  /* "FORMAȚIA" — serif italic, fără text-shadow greu */
  .hero-kicker-text {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.90);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.60);
    margin-bottom: 0.05rem;
  }

  /* "Florentina Pană" — gold static, fără shimmer/filter */
  .hero-title-gold {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 6.5vw, 4.8rem);
    letter-spacing: 0.06em;
    line-height: 1.0;
    background: linear-gradient(135deg, #e8c85b 0%, #ffeaa0 50%, #e8c85b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Lead text */
  .hero-lead {
    max-width: 50ch;
    margin: 0;
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    line-height: 1.75;
    color: #ffffff !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.50);
    text-align: center;
    text-wrap: pretty;
  }

  /* ════════════════════════════════════════════════════════════════
     HERO CTA BUTTONS
  ════════════════════════════════════════════════════════════════ */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .hero-cta-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    min-height: 48px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0c0f1f;
    background: linear-gradient(135deg, #F5A623, #f7c864);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(245, 166, 35, 0.35);
    transition: transform 180ms ease;
    position: relative;
  }
  .hero-cta-primary::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 6px 24px rgba(245, 166, 35, 0.5);
    transition: opacity 180ms ease;
    will-change: opacity;
  }
  .hero-cta-primary:hover {
    transform: translateY(-1px);
  }
  .hero-cta-primary:hover::after {
    opacity: 1;
  }
  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.5rem;
    min-height: 48px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease;
  }
  .hero-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.14);
  }

  /* ════════════════════════════════════════════════════════════════
     STAT PILLS
  ════════════════════════════════════════════════════════════════ */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }
  .hero-stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.85rem;
    padding: 0.35rem 0.85rem;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    min-width: 60px;
  }
  .hero-stat-num {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.50);
    line-height: 1;
  }
  .hero-stat-label {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85) !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.50);
    margin-top: 0.12rem;
  }

  /* ════════════════════════════════════════════════════════════════
     HERO PHOTO CARD — doar mobil (≤ 767px)
  ════════════════════════════════════════════════════════════════ */
  .hero-photo-card {
    display: none; /* ascuns pe desktop */
  }

  @media (max-width: 767px) {
    .hero-photo-card {
      display: block;
      width: 88%;
      max-width: 300px;
      margin: 0.9rem auto 0.25rem;
      border-radius: 1.25rem;
      overflow: hidden;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.40);
      aspect-ratio: 3 / 2;
      background: rgba(255, 255, 255, 0.06);
    }

    .hero-photo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      border-radius: 1.25rem;
      display: block;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     SOCIAL MEDIA ROW — doar mobil (≤ 767px)
  ════════════════════════════════════════════════════════════════ */
  .hero-social-row {
    display: none; /* ascuns pe desktop */
  }

  @media (max-width: 767px) {
    .hero-social-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      margin-top: 0.5rem;
      width: 100%;
    }

    .hero-social-label {
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(241, 229, 172, 0.90);
    }

    .hero-social-icons {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      justify-content: center;
    }

    .hero-social-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      text-decoration: none;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    .hero-social-btn:active {
      transform: scale(0.90);
      opacity: 0.75;
    }

    .hero-social-btn svg {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      /* Umbră colorată specifică fiecărei rețele */
    }

    .hero-social-btn span {
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.90);
    }

    /* YouTube */
    .hero-social-btn--yt svg {
      background: #FF0000;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hero-social-btn--yt span { color: rgba(255, 160, 160, 0.95); }

    /* Facebook */
    .hero-social-btn--fb svg {
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hero-social-btn--fb span { color: rgba(140, 195, 255, 0.95); }

    /* Instagram */
    .hero-social-btn--ig svg {
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hero-social-btn--ig span { color: rgba(255, 180, 215, 0.95); }

    /* TikTok */
    .hero-social-btn--tt svg {
      border: 1.5px solid rgba(255,255,255,0.20);
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hero-social-btn--tt span { color: rgba(255, 215, 225, 0.95); }
  }

  /* ════════════════════════════════════════════════════════════════
     HERO FULLSCREEN — override al cardului global din #continut>section
  ════════════════════════════════════════════════════════════════ */
  .hero-fullscreen {
    width: 100% !important;
    max-width: 900px !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    margin-left: auto !important;
    margin-right: auto !important;
    border-radius: 1.5rem !important;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 8px 24px rgba(0, 0, 0, 0.40);
    /* min-height bazat pe conținut, nu 100vh — evită spațiul gol de jos */
    min-height: auto !important;
    /* padding-top >= 4rem → text "Formația" + badge vizibil sub header fix (~4rem înălțime) */
    padding-top: clamp(4rem, 5vw, 4.5rem) !important;
    /* padding-bottom redus — fără spațiu gol sub statistici */
    padding-bottom: 2rem !important;
    position: relative;
    overflow: hidden;
    /* Tranziție identică cu .hp-card */
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease,
      border-color 300ms ease;
  }

  /* Hover pe cardul hero — doar pe dispozitive cu pointer precis */
  @media (hover: hover) and (pointer: fine) {
    .hero-fullscreen:hover {
      transform: scale(1.02);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.20),
        0 12px 32px rgba(0, 0, 0, 0.50);
    }
  }

  /* ════════════════════════════════════════════════════════════════
     HP-HERO-WRAP — container vizual simetric cu .hp-highlights
     Aceeași lățime max 900px, aceleași margini laterale auto,
     același border-radius 1.5rem, același padding lateral 2rem.
  ════════════════════════════════════════════════════════════════ */
  .hp-hero-wrap {
    max-width: var(--container-max);   /* sursă unică token global */
    margin-inline: auto;
    border-radius: 1.5rem;
    padding-inline: var(--container-pad-x);
  }

  @media (max-width: 374px) {
    .hp-hero-wrap {
      padding-inline: 0.5rem;
    }
    .hero-title-gold {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .kicker-badge {
      font-size: 0.7rem;
      padding: 0.25rem 0.6rem;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     HIGHLIGHTS — 2 carduri side-by-side (desktop) / stacked (mobile)
  ════════════════════════════════════════════════════════════════ */
  .hp-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--container-max);
    padding: 1.5rem var(--container-pad-x);
    margin: -5rem auto clamp(2.5rem, 6vw, 4rem);
    position: relative;
    z-index: 4;
  }

  @media (max-width: 767px) {
    .hp-highlights {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem;
      margin-top: -3rem;
    }

    /* Reduce card min-height când stivuite — evită spațiu alb excesiv */
    .hp-card {
      min-height: 240px;
    }

    .hp-card--story {
      min-height: 220px;
    }

    /* Padding mai strâns în card-content pe mobil */
    .hp-card-content {
      padding: 1.75rem 1.5rem;
      gap: 0.45rem;
    }

    /* Titlu card proporțional pe ecran mic */
    .hp-card-title {
      font-size: clamp(1.5rem, 5.5vw, 1.9rem);
    }
  }

  /* Stretched link — acoperă întreg cardul, navigare la URL-ul cardului */
  .hp-card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .hp-card {
    position: relative;
    min-height: 300px;
    border-radius: 1.5rem;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    cursor: pointer;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 300ms ease,
                border-color 300ms ease;
  }

  @media (min-width: 1025px) {
    .hp-card { min-height: 340px; }
  }

  /* hover doar pe dispozitive cu pointer precis — evită sticky-hover pe touch */
  @media (hover: hover) and (pointer: fine) {
    .hp-card:hover {
      transform: scale(1.02);
    }
  }

  /* Card 1 — Povestea noastră — glassmorphism */
  .hp-card--story {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    min-height: 280px;
    background:
      radial-gradient(ellipse at 70% 30%, rgba(61, 26, 110, 0.55) 0%, rgba(26, 10, 61, 0.40) 55%, transparent 100%);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid rgba(160, 90, 255, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 rgba(200, 140, 255, 0.10);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card--story:hover {
      border-color: rgba(180, 110, 255, 0.60);
      box-shadow: 0 20px 56px rgba(100, 40, 200, 0.35), 0 4px 16px rgba(0, 0, 0, 0.5),
                  inset 0 1px 0 rgba(200, 140, 255, 0.20);
    }
  }

  /* Conținut story-card: umple înălțimea cardului → centrare verticală garantată */
  .hp-card--story .hp-card-content {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }

  /* Card 2 — Rezervă acum — glassmorphism */
  .hp-card--book {
    background:
      radial-gradient(ellipse 65% 55% at 90% 80%, rgba(11, 188, 214, 0.18) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 10% 20%, rgba(4, 80, 100, 0.20) 0%, transparent 60%),
      rgba(3, 18, 24, 0.45);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid rgba(11, 188, 214, 0.18);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card--book:hover {
      border-color: rgba(11, 188, 214, 0.52);
      box-shadow: 0 20px 52px rgba(11, 188, 214, 0.18), 0 4px 16px rgba(0, 0, 0, 0.4);
    }
  }

  .hp-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.20) 45%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 1;
  }

  .hp-card-content {
    position: relative;
    /* z-index: 3 — deasupra hp-card-link (z:2) și hp-card-overlay (z:1) */
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 2.25rem 2rem;
    width: 100%;
  }

  .hp-card-kicker {
    font-family: 'Oswald', sans-serif;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(241, 229, 172, 0.78);
  }

  .hp-card-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0;
    line-height: 1.1;
  }

  .hp-card--book .hp-card-title {
    color: rgba(190, 252, 255, 0.95);
  }

  .hp-card-text {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    color: rgba(215, 225, 240, 0.90);
    margin: 0;
    line-height: 1.65;
  }

  .hp-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 211, 102, 0.13);
    border: 1px solid rgba(37, 211, 102, 0.40);
    border-radius: 0.65rem;
    padding: 0.5rem 1rem;
    font-family: 'Oswald', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #25d366;
    text-decoration: none;
    width: fit-content;
    margin-top: 0.2rem;
    /* z-index: 4 — clickabil deasupra stretched link-ului (z:2) */
    position: relative;
    z-index: 4;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .hp-whatsapp-btn:hover {
    background: rgba(37, 211, 102, 0.26);
    border-color: rgba(37, 211, 102, 0.68);
    color: #4dff96;
  }

  .hp-whatsapp-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .hp-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.70rem;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(241, 229, 172, 0.82);
    margin-top: 0.3rem;
    transition: color 200ms ease, gap 200ms ease;
  }

  .hp-card:hover .hp-card-cta {
    color: #F1E5AC;
    gap: 0.6rem;
  }

  .hp-card--book .hp-card-cta {
    color: rgba(11, 188, 214, 0.88);
  }

  .hp-card--book:hover .hp-card-cta {
    color: var(--teal, #0BBCD6);
    gap: 0.6rem;
  }

  /* ════════════════════════════════════════════════════════════════
     SEO CONTENT SECTIONS — Despre, De ce noi, Evenimente, FAQ
  ════════════════════════════════════════════════════════════════ */
  .hp-seo-section {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-block: var(--section-pad-y);
    padding-inline: var(--container-pad-x);
  }

  .hp-seo-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0 0 1.5rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hp-seo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .hp-seo-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 767px) {
    .hp-seo-grid,
    .hp-seo-grid--3 {
      grid-template-columns: 1fr;
      gap: var(--stack-gap);
    }
    .hp-seo-text {
      font-size: 0.88rem;
      line-height: 1.75;
    }
    .hp-faq-answer {
      font-size: 0.88rem;
      line-height: 1.75;
    }
  }

  .hp-seo-block {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    padding: 1.5rem 1.75rem;
    background: rgba(10, 22, 50, 0.55);
  }

  .hp-seo-subtitle {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 600;
    color: #F0E6B8;
    margin: 0 0 0.75rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .hp-seo-text {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    line-height: 1.8;
    color: #D0D8E8;
    margin: 0;
    text-wrap: pretty;
  }

  .hp-seo-text--link {
    margin-top: 0.75rem;
  }

  .hp-inline-link {
    color: var(--gold, #f5a623);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 166, 35, 0.35);
    transition: border-color 0.2s, opacity 0.2s;
  }
  .hp-inline-link:hover {
    border-bottom-color: var(--gold, #f5a623);
    opacity: 0.85;
  }

  /* FAQ */
  .hp-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hp-faq-item {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    padding: 0;
    background: rgba(10, 22, 50, 0.55);
    overflow: hidden;
  }

  .hp-faq-item[open] {
    border-color: rgba(241, 229, 172, 0.20);
  }

  .hp-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .hp-faq-question::-webkit-details-marker {
    display: none;
  }

  .hp-faq-q-text {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(0.92rem, 1.5vw, 1.05rem);
    font-weight: 600;
    color: #E8E8E8;
    margin: 0;
    line-height: 1.35;
    text-wrap: balance;
