  .hp-convert-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }

  .hp-convert-btn--wa {
    animation: convertPulseWa 2.6s ease-in-out infinite;
  }

  .hp-convert-btn--offer {
    animation: convertPulseGold 2.8s ease-in-out infinite;
  }

