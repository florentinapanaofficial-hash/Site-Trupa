    background:
      linear-gradient(135deg, rgba(8, 16, 38, 0.74), rgba(9, 20, 46, 0.7)),
      radial-gradient(circle at 88% 18%, rgba(245, 166, 35, 0.16), transparent 42%),
      radial-gradient(circle at 8% 86%, rgba(11, 188, 214, 0.16), transparent 45%);
