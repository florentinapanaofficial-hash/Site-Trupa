---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import couplesData from '../data/couples.json';
import heroImg from '../assets/card-1-panoramica.jpg';

const optimizedHero = await getImage({ src: heroImg, format: 'webp', width: 320, height: 213 });

const { acasa } = seo;
const { contact } = siteContent;
const faqItems = acasa.faq;
import { sanitizeUrl } from '../lib/sanitize-url';

const socialLinks = {
  youtube:   siteContent.socialLinks?.youtube ? sanitizeUrl(siteContent.socialLinks.youtube) : null,
  facebook:  siteContent.socialLinks?.facebook ? sanitizeUrl(siteContent.socialLinks.facebook) : null,
  instagram: siteContent.socialLinks?.instagram ? sanitizeUrl(siteContent.socialLinks.instagram) : null,
  tiktok:    siteContent.socialLinks?.tiktok ? sanitizeUrl(siteContent.socialLinks.tiktok) : null,
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: acasa.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const waHref = `https://wa.me/${contact.phoneRaw.replace('+', '')}?text=Bun%C4%83%20ziua!%20A%C8%99%20dori%20s%C4%83%20rezerv%20Forma%C8%9Bia%20Florentina%20Pan%C4%83%20pentru%20evenimentul%20meu.`;

const heroVideos = siteContent.videos.slice(0, 3).map((video) => ({
  title: video.title,
  thumbJpg: `https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`,
}));

const homepagePhotoSources = {
  claudiuFlorentina: {
    avifSrcSet: '/images/galerie-foto-site/placerea-scenei-claudiu-florentina-500.avif 500w, /images/galerie-foto-site/placerea-scenei-claudiu-florentina-700.avif 700w, /images/galerie-foto-site/placerea-scenei-claudiu-florentina-1000.avif 1000w',
    webpSrcSet: '/images/galerie-foto-site/placerea-scenei-claudiu-florentina-500.webp 500w, /images/galerie-foto-site/placerea-scenei-claudiu-florentina-700.webp 700w, /images/galerie-foto-site/placerea-scenei-claudiu-florentina-1000.webp 1000w',
    fallbackSrc: '/images/galerie-foto-site/placerea-scenei-claudiu-florentina.jpg',
  },
  anaFlorentina: {
    fallbackSrc: '/images/galerie-foto-site/placerea-scenei-ana-florentina.jpg',
  },
  evenimentOne: {
    fallbackSrc: '/images/galerie-foto-site/Galerie Evenimente 1.jpg',
  },
  claudiuTwo: {
    fallbackSrc: '/images/galerie-foto-site/Claudiu 2.jpg',
  },
} as const;

const heroSliderPhotos = [
  {
    ...homepagePhotoSources.claudiuFlorentina,
    alt: 'Formația Florentina Pană în plin show live pe scenă',
    position: '40% 30%',
  },
  {
    ...homepagePhotoSources.anaFlorentina,
    alt: 'Moment live de scenă la un eveniment premium',
    position: '50% 14%',
  },
  {
    ...homepagePhotoSources.evenimentOne,
    alt: 'Public și formație într-un moment live energic pe scenă',
    position: '38% 16%',
  }
] as const;

const heroPhotos: Array<{ variant: keyof typeof homepagePhotoSources; alt: string }> = [
  {
    variant: 'claudiuFlorentina',
    alt: 'Formația Florentina Pană în plin show live pe scenă',
  },
  {
    variant: 'anaFlorentina',
    alt: 'Moment live în duet pe scenă la un eveniment premium',
  },
  {
    variant: 'claudiuTwo',
    alt: 'Public și formație într-un moment live energic pe scenă',
  },
];

const signatureCouples = [...couplesData.couples]
  .sort((a, b) => (b.isoDate || '').localeCompare(a.isoDate || ''))
  .slice(0, 3)
  .map((item) => ({
    names: item.names,
    city: item.city,
    date: item.date,
    recommendation: item.recommendation,
    slug: item.slug,
  }));
const heroTelHref = `tel:${contact.phoneRaw}`;
const heroWaHref = `https://wa.me/${contact.phoneRaw.replace('+', '')}?text=Bun%C4%83!%20Vreau%20s%C4%83%20verific%20disponibilitatea%20Forma%C8%9Biei%20Florentina%20Pan%C4%83.`;
---

<BaseLayout title={acasa.meta.title} description={acasa.meta.description} ogImage={siteContent.seo.ogImage}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <section class="hero-slider" aria-label="Galerie automată cu imagini live Formația Florentina Pană">
    <div class="hero-slider-track" data-hero-slider data-ready="false">
      <div class="hero-slider-placeholder" aria-hidden="true">
        Momente live autentice — se încarcă galeria foto
      </div>

      {heroSliderPhotos.map((slide, index) => (
        <div class={`hero-slider-slide${index === 0 ? ' is-active' : ''}`} data-hero-slide style={`--slide-pos: ${slide.position};`}>
          <picture>
            {slide.avifSrcSet && (
              <source
                type="image/avif"
                srcset={slide.avifSrcSet}
                sizes="(max-width: 767px) 92vw, (max-width: 1280px) 96vw, 1120px"
              />
            )}
            {slide.webpSrcSet && (
              <source
                type="image/webp"
                srcset={slide.webpSrcSet}
                sizes="(max-width: 767px) 92vw, (max-width: 1280px) 96vw, 1120px"
              />
            )}
            <img
              src={slide.fallbackSrc}
              alt={slide.alt}
              class="hero-slider-image"
              loading="lazy"
              decoding="async"
              width="1000"
              height="560"
            />
          </picture>
        </div>
      ))}
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      HERO — Scenă, titlu mare, CTA-uri
  ═══════════════════════════════════════════ */}
  <section id="acasa" class="hero-stage hero-fullscreen hp-hero-wrap" aria-label="Secțiunea principală">
    <div class="hero-stage-inner">
      <div class="hero-light-orbs" aria-hidden="true">
        <span class="hero-orb hero-orb--one"></span>
        <span class="hero-orb hero-orb--two"></span>
        <span class="hero-orb hero-orb--three"></span>
      </div>

      <span class="kicker-badge anim-hero-load anim-hero-d1" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11.3 1.046A1 1 0 0 1 12 2v5h4a1 1 0 0 1 .82 1.573l-7 10A1 1 0 0 1 8 18v-5H4a1 1 0 0 1-.82-1.573l7-10a1 1 0 0 1 1.12-.38Z"/></svg>
        {acasa.hero.kicker}
      </span>

      {/* Card foto — vizibil doar pe mobil, colțuri rotunjite */}
      <div class="hero-photo-card anim-hero-load anim-hero-d2">
        <img
          src={optimizedHero.src}
          alt="Formația Florentina Pană — spectacol live pe scenă"
          class="hero-photo-img anim-img-hover"
          width="320"
          height="213"
          loading="lazy"
          fetchpriority="auto"
          decoding="async"
        />
      </div>

      <h1 class="hero-title-xl anim-hero-load anim-hero-d2">
        <span class="hero-title-gold hero-title-gold--compact">Formație Nuntă Pitești - Formația Florentina Pană</span>
      </h1>

      <p class="hero-lead anim-hero-load anim-hero-d3">
        {acasa.hero.descriere}
      </p>

      <p class="hero-pricing-note anim-hero-load anim-hero-d3">
        Pentru alegerea unei formații de nuntă în Pitești contează vibe-ul, repertoriul și modul în care ținem ringul plin de la primul dans până la final.
        Dacă vrei o trupă de nunți în Argeș care livrează energie autentică și organizare clară, completează formularul de buget și revenim rapid cu o ofertă personalizată.
        <a href="/contact/" class="hero-pricing-link">Completează formularul de buget</a>
      </p>

      {/* CTA-uri hero */}
      <div class="hero-cta-row anim-hero-load anim-hero-d4">
        <a href={`tel:${contact.phoneRaw}`} class="hero-cta-primary" onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'hero'})">
          <svg xmlns="http://www.w3.org/2000/svg" class="hero-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Sună Acum
        </a>
        <a href="/galerie-video/" class="hero-cta-secondary" onclick="window.gtag&&window.gtag('event','click_gallery_video',{event_category:'hero'})">
          Ascultă live
        </a>
      </div>

      {/* Stat pills */}
      <div class="hero-stats anim-hero-load anim-hero-d4" aria-label="Statistici formație">
        <div class="hero-stat-pill">
          <span class="hero-stat-num" data-target="10+">10+</span>
          <span class="hero-stat-label">ani experiență</span>
        </div>
        <div class="hero-stat-pill">
          <span class="hero-stat-num" data-target="500+">500+</span>
          <span class="hero-stat-label">evenimente</span>
        </div>
        <div class="hero-stat-pill">
          <span class="hero-stat-num" data-target="100%">100%</span>
          <span class="hero-stat-label">live</span>
        </div>
      </div>

      {/* Social media icons — vizibile doar pe mobil, umplu spațiul gol */}
      <div class="hero-social-row" aria-label="Rețele sociale">
        <span class="hero-social-label">Urmărește-ne</span>
        <div class="hero-social-icons">
          {socialLinks.youtube && (
            <a href={socialLinks.youtube} class="hero-social-btn hero-social-btn--yt"
              target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="6" width="20" height="13" rx="4" fill="#fff"/>
                <polygon points="9.5,9.5 9.5,15.5 16.5,12.5" fill="#FF0000"/>
              </svg>
              <span>YouTube</span>
            </a>
          )}
          {socialLinks.facebook && (
            <a href={socialLinks.facebook} class="hero-social-btn hero-social-btn--fb"
              target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5" fill="#1877F2"/>
                <path d="M13.5 21V14.3H16l.4-2.85H13.5V9.7c0-.82.38-1.2 1.38-1.2H16.5V5.85C16.05 5.77 15.1 5.7 14 5.7c-2.65 0-4.05 1.4-4.05 4.15v1.6H8v2.85h1.95V21H13.5z" fill="#fff"/>
              </svg>
              <span>Facebook</span>
            </a>
          )}
          {socialLinks.instagram && (
            <a href={socialLinks.instagram} class="hero-social-btn hero-social-btn--ig"
              target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5.5"
                  fill="url(#ig-grad-hero)"/>
                <defs>
                  <radialGradient id="ig-grad-hero" cx="30%" cy="110%" r="140%">
                    <stop offset="0%" stop-color="#ffd676"/>
                    <stop offset="25%" stop-color="#f46f30"/>
                    <stop offset="55%" stop-color="#e1306c"/>
                    <stop offset="80%" stop-color="#833ab4"/>
                    <stop offset="100%" stop-color="#405de6"/>
                  </radialGradient>
                </defs>
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="#fff" stroke-width="2"/>
                <circle cx="12" cy="12" r="4.3" stroke="#fff" stroke-width="2"/>
                <circle cx="17.5" cy="6.6" r="1.4" fill="#fff"/>
              </svg>
              <span>Instagram</span>
            </a>
          )}
          {socialLinks.tiktok && (
            <a href={socialLinks.tiktok} class="hero-social-btn hero-social-btn--tt"
              target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect width="24" height="24" rx="5" fill="#010101"/>
                <path transform="translate(-0.5,-0.4)" d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#25f4ee"/>
                <path transform="translate(0.5,0.4)" d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#fe2c55"/>
                <path d="M16.5 3h-2.3v11.6a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8 2.8 2.8 0 0 1 2.8-2.8c.3 0 .55.05.8.12V9.45a6.2 6.2 0 0 0-.8-.05 6.1 6.1 0 0 0-6.1 6.1 6.1 6.1 0 0 0 6.1 6.1 6.1 6.1 0 0 0 6.1-6.1V8.35a8.5 8.5 0 0 0 4.8 1.5V7.3a6.1 6.1 0 0 1-4.5-4.3h-.3z" fill="#fff"/>
              </svg>
              <span>TikTok</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="hp-meet-teaser section-container" aria-label="Cunoaște Formația Florentina Pană">
    <div class="hp-meet-wrap reveal-on-scroll from-bottom" style="--reveal-delay: 30ms">
      <div class="hp-meet-media">
        <picture>
          <img
            src="/images/galerie-foto-site/placerea-scenei-ana-florentina.jpg"
            alt="Florentina și Claudiu în timpul unui moment live"
            loading="lazy"
            decoding="async"
            width="500"
            height="889"
          />
        </picture>
      </div>
      <div class="hp-meet-content">
        <p class="hp-meet-kicker">Conexiune reală</p>
        <h2 class="hp-meet-title">Vrei să ne cunoști înainte de eveniment? Exact așa lucrăm.</h2>
        <p class="hp-meet-copy">
          Discutăm direct cu voi, înțelegem atmosfera dorită și construim împreună planul serii.
          Ne pasă de oameni, nu doar de playlist.
        </p>
        <div class="hp-meet-actions">
          <a href="/despre/" class="btn-outline" onclick="window.gtag&&window.gtag('event','click_about',{event_category:'homepage',event_label:'meet-section'})">Cunoaște-ne mai bine</a>
          <a href="/contact/" class="btn-solid" onclick="window.gtag&&window.gtag('event','click_contact',{event_category:'homepage',event_label:'meet-section'})">Hai să vorbim acum</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hp-convert-strip section-container" aria-label="Contact rapid și ofertă">
    <div class="hp-convert-wrap reveal-on-scroll from-bottom" style="--reveal-delay: 45ms">
      <div class="hp-convert-copy">
        <p class="hp-convert-kicker">Disponibilitate rapidă</p>
        <h2 class="hp-convert-title">Spune-ne data și bugetul, iar noi revenim rapid cu o ofertă clară.</h2>
      </div>
      <div class="hp-convert-actions">
        <a href={heroTelHref} class="hp-convert-btn hp-convert-btn--call" aria-label="Sună acum pentru ofertă" onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'homepage',event_label:'convert-strip'})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Sună Acum
        </a>
        <a href={heroWaHref} class="hp-convert-btn hp-convert-btn--wa" target="_blank" rel="noopener noreferrer" aria-label="Scrie pe WhatsApp pentru disponibilitate" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'homepage',event_label:'convert-strip'})">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
          WhatsApp
        </a>
        <a href="/oferta-premium/" class="hp-convert-btn hp-convert-btn--offer" aria-label="Vezi oferta premium Florentina Pană" onclick="window.gtag&&window.gtag('event','click_premium_offer',{event_category:'homepage',event_label:'convert-strip'})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 11 23l-9-9 9.59-9.59a2 2 0 0 1 1.41-.59H20a2 2 0 0 1 2 2v6.99a2 2 0 0 1-.59 1.42Z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          Ofertă Premium
        </a>
      </div>
    </div>
  </section>

  <section class="hp-team-spotlight section-container" aria-label="Cunoaște nucleul formației">
    <div class="hp-team-head reveal-on-scroll from-bottom" style="--reveal-delay: 55ms">
      <p class="hp-team-kicker">Nucleul formației</p>
      <h2 class="hp-team-title">Oameni reali, energie reală, chimie care se simte pe scenă</h2>
      <p class="hp-team-copy">
        Înainte de playlist, există oamenii. De aceea punem accent pe relația directă cu voi,
        pe încredere și pe vibe-ul pe care îl construim împreună la eveniment.
      </p>
    </div>

    <div class="hp-team-grid">
      <article class="hp-team-card reveal-on-scroll from-left" style="--reveal-delay: 80ms">
        <picture>
          <source
            type="image/avif"
            srcset={homepagePhotoSources.claudiuFlorentina.avifSrcSet}
            sizes="(max-width: 767px) 92vw, 485px"
          />
          <source
            type="image/webp"
            srcset={homepagePhotoSources.claudiuFlorentina.webpSrcSet}
            sizes="(max-width: 767px) 92vw, 485px"
          />
          <img
            src={homepagePhotoSources.claudiuFlorentina.fallbackSrc}
            alt="Florentina și Claudiu în timpul unui show live"
            loading="lazy"
            decoding="async"
            width="500"
            height="889"
          />
        </picture>
        <div class="hp-team-overlay" aria-hidden="true"></div>
        <div class="hp-team-content">
          <p class="hp-team-role">Voce & Show Direction</p>
          <h3>Florentina Pană</h3>
          <p>Prezență scenică puternică, emoție autentică și conexiune directă cu invitații.</p>
        </div>
      </article>

      <article class="hp-team-card reveal-on-scroll from-right" style="--reveal-delay: 150ms">
        <picture>
          <img
            src="/images/galerie-foto-site/Claudiu 2.jpg"
            alt="Claudiu coordonând atmosfera live la eveniment"
            loading="lazy"
            decoding="async"
            width="500"
            height="287"
          />
        </picture>
        <div class="hp-team-overlay" aria-hidden="true"></div>
        <div class="hp-team-content">
          <p class="hp-team-role">Coordonare & Energie Live</p>
          <h3>Pană Claudiu</h3>
          <p>Ritm impecabil al serii, tranziții inteligente și focus total pe experiența invitaților.</p>
        </div>
      </article>
    </div>

    <div class="hp-team-actions reveal-on-scroll from-bottom" style="--reveal-delay: 200ms">
      <a href="/membri/" class="btn-outline">Vezi toată echipa</a>
      <a href="/contact/" class="btn-solid">Hai să ne cunoaștem</a>
    </div>
  </section>

  <section class="hp-trust-ribbon section-container" aria-label="Beneficii premium">
    <div class="hp-trust-ribbon-inner reveal-on-scroll from-bottom" style="--reveal-delay: 40ms">
      <p class="hp-trust-title">Standardul nostru pentru evenimentul tău</p>
      <div class="hp-trust-pills">
        <span class="hp-trust-pill">Recenzii reale 5 stele</span>
        <span class="hp-trust-pill">Contract clar, fără surprize</span>
        <span class="hp-trust-pill">Show 100% live</span>
        <span class="hp-trust-pill">Acoperire națională</span>
      </div>
      <a href="/contact/" class="hp-trust-cta">Verifică data evenimentului</a>
    </div>
  </section>

  <section class="hp-signature-flow section-container" aria-label="Cum transformăm evenimentul într-un spectacol">
    <div class="hp-signature-head reveal-on-scroll from-bottom" style="--reveal-delay: 20ms">
      <p class="hp-signature-kicker">Signature Flow</p>
