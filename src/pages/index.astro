      bottom: auto;
      background: linear-gradient(180deg, rgba(4, 10, 25, 0.10), rgba(4, 10, 25, 0.82));
      padding: 0.75rem 0.8rem 0.85rem;
    }

    .hp-team-content p {
      font-size: 0.8rem;
      line-height: 1.62;
    }

    .hp-team-actions .btn-solid,
    .hp-team-actions .btn-outline {
      width: 100%;
    }

    .hp-convert-actions {
      width: 100%;
      justify-content: stretch;
      gap: 0.62rem;
    }

    .hp-convert-btn {
      width: 100%;
      font-size: 0.9rem;
      min-height: 52px;
    }

    .hp-meet-media {
      min-height: 220px;
    }

    .hp-meet-content {
      padding: 0.9rem;
    }

    .hp-meet-actions .btn-solid,
    .hp-meet-actions .btn-outline {
      width: 100%;
    }

    .hp-signature-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .hp-signature-grid::before {
      display: none;
    }

    .hp-signature-card {
      padding: 0.9rem;
    }

    .hp-signature-card p {
      font-size: 0.84rem;
    }

    .hp-signature-actions .btn-solid,
    .hp-signature-actions .btn-outline {
      width: 100%;
    }
  }

  @media (max-width: 1024px) {
    .hp-team-card {
      display: flex;
      flex-direction: column;
      min-height: 250px;
    }

    .hp-team-card picture {
      position: relative;
      inset: auto;
      display: block;
    }

    .hp-team-card img {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      flex: none;
      object-fit: cover;
    }

    .hp-team-overlay {
      display: none;
    }

    .hp-team-content {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      background: linear-gradient(180deg, rgba(4, 10, 25, 0.12), rgba(4, 10, 25, 0.84));
      padding: 0.85rem 0.9rem 0.95rem;
    }
  }

  @media (max-width: 767px) {
    .hp-highlights {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem;
      margin-top: -3rem;
    }

    .hp-diamond-head {
      padding-top: 0;
    }

    .hp-diamond-title {
      font-size: clamp(1.3rem, 6.2vw, 1.7rem);
    }

    .hp-diamond-copy {
      font-size: 0.85rem;
      line-height: 1.72;
    }

    /* Reduce card min-height când stivuite — evită spațiu alb excesiv */
    .hp-card {
      min-height: 240px;
    }

    .hp-card--story {
      min-height: 220px;
    }

    /* Padding mai strâns în card-content pe mobil */
    .hp-card-content {
      padding: 1.75rem 1.5rem;
      gap: 0.45rem;
    }

    /* Titlu card proporțional pe ecran mic */
    .hp-card-title {
      font-size: clamp(1.5rem, 5.5vw, 1.9rem);
    }
  }

  /* Stretched link — acoperă întreg cardul, navigare la URL-ul cardului */
  .hp-card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .hp-card {
    position: relative;
    min-height: 300px;
    border-radius: 1.5rem;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    cursor: pointer;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 300ms ease,
                border-color 300ms ease;
  }

  .hp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0.55;
    z-index: 2;
  }

  @media (min-width: 1025px) {
    .hp-card { min-height: 340px; }
  }

  /* hover doar pe dispozitive cu pointer precis — evită sticky-hover pe touch */
  @media (hover: hover) and (pointer: fine) {
    .hp-card:hover {
      transform: scale(1.02);
    }

    .hp-card:hover::before {
      border-color: rgba(255, 255, 255, 0.24);
      opacity: 1;
    }
  }

  /* Card 1 — Povestea noastră — glassmorphism */
  .hp-card--story {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    min-height: 280px;
    background:
      radial-gradient(ellipse at 70% 30%, rgba(61, 26, 110, 0.55) 0%, rgba(26, 10, 61, 0.40) 55%, transparent 100%);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid rgba(160, 90, 255, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 rgba(200, 140, 255, 0.10);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card--story:hover {
      border-color: rgba(180, 110, 255, 0.60);
      box-shadow: 0 20px 56px rgba(100, 40, 200, 0.35), 0 4px 16px rgba(0, 0, 0, 0.5),
                  inset 0 1px 0 rgba(200, 140, 255, 0.20);
    }
  }

  /* Conținut story-card: umple înălțimea cardului → centrare verticală garantată */
  .hp-card--story .hp-card-content {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }

  /* Card 2 — Rezervă acum — glassmorphism */
  .hp-card--book {
    background:
      radial-gradient(ellipse 65% 55% at 90% 80%, rgba(11, 188, 214, 0.18) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 10% 20%, rgba(4, 80, 100, 0.20) 0%, transparent 60%),
      rgba(3, 18, 24, 0.45);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid rgba(11, 188, 214, 0.18);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card--book:hover {
      border-color: rgba(11, 188, 214, 0.52);
      box-shadow: 0 20px 52px rgba(11, 188, 214, 0.18), 0 4px 16px rgba(0, 0, 0, 0.4);
    }
  }

  .hp-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.20) 45%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Imagine de fundal pentru cardul "Povestea noastră" */
  .hp-card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Overlay mai puternic peste foto pentru contrast text WCAG AA */
  .hp-card--story .hp-card-overlay {
    background:
      linear-gradient(135deg,
        rgba(40, 14, 80, 0.78) 0%,
        rgba(20, 8, 50, 0.55) 50%,
        rgba(0, 0, 0, 0.70) 100%);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card--story:hover .hp-card-bg {
      transform: scale(1.06);
    }
  }

  .hp-card-content {
    position: relative;
    /* z-index: 3 — deasupra hp-card-link (z:2) și hp-card-overlay (z:1) */
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 2.25rem 2rem;
    width: 100%;
  }

  .hp-card-kicker {
    font-family: 'Oswald', sans-serif;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(241, 229, 172, 0.78);
  }

  .hp-card-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0;
    line-height: 1.1;
  }

  .hp-card--book .hp-card-title {
    color: rgba(190, 252, 255, 0.95);
  }

  .hp-card-text {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    color: rgba(215, 225, 240, 0.90);
    margin: 0;
    line-height: 1.65;
  }

  .hp-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 211, 102, 0.13);
    border: 1px solid rgba(37, 211, 102, 0.40);
    border-radius: 0.65rem;
    padding: 0.5rem 1rem;
    font-family: 'Oswald', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #25d366;
    text-decoration: none;
    width: fit-content;
    margin-top: 0.2rem;
    /* z-index: 4 — clickabil deasupra stretched link-ului (z:2) */
    position: relative;
    z-index: 4;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .hp-whatsapp-btn:hover {
    background: rgba(37, 211, 102, 0.26);
    border-color: rgba(37, 211, 102, 0.68);
    color: #4dff96;
  }

  .hp-whatsapp-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .hp-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.70rem;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(241, 229, 172, 0.82);
    margin-top: 0.3rem;
    transition: color 200ms ease, gap 200ms ease;
  }

  .hp-card:hover .hp-card-cta {
    color: #F1E5AC;
    gap: 0.6rem;
  }

  .hp-card--book .hp-card-cta {
    color: rgba(11, 188, 214, 0.88);
  }

  .hp-card--book:hover .hp-card-cta {
    color: var(--teal, #0BBCD6);
    gap: 0.6rem;
  }

  /* ════════════════════════════════════════════════════════════════
     SEO CONTENT SECTIONS — Despre, De ce noi, Evenimente, FAQ
  ════════════════════════════════════════════════════════════════ */
  .hp-seo-section {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-block: var(--hp-section-pad);
    padding-inline: var(--container-pad-x);
  }

  .hp-seo-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0 0 1.5rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hp-seo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .hp-seo-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 767px) {
    .hp-seo-grid,
    .hp-seo-grid--3 {
      grid-template-columns: 1fr;
      gap: var(--stack-gap);
    }
    .hp-seo-text {
      font-size: 0.88rem;
      line-height: 1.75;
    }
    .hp-faq-answer {
      font-size: 0.88rem;
      line-height: 1.75;
    }
  }

  .hp-seo-block {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    padding: 1.5rem 1.75rem;
    background: rgba(10, 22, 50, 0.55);
  }

  .hp-seo-subtitle {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 600;
    color: #F0E6B8;
    margin: 0 0 0.75rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .hp-seo-text {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    line-height: 1.8;
    color: #D0D8E8;
    margin: 0;
    text-wrap: pretty;
  }

  .hp-seo-text--link {
    margin-top: 0.75rem;
  }

  .hp-inline-link {
    color: var(--gold, #f5a623);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 166, 35, 0.35);
    transition: border-color 0.2s, opacity 0.2s;
  }
  .hp-inline-link:hover {
    border-bottom-color: var(--gold, #f5a623);
    opacity: 0.85;
  }

  /* FAQ */
  .hp-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hp-faq-item {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    padding: 0;
    background: rgba(10, 22, 50, 0.55);
    overflow: hidden;
  }

  .hp-faq-item[open] {
    border-color: rgba(241, 229, 172, 0.20);
  }

  .hp-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .hp-faq-question::-webkit-details-marker {
    display: none;
  }

  .hp-faq-q-text {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(0.92rem, 1.5vw, 1.05rem);
    font-weight: 600;
    color: #E8E8E8;
    margin: 0;
    line-height: 1.35;
    text-wrap: balance;
  }

  .hp-faq-chevron {
    flex-shrink: 0;
    color: rgba(241, 229, 172, 0.50);
    transition: transform 200ms ease;
  }

  .hp-faq-item[open] .hp-faq-chevron {
    transform: rotate(180deg);
  }

  .hp-faq-answer {
    padding: 0 1.5rem 1.25rem;
    margin: 0;
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    line-height: 1.8;
    color: #D0D8E8;
    text-wrap: pretty;
  }

  /* ════════════════════════════════════════════════════════════════
     SHOWCASE CINEMATIC — layout mixt text + video + foto
  ════════════════════════════════════════════════════════════════ */
  .hp-cinematic {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-block: var(--hp-section-pad);
  }

  .hp-cinematic-head {
    max-width: 68ch;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .hp-cinematic-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.45rem;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(11, 188, 214, 0.42);
    background: rgba(11, 188, 214, 0.12);
    color: rgba(172, 240, 248, 0.95);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hp-cinematic-kicker {
    display: inline-block;
    margin: 0 0 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(241, 229, 172, 0.9);
  }

  .hp-cinematic-title {
    margin: 0;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.6rem, 4.4vw, 2.4rem);
    line-height: 1.15;
    color: #fff;
    text-wrap: balance;
  }

  .hp-cinematic-copy {
    margin: 0.85rem auto 0;
    color: #d0d8e8;
    line-height: 1.75;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .hp-cinematic-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.8vw, 1.2rem);
    align-items: stretch;
  }

  .hp-cine-card,
  .hp-cine-story {
    position: relative;
    border-radius: 1.1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(9, 18, 42, 0.58);
    min-height: 220px;
  }

  .hp-cine-card {
    text-decoration: none;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.34);
    transition: transform 280ms ease, box-shadow 280ms ease, border-color 280ms ease;
  }

  .hp-cine-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms ease;
  }

  .hp-cine-card picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hp-cine-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.12) 60%, transparent 100%);
    pointer-events: none;
  }

  .hp-cine-caption {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.75rem;
    color: #fff;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    z-index: 3;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);
  }

  .hp-cine-chip {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 3;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(240, 59, 59, 0.9);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hp-cine-play {
    position: absolute;
    right: 0.7rem;
    top: 0.62rem;
    z-index: 3;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hp-cine-card--video:nth-of-type(1) { grid-column: span 4; }
  .hp-cine-card--video:nth-of-type(2) { grid-column: span 4; }
  .hp-cine-card--video:nth-of-type(3) { grid-column: span 4; }

  .hp-cine-card--video,
  .hp-cine-card--photo {
    aspect-ratio: 16 / 9;
    min-height: 0;
  }

  .hp-cine-card--photo {
    aspect-ratio: 4 / 5;
  }

  .hp-cine-card--photo img {
    object-position: center 24%;
  }

  .hp-cine-story {
    grid-column: span 6;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.8rem;
    background:
      radial-gradient(circle at 80% 15%, rgba(245, 166, 35, 0.2), transparent 40%),
      radial-gradient(circle at 10% 90%, rgba(11, 188, 214, 0.24), transparent 45%),
      rgba(8, 16, 36, 0.82);
  }

  .hp-cine-story h3 {
    margin: 0;
    color: #fff;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.2rem, 2.1vw, 1.6rem);
    line-height: 1.15;
  }

  .hp-cine-story p {
    margin: 0;
    color: #d4dcef;
    line-height: 1.75;
    font-size: 0.92rem;
  }

  .hp-cine-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .hp-cine-card--photo {
    grid-column: span 6;
  }

  .hp-cine-editorial {
    grid-column: span 6;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background:
      radial-gradient(circle at 85% 20%, rgba(245, 166, 35, 0.22), transparent 42%),
      rgba(9, 18, 40, 0.72);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.32);
  }

  .hp-cine-editorial-kicker {
    margin: 0;
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 225, 160, 0.9);
    font-weight: 700;
  }

  .hp-cine-editorial h3 {
    margin: 0;
    color: #f8fbff;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.08rem, 1.9vw, 1.32rem);
    line-height: 1.2;
  }

  .hp-cine-editorial p {
    margin: 0;
    color: rgba(211, 224, 243, 0.94);
    line-height: 1.72;
    font-size: 0.86rem;
  }

  .hp-cine-editorial-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin-top: 0.25rem;
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(245, 166, 35, 0.46);
    padding: 0.45rem 0.9rem;
    text-decoration: none;
    color: #ffe8bd;
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.22), rgba(255, 209, 102, 0.16));
    font-family: 'Oswald', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .hp-cine-editorial-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  .hp-cinematic-marquee {
    margin-top: 0.95rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 16, 38, 0.6);
    overflow: hidden;
  }

  .hp-cinematic-track {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: max-content;
    padding: 0.62rem 0.8rem;
    color: rgba(227, 238, 255, 0.88);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    animation: cinematicMarquee 18s linear infinite;
  }

  .hp-proof {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-block: var(--hp-section-pad);
  }

