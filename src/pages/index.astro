    min-height: auto !important;
    /* padding-top >= 4rem → text "Formația" + badge vizibil sub header fix (~4rem înălțime) */
    padding-top: clamp(5rem, 6vw, 5.5rem) !important;
    /* padding-bottom redus — fără spațiu gol sub statistici */
    padding-bottom: 3rem !important;
    position: relative;
    overflow: hidden;
    /* Tranziție identică cu .hp-card */
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease,
      border-color 300ms ease;
    /* Gradient de fundal vibrant + scenic backdrop */
    background: linear-gradient(135deg, 
      rgba(11, 50, 120, 0.85) 0%,
      rgba(20, 80, 150, 0.80) 20%,
      rgba(8, 16, 42, 0.90) 50%,
      rgba(15, 60, 130, 0.82) 80%,
      rgba(5, 30, 80, 0.88) 100%);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    border: 1px solid rgba(245, 166, 35, 0.15);
  }

  /* Hover pe cardul hero — doar pe dispozitive cu pointer precis */
  @media (hover: hover) and (pointer: fine) {
    .hero-fullscreen:hover {
      transform: scale(1.015);
      box-shadow:
        0 0 0 1px rgba(245, 166, 35, 0.25),
        0 12px 40px rgba(245, 166, 35, 0.20),
        0 0 60px rgba(11, 188, 214, 0.25);
    }
  }

  /* Glow effect în colțurile hero-ului — teatru luminos */
  .hero-fullscreen::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2rem;
    background: 
      radial-gradient(900px at 20% 30%, rgba(11, 188, 214, 0.15) 0%, transparent 30%),
      radial-gradient(900px at 80% 70%, rgba(245, 166, 35, 0.12) 0%, transparent 35%),
      radial-gradient(900px at 50% 50%, rgba(120, 70, 255, 0.08) 0%, transparent 40%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-stage-inner {
    position: relative;
    z-index: 2;
  }

  /* ════════════════════════════════════════════════════════════════
     HP-HERO-WRAP — container vizual simetric cu .hp-highlights
     Aceeași lățime max 1000px, aceleași margini laterale auto,
     același border-radius 2rem, același padding lateral 2rem.
  ════════════════════════════════════════════════════════════════ */
  .hp-hero-wrap {
    max-width: 1000px;
    margin-inline: auto;
    border-radius: 2rem;
    padding-inline: var(--container-pad-x);
  }

  @media (max-width: 767px) {
    .hero-kicker-text {
      font-size: clamp(1.98rem, 3.2vw, 2.8rem);
      letter-spacing: 0.15em;
      margin-bottom: 0.15rem;
    }

    .hero-title-gold {
      font-size: clamp(2.6rem, 7vw, 5rem);
    }
  }

  @media (max-width: 374px) {
    .hp-hero-wrap {
      padding-inline: 0.5rem;
    }
    .hero-kicker-text {
      font-size: clamp(1.75rem, 5.5vw, 2.2rem);
      letter-spacing: 0.13em;
      margin-bottom: 0.1rem;
    }
    .hero-title-gold {
      font-size: clamp(2.3rem, 8vw, 3.2rem);
    }
    .kicker-badge {
      font-size: 0.72rem;
      padding: 0.28rem 0.68rem;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     HIGHLIGHTS — 2 carduri side-by-side (desktop) / stacked (mobile)
  ════════════════════════════════════════════════════════════════ */
  .hp-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--container-max);
    padding: 1.5rem var(--container-pad-x);
    margin: -5rem auto clamp(1.25rem, 3.5vw, 2.2rem);
    position: relative;
    z-index: 4;
  }

  .hp-highlights--diamond {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1.5rem;
    background:
      linear-gradient(130deg, rgba(8, 16, 40, 0.56), rgba(10, 20, 46, 0.52)),
      radial-gradient(circle at 10% 15%, rgba(11, 188, 214, 0.16), transparent 42%),
      radial-gradient(circle at 88% 88%, rgba(245, 166, 35, 0.14), transparent 40%);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.32);
    overflow: hidden;
  }

  .hp-highlights--diamond::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(112deg,
      transparent 0%,
      transparent 34%,
      rgba(255, 255, 255, 0.14) 47%,
      rgba(255, 255, 255, 0.03) 56%,
      transparent 66%,
      transparent 100%);
    transform: translateX(-35%);
    opacity: 0;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-highlights--diamond:hover::before {
      transform: translateX(0);
      opacity: 1;
    }
  }

