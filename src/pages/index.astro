  <script is:inline>
    (() => {
      const slider = document.querySelector('[data-hero-slider]');
      if (!slider) return;

      const slides = Array.from(slider.querySelectorAll('[data-hero-slide]'));
      if (slides.length < 1) return;

      const REVEAL_DELAY_MS = 3200;
      const AUTOPLAY_DELAY_AFTER_REVEAL_MS = 1200;

      const revealSlider = () => {
        slider.setAttribute('data-ready', 'true');
      };

      const scheduleReveal = () => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(() => {
            window.setTimeout(revealSlider, REVEAL_DELAY_MS);
          }, { timeout: 2200 });
        } else {
          window.setTimeout(revealSlider, REVEAL_DELAY_MS);
        }
      };

      if (document.readyState === 'complete') {
        scheduleReveal();
      } else {
        window.addEventListener('load', scheduleReveal, { once: true });
      }

      if (slides.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let activeIndex = 0;
      const startSlider = () => {
        if (slider.getAttribute('data-ready') !== 'true') return;
        slider.setAttribute('data-running', 'true');
        window.setInterval(() => {
          slides[activeIndex].classList.remove('is-active');
          activeIndex = (activeIndex + 1) % slides.length;
          slides[activeIndex].classList.add('is-active');
        }, 4200);
      };

      // Sliderul pornește după ce zona devine vizibilă și pagina trece de faza critică.
      window.setTimeout(startSlider, REVEAL_DELAY_MS + AUTOPLAY_DELAY_AFTER_REVEAL_MS);
    })();
  </script>

  <script is:inline>
    (() => {
      const targets = Array.from(document.querySelectorAll('.reveal-on-scroll'));
      if (!targets.length || !('IntersectionObserver' in window)) return;

      const io = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, {
        threshold: 0.18,
        rootMargin: '0px 0px -8% 0px',
      });

      targets.forEach((target) => io.observe(target));
    })();
  </script>

  <script is:inline>
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const nums = Array.from(document.querySelectorAll('.hero-stat-num[data-target]'));
      if (!nums.length) return;

      const animate = (el) => {
        const target = (el.getAttribute('data-target') || '').trim();
        const numeric = parseInt(target.replace(/\D/g, ''), 10);
        if (!numeric || Number.isNaN(numeric)) return;
        const suffix = target.includes('%') ? '%' : '+';
        const duration = 1100;
        const start = performance.now();

        const tick = (now) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          const value = Math.round(eased * numeric);
          el.textContent = `${value}${suffix}`;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          animate(entry.target);
          obs.unobserve(entry.target);
        });
      }, { threshold: 0.6 });

      nums.forEach((n) => io.observe(n));
    })();
  </script>

  <script is:inline>
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(max-width: 1024px)').matches) return;
      if (!window.matchMedia('(hover: hover)').matches) return;

      const cards = Array.from(document.querySelectorAll('.hp-highlights--diamond .hp-card'));
      if (!cards.length) return;

      cards.forEach((card) => {
        let rect = null;
        const cacheRect = () => { rect = card.getBoundingClientRect(); };
        const reset = () => { card.style.transform = ''; };

        card.addEventListener('mouseenter', cacheRect);
        card.addEventListener('mousemove', (event) => {
          if (!rect) cacheRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const moveX = (px - 0.5) * 8;
          const moveY = (py - 0.5) * 6;
          card.style.transform = `translate3d(${moveX.toFixed(2)}px, ${moveY.toFixed(2)}px, 0) scale(1.018)`;
        });
        card.addEventListener('mouseleave', reset);
        window.addEventListener('resize', () => { rect = null; reset(); }, { passive: true });
      });
    })();
  </script>

  <script is:inline>
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(max-width: 1024px)').matches) return;
      if (!window.matchMedia('(hover: hover)').matches) return;

      const cinematicCards = Array.from(document.querySelectorAll('.hp-cine-card'));
      if (!cinematicCards.length) return;

      cinematicCards.forEach((card) => {
        let rect = null;
        const cacheRect = () => { rect = card.getBoundingClientRect(); };
        const clear = () => { card.style.transform = ''; };

        card.addEventListener('mouseenter', cacheRect);
        card.addEventListener('mousemove', (event) => {
          if (!rect) cacheRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const x = (px - 0.5) * 5;
          const y = (py - 0.5) * 5;
          card.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(1.015)`;
        });
        card.addEventListener('mouseleave', clear);
      });
    })();
  </script>

