---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import BackButton from '../components/BackButton.astro';
import { sanitizeUrl } from '../lib/sanitize-url';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';

const { tvAppearances, brand } = siteContent;

const getYoutubeId = (url: string) => {
  const match = url.match(/(?:v=|youtu\.be\/)([^&?/]+)/);
  return match?.[1] ?? '';
};

const SITE = 'https://www.florentinapanaofficial.ro';

const videoObjectsLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Apariții TV — ${brand.name}`,
  itemListElement: tvAppearances
    .map((item, idx) => {
      const ytId = getYoutubeId(item.videoUrl);
      if (!ytId) return null;
      return {
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'VideoObject',
          name: item.show || `Apariție TV #${idx + 1}`,
          description: item.note || `Moment live de la ${item.channel} (${item.year})`,
          thumbnailUrl: `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg`,
          uploadDate: `${item.year}-01-01`,
          embedUrl: `https://www.youtube.com/embed/${ytId}`,
          url: item.videoUrl,
          publisher: {
            '@type': 'Organization',
            name: brand.name,
            url: SITE,
          },
        },
      };
    })
    .filter(Boolean),
};
---

<BaseLayout title={`Apariții TV și Emisiuni | ${brand.name}`} description="Galerie video cu apariții TV ale Formației Florentina Pană în emisiuni și gale televizate din România.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(videoObjectsLd)} />
  </Fragment>
  <section class="section-container py-16 aparitii-tv-page">
    <div class="mb-8"><BackButton href="/" label="Acasă" /></div>
    <header class="section-head mx-auto text-center">
      <p class="kicker">Credibilitate</p>
      <h1 class="section-title">Apariții TV — Momente din Emisiuni și Gale</h1>
      <p class="section-copy">Selecție video cu momente din apariții TV, grupate în format card.</p>
    </header>

    <h2 class="mt-8 text-xl font-bold text-white/80">Clipuri video din emisiuni și gale TV</h2>

    <div class="mt-4 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {tvAppearances.map((item, index) => {
        const youtubeId = getYoutubeId(item.videoUrl);

        return (
          <article class="glass-card group h-full transition-all duration-300 hover:-translate-y-1 hover:border-[rgba(245,166,35,0.5)] hover:shadow-[0_20px_45px_rgba(245,166,35,0.16)]">
            {youtubeId ? (
              <YoutubeEmbed youtubeId={youtubeId} title={item.show || `Apariție TV ${index + 1}`} class="rounded-xl" />
            ) : (
              <div class="grid aspect-video w-full place-items-center rounded-xl border border-white/20 bg-white/10 text-xs font-semibold text-white/90">
                Link YouTube invalid
              </div>
            )}

            <p class="mt-3 text-sm font-semibold text-white">Apariție TV #{index + 1}</p>
            <a
              href={sanitizeUrl(item.videoUrl)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-flex items-center rounded-full border border-[rgba(245,166,35,0.3)] bg-[rgba(245,166,35,0.08)] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#FFD166] transition hover:-translate-y-0.5 hover:border-[rgba(245,166,35,0.6)] hover:bg-[rgba(245,166,35,0.15)]"
            >
              Vezi pe YouTube
            </a>
          </article>
        );
      })}
    </div>

    <div id="yt-consent-bottom" class="mt-8 rounded-xl border border-[rgba(245,166,35,0.28)] bg-[rgba(245,166,35,0.08)] p-4 text-center">
      <p class="text-sm text-white/85">
        Pentru redarea clipurilor direct în pagină, acceptă cookie-urile YouTube o singură dată.
      </p>
      <button
        id="yt-consent-bottom-btn"
        type="button"
        class="mt-3 inline-flex items-center rounded-full border border-[rgba(245,166,35,0.45)] bg-[rgba(245,166,35,0.14)] px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#FFD166] transition hover:-translate-y-0.5 hover:border-[rgba(245,166,35,0.7)] hover:bg-[rgba(245,166,35,0.2)]"
      >
        Acceptă cookie-urile YouTube
      </button>
    </div>
  </section>

  <script is:inline>
    (() => {
      const consentWrap = document.getElementById('yt-consent-bottom');
      const consentBtn = document.getElementById('yt-consent-bottom-btn');
      if (!consentWrap || !consentBtn) return;

      const isGranted = () => {
        try {
          return localStorage.getItem('cookie_consent') === 'granted';
        } catch {
          return false;
        }
      };

      const syncVisibility = () => {
        consentWrap.style.display = isGranted() ? 'none' : '';
      };

      consentBtn.addEventListener('click', () => {
        try {
          localStorage.setItem('cookie_consent', 'granted');
        } catch {}
        window.dispatchEvent(new CustomEvent('cookie:granted'));
        syncVisibility();
      });

      window.addEventListener('cookie:granted', syncVisibility);
      syncVisibility();
    })();
  </script>

  <style>
    /* Pe această pagină folosim un singur buton global de consimțământ, la final. */
    .aparitii-tv-page .yt-gate__btn-accept {
      display: none;
    }
  </style>
</BaseLayout>
