---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blogPostsRaw from '../../data/blogPosts.json';
import BackButton from '../../components/BackButton.astro';
import siteContent from '../../data/siteContent.json';

interface ContentBlock {
  type: string;
  text?: string;
  src?: string;
  caption?: string;
  items?: { label: string; href: string }[];
  // CTA block
  label?: string;
  ctaText?: string;
  ctaHref?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
  variant?: 'whatsapp' | 'primary';
}

interface FaqItem {
  q: string;
  a: string;
}

interface Post {
  slug: string;
  category: string;
  categoryAccent: string;
  title: string;
  excerpt: string;
  coverEmoji: string;
  coverImage: string;
  readTime: string;
  date: string;
  author: string;
  content: ContentBlock[];
  faq?: FaqItem[];
}

export const prerender = true;

const allPosts = (blogPostsRaw as any).items as unknown as Post[];

export function getStaticPaths() {
  return ((blogPostsRaw as any).items as unknown as Post[]).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' });

const accentColorMap: Record<string, string> = {
  rose: 'var(--rose)',
  gold: 'var(--gold)',
  teal: 'var(--teal)',
};

const heroBgMap: Record<string, string> = {
  rose: 'rgba(232,50,90,0.42)',
  gold: 'rgba(245,166,35,0.40)',
  teal: 'rgba(11,188,214,0.40)',
};

const accentColor = accentColorMap[post.categoryAccent] ?? 'var(--gold)';
const heroBg = heroBgMap[post.categoryAccent] ?? 'rgba(245,166,35,0.40)';

const prevPost = allPosts[allPosts.findIndex((p) => p.slug === post.slug) - 1];
const nextPost = allPosts[allPosts.findIndex((p) => p.slug === post.slug) + 1];

const siteBase = 'https://www.florentinapanaofficial.ro';
const postCanonical = `${siteBase}/blog/${post.slug}`;
const shareUrlEnc = encodeURIComponent(postCanonical);
const shareTextEnc = encodeURIComponent(post.title);
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${shareUrlEnc}`;
const whatsappShareUrl = `https://wa.me/?text=${shareTextEnc}%20${shareUrlEnc}`;
const postOgImage = post.coverImage?.startsWith('http')
  ? post.coverImage
  : post.coverImage
    ? `${siteBase}${post.coverImage}`
    : `${siteBase}/images/og-default-1200x630.jpg`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: postOgImage,
  url: postCanonical,
  author: { '@type': 'Organization', name: 'Formația Florentina Pană', url: siteBase },
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postCanonical },
  publisher: { '@type': 'Organization', name: siteContent.brand.name, url: siteBase },
};

const faqJsonLd = post.faq && post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;
---

<BaseLayout
  title={`${post.title} | ${siteContent.brand.name}`}
  description={post.excerpt}
  ogImage={postOgImage}
  ogType="article"
  datePublished={post.date}
  dateModified={post.date}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date} />
    <meta property="article:author" content={post.author} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>
  <section class="bp-page">

    {/* ── Hero ── */}
    <div class="bp-hero" style={`--hero-glow: ${heroBg};`}>
      <div class="bp-hero-bg-emoji" aria-hidden="true">{post.coverEmoji}</div>
      <div class="bp-hero-inner">
        <BackButton href="/blog/" label="Noutăți" />
        <span
          class="bp-cat"
          style={`color:${accentColor}; border-color:${accentColor}; background:rgba(0,0,0,0.25);`}
        >
          {post.category}
        </span>
        <h1 class="bp-title">{post.title}</h1>
        <p class="bp-lead">{post.excerpt}</p>
        <div class="bp-meta">
          <span>✍ {post.author}</span>
          <span class="bp-sep" aria-hidden="true">·</span>
          <span>{formatDate(post.date)}</span>
          <span class="bp-sep" aria-hidden="true">·</span>
          <span>{post.readTime} citire</span>
        </div>
      </div>
    </div>

    {/* ── Conținut articol ── */}
    <article class="bp-article" aria-label={post.title}>
      {post.content.map((block) => {
        if (block.type === 'heading') {
          return <h2 class="bp-h2">{block.text}</h2>;
        }
        if (block.type === 'paragraph') {
          return <p class="bp-p">{block.text}</p>;
        }
        if (block.type === 'image') {
          return (
            <figure class="bp-figure">
              {block.src ? (
                <img
                  src={block.src}
                  alt={block.caption || `Ilustrație pentru articolul ${post.title}`}
                  class="bp-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
              ) : (
                <div class="bp-img-placeholder" aria-hidden="true">
                  <span class="bp-img-placeholder-emoji">{post.coverEmoji}</span>
                  <span class="bp-img-placeholder-hint">Adaugă o fotografie în câmpul src</span>
                </div>
              )}
              {block.caption && (
                <figcaption class="bp-figcaption">{block.caption}</figcaption>
              )}
            </figure>
          );
        }
        if (block.type === 'links' && block.items) {
          return (
            <nav class="bp-inline-links" aria-label="Link-uri recomandate">
              {block.items.map((link) => (
                <a href={link.href} class="bp-inline-link">{link.label}</a>
              ))}
            </nav>
          );
        }
        if (block.type === 'cta') {
          const isWhatsApp = block.variant === 'whatsapp';
          return (
            <aside class={`bp-inline-cta${isWhatsApp ? ' bp-inline-cta--wa' : ''}`} role="complementary">
              {block.label && <p class="bp-inline-cta-label">{block.label}</p>}
              {block.text && <p class="bp-inline-cta-text">{block.text}</p>}
              <div class="bp-inline-cta-actions">
                {block.ctaHref && block.ctaText && (
                  <a
                    href={block.ctaHref}
                    class={isWhatsApp ? 'btn-whatsapp' : 'btn-solid'}
                    target={block.ctaHref.startsWith('http') ? '_blank' : undefined}
                    rel={block.ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {isWhatsApp && <span aria-hidden="true" class="btn-whatsapp-icon">💬</span>}
                    {block.ctaText}
                  </a>
                )}
                {block.ctaSecondaryHref && block.ctaSecondaryText && (
                  <a href={block.ctaSecondaryHref} class="btn-outline">{block.ctaSecondaryText}</a>
                )}
              </div>
            </aside>
          );
        }
        return null;
      })}

      {post.faq && post.faq.length > 0 && (
        <section class="bp-faq" aria-labelledby="bp-faq-title">
          <h2 id="bp-faq-title" class="bp-h2">Întrebări frecvente despre prețuri și rezervare</h2>
          <div class="bp-faq-list">
            {post.faq.map((item) => (
              <details class="bp-faq-item">
                <summary class="bp-faq-q">{item.q}</summary>
                <p class="bp-faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </article>

    {/* ── Distribuie articolul ── */}
    <aside class="bp-share" aria-label="Distribuie articolul">
      <p class="bp-share-label">Ți-a plăcut articolul? Distribuie-l:</p>
      <div class="bp-share-actions">
        <a
          href={facebookShareUrl}
          class="bp-share-btn bp-share-btn--fb"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Distribuie pe Facebook: ${post.title}`}
        >
          <svg class="bp-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.87.24-1.46 1.49-1.46H16.6V4.44c-.28-.04-1.22-.12-2.31-.12-2.29 0-3.86 1.4-3.86 3.96V10.5H7.9v3h2.53V21h3.07z"/>
          </svg>
          <span>Facebook</span>
        </a>
        <a
          href={whatsappShareUrl}
          class="bp-share-btn bp-share-btn--wa"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Distribuie pe WhatsApp: ${post.title}`}
        >
          <svg class="bp-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M20.52 3.48A11.78 11.78 0 0 0 12.05 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.4-1.68a11.83 11.83 0 0 0 5.65 1.44h.01c6.54 0 11.84-5.3 11.84-11.85 0-3.17-1.23-6.15-3.38-8.43zM12.05 21.8h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.22-3.8 1 1.02-3.7-.24-.38a9.86 9.86 0 0 1-1.5-5.27c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.13 1.03 7 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.44 9.88-9.86 9.88zm5.4-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.96-.94 1.16c-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.01-1.04 2.47s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </aside>

    {/* ── Navigare între articole ── */}
    {(prevPost || nextPost) && (
      <nav class="bp-nav" aria-label="Navigare articole">
        <div class="bp-nav-inner">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}/`} class="bp-nav-link bp-nav-link--prev">
              <span class="bp-nav-dir">← Anterior</span>
              <span class="bp-nav-post-title">{prevPost.title}</span>
            </a>
          ) : <div></div>}
          {nextPost && (
            <a href={`/blog/${nextPost.slug}/`} class="bp-nav-link bp-nav-link--next">
              <span class="bp-nav-dir">Următor →</span>
              <span class="bp-nav-post-title">{nextPost.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    {/* ── CTA ── */}
    <div class="bp-cta">
      <p class="bp-cta-label">Pregătești un eveniment special?</p>
      <h2 class="bp-cta-title">Contactează-ne pentru o ofertă personalizată</h2>
      <div class="bp-cta-actions">
        <a href="/contact/" class="btn-solid">Solicită ofertă</a>
        <a href="/comunitate/#blog" class="btn-outline">← Blog</a>
      </div>
    </div>

  </section>
</BaseLayout>

<style>
  .bp-page {
    background: var(--bg-deep);
    min-height: 100dvh;
  }

  /* ── Hero ── */
  .bp-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 8rem) 1.5rem clamp(3.5rem, 6vw, 5.5rem);
    background: radial-gradient(ellipse at 50% -10%, var(--hero-glow) 0%, transparent 60%);
  }
  .bp-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--bg-deep) 100%);
    pointer-events: none;
  }
  .bp-hero-bg-emoji {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 5vw;
    font-size: clamp(8rem, 22vw, 16rem);
    opacity: 0.055;
    pointer-events: none;
    user-select: none;
    filter: blur(3px);
  }
  .bp-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin-inline: auto;
  }
  .bp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 160ms ease;
  }
  .bp-back:hover { color: var(--gold); }
  .bp-cat {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
    backdrop-filter: blur(6px);
  }
  .bp-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--title);
    line-height: 1.12;
    margin: 0 0 1rem;
  }
  .bp-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--body);
    margin: 0 0 1.5rem;
    max-width: 58ch;
  }
  .bp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--muted);
  }
  .bp-sep { opacity: 0.4; }

  /* ── Article ── */
  .bp-article {
    max-width: 720px;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 3rem;
  }
  .bp-h2 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 2.5rem 0 0.85rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--line);
  }
  .bp-h2:first-child { margin-top: 0; }
  .bp-p {
    font-size: 1.02rem;
    line-height: 1.82;
    color: var(--body);
    margin: 0 0 1.35rem;
  }
  .bp-figure {
    margin: 2.5rem 0;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .bp-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .bp-img-placeholder {
    aspect-ratio: 16/9;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .bp-img-placeholder-emoji { font-size: 3.5rem; opacity: 0.3; }
  .bp-img-placeholder-hint {
    font-size: 0.78rem;
    color: var(--muted);
    font-style: italic;
  }
  .bp-figcaption {
    padding: 0.7rem 1.1rem;
    font-size: 0.84rem;
    color: var(--muted);
    font-style: italic;
    background: var(--surface);
    border-top: 1px solid var(--line);
    margin: 0;
  }

  /* ── Distribuie ── */
  .bp-share {
    max-width: 720px;
    margin: 0 auto 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    text-align: center;
  }
  .bp-share-label {
    margin: 0 0 0.9rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--body);
    letter-spacing: 0.02em;
  }
  .bp-share-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .bp-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.3rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    color: #fff;
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
  }
  .bp-share-btn:hover,
  .bp-share-btn:focus-visible {
    transform: translateY(-2px);
    filter: brightness(1.08);
    box-shadow: 0 8px 22px rgba(0,0,0,0.35);
  }
  .bp-share-btn--fb { background: #1877F2; }
  .bp-share-btn--wa { background: #25D366; }
  .bp-share-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  /* ── Nav articole ── */
  .bp-nav {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .bp-nav-inner {
    max-width: 720px;
    margin-inline: auto;
    padding: 1.75rem 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .bp-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 240px;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .bp-nav-link--next { text-align: right; }
  .bp-nav-dir {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bp-nav-post-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--title);
    line-height: 1.3;
    transition: color 160ms ease;
  }
  .bp-nav-link:hover .bp-nav-post-title { color: var(--gold); }
  .bp-nav-link:hover .bp-nav-dir { color: var(--gold); }

  /* ── Inline links block ── */
  .bp-inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
  }
  .bp-inline-link {
    font-family: 'Oswald', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--gold, #f5a623);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 166, 35, 0.3);
    padding-bottom: 1px;
    transition: border-color 0.2s, opacity 0.2s;
  }
  .bp-inline-link:hover {
    border-bottom-color: var(--gold, #f5a623);
    opacity: 0.8;
  }

  /* ── CTA ── */
  .bp-cta {
    max-width: 720px;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 5rem;
    text-align: center;
  }
  .bp-cta-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .bp-cta-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--title);
    margin: 0 0 1.75rem;
  }
  .bp-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  /* ── Inline CTA (WhatsApp / primary) ── */
  .bp-inline-cta {
    margin: 2.25rem auto;
    max-width: 720px;
    padding: 1.75rem 1.5rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(245,166,35,0.10), rgba(232,50,90,0.08));
    border: 1px solid rgba(245,166,35,0.35);
    text-align: center;
  }
  .bp-inline-cta--wa {
    background: linear-gradient(135deg, rgba(37,211,102,0.14), rgba(18,140,126,0.10));
    border-color: rgba(37,211,102,0.45);
  }
  .bp-inline-cta-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.45rem;
  }
  .bp-inline-cta-text {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 600;
    color: var(--title);
    margin: 0 0 1.25rem;
    line-height: 1.35;
  }
  .bp-inline-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.6rem;
    border-radius: 9999px;
    background: #25D366;
    color: #0a2a18;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(37,211,102,0.35);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .btn-whatsapp:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(37,211,102,0.45);
  }
  .btn-whatsapp-icon { font-size: 1.15rem; line-height: 1; }

  /* ── FAQ ── */
  .bp-faq {
    max-width: 720px;
    margin: 3rem auto 1rem;
    padding-inline: 1.5rem;
