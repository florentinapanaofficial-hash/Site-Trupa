---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import couplesData from '../data/couples.json';
import CoupleCard from '../components/CoupleCard.astro';
import BackButton from '../components/BackButton.astro';

export const prerender = true;

const { brand, seo, contact } = siteContent;
const couples = couplesData.couples;
const whatsappNumber = contact.phoneRaw.replace(/\D/g, '');

const pageTitle = `Mirii Noștri — Comunitate | ${brand.name}`;
const pageDescription = `Descoperă poveștile de dragoste ale cuplurilor care ne-au ales. ${couples.length} perechi fericite — recenzii, galerie foto și dansul mirilor. ${brand.name} — Pitești, Argeș.`;

const SITE = 'https://www.florentinapanaofficial.ro';
const pageUrl = `${SITE}/comunitatea-noastra`;

/* ─── JSON-LD: CollectionPage ─────────────────────────────── */
const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  inLanguage: 'ro',
  isPartOf: { '@type': 'WebSite', url: SITE },
  publisher: {
    '@type': 'MusicGroup',
    name: brand.name,
    url: SITE,
  },
};

/* ─── JSON-LD: AggregateRating ─────────────── */
const aggregateRatingLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand.name,
  image: `${SITE}${seo.ogImage}`,
  url: SITE,
  telephone: contact.phoneRaw,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pitești',
    addressRegion: 'Argeș',
    addressCountry: 'RO',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
    reviewCount: String(couples.length),
  },
  review: couples.slice(0, 5).map((c) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: c.names },
    datePublished: c.isoDate,
    reviewBody: c.recommendation,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  })),
};

const schemas = [collectionPageLd, aggregateRatingLd];
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={seo.ogImage}>
  <Fragment slot="head">
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <section class="section-container pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mb-6"><BackButton href="/" label="Acasă" /></div>

    <!-- ═══ HERO ═══════════════════════════════════════════════════ -->
    <header class="community-hero mx-auto text-center mb-10">
      <p class="community-hero__kicker">Formația Florentina Pană</p>
      <h1 class="community-hero__title">Mirii Noștri</h1>
      <p class="community-hero__subtitle">
        Fiecare nuntă e o poveste unică. Iată cuplurile care ne-au încredințat cele mai frumoase momente din viața lor.
      </p>
      <div class="community-hero__stats">
        <span class="community-hero__stat">💍 {couples.length} cupluri fericite</span>
        <span class="community-hero__stat">⭐ 5.0 rating</span>
      </div>
    </header>

    <!-- ═══ SEARCH BAR ═════════════════════════════════════════════ -->
    <div class="community-search" role="search">
      <label for="coupleSearch" class="sr-only">Caută pereche de miri</label>
      <div class="community-search__wrap">
        <svg class="community-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="search"
          id="coupleSearch"
          class="community-search__input"
          placeholder="Caută după numele mirilor, oraș sau dată..."
          autocomplete="off"
        />
        <span class="community-search__count" id="searchCount">{couples.length} rezultate</span>
      </div>
    </div>

    <!-- ═══ GRID CARDURI MIRI ══════════════════════════════════════ -->
    <div class="couples-grid" id="couplesGrid">
      {couples.map((couple) => (
        <div
          class="couples-grid__item"
          data-couple-name={couple.names.toLowerCase()}
          data-couple-city={couple.city.toLowerCase()}
          data-couple-date={couple.date.toLowerCase()}
        >
          <CoupleCard
            slug={couple.slug}
            names={couple.names}
            city={couple.city}
            date={couple.date}
            coverPhoto={couple.coverPhoto}
            accentColor={couple.accentColor}
            accentGlow={couple.accentGlow}
          />
        </div>
      ))}
    </div>

    <!-- ═══ EMPTY STATE (hidden by default) ════════════════════════ -->
    <div class="couples-empty" id="couplesEmpty" hidden>
      <p>😔 Nicio pereche nu corespunde căutării tale.</p>
      <p class="couples-empty__hint">Încearcă alt nume, oraș sau dată.</p>
    </div>

    <!-- ═══ LINK PUBLICAȚII ═════════════════════════════════════════ -->
    <div class="community-links">
      <a href="/publicatii" class="community-link">
        <span class="community-link__icon">📰</span>
        <span class="community-link__text">
          <strong>Publicații</strong>
          <small>Articole, povești de nuntă și ghiduri utile</small>
        </span>
        <span class="community-link__arrow" aria-hidden="true">→</span>
      </a>
      <a href="/vlog" class="community-link">
        <span class="community-link__icon">🎬</span>
        <span class="community-link__text">
          <strong>Vlog</strong>
          <small>Din culisele evenimentelor noastre</small>
        </span>
        <span class="community-link__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- ═══ CTA BANNER ═════════════════════════════════════════════ -->
    <div class="ctab-wrap mx-auto mt-14 max-w-3xl">
      <p class="ctab-kicker">Sezonul 2026–2027</p>
      <h2 class="ctab-title">Vrei să faci parte din familia noastră?</h2>
      <p class="ctab-sub">Locurile se ocupă rapid. Contactează-ne acum și asigură-ți data dorită.</p>
      <div class="ctab-actions">
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Bună! Vreau să rezerv o dată pentru evenimentul meu cu Formația Florentina Pană.')}`}
          class="ctab-btn ctab-btn--wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Scrie pe WhatsApp
        </a>
        <a href="/contact" class="ctab-btn ctab-btn--outline">Formular contact →</a>
      </div>
    </div>
  </section>

  <!-- ═══ SEARCH SCRIPT ════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      var searchInput = document.getElementById('coupleSearch');
      var grid = document.getElementById('couplesGrid');
      var emptyState = document.getElementById('couplesEmpty');
      var countEl = document.getElementById('searchCount');

      if (!searchInput || !grid) return;

      var items = Array.from(grid.querySelectorAll('.couples-grid__item'));
      var totalCount = items.length;

      searchInput.addEventListener('input', function () {
        var query = this.value.trim().toLowerCase();
        var visibleCount = 0;

        items.forEach(function (item) {
          var name = item.getAttribute('data-couple-name') || '';
          var city = item.getAttribute('data-couple-city') || '';
          var date = item.getAttribute('data-couple-date') || '';
          var haystack = name + ' ' + city + ' ' + date;

          var match = !query || haystack.indexOf(query) !== -1;
          item.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });

        if (emptyState) {
          emptyState.hidden = visibleCount > 0;
        }
        if (countEl) {
          countEl.textContent = query
            ? visibleCount + ' din ' + totalCount + ' rezultate'
            : totalCount + ' rezultate';
        }
      });
    })();
  </script>

  <!-- ═══ ENTRANCE ANIMATION ═══════════════════════════════════════ -->
  <script is:inline>
    (function () {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );

      document.querySelectorAll('.couples-grid__item').forEach(function (el, i) {
        el.style.setProperty('--delay', i * 80 + 'ms');
        observer.observe(el);
      });
    })();
  </script>

  <!-- ═══ STYLES ═══════════════════════════════════════════════════ -->
  <style>
    /* ═══ HERO ═══ */
    .community-hero__kicker {
      font-family: 'Oswald', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      margin: 0 0 0.6rem;
    }

    .community-hero__title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 700;
      color: var(--title, #fff8ee);
      margin: 0 0 0.75rem;
      line-height: 1.15;
    }

    .community-hero__subtitle {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 1.25rem;
      line-height: 1.6;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }

    .community-hero__stats {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .community-hero__stat {
      font-size: 0.85rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.7);
      letter-spacing: 0.02em;
    }

    /* ═══ SEARCH ═══ */
    .community-search {
      max-width: 540px;
      margin: 0 auto 2.5rem;
    }

    .community-search__wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .community-search__icon {
      position: absolute;
      left: 1rem;
      color: rgba(255, 255, 255, 0.4);
      pointer-events: none;
      flex-shrink: 0;
    }

    .community-search__input {
      width: 100%;
      padding: 0.85rem 1rem 0.85rem 2.75rem;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.25s, background 0.25s;
    }

    .community-search__input::placeholder {
      color: rgba(255, 255, 255, 0.35);
    }

    .community-search__input:focus {
      border-color: var(--gold);
      background: rgba(255, 255, 255, 0.08);
    }

    .community-search__count {
      position: absolute;
      right: 1rem;
      font-size: 0.72rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.4);
      pointer-events: none;
      white-space: nowrap;
    }

    /* ═══ COUPLES GRID ═══ */
    .couples-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 72rem;
      margin: 0 auto 3rem;
    }

    @media (min-width: 640px) {
      .couples-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .couples-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* Entrance animation */
    .couples-grid__item {
      opacity: 0;
      transform: translateY(24px);
    }

    .couples-grid__item.is-visible {
      animation: coupleCardIn 500ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
      animation-delay: var(--delay, 0ms);
    }

    @keyframes coupleCardIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ═══ EMPTY STATE ═══ */
    .couples-empty {
      text-align: center;
      padding: 2.5rem 1rem;
      color: rgba(255, 255, 255, 0.6);
      max-width: 72rem;
      margin: 0 auto;
    }

    .couples-empty p {
      margin: 0 0 0.4rem;
      font-size: 1rem;
    }

    .couples-empty__hint {
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.4);
    }

    /* ═══ LINK PUBLICAȚII ═══ */
    .community-links {
      max-width: 540px;
      margin: 0 auto 2rem;
    }

    .community-link {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.04);
      text-decoration: none;
      color: inherit;
      transition: all 0.25s ease;
    }

    .community-link:hover {
      border-color: var(--gold);
      background: rgba(255, 255, 255, 0.07);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(245, 166, 35, 0.1);
    }

    .community-link__icon {
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .community-link__text {
      flex: 1;
      min-width: 0;
    }

    .community-link__text strong {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--gold);
      margin-bottom: 0.15rem;
    }

    .community-link__text small {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.5);
    }

    .community-link__arrow {
      font-size: 1.25rem;
      color: var(--gold);
      opacity: 0;
      transform: translateX(-4px);
      transition: all 0.25s;
    }

    .community-link:hover .community-link__arrow {
      opacity: 1;
      transform: translateX(0);
    }

    /* ═══ CTA BANNER ═══ */
    .ctab-wrap {
      border-radius: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: radial-gradient(ellipse at 50% 0%, rgba(245, 166, 35, 0.12) 0%, rgba(18, 10, 39, 0.92) 65%);
      padding: 2.5rem 1.5rem;
      text-align: center;
      box-shadow: 0 20px 56px rgba(8, 9, 18, 0.52);
    }

    .ctab-kicker {
      font-family: 'Oswald', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      margin: 0 0 0.6rem;
    }

    .ctab-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.5rem, 4vw, 2.1rem);
      font-weight: 700;
      color: var(--title);
      margin: 0 0 0.75rem;
      line-height: 1.2;
    }

    .ctab-sub {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 1.5rem;
      line-height: 1.6;
    }

    .ctab-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
    }

    .ctab-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-decoration: none;
      min-height: 48px;
      transition: transform 160ms ease, filter 160ms ease, box-shadow 160ms ease;
    }

    .ctab-btn:hover {
      transform: translateY(-2px);
    }

    .ctab-btn--wa {
      background: linear-gradient(135deg, #2fdc81 0%, #1cbf6a 100%);
      color: #062315;
      border: 1px solid rgba(122, 255, 181, 0.55);
      box-shadow: 0 8px 24px rgba(28, 191, 106, 0.3);
    }

    .ctab-btn--wa:hover {
      filter: brightness(1.06) saturate(1.08);
      box-shadow: 0 12px 32px rgba(28, 191, 106, 0.45);
    }

    .ctab-btn--outline {
      background: rgba(255, 255, 255, 0.06);
      color: rgba(235, 245, 255, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .ctab-btn--outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.4);
    }

    /* ═══ MOBILE ═══ */
    @media (max-width: 639px) {
      .community-search__count {
        display: none;
      }

      .community-search__input {
        font-size: 0.85rem;
        padding-right: 1rem;
      }
    }

    /* ═══ SR-ONLY ═══ */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</BaseLayout>
