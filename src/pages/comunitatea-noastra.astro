---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import BackButton from '../components/BackButton.astro';
import blogPosts from '../data/blogPosts.json';
import { query as dbQuery } from '../lib/db.js';

export const prerender = false;

const { brand, seo, contact, realMoments } = siteContent;

const whatsappNumber = contact.phoneRaw.replace(/\D/g, '');

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('ro-RO', { day: 'numeric', month: 'short', year: 'numeric' });

const accentBgMap: Record<string, string> = {
  rose: 'rgba(232,50,90,0.22)',
  gold: 'rgba(245,166,35,0.22)',
  teal: 'rgba(11,188,214,0.2)',
};
const accentColorMap: Record<string, string> = {
  rose: 'var(--rose)',
  gold: 'var(--gold)',
  teal: 'var(--teal)',
};

let galleryPhotos: Array<{
  id: number;
  titlu: string;
  imagine_url: string;
  data_upload: string;
}> = [];

try {
  const rows = (await dbQuery(
    `SELECT id, titlu, imagine_url, data_upload
     FROM gallery
     WHERE imagine_url LIKE '/uploads/%'
     ORDER BY data_upload DESC`,
  )) as Array<{ id: number; titlu: string; imagine_url: string; data_upload: string }>;

  galleryPhotos = rows.filter((row) => typeof row.imagine_url === 'string' && row.imagine_url.startsWith('/uploads/'));
} catch (error) {
  console.error('Nu s-a putut citi galeria foto din DB:', error);
}

const heroCards = [
  {
    emoji: '💍',
    title: 'Momente cu mirii',
    href: '/momente-cu-mirii',
    image: '/images/Galerie Foto Site/Card 1 panoramica.jpg',
    accent: 'rose',
    description: 'Pășește în albumul mirilor noștri — galerie interactivă cu fotografii de la dansul mirilor, intrarea în sală și cele mai emoționante momente de la nuntă.',
  },
  {
    emoji: '💬',
    title: 'Cuvintele lor valorează mai mult',
    href: '#testimoniale',
    image: '/images/Galerie Foto Site/Galerie Foto Claudiu & Florentina Pană 3.jpg',
    accent: 'gold',
    description: 'Ce spun mirii despre noi? Recenzii autentice de la cuplurile Andreea & Radu, Bianca & Mihai, Elena & Alexandru și alți miri care ne-au ales.',
  },
  {
    emoji: '📸',
    title: 'Galerie Foto Comunitate',
    href: '#galerie-foto',
    image: '/images/Galerie Foto Site/Galerie Foto Claudiu & Florentina Pană 5.jpg',
    accent: 'violet',
    description: 'Fotografii de la nunțile comunității noastre — ringul de dans plin, mirii fericiți, invitații în hora tradițională și atmosfera de la fiecare eveniment.',
  },
  {
    emoji: '📰',
    title: 'Publicații & Vlog',
    href: '#publicatii',
    image: '/images/Galerie Foto Site/Galerie Foto Claudiu & Florentina Pană 7.jpg',
    accent: 'teal',
    description: 'Ghiduri pentru miri — cum alegi formația perfectă, ce piese pentru dansul mirilor, sfaturi de repertoriu și povești din culise.',
  },
];

const pageTitle = `Comunitatea Noastră — Recenzii Nuntă Pitești | ${brand.name}`;
const pageDescription = 'Comunitatea Formației Florentina Pană — recenzii reale de la nunți în Pitești și Argeș, galerie foto comunitate și publicații. Descoperă poveștile cuplurilor!';

const SITE = 'https://www.florentinapanaofficial.ro';
const pageUrl = `${SITE}/comunitatea-noastra`;

/* ─── JSON-LD: CollectionPage ─────────────────────────────── */
const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  inLanguage: 'ro',
  isPartOf: { '@type': 'WebSite', url: SITE },
  publisher: {
    '@type': 'MusicGroup',
    name: brand.name,
    url: SITE,
  },
};

/* ─── JSON-LD: ItemList (hero cards) ──────────────────────── */
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Secțiuni comunitate',
  numberOfItems: heroCards.length,
  itemListElement: heroCards.map((card, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: card.title,
    description: card.description,
    url: card.href.startsWith('#') ? `${pageUrl}${card.href}` : `${SITE}${card.href}`,
    image: `${SITE}${card.image}`,
  })),
};

/* ─── JSON-LD: AggregateRating (testimoniale) ─────────────── */
const reviewCount = realMoments.events.length;
const aggregateRatingLd = reviewCount > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand.name,
  image: `${SITE}${seo.ogImage}`,
  url: SITE,
  telephone: contact.phoneRaw,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pitești',
    addressRegion: 'Argeș',
    addressCountry: 'RO',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
    reviewCount: String(reviewCount),
  },
  review: realMoments.events.slice(0, 5).map((ev: any) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: ev.couple },
    datePublished: ev.date,
    reviewBody: ev.coupleQuote,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  })),
} : null;

const schemas = [collectionPageLd, itemListLd, aggregateRatingLd].filter(Boolean);
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={seo.ogImage}>
  <Fragment slot="head">
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>
  <section class="section-container pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mb-6"><BackButton href="/" label="Acasă" /></div>

    <header class="section-head mx-auto text-center mb-10">
      <p class="kicker">Formația Florentina Pană</p>
      <h1 class="section-title">Comunitatea Formației Florentina Pană</h1>
      <p class="section-copy">
        Fiecare nuntă e o poveste unică. Iată ce spun cuplurile care ne-au încredințat cele mai frumoase momente din viața lor.
      </p>
    </header>

    <!-- ═══ HERO CARDS — GRID 2×2 ═══════════════════════════════════ -->
    <div class="chero-grid">
      {heroCards.map((card, i) => (
        <a
          href={card.href}
          class={`chero-card chero-card--${card.accent}`}
          style={`--delay:${i * 120}ms`}
        >
          <img
            src={card.image}
            alt={card.title}
            class="chero-card__img"
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
            width="640"
            height="480"
          />
          <div class="chero-card__overlay" aria-hidden="true"></div>
          <div class="chero-card__body">
            <span class="chero-card__emoji">{card.emoji}</span>
            <h2 class="chero-card__title">{card.title}</h2>
          </div>
          <button
            type="button"
            class="chero-card__info"
            data-info-btn
            aria-label={`Informații: ${card.title}`}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </button>
          <div class="chero-card__tooltip" role="tooltip">
            <p>{card.description}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- ═══ SECȚIUNILE DE CONȚINUT ══════════════════════════════════ -->

    <!-- ─── SECȚIUNEA 1 — Testimoniale ─────────────────────────────── -->
    <section id="testimoniale" class="csection">
      <div class="csection__head">
        <span class="csection__icon">💬</span>
        <h2 class="csection__title">Cuvintele lor valorează mai mult</h2>
        <span class="csection__badge">{realMoments.events.length} recenzii</span>
      </div>
      <div class="testimonials-grid">
        {realMoments.events.map((event) => {
          const accentColor = (event as any).accentColor ?? '#f5a623';
          const blogSlug = (event as any).blogSlug ?? '';
          const initials = event.couple.split('&').map((n: string) => n.trim()[0] ?? '').join('');
          return (
            <article class="testimonial-card" style={`--tc:${accentColor}`}>
              <div class="tc-stars" aria-label="5 stele din 5">★★★★★</div>
              <blockquote class="tc-quote">{event.coupleQuote}</blockquote>
              <footer class="tc-footer">
                <div class="tc-avatar" aria-hidden="true">{initials}</div>
                <div class="tc-meta">
                  <p class="tc-name">{event.couple}</p>
                  <p class="tc-location">{event.city} &bull; {event.date}</p>
                </div>
                {blogSlug && (
                  <a class="tc-blog-link" href={`/blog/${blogSlug}`}>Povestea lor →</a>
                )}
              </footer>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ─── SECȚIUNEA 2 — Galerie Foto Comunitate ──────────────────── -->
    <section id="galerie-foto" class="csection">
      <div class="csection__head">
        <span class="csection__icon">📸</span>
        <h2 class="csection__title">Galerie Foto Comunitate</h2>
        <span class="csection__badge">{galleryPhotos.length} imagini</span>
      </div>
      {galleryPhotos.length > 0 ? (
        <div class="community-gallery-grid" data-db-gallery-grid>
          {galleryPhotos.map((photo) => (
            <article class="community-gallery-item" aria-label={photo.titlu}>
              <img src={photo.imagine_url} alt={photo.titlu} loading="lazy" decoding="async" width="640" height="480" />
              <div class="community-gallery-meta">
                <p class="community-gallery-title">{photo.titlu}</p>
                <p class="community-gallery-date">{new Date(photo.data_upload).toLocaleDateString('ro-RO')}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="csection__empty">
          <p>Nu există poze în galerie momentan.</p>
          <p class="csection__empty-sub">Reveniți curând — adăugăm mereu momente noi! 📷</p>
        </div>
      )}
    </section>

    <!-- ─── SECȚIUNEA 3 — Publicații & Vlog ─────────────────────────── -->
    <section id="publicatii" class="csection">
      <div class="csection__head">
        <span class="csection__icon">📰</span>
        <h2 class="csection__title">Publicații & Vlog</h2>
        <span class="csection__badge">{((blogPosts as any).items as any[]).length} articole</span>
      </div>
      <p class="blog-aside-sub">Muzică, culise și ghiduri utile — scrise de noi, pentru tine.</p>
      <div class="blog-list">
        {((blogPosts as any).items as any[]).map((post) => {
          const bg = accentBgMap[post.categoryAccent] ?? 'rgba(245,166,35,0.22)';
          const color = accentColorMap[post.categoryAccent] ?? 'var(--gold)';
          return (
            <a href={`/blog/${post.slug}`} class="blog-card">
              <div
                class="blog-card-thumb"
                aria-hidden="true"
                style={`background: radial-gradient(ellipse at 50% 50%, ${bg} 0%, var(--bg-mid) 100%);`}
              >
                <span>{post.coverEmoji}</span>
              </div>
              <div class="blog-card-text">
                <div class="blog-card-top">
                  <span
                    class="blog-cat-pill"
                    style={`color:${color}; border-color:${color}; background:${bg};`}
                  >
                    {post.category}
                  </span>
                  <span class="blog-card-time">{post.readTime}</span>
                </div>
                <p class="blog-card-title">{post.title}</p>
                <p class="blog-card-excerpt">{post.excerpt}</p>
                <span class="blog-card-date">{formatDate(post.date)}</span>
              </div>
            </a>
          );
        })}
      </div>
      <a href={`/blog/${((blogPosts as any).items as any[])[0]?.slug ?? ''}`} class="blog-aside-cta">
        Citește ultimul articol
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </section>

    <!-- ─── CTA rezervare ────────────────────────────────────────────── -->
    <div class="ctab-wrap mx-auto mt-14 max-w-3xl">
      <p class="ctab-kicker">Sezonul 2026–2027</p>
      <h2 class="ctab-title">Vrei să faci parte din familia noastră?</h2>
      <p class="ctab-sub">Locurile se ocupă rapid. Contactează-ne acum și asigură-ți data dorită.</p>
      <div class="ctab-actions">
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Bună! Vreau să rezerv o dată pentru evenimentul meu cu Formația Florentina Pană.')}`}
          class="ctab-btn ctab-btn--wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Scrie pe WhatsApp
        </a>
        <a href="/contact" class="ctab-btn ctab-btn--outline">Formular contact →</a>
      </div>
    </div>
  </section>

  <!-- ═══ SCRIPT ═══════════════════════════════════════════════════ -->
  <script is:inline>
    /* ── Info tooltip toggle ── */
    var hoverTimers = new WeakMap();
    var autoCloseTimers = new WeakMap();
    var isTouch = 'ontouchstart' in window;

    function closeAllTooltips() {
      document.querySelectorAll('.chero-card__tooltip.is-visible').forEach(function (t) {
        t.classList.remove('is-visible');
        var card = t.closest('.chero-card');
        if (card) clearTimeout(autoCloseTimers.get(card));
      });
    }

    function showTooltip(card) {
      var tooltip = card.querySelector('.chero-card__tooltip');
      if (!tooltip || tooltip.classList.contains('is-visible')) return;
      closeAllTooltips();
      tooltip.classList.add('is-visible');
      /* Auto-close după 4s */
      clearTimeout(autoCloseTimers.get(card));
      autoCloseTimers.set(card, setTimeout(function () {
        tooltip.classList.remove('is-visible');
      }, 4000));
    }

    /* Click pe butonul ℹ (mobil + desktop) */
    document.querySelectorAll('[data-info-btn]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var card = btn.closest('.chero-card');
        if (!card) return;
        var tooltip = card.querySelector('.chero-card__tooltip');
        if (!tooltip) return;
        var isOpen = tooltip.classList.contains('is-visible');
        closeAllTooltips();
        if (!isOpen) showTooltip(card);
      });
    });

    /* Desktop hover — apare după 1.5s, dispare la mouseleave */
    if (!isTouch) {
      document.querySelectorAll('.chero-card').forEach(function (card) {
        card.addEventListener('mouseenter', function () {
          clearTimeout(hoverTimers.get(card));
          hoverTimers.set(card, setTimeout(function () {
            showTooltip(card);
          }, 1500));
        });
        card.addEventListener('mouseleave', function () {
          clearTimeout(hoverTimers.get(card));
          var tooltip = card.querySelector('.chero-card__tooltip');
          if (tooltip) {
            tooltip.classList.remove('is-visible');
            clearTimeout(autoCloseTimers.get(card));
          }
        });
      });
    }

    /* ── Close tooltips on outside click ── */
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-info-btn]') && !e.target.closest('.chero-card__tooltip')) {
        closeAllTooltips();
      }
    });

    /* ── Smooth scroll for anchor cards ── */
    document.querySelectorAll('.chero-card[href^="#"]').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.target.closest('[data-info-btn]') || e.target.closest('.chero-card__tooltip')) return;
        var targetId = card.getAttribute('href');
        if (!targetId) return;
        var target = document.querySelector(targetId);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    /* ── Staggered entrance animation via IntersectionObserver ── */
    var entranceObserver = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            entranceObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll('.chero-card, .csection').forEach(function (el) {
      entranceObserver.observe(el);
    });
  </script>

  <!-- ═══ STYLES ═══════════════════════════════════════════════════ -->
  <style>
    /* ═══ HERO CARDS GRID ═══ */
    .chero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 72rem;
      margin: 0 auto 3.5rem;
    }

    @media (min-width: 640px) {
      .chero-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
    }

    /* ─── Card base ─── */
    .chero-card {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      aspect-ratio: 3 / 4;
      border-radius: 1.5rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 12px 40px rgba(8, 9, 18, 0.5);
      transition:
        transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 280ms ease,
        border-color 280ms ease;
      opacity: 0;
      transform: translateY(30px);
    }

    .chero-card.is-visible {
      animation: cheroEntrance 600ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
      animation-delay: var(--delay, 0ms);
    }

    @keyframes cheroEntrance {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (min-width: 640px) {
      .chero-card {
        aspect-ratio: 4 / 5;
      }
    }

    @media (min-width: 1024px) {
      .chero-card {
        aspect-ratio: 5 / 4;
      }
    }

    .chero-card:hover {
      transform: translateY(-6px) scale(1.02);
      border-color: rgba(255, 255, 255, 0.25);
    }

    /* ─── Accent hover glows ─── */
    .chero-card--rose:hover {
      box-shadow:
        0 0 0 1px rgba(232, 50, 90, 0.3) inset,
        0 20px 50px rgba(232, 50, 90, 0.25),
        0 0 80px rgba(232, 50, 90, 0.15);
      border-color: rgba(232, 50, 90, 0.5);
    }

    .chero-card--gold:hover {
      box-shadow:
        0 0 0 1px rgba(245, 166, 35, 0.3) inset,
        0 20px 50px rgba(245, 166, 35, 0.25),
        0 0 80px rgba(245, 166, 35, 0.15);
      border-color: rgba(245, 166, 35, 0.5);
    }

    .chero-card--violet:hover {
      box-shadow:
        0 0 0 1px rgba(187, 134, 252, 0.3) inset,
        0 20px 50px rgba(187, 134, 252, 0.25),
        0 0 80px rgba(187, 134, 252, 0.15);
      border-color: rgba(187, 134, 252, 0.5);
    }

    .chero-card--teal:hover {
      box-shadow:
        0 0 0 1px rgba(11, 188, 214, 0.3) inset,
        0 20px 50px rgba(11, 188, 214, 0.25),
        0 0 80px rgba(11, 188, 214, 0.15);
      border-color: rgba(11, 188, 214, 0.5);
    }

    /* ─── Card image ─── */
    .chero-card__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      transition: transform 400ms ease;
    }

    .chero-card:hover .chero-card__img {
      transform: scale(1.08);
    }

    /* ─── Overlay gradients per accent ─── */
    .chero-card__overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      transition: opacity 300ms ease;
    }

    .chero-card--rose .chero-card__overlay {
      background: linear-gradient(
        to top,
        rgba(180, 30, 70, 0.85) 0%,
        rgba(120, 20, 55, 0.52) 40%,
        rgba(18, 10, 39, 0.3) 100%
      );
    }

    .chero-card--gold .chero-card__overlay {
      background: linear-gradient(
        to top,
        rgba(200, 130, 20, 0.85) 0%,
        rgba(140, 80, 10, 0.5) 40%,
        rgba(18, 10, 39, 0.3) 100%
      );
    }

    .chero-card--violet .chero-card__overlay {
      background: linear-gradient(
        to top,
        rgba(140, 90, 210, 0.85) 0%,
        rgba(100, 60, 160, 0.5) 40%,
        rgba(18, 10, 39, 0.3) 100%
      );
    }

    .chero-card--teal .chero-card__overlay {
      background: linear-gradient(
        to top,
        rgba(8, 150, 175, 0.85) 0%,
        rgba(5, 100, 120, 0.5) 40%,
        rgba(18, 10, 39, 0.3) 100%
      );
    }

    /* ─── Card body (emoji + title) ─── */
