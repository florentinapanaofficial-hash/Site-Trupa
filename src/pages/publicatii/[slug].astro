---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackButton from '../../components/BackButton.astro';
import siteContent from '../../data/siteContent.json';

export const prerender = true;

export async function getStaticPaths() {
  const localEntries = await getCollection('publicatii');
  const localPaths = localEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { type: 'local', item: entry },
  }));

  const supabaseUrl = import.meta.env.SUPABASE_URL || import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  let dbArticles = [];
  if (supabaseUrl && supabaseAnonKey) {
    const url = `${supabaseUrl}/rest/v1/articole_publicatii?select=slug,titlu,continut,created_at`;
    const response = await fetch(url, {
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${supabaseAnonKey}`,
      },
    });

    if (!response.ok) {
      console.log('Eroare Supabase REST:', response.status, response.statusText);
    } else {
      const payload = await response.json();
      dbArticles = Array.isArray(payload) ? payload : [];
    }
  }

  console.log("Articole găsite în DB:", dbArticles?.length || 0);

  const supabasePaths = dbArticles?.map((articol) => ({
    params: { slug: articol.slug },
    props: { type: 'supabase', item: articol },
  })) || [];

  return [...localPaths, ...supabasePaths];
}

const { type, item } = Astro.props;
const { brand } = siteContent;

let pageTitle = '';
let pageDescription = '';
let publishedDate = '';
let category = '';
let ogImage = '';
let ContentComponent = null;

if (type === 'local') {
  pageTitle = `${item.data.titlu} | Publicații | ${brand.name}`;
  pageDescription = item.data.descriere;
  ogImage = item.data.imaginePrincipala;
  category = item.data.categorie;
  publishedDate = item.data.dataPublicarii.toLocaleDateString('ro-RO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
  const rendered = await item.render();
  ContentComponent = rendered.Content;
} else {
  pageTitle = `${item.titlu} | Publicații | ${brand.name}`;
  pageDescription = item.titlu; 
  category = "Noutăți";
  publishedDate = new Date(item.created_at || Date.now()).toLocaleDateString('ro-RO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <article class="pub-article">
    <div class="section-container pt-8 pb-4 sm:pt-10">
      <div class="mb-6"><BackButton href="/publicatii/" label="Toate publicațiile" /></div>
    </div>

    <header class="pub-article__hero section-container">
      <p class="pub-article__meta">{category} • {publishedDate}</p>
      <h1 class="pub-article__title">{type === 'local' ? item.data.titlu : item.titlu}</h1>
      
      {type === 'local' && <p class="pub-article__description">{item.data.descriere}</p>}
      
      {type === 'local' && item.data.imaginePrincipala && (
        <div class="pub-article__image-wrap">
          <img
            src={item.data.imaginePrincipala}
            alt={item.data.titlu}
            class="pub-article__image"
            loading="eager"
            decoding="async"
            width="1600"
            height="900"
          />
        </div>
      )}
    </header>

    <div class="section-container">
      <div class="pub-article__content prose-shell">
        {type === 'local' && ContentComponent ? (
          <ContentComponent />
        ) : (
          <div set:html={item.continut} />
        )}
      </div>
    </div>
  </article>

  <style>
    .pub-article {
      padding-bottom: 4rem;
    }

    .pub-article__hero {
      max-width: 58rem;
      margin: 0 auto 2rem;
      text-align: center;
    }

    .pub-article__meta {
      margin: 0;
      font-family: 'Oswald', sans-serif;
      color: #f2cc7f;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.8rem;
    }

    .pub-article__title {
      margin: 0.8rem 0 0;
      font-size: clamp(2.4rem, 6vw, 4.3rem);
      color: #fff9ef;
    }

    .pub-article__description {
      margin: 1rem auto 0;
      max-width: 44rem;
      color: rgba(255, 255, 255, 0.72);
      font-size: 1.02rem;
    }

    .pub-article__image-wrap {
      margin-top: 1.8rem;
      overflow: hidden;
      border-radius: 1.6rem;
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: 0 22px 48px rgba(0, 0, 0, 0.3);
    }

    .pub-article__image {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    .pub-article__content {
      max-width: 50rem;
      margin: 0 auto;
      padding: 2rem clamp(1.1rem, 3vw, 2rem);
      border-radius: 1.5rem;
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      border: 1px solid rgba(255,255,255,0.08);
    }

    .prose-shell :global(h2),
    .prose-shell :global(h3) {
      margin-top: 1.8rem;
      margin-bottom: 0.8rem;
      color: #fff9ef;
    }

    .prose-shell :global(p) {
      margin: 0 0 1rem;
      max-width: none;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.9;
      font-size: 1.03rem;
    }

    .prose-shell :global(a) {
      color: #f2cc7f;
      text-decoration: underline;
    }
  </style>
</BaseLayout>