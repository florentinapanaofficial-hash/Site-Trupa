---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import siteContent from '../data/siteContent.json';

const { contact } = siteContent;
const whatsappNumber = contact.phoneRaw.replace(/\D/g, '');
const whatsappMessage = encodeURIComponent('Bună ziua! Doresc oferta premium pentru evenimentul meu.');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<BaseLayout
  title="Prețuri & Ofertă Formație Nuntă 2026 | Florentina Pană"
  description="Prețuri formație nuntă 2026-2027: spune bugetul estimat și primești ofertă personalizată, pachet muzică live complet și răspuns rapid."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Cât costă o formație de nuntă în 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prețul formației de nuntă variază în funcție de numărul de artiști, durata programului și locația evenimentului. Contactați-ne pentru o ofertă personalizată adaptată bugetului și evenimentului dumneavoastră."
          }
        },
        {
          "@type": "Question",
          "name": "Ce include pachetul premium de muzică live?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pachetul premium include program muzical live complet, repertoriu personalizat (petrecere, dans, momente tradiționale, piese moderne), suport pentru organizarea timeline-ului serii și interacțiune elegantă cu invitații."
          }
        },
        {
          "@type": "Question",
          "name": "În ce orașe activează Formația Florentina Pană?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Formația Florentina Pană activează în toată România: București, Pitești, Câmpulung, Curtea de Argeș, Craiova, Ploiești, Brașov și alte orașe. Contactați-ne pentru disponibilitate."
          }
        },
        {
          "@type": "Question",
          "name": "Cum pot rezerva formația pentru evenimentul meu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puteți rezerva formația prin formularul de contact de pe site, telefonic sau pe WhatsApp. Verificăm disponibilitatea și revenim cu ofertă personalizată în cel mai scurt timp."
          }
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Ofertă Premium Formație Nuntă 2026-2027",
      "description": "Servicii muzicale live premium pentru nunți, botezuri, aniversări și corporate. Repertoriu personalizat, energie reală pe scenă, coordonare profesionistă.",
      "provider": {
        "@type": "MusicGroup",
        "name": "Formația Florentina Pană",
        "url": "https://www.florentinapanaofficial.ro/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Romania"
      },
      "serviceType": "Live Music Entertainment",
      "offers": {
        "@type": "Offer",
        "name": "Pachet Signature Muzică Live",
        "description": "Program muzical live adaptat evenimentului, suport pentru timeline, repertoriu divers și coordonare cu echipa organizatorică.",
        "url": "https://www.florentinapanaofficial.ro/oferta-premium/",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "validThrough": "2027-12-31"
      },
      "url": "https://www.florentinapanaofficial.ro/oferta-premium/"
    }
    ])} />
  </Fragment>
  <section class="section-container premium-page py-12">
    <div class="mb-5"><BackButton href="/contact/" label="Înapoi la contact" /></div>

    <article class="premium-shell">
      <p class="premium-kicker">Pachet Signature — Muzică Live Nuntă 2026-2027</p>
      <h1 class="premium-title">Prețuri și ofertă formație nuntă adaptată evenimentului tău</h1>
      <p class="premium-lead">
        Cauți o <strong>formație de nuntă cu prețuri clare și pachet complet</strong>? Spune-ne bugetul estimat, iar noi
        îți propunem formula potrivită de trupă și o ofertă personalizată pentru nunți, botezuri și aniversări —
        repertoriu adaptat, sunet profesional și o echipă care ține ritmul serii de la primul dans până la ultimul bis.
      </p>

      <div class="premium-budget-callout mt-5" aria-label="Ofertă în funcție de buget">
        <p>
          Majoritatea cuplurilor caută o trupă care se potrivește bugetului lor. Tocmai de aceea tratăm suma indicată ca reper
          pentru a recomanda varianta de pachet cea mai potrivită evenimentului, fără compromisuri inutile.
        </p>
      </div>

      <div class="premium-grid mt-6">
        <section class="premium-card">
          <h2>Ce primești în pachet</h2>
          <ul>
            <li>Program live adaptat momentelor cheie ale evenimentului</li>
            <li>Repertoriu divers: petrecere, dans, momente tradiționale, piese moderne</li>
            <li>Interacțiune elegantă cu invitații, fără pauze incomode</li>
            <li>Suport pentru organizarea timeline-ului muzical al serii</li>
          </ul>
        </section>

        <section class="premium-card">
          <h2>Pentru cine este potrivit</h2>
          <ul>
            <li>Cupluri care vor o nuntă premium, fluidă și fără momente moarte</li>
            <li>Botezuri sau aniversări cu invitați din generații diferite</li>
            <li>Evenimente corporate cu standard ridicat de prezentare</li>
            <li>Organizatori care au nevoie de colaborare clară, profesionistă</li>
          </ul>
        </section>
      </div>

      <section class="premium-highlight mt-6" aria-label="Avantaj competitiv">
        <h2>De ce aleg cuplurile formația Florentina Pană?</h2>
        <p>
          Nu primești doar <strong>muzică live la nuntă</strong>, ci o experiență completă: calibrare pe public,
          tranziții curate între momente, prezență scenică autentică și comunicare rapidă cu echipa ta de organizare.
          Pachetul de <strong>muzică live pentru nuntă</strong> include tot ce ai nevoie pentru o seară fără momente goale.
        </p>
      </section>

      <section class="premium-faq mt-6" aria-label="Întrebări frecvente despre formația de nuntă">
        <h2 class="premium-faq-title">Întrebări frecvente</h2>
        <dl class="premium-faq-list">
          <div class="premium-faq-item">
            <dt>Cât costă o formație de nuntă în 2026?</dt>
            <dd>Prețul variază în funcție de numărul de artiști, durata programului și locație. Trimite-ne data, orașul și bugetul estimat, iar noi revenim cu o ofertă clară, adaptată evenimentului tău.</dd>
          </div>
          <div class="premium-faq-item">
            <dt>Ce include pachetul premium de muzică live?</dt>
            <dd>Program muzical live complet, repertoriu personalizat (petrecere, dans, momente tradiționale, piese moderne), suport pentru timeline-ul serii și interacțiune elegantă cu invitații.</dd>
          </div>
          <div class="premium-faq-item">
            <dt>În ce orașe activează Formația Florentina Pană?</dt>
            <dd>Activăm în toată România: București, Pitești, Câmpulung, Curtea de Argeș, Craiova, Ploiești, Brașov și alte orașe. Contactează-ne pentru disponibilitate.</dd>
          </div>
          <div class="premium-faq-item">
            <dt>Cum rezerv formația pentru evenimentul meu?</dt>
            <dd>Prin formularul de contact, telefonic sau pe WhatsApp. Verificăm disponibilitatea și revenim cu ofertă personalizată în cel mai scurt timp.</dd>
          </div>
        </dl>
      </section>

      <section class="premium-cta mt-6">
        <p class="premium-cta-title">Vrei o ofertă personalizată în funcție de data, locația și bugetul tău?</p>
        <div class="premium-cta-actions">
          <a
            class="btn-solid"
            href="/contact/?sursa=oferta-premium"
            onclick="window.gtag&&window.gtag('event','premium_offer_contact_click',{event_category:'offer'})"
          >
            Cere ofertă personalizată
          </a>
          <a
            class="btn-outline"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.gtag&&window.gtag('event','premium_offer_whatsapp_click',{event_category:'offer'})"
          >
            Discută pe WhatsApp
          </a>
        </div>
      </section>
    </article>
  </section>

  <style>
    .premium-shell {
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 1.1rem;
      background:
        radial-gradient(circle at 12% 20%, rgba(255, 231, 166, 0.16), transparent 42%),
        radial-gradient(circle at 85% 0%, rgba(71, 185, 255, 0.14), transparent 35%),
        rgba(8, 16, 42, 0.8);
      padding: clamp(1rem, 2vw, 1.5rem);
    }

    .premium-kicker {
      margin: 0;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(252, 228, 176, 0.95);
    }

    .premium-title {
      margin: 0.38rem 0 0;
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      line-height: 1.1;
      color: #f8fbff;
      text-wrap: balance;
    }

    .premium-lead {
      margin-top: 0.7rem;
      max-width: 70ch;
      color: rgba(234, 243, 255, 0.92);
      line-height: 1.65;
      font-size: 0.98rem;
    }

    .premium-budget-callout {
      border-radius: 0.95rem;
      border: 1px solid rgba(125, 211, 252, 0.22);
      background: rgba(14, 37, 58, 0.68);
      padding: 0.85rem 0.95rem;
    }

    .premium-budget-callout p {
      margin: 0;
      color: rgba(230, 244, 255, 0.88);
      line-height: 1.6;
      font-size: 0.9rem;
    }

    .premium-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .premium-card {
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 0.95rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 0.95rem;
    }

    .premium-card h2,
    .premium-highlight h2 {
      margin: 0;
      font-size: 1.02rem;
      font-weight: 700;
      color: #f6faff;
    }

    .premium-card ul {
      margin: 0.6rem 0 0;
      padding-left: 1rem;
      color: rgba(231, 242, 255, 0.9);
      line-height: 1.65;
      font-size: 0.92rem;
    }

    .premium-highlight {
      border-radius: 0.95rem;
      border: 1px solid rgba(255, 225, 150, 0.32);
      background: rgba(255, 205, 112, 0.08);
      padding: 0.9rem;
    }

    .premium-highlight p {
      margin: 0.5rem 0 0;
      color: rgba(240, 247, 255, 0.92);
      line-height: 1.65;
      font-size: 0.94rem;
    }

    .premium-cta {
      border-radius: 0.95rem;
      border: 1px solid rgba(125, 211, 252, 0.28);
      background: rgba(15, 28, 58, 0.8);
      padding: 0.9rem;
    }

    .premium-cta-title {
      margin: 0;
      color: #e8f4ff;
      font-weight: 700;
      font-size: 0.96rem;
    }

    .premium-cta-actions {
      margin-top: 0.65rem;
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .premium-faq {
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 0.95rem;
      background: rgba(255, 255, 255, 0.03);
      padding: 0.95rem;
    }

    .premium-faq-title {
      margin: 0 0 0.75rem;
      font-size: 1.02rem;
      font-weight: 700;
      color: #f6faff;
    }

    .premium-faq-list {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .premium-faq-item dt {
      font-size: 0.9rem;
      font-weight: 700;
      color: rgba(200, 235, 255, 0.97);
      margin-bottom: 0.25rem;
    }

    .premium-faq-item dd {
      margin: 0;
      font-size: 0.88rem;
      line-height: 1.6;
      color: rgba(220, 238, 255, 0.82);
    }

    @media (max-width: 900px) {
      .premium-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 767px) {
      .premium-cta-actions .btn-solid,
      .premium-cta-actions .btn-outline {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</BaseLayout>