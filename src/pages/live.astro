---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';

const YOUTUBE_CHANNEL_ID = process.env.YOUTUBE_CHANNEL_ID?.trim() || 'UCNi3X-Qm3V4aaOAFSOlzHew';
const livePageTitle = 'LIVE de la Evenimente | Formația Florentina Pană';
const livePageDescription = 'Urmărește live stream-urile de la nunți, botezuri și evenimente cu Formația Florentina Pană. Simte energia FP Band în timp real.';
const livePageOgImage = '/images/og-live-1200x630.jpg';
---

<BaseLayout
  title={livePageTitle}
  description={livePageDescription}
  ogImage={livePageOgImage}
>

  {/* ═══════════════════════════════════════════
      HERO — Titlu editorial + indicator ON AIR
  ═══════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-black py-20 sm:py-28">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-[#1a1005]"></div>

    <div class="section-container relative z-10 text-center">
      <div class="mb-8"><BackButton href="/" label="Acasă" /></div>

      {/* Indicator ON AIR — ascuns implicit, JS îl afișează dacă e live */}
      <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-red-500/30 bg-red-500/10 px-5 py-2.5" id="live-badge" style="display:none">
        <span class="relative flex h-3.5 w-3.5">
          <span class="absolute inline-flex h-full w-full animate-pulse rounded-full bg-red-500 opacity-75"></span>
          <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-red-500"></span>
        </span>
        <span class="text-sm font-bold uppercase tracking-widest text-red-400">Transmisiune Live</span>
      </div>

      <h1 class="mx-auto max-w-3xl font-serif text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
        Simte energia FP Band<br class="hidden sm:block" /> în timp real
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/60">
        Transmisiuni în direct de la cele mai frumoase evenimente — nunți, botezuri, petreceri.
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      PLAYER — YouTube Live Embed + ramă aurie
      Suportă atât 16:9 (landscape) cât și 9:16 (vertical/Stories)
  ═══════════════════════════════════════════ */}
  <section class="live-player-section bg-[#1a1005] py-12 sm:py-16">
    <div class="section-container">

      {/* Status format — detectare automată landscape / vertical */}
      <div class="mb-6 flex items-center justify-center">
        <p id="live-format-status" class="live-format-status" aria-live="polite">
          Detectăm automat formatul video...
        </p>
      </div>

      {/* Wrapper glassmorphism — fundal blur decorativ vizibil în modul vertical pe desktop */}
      <div class="live-glass-wrap" id="live-glass-wrap">
        {/* Stratul de blur glassmorphism — fundaluri colorate difuze */}
        <div class="live-glass-bg" aria-hidden="true">
          <div class="live-glass-blob live-glass-blob--amber"></div>
          <div class="live-glass-blob live-glass-blob--red"></div>
          <div class="live-glass-blob live-glass-blob--gold"></div>
        </div>

        {/* Container player — adaptiv landscape / vertical */}
        <div class="live-player-frame" id="live-player-frame">
          <div class="live-player-aspect" id="live-player-aspect">
            {/* src gol inițial — JS îl populează după verificarea live-status */}
            <iframe
              id="live-player"
              src=""
              data-channel={YOUTUBE_CHANNEL_ID}
              title="Live Stream — Formația Florentina Pană"
              class="absolute inset-0 h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>

      {/* Mesaj offline — afișat de JS când nu e live */}
      <p id="offline-msg" class="mx-auto mt-4 max-w-xl text-center text-sm leading-relaxed text-amber-400/70" style="display:none">
        Nu suntem live acum — în player poți vedea ultimul nostru eveniment înregistrat.
      </p>

      {/* Text descriptiv sub player */}
      <p class="mx-auto mt-8 max-w-xl text-center text-base leading-relaxed text-white/50">
        Suntem pe scenă, dând viață momentelor magice. Dacă nu suntem live acum, poți vedea ultima noastră petrecere în player-ul de mai sus.
      </p>

      {/* ── Butoane distribuire socială ── */}
      <div class="mx-auto mt-6 flex max-w-md flex-wrap items-center justify-center gap-3">
        {/* WhatsApp */}
        <a
          id="share-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="live-share-btn"
          aria-label="Distribuie pe WhatsApp"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347ZM12.05 21.785h-.01a9.87 9.87 0 0 1-5.03-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.2 12.05C2.2 6.62 6.62 2.2 12.05 2.2c2.634 0 5.108 1.027 6.968 2.893A9.82 9.82 0 0 1 21.9 12.06c-.005 5.43-4.42 9.85-9.85 9.85v-.125ZM12.05.075C5.495.075.075 5.495.075 12.05c0 2.12.553 4.19 1.607 6.02L.05 24l6.095-1.598A11.93 11.93 0 0 0 12.05 24.1c6.555 0 11.975-5.42 11.975-11.975C24.025 5.57 18.605.075 12.05.075Z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        {/* Facebook */}
        <a
          id="share-fb"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="live-share-btn"
          aria-label="Distribuie pe Facebook"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12Z"/>
          </svg>
          <span>Facebook</span>
        </a>

        {/* Copy Link */}
        <button
          type="button"
          id="share-copy"
          class="live-share-btn"
          aria-label="Copiază linkul"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.101" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.172 13.828a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-label">Copiază linkul</span>
        </button>
      </div>

      {/* ── Panou „Anunță Live pe Facebook" ── */}
      <div class="mx-auto mt-10 max-w-xl rounded-2xl border border-[#1877f2]/30 bg-[#1877f2]/8 p-6" id="announce-box">
        <div class="mb-3 flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-pulse rounded-full bg-[#1877f2] opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#1877f2]"></span>
          </span>
          <p class="text-xs font-bold uppercase tracking-widest text-[#74a7ff]">Anunță evenimentul Live</p>
        </div>

        <p class="mb-3 text-xs leading-relaxed text-white/40">Copiază textul de mai jos, apoi postează-l pe Facebook — 10 secunde și fanii tăi știu că ești live.</p>

        {/* Textul pre-scris — editabil de Claudiu */}
        <div class="relative rounded-xl border border-white/10 bg-black/40 p-4">
          <p class="live-announce-text select-all text-sm leading-relaxed text-white/80" id="announce-text">
            🎵 Suntem LIVE acum! Urmărește în direct muzica noastră de la eveniment 🎶<br />
            Intră pe link și simte atmosfera alături de noi 👇<br />
            https://florentinapanaofficial.ro/live/
          </p>
          <button
            type="button"
            id="copy-announce"
            class="mt-3 flex w-full items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/5 py-2 text-xs font-semibold text-white/60 transition-all hover:border-[#1877f2]/40 hover:bg-[#1877f2]/10 hover:text-[#74a7ff]"
            aria-label="Copiază textul de anunț"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-announce-label">Copiază textul</span>
          </button>
        </div>

        {/* Buton Facebook mare */}
        <a
          id="btn-fb-announce"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex w-full items-center justify-center gap-3 rounded-xl bg-[#1877f2] py-3.5 text-sm font-bold text-white shadow-[0_4px_20px_rgba(24,119,242,0.35)] transition-all hover:bg-[#1565d8] hover:shadow-[0_6px_28px_rgba(24,119,242,0.5)]"
          aria-label="Deschide Facebook pentru a posta"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12Z"/>
          </svg>
          Postează pe Facebook
        </a>
      </div>

      {/* CTA — imediat sub player, vizibil indiferent de format */}
      <div class="mt-8 text-center">
        <a
          href="/contact/"
          class="inline-flex items-center gap-3 rounded-xl border-2 border-amber-500/60 bg-gradient-to-r from-amber-600 to-amber-500 px-8 py-4 text-lg font-bold text-black shadow-[0_8px_32px_rgba(245,166,35,0.35)] transition-all hover:scale-105 hover:shadow-[0_12px_40px_rgba(245,166,35,0.5)]"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.348 14.652a3.75 3.75 0 0 1 0-5.304m5.304 0a3.75 3.75 0 0 1 0 5.304m-7.425 2.121a6.75 6.75 0 0 1 0-9.546m9.546 0a6.75 6.75 0 0 1 0 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788M12 12h.008v.008H12V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
          Vrei acest vibe la evenimentul tău? Verifică disponibilitatea
        </a>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      ULTIMELE LIVE-URI ÎNREGISTRATE
  ═══════════════════════════════════════════ */}
  <section class="bg-[#0d0800] py-14 sm:py-18">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center mb-10">
        <p class="text-amber-400/70 text-xs font-bold uppercase tracking-widest mb-2">Replay</p>
        <h2 class="font-serif text-3xl font-bold text-white sm:text-4xl">Ultimele Live-uri Înregistrate</h2>
        <p class="mt-3 text-white/50 text-sm">Nu ai prins transmisiunea? Revezi evenimentele noastre în întregime.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
        <!-- Live 1 — cel mai recent -->
        <a href="https://www.youtube.com/watch?v=bffqJGtP9ok" target="_blank" rel="noopener noreferrer"
          class="group block rounded-2xl overflow-hidden border border-white/10 bg-white/5 transition-all hover:border-amber-500/40 hover:bg-white/[0.08]">
          <div class="relative aspect-video">
            <img src="https://img.youtube.com/vi/bffqJGtP9ok/maxresdefault.jpg"
              alt="Live FP Band — eveniment 03.05.2026" class="w-full h-full object-cover" loading="lazy" width="480" height="270" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-red-600 shadow-lg">
                <svg class="h-5 w-5 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
              </span>
            </div>
          </div>
          <div class="p-4">
            <p class="text-sm font-semibold text-white/90 group-hover:text-amber-400 transition-colors">Live FP Band — Eveniment</p>
            <p class="mt-1 text-xs text-white/40">3 mai 2026</p>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DbffqJGtP9ok"
              target="_blank"
              rel="noopener noreferrer"
              class="live-card-share"
              aria-label="Distribuie acest live pe Facebook"
            >
              Distribuie pe Facebook
            </a>
          </div>
        </a>
        <!-- Live 2 -->
        <a href="https://www.youtube.com/watch?v=EAQ_mTbj_uY" target="_blank" rel="noopener noreferrer"
          class="group block rounded-2xl overflow-hidden border border-white/10 bg-white/5 transition-all hover:border-amber-500/40 hover:bg-white/[0.08]">
          <div class="relative aspect-video">
            <img src="https://img.youtube.com/vi/EAQ_mTbj_uY/maxresdefault.jpg"
              alt="Live FP Band — eveniment 03.05.2026" class="w-full h-full object-cover" loading="lazy" width="480" height="270" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-red-600 shadow-lg">
                <svg class="h-5 w-5 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
              </span>
            </div>
          </div>
          <div class="p-4">
            <p class="text-sm font-semibold text-white/90 group-hover:text-amber-400 transition-colors">Live FP Band — Eveniment</p>
            <p class="mt-1 text-xs text-white/40">3 mai 2026</p>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DEAQ_mTbj_uY"
              target="_blank"
              rel="noopener noreferrer"
              class="live-card-share"
              aria-label="Distribuie acest live pe Facebook"
            >
              Distribuie pe Facebook
            </a>
          </div>
        </a>
        <!-- Live 3 -->
        <a href="https://www.youtube.com/watch?v=3b9KYuoTjBA" target="_blank" rel="noopener noreferrer"
          class="group block rounded-2xl overflow-hidden border border-white/10 bg-white/5 transition-all hover:border-amber-500/40 hover:bg-white/[0.08]">
          <div class="relative aspect-video">
            <img src="https://img.youtube.com/vi/3b9KYuoTjBA/maxresdefault.jpg"
              alt="Live FP Band — eveniment 03.05.2026" class="w-full h-full object-cover" loading="lazy" width="480" height="270" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-red-600 shadow-lg">
                <svg class="h-5 w-5 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
              </span>
            </div>
          </div>
          <div class="p-4">
            <p class="text-sm font-semibold text-white/90 group-hover:text-amber-400 transition-colors">Live FP Band — Eveniment</p>
            <p class="mt-1 text-xs text-white/40">3 mai 2026</p>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3D3b9KYuoTjBA"
              target="_blank"
              rel="noopener noreferrer"
              class="live-card-share"
              aria-label="Distribuie acest live pe Facebook"
            >
              Distribuie pe Facebook
            </a>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      PROGRAM — Următoarele live-uri
  ═══════════════════════════════════════════ */}
  <section class="bg-black py-16 sm:py-20">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="mb-2 font-serif text-3xl font-bold text-white sm:text-4xl">Programul Live-urilor</h2>
        <p class="mb-10 text-white/50">Următoarele transmisiuni programate</p>

        <div class="space-y-4 text-left">
          <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-5">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-white">Nuntă — Pitești, Argeș</p>
              <p class="mt-1 text-sm text-white/50">Data și ora vor fi anunțate în curând</p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-5">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-white">Botez — Câmpulung, Argeș</p>
              <p class="mt-1 text-sm text-white/50">Data și ora vor fi anunțate în curând</p>
            </div>
          </div>
        </div>

        <p class="mt-8 text-sm text-white/30">Programul se actualizează periodic. Urmărește-ne pe rețelele sociale pentru notificări.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Indicator format detectat automat ── */
  .live-format-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(245, 166, 35, 0.35);
    background: rgba(245, 166, 35, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ── Glassmorphism wrapper ── */
  .live-glass-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 320px;
    transition: min-height 0.4s ease;
  }
  .live-glass-wrap.is-vertical {
    min-height: 70vh;
  }

  /* Blob-uri difuze — vizibile doar în modul vertical pe desktop */
  .live-glass-bg {
    position: absolute;
    inset: -40px;
    z-index: 0;
    overflow: hidden;
    border-radius: 1.5rem;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .live-glass-wrap.is-vertical .live-glass-bg {
    opacity: 1;
  }
  .live-glass-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .live-glass-blob--amber {
    width: 340px;
    height: 340px;
    top: -10%;
    left: -5%;
    background: rgba(245, 166, 35, 0.18);
  }
  .live-glass-blob--red {
    width: 260px;
    height: 260px;
    bottom: 5%;
    right: -3%;
    background: rgba(239, 68, 68, 0.12);
  }
  .live-glass-blob--gold {
    width: 200px;
    height: 200px;
    top: 40%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(234, 179, 8, 0.1);
  }

  /* ── Player frame — rama aurie ── */
  .live-player-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 56rem; /* 896px — landscape default */
    border-radius: 1rem;
    border: 2px solid rgba(245, 166, 35, 0.4);
    background: rgba(0, 0, 0, 0.6);
    padding: 0.5rem;
    box-shadow: 0 0 60px rgba(245, 166, 35, 0.15);
    transition: max-width 0.4s ease, border-radius 0.4s ease;
  }
  @media (min-width: 640px) {
    .live-player-frame { padding: 0.75rem; }
  }

  /* Modul vertical — efect ecran de telefon */
  .live-glass-wrap.is-vertical .live-player-frame {
    max-width: 440px;
    border-radius: 1.5rem;
    border-color: rgba(245, 166, 35, 0.5);
    box-shadow:
      0 0 80px rgba(245, 166, 35, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  /* ── Aspect ratio container ── */
  .live-player-aspect {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 0.75rem;
    aspect-ratio: 16 / 9;
    transition: aspect-ratio 0.4s ease;
  }
  .live-glass-wrap.is-vertical .live-player-aspect {
    aspect-ratio: 9 / 16;
  }

  /* Glassmorphism backdrop pe wrapper în modul vertical */
  .live-glass-wrap.is-vertical::before {
    content: '';
    position: absolute;
    inset: -20px;
    z-index: 0;
    border-radius: 2rem;
    background: rgba(26, 16, 5, 0.5);
    backdrop-filter: blur(30px) saturate(1.4);
    -webkit-backdrop-filter: blur(30px) saturate(1.4);
  }

  /* ── Butoane distribuire ── */
  .live-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(245, 166, 35, 0.25);
    background: rgba(245, 166, 35, 0.06);
    color: #d4a04a;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }
  .live-share-btn:hover {
    border-color: rgba(245, 166, 35, 0.5);
    background: rgba(245, 166, 35, 0.14);
    color: #f5a623;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(245, 166, 35, 0.15);
  }
  .live-share-btn:active {
    transform: translateY(0);
  }

  .live-card-share {
    display: inline-flex;
    margin-top: 0.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(24, 119, 242, 0.35);
    background: rgba(24, 119, 242, 0.12);
    color: #8bb7ff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.4rem 0.65rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .live-card-share:hover {
    border-color: rgba(24, 119, 242, 0.6);
    background: rgba(24, 119, 242, 0.2);
    color: #bfd7ff;
  }
</style>

<script is:inline>
  (function () {
    // ── Detecție live ──
    var player = document.getElementById('live-player');
    var badge = document.getElementById('live-badge');
    var offlineMsg = document.getElementById('offline-msg');
    var channelId = player ? player.getAttribute('data-channel') : null;

    var LAST_LIVE_ID = 'bffqJGtP9ok'; // ultimul live înregistrat — actualizează după fiecare eveniment

    var formatStatus = document.getElementById('live-format-status');
    const wrap = document.getElementById('live-glass-wrap');

    if (!wrap) return;

    function setFormat(vertical) {
      wrap.classList.toggle('is-vertical', vertical);
      if (formatStatus) {
        formatStatus.textContent = vertical
          ? 'Format detectat automat: Vertical 9:16'
          : 'Format detectat automat: Landscape 16:9';
      }
    }

    function detectByThumbnail(videoId) {
      var variants = ['maxresdefault', 'sddefault', 'hqdefault'];

      return new Promise(function (resolve) {
        var index = 0;

        function tryNext() {
          if (index >= variants.length) {
            resolve(false);
            return;
          }

          var img = new Image();
          img.onload = function () {
            resolve(img.naturalHeight > img.naturalWidth);
          };
          img.onerror = function () {
            index += 1;
            tryNext();
          };
          img.src = 'https://i.ytimg.com/vi/' + videoId + '/' + variants[index] + '.jpg';
        }

        tryNext();
      });
    }

    function detectVideoFormat(videoId) {
      var watchUrl = 'https://www.youtube.com/watch?v=' + videoId;
      var noEmbedUrl = 'https://noembed.com/embed?url=' + encodeURIComponent(watchUrl);

      return fetch(noEmbedUrl)
        .then(function (response) {
          if (!response.ok) throw new Error('noembed failed');
          return response.json();
        })
        .then(function (meta) {
          if (meta && Number(meta.width) > 0 && Number(meta.height) > 0) {
            return Number(meta.height) > Number(meta.width);
          }

          return detectByThumbnail(videoId);
        })
        .catch(function () {
          return detectByThumbnail(videoId);
        });
    }

    function applyDetectedFormat(videoId) {
      detectVideoFormat(videoId)
        .then(function (isVertical) {
          setFormat(isVertical);
        })
        .catch(function () {
          setFormat(false);
        });
    }

    // Default până la detectarea formatului real
    setFormat(false);

    if (player && channelId) {
      fetch('/api/live-status')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.isLive && data.videoId) {
            player.src = 'https://www.youtube-nocookie.com/embed/' + data.videoId + '?autoplay=1&rel=0';
            if (badge) badge.style.display = '';
            if (offlineMsg) offlineMsg.style.display = 'none';
            applyDetectedFormat(data.videoId);
          } else {
            if (badge) badge.style.display = 'none';
            if (offlineMsg) offlineMsg.style.display = '';
            // Fallback: ultimul live înregistrat
            player.src = 'https://www.youtube-nocookie.com/embed/' + LAST_LIVE_ID + '?rel=0';
            applyDetectedFormat(LAST_LIVE_ID);
          }
        })
        .catch(function () {
          if (badge) badge.style.display = 'none';
          if (offlineMsg) offlineMsg.style.display = '';
          if (player) player.src = 'https://www.youtube-nocookie.com/embed/' + LAST_LIVE_ID + '?rel=0';
          applyDetectedFormat(LAST_LIVE_ID);
        });
    }

    // ── Share buttons — URL dinamic ──
    var pageUrl = encodeURIComponent(window.location.href);
    var shareText = encodeURIComponent('Uită-te acum LIVE la FP Band: ' + window.location.href);

    var waBtn = document.getElementById('share-wa');
    var fbBtn = document.getElementById('share-fb');
    var copyBtn = document.getElementById('share-copy');
    var copyLabel = document.getElementById('copy-label');

    if (waBtn) waBtn.href = 'https://api.whatsapp.com/send?text=' + shareText;
    if (fbBtn) fbBtn.href = 'https://www.facebook.com/sharer/sharer.php?u=' + pageUrl;

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          var orig = copyLabel.textContent;
          copyLabel.textContent = 'Copiat!';
          copyBtn.style.borderColor = 'rgba(34, 197, 94, 0.5)';
          copyBtn.style.color = '#22c55e';
          setTimeout(function () {
            copyLabel.textContent = orig;
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2000);
        });
      });
    }

    // ── Panou Anunță Live pe Facebook ──
    var announceText = document.getElementById('announce-text');
    var copyAnnounceBtn = document.getElementById('copy-announce');
    var copyAnnounceLabel = document.getElementById('copy-announce-label');
    var fbAnnounceBtn = document.getElementById('btn-fb-announce');

    // Buton Facebook — URL sharer cu link-ul paginii live
    var liveUrl = 'https://florentinapanaofficial.ro/live/';
    if (fbAnnounceBtn) {
      fbAnnounceBtn.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(liveUrl);
    }

    // Buton Copiază textul de anunț
    if (copyAnnounceBtn && announceText && copyAnnounceLabel) {
      copyAnnounceBtn.addEventListener('click', function () {
        var text = announceText.innerText || announceText.textContent || '';
        navigator.clipboard.writeText(text.trim()).then(function () {
          var orig = copyAnnounceLabel.textContent;
          copyAnnounceLabel.textContent = '✓ Copiat!';
          copyAnnounceBtn.style.borderColor = 'rgba(34, 197, 94, 0.5)';
          copyAnnounceBtn.style.color = '#22c55e';
          setTimeout(function () {
            copyAnnounceLabel.textContent = orig;
            copyAnnounceBtn.style.borderColor = '';
            copyAnnounceBtn.style.color = '';
          }, 2500);
        });
      });
    }
  })();
</script>
