<style>
  /* ── Indicator format detectat automat ── */
  .live-format-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(245, 166, 35, 0.35);
    background: rgba(245, 166, 35, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ── Glassmorphism wrapper ── */
  .live-glass-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 320px;
    transition: min-height 0.4s ease;
  }
  .live-glass-wrap.is-vertical {
    min-height: 70dvh;
  }

  /* Blob-uri difuze — vizibile doar în modul vertical pe desktop */
  .live-glass-bg {
    position: absolute;
    inset: -40px;
    z-index: 0;
    overflow: hidden;
    border-radius: 1.5rem;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .live-glass-wrap.is-vertical .live-glass-bg {
    opacity: 1;
  }
  .live-glass-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .live-glass-blob--amber {
    width: 340px;
    height: 340px;
    top: -10%;
    left: -5%;
    background: rgba(245, 166, 35, 0.18);
  }
  .live-glass-blob--red {
    width: 260px;
    height: 260px;
    bottom: 5%;
    right: -3%;
    background: rgba(239, 68, 68, 0.12);
  }
  .live-glass-blob--gold {
    width: 200px;
    height: 200px;
    top: 40%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(234, 179, 8, 0.1);
  }

  /* ── Player frame — rama aurie ── */
  .live-player-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 56rem; /* 896px — landscape default */
    border-radius: 1rem;
    border: 2px solid rgba(245, 166, 35, 0.4);
    background: rgba(0, 0, 0, 0.6);
    padding: 0.5rem;
    box-shadow: 0 0 60px rgba(245, 166, 35, 0.15);
    transition: max-width 0.4s ease, border-radius 0.4s ease;
  }
  @media (min-width: 640px) {
    .live-player-frame { padding: 0.75rem; }
  }

  /* Modul vertical — efect ecran de telefon */
  .live-glass-wrap.is-vertical .live-player-frame {
    max-width: 440px;
    border-radius: 1.5rem;
    border-color: rgba(245, 166, 35, 0.5);
    box-shadow:
      0 0 80px rgba(245, 166, 35, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  /* ── Aspect ratio container ── */
  .live-player-aspect {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 0.75rem;
    aspect-ratio: 16 / 9;
    transition: aspect-ratio 0.4s ease;
  }
  .live-glass-wrap.is-vertical .live-player-aspect {
    aspect-ratio: 9 / 16;
  }

  .live-player-aspect iframe {
    pointer-events: auto;
  }

  /* Glassmorphism backdrop pe wrapper în modul vertical */
  .live-glass-wrap.is-vertical::before {
    content: '';
    position: absolute;
    inset: -20px;
    z-index: 0;
    border-radius: 2rem;
    background: rgba(26, 16, 5, 0.5);
    pointer-events: none;
    backdrop-filter: blur(30px) saturate(1.4);
    -webkit-backdrop-filter: blur(30px) saturate(1.4);
  }

  /* ── Butoane distribuire ── */
  .live-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(245, 166, 35, 0.25);
    background: rgba(245, 166, 35, 0.06);
    color: #d4a04a;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }
  .live-share-btn:hover {
    border-color: rgba(245, 166, 35, 0.5);
    background: rgba(245, 166, 35, 0.14);
    color: #f5a623;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(245, 166, 35, 0.15);
  }
  .live-share-btn:active {
    transform: translateY(0);
  }

  .live-card-share {
    display: inline-flex;
    margin-top: 0.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(24, 119, 242, 0.35);
    background: rgba(24, 119, 242, 0.12);
    color: #8bb7ff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.4rem 0.65rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .live-card-share:hover {
    border-color: rgba(24, 119, 242, 0.6);
    background: rgba(24, 119, 242, 0.2);
    color: #bfd7ff;
  }
</style>

<script is:inline>
  (function () {
    // ── Status live + format default pentru player Cloudflare ──
    var player = document.getElementById('live-player');
    var badge = document.getElementById('live-badge');
    var offlineMsg = document.getElementById('offline-msg');
    var isLive = player ? player.getAttribute('data-live') === 'true' : false;

    var formatStatus = document.getElementById('live-format-status');
    const wrap = document.getElementById('live-glass-wrap');

    if (!wrap) return;

    function setFormat(vertical) {
      wrap.classList.toggle('is-vertical', vertical);
      if (formatStatus) {
        formatStatus.textContent = vertical
          ? 'Format detectat automat: Vertical 9:16'
          : 'Format detectat automat: Landscape 16:9';
      }
    }

    // Playerul Cloudflare folosește stream landscape în pagina principală
    setFormat(false);
    if (badge) badge.style.display = isLive ? '' : 'none';
    if (offlineMsg) offlineMsg.style.display = isLive ? 'none' : '';

    // ── Share buttons — URL dinamic ──
    var pageUrl = encodeURIComponent(window.location.href);
    var shareText = encodeURIComponent('Uită-te acum LIVE la FP Band: ' + window.location.href);

    var waBtn = document.getElementById('share-wa');
    var fbBtn = document.getElementById('share-fb');
    var copyBtn = document.getElementById('share-copy');
    var copyLabel = document.getElementById('copy-label');

    if (waBtn) waBtn.href = 'https://api.whatsapp.com/send?text=' + shareText;
    if (fbBtn) fbBtn.href = 'https://www.facebook.com/sharer/sharer.php?u=' + pageUrl;

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          var orig = copyLabel.textContent;
          copyLabel.textContent = 'Copiat!';
          copyBtn.style.borderColor = 'rgba(34, 197, 94, 0.5)';
          copyBtn.style.color = '#22c55e';
          setTimeout(function () {
            copyLabel.textContent = orig;
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2000);
        });
      });
    }

    // ── Buton nativ Distribuie ──
    var nativeShareBtn = document.getElementById('btn-native-share');
    var shareToast = document.getElementById('live-share-toast');

    function showShareToast() {
      if (!shareToast) return;
      shareToast.style.display = '';
      clearTimeout(shareToast._hideTimer);
      shareToast._hideTimer = setTimeout(function () {
        shareToast.style.display = 'none';
      }, 2500);
    }

    if (nativeShareBtn) {
      nativeShareBtn.addEventListener('click', function () {
        var url = window.location.href;
        var shareData = {
          title: 'Live cu Florentina Pană',
          text: 'Urmărește transmisiunea live a Formației Florentina Pană!',
          url: url,
        };
        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          navigator.share(shareData).catch(function () {});
        } else {
          navigator.clipboard.writeText(url).then(showShareToast).catch(function () {
            try {
              var ta = document.createElement('textarea');
              ta.value = url;
              ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
              document.body.appendChild(ta);
              ta.focus();
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              showShareToast();
            } catch (err) {}
          });
        }
      });
    }

    // ── Panou Anunță Live pe Facebook ──
    var announceText = document.getElementById('announce-text');
    var copyAnnounceBtn = document.getElementById('copy-announce');
    var copyAnnounceLabel = document.getElementById('copy-announce-label');
    var fbAnnounceBtn = document.getElementById('btn-fb-announce');

    // Buton Facebook — URL sharer cu link-ul paginii live
    var liveUrl = 'https://florentinapanaofficial.ro/live/';
    if (fbAnnounceBtn) {
      fbAnnounceBtn.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(liveUrl);
    }

    // Buton Copiază textul de anunț
    if (copyAnnounceBtn && announceText && copyAnnounceLabel) {
      copyAnnounceBtn.addEventListener('click', function () {
        var text = announceText.innerText || announceText.textContent || '';
        navigator.clipboard.writeText(text.trim()).then(function () {
          var orig = copyAnnounceLabel.textContent;
          copyAnnounceLabel.textContent = '✓ Copiat!';
          copyAnnounceBtn.style.borderColor = 'rgba(34, 197, 94, 0.5)';
          copyAnnounceBtn.style.color = '#22c55e';
          setTimeout(function () {
            copyAnnounceLabel.textContent = orig;
            copyAnnounceBtn.style.borderColor = '';
            copyAnnounceBtn.style.color = '';
          }, 2500);
        });
      });
    }
  })();
</script>

<script is:inline>
  /* ── Mutual Exclusion pe iframes YouTube ─────────────────────────────────────
     Când un iframe YouTube începe redarea (playerState 1), toate celelalte
     iframes de pe pagină primesc comanda pauseVideo via postMessage.
     Necesită enablejsapi=1 în src-ul fiecărui iframe (adăugat deja).
  ─────────────────────────────────────────────────────────────────────────── */
  (function () {
    var YT_PAUSE = JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' });
    var YT_ORIGIN = 'https://www.youtube-nocookie.com';

    function pauseAllExcept(activeSource) {
      document.querySelectorAll('iframe[src*="youtube"]').forEach(function (iframe) {
        try {
          if (iframe.contentWindow && iframe.contentWindow !== activeSource) {
            iframe.contentWindow.postMessage(YT_PAUSE, YT_ORIGIN);
          }
        } catch (err) {}
      });
    }

    window.addEventListener('message', function (e) {
      if (!e.data || !e.source) return;
      if (e.origin !== YT_ORIGIN) return;
      var data;
      try {
        data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      } catch (err) {
        return;
      }
      /* YouTube trimite playerState: 1 (playing) prin evenimentul infoDelivery */
      if (data.event === 'infoDelivery' && data.info && data.info.playerState === 1) {
        pauseAllExcept(e.source);
      }
    });
  })();
</script>
