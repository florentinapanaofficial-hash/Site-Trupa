<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.ob-email-contact');
    if (el) {
      const u = el.getAttribute('data-u');
      const d = el.getAttribute('data-d');
      if (u && d) {
        const addr = u + '@' + d;
        el.outerHTML = `<a class="btn-outline" href="mailto:${addr}" style="overflow-wrap:anywhere;word-break:break-word">Email: ${addr}</a>`;
      }
    }
  });
</script>
