---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import BackButton from '../components/BackButton.astro';
import ZoneAcoperite from '../components/ZoneAcoperite.astro';

const { contact } = siteContent;
const contactSeo = seo.contact;

const whatsappNumber = contact.phoneRaw.replace(/\D/g, '');
const whatsappBase = `https://wa.me/${whatsappNumber}`;
const whatsappPrefilledText = encodeURIComponent('Bună ziua! Aș dori informații pentru rezervare în sezonul 2026-2027.');
const whatsappMessageLink = `${whatsappBase}?text=${whatsappPrefilledText}`;

// Schema ContactPage + ContactPoint — legată prin @id de MusicGroup din BaseLayout
// (înlocuiește vechea injecție `seo.schema`, care dubla schema MusicGroup globală)
const SITE = 'https://www.florentinapanaofficial.ro';
const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE}/contact/#contact-page`,
  name: contactSeo.meta.title,
  description: contactSeo.meta.description,
  url: `${SITE}/contact/`,
  inLanguage: 'ro',
  about: { '@type': 'MusicGroup', '@id': `${SITE}/#music-group` },
  mainEntity: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: seo.schema.telephone,
    email: seo.schema.email,
    url: `${SITE}/contact/`,
    availableLanguage: ['ro', 'en'],
    areaServed: 'RO',
  },
};
---

<BaseLayout title={contactSeo.meta.title} description={contactSeo.meta.description}>
  <section class="section-container contact-compact py-12" id="contact">
    <div class="mb-6"><BackButton href="/" label="Acasă" /></div>

    <div class="rounded-2xl border border-white/20 bg-white/10 p-4 sm:p-6">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:items-start">
        <div>
          <p class="kicker">Contact</p>
          <h1 class="section-title">{contactSeo.h1}</h1>
          <p class="section-copy">{contactSeo.descriere}</p>
          <p class="mt-3 text-sm text-white/85">
            Dacă sunteți în etapa în care comparați opțiuni și căutați o <strong>formație nuntă preț</strong> sau <strong>prețuri formație nuntă București</strong>,
            intervalul nostru transparent este <strong>2.500-4.000 euro</strong> pentru eveniment complet, în funcție de formulă, locație și cerințe. Trimiteți data, locația și bugetul estimat, iar noi revenim cu o ofertă personalizată, calibrată pe stilul evenimentului dvs.
          </p>

          <a
            href="/oferta-premium/"
            class="premium-offer-link mt-3"
            onclick="window.gtag&&window.gtag('event','click_premium_offer',{event_category:'contact'})"
          >
            Vezi oferta premium 2026-2027 și serviciile incluse
          </a>

          <div class="mt-4 flex min-w-0 flex-wrap gap-2">
            <a class="btn-solid" href={`tel:${contact.phoneRaw}`} onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'contact'})">Telefon: {contact.phoneDisplay}</a>
            <span class="btn-outline ob-email-contact" data-u="contact" data-d="florentinapanaofficial.ro">Email: [email protejat]</span>
          </div>

          <div class="desktop-whatsapp-actions mt-3 flex flex-wrap gap-2" aria-label="Comunicare rapidă desktop">
            <a class="btn-whatsapp" href={whatsappBase} target="_blank" rel="noopener noreferrer" aria-label="Deschide WhatsApp pentru comunicare rapidă" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'contact'})">
              <span class="btn-whatsapp-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" fill="none">
                  <path
                    d="M20 11.89C20 16.31 16.42 19.89 12 19.89C10.7 19.89 9.46 19.58 8.37 19.03L4.67 19.92L5.59 16.35C4.98 15.24 4.63 13.97 4.63 12.63C4.63 8.21 8.21 4.63 12.63 4.63C17.05 4.63 20.63 8.21 20.63 12.63"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M9.55 9.66C9.74 9.22 9.92 9.21 10.12 9.21C10.27 9.21 10.43 9.21 10.58 9.21C10.73 9.21 10.95 9.15 11.13 9.35C11.31 9.55 11.8 10.11 11.87 10.26C11.94 10.41 11.98 10.58 11.87 10.76C11.76 10.94 11.71 11.05 11.6 11.18C11.49 11.31 11.37 11.46 11.52 11.71C11.67 11.96 12.2 12.81 13.02 13.52C14.08 14.44 14.98 14.73 15.24 14.84C15.49 14.95 15.64 14.94 15.75 14.82C15.86 14.7 16.23 14.28 16.36 14.1C16.49 13.92 16.62 13.95 16.83 14.03C17.04 14.1 18.14 14.64 18.37 14.75C18.59 14.86 18.75 14.91 18.8 15.01C18.86 15.12 18.86 15.62 18.63 16.05C18.41 16.48 17.35 16.86 16.86 16.9C16.37 16.94 15.76 17.06 14.12 16.41C12.47 15.76 11.38 14.2 11.17 13.91C10.96 13.62 10 12.35 10 10.97C10 10.56 10.05 10.13 9.55 9.66Z"
                    fill="currentColor"
                  />
                </svg>
              </span>
              <span>WhatsApp: Comunică rapid</span>
            </a>
            <a class="btn-outline" href={`tel:${contact.phoneRaw}`} onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'contact'})">Apelează direct</a>
            <a class="btn-outline" href={whatsappMessageLink} target="_blank" rel="noopener noreferrer" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'contact'})">Trimite mesaj WhatsApp</a>
          </div>

          <p class="mt-3 text-xs text-white/90">{contactSeo.city}</p>
        </div>

        <div class="flex flex-col gap-3 border-t border-white/20 pt-5 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
          <h2 class="text-lg font-extrabold text-white">Cere o ofertă personalizată</h2>
          <p class="text-sm text-white/85">Completează detaliile evenimentului în formularul de rezervare. Revenim rapid cu o ofertă adaptată datei, locației și bugetului tău.</p>
          <a href="/rezervare/" class="btn-solid mt-2 inline-flex justify-center">Verifică disponibilitatea și cere ofertă</a>
        </div>
      </div>
    </div>

    <section class="mt-6 rounded-2xl border border-white/20 bg-white/10 p-4 sm:p-6" aria-label="Întrebări despre preț">
      <h2 class="section-title !text-2xl">Întrebări frecvente despre preț</h2>
      <p class="section-copy mt-2">
        Ca să evităm confuziile, menționăm clar: pentru Formația Florentina Pană, intervalul real este <strong>2.500-4.000 euro</strong>, în funcție de formulă și cerințele evenimentului.
      </p>

      <div class="mt-4 space-y-2">
        <details class="rounded-xl border border-white/20 bg-black/20 px-4 py-3">
          <summary class="cursor-pointer font-semibold text-white">Care este prețul formației?</summary>
          <p class="mt-2 text-sm text-white/80">Prețul transparent este 2.500-4.000 euro pentru eveniment complet (muzică live + sonorizare), în funcție de componență, locație și program.</p>
        </details>

        <details class="rounded-xl border border-white/20 bg-black/20 px-4 py-3">
          <summary class="cursor-pointer font-semibold text-white">De ce pot apărea online prețuri mai mici?</summary>
          <p class="mt-2 text-sm text-white/80">În multe cazuri, acele sume nu includ aceeași formulă live, aceeași sonorizare sau aceleași garanții contractuale. Oferta noastră este completă și transparentă.</p>
        </details>

        <details class="rounded-xl border border-white/20 bg-black/20 px-4 py-3">
          <summary class="cursor-pointer font-semibold text-white">Cum primesc prețul exact pentru data mea?</summary>
          <p class="mt-2 text-sm text-white/80">Trimite-ne data, locația și tipul de eveniment. Îți răspundem în maximum 24 de ore cu ofertă scrisă, fără costuri ascunse.</p>
        </details>
      </div>
    </section>

    <div class="mt-6">
      <ZoneAcoperite />
    </div>
  </section>

  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <style>
    .premium-offer-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 213, 122, 0.5);
      background: linear-gradient(130deg, rgba(255, 210, 118, 0.22), rgba(255, 255, 255, 0.06));
      color: #fff4d2;
      padding: 0.5rem 0.82rem;
      font-size: 0.76rem;
      font-weight: 700;
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .premium-offer-link:hover {
      transform: translateY(-1px);
      border-color: rgba(255, 231, 166, 0.8);
    }

    .contact-compact .section-title {
      font-size: clamp(1.55rem, 2.8vw, 2.1rem);
      line-height: 1.1;
    }

    .contact-compact .section-copy {
      font-size: 0.92rem;
      line-height: 1.5;
      max-width: 58ch;
    }

    .contact-compact .kicker {
      font-size: 0.72rem;
      letter-spacing: 0.2em;
    }

    .contact-compact .btn-solid,
    .contact-compact .btn-outline,
    .contact-compact .btn-whatsapp {
      min-height: 38px;
      padding: 0.52rem 0.86rem;
      font-size: 0.82rem;
    }

    @media (max-width: 767px) {
      .contact-compact {
        padding-top: 2.5rem;
        padding-bottom: 2.5rem;
      }

      .contact-compact .btn-solid,
      .contact-compact .btn-outline,
      .contact-compact .btn-whatsapp {
        width: 100%;
        max-width: 100%;
        justify-content: center;
        overflow-wrap: anywhere;
        word-break: break-word;
        white-space: normal;
        text-align: center;
      }

      .contact-compact .grid {
        min-width: 0;
      }

      .contact-compact .grid > div {
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
    }
  </style>

  <style is:global>
    @media (max-width: 767px) {
      .desktop-whatsapp-actions {
        display: none !important;
      }
    }
  </style>
</BaseLayout>

<script>
  function revealContactEmail() {
    const el = document.querySelector('.ob-email-contact');
    if (el) {
      const u = el.getAttribute('data-u');
      const d = el.getAttribute('data-d');
      if (u && d) {
        const addr = u + '@' + d;
        el.outerHTML = `<a class="btn-outline" href="mailto:${addr}" style="overflow-wrap:anywhere;word-break:break-word">Email: ${addr}</a>`;
      }
    }
  }

  revealContactEmail();
  document.addEventListener('astro:page-load', revealContactEmail);
</script>