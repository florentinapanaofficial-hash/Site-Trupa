---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import BackButton from '../components/BackButton.astro';
import ZoneAcoperite from '../components/ZoneAcoperite.astro';

const { contact } = siteContent;
const contactSeo = seo.contact;

const whatsappNumber = contact.phoneRaw.replace(/\D/g, '');
const whatsappBase = `https://wa.me/${whatsappNumber}`;
const whatsappPrefilledText = encodeURIComponent('Bună ziua! Aș dori informații pentru rezervare în sezonul 2026-2027.');
const whatsappMessageLink = `${whatsappBase}?text=${whatsappPrefilledText}`;
---

<BaseLayout title={contactSeo.meta.title} description={contactSeo.meta.description}>
  <section class="section-container contact-compact py-12" id="contact">
    <div class="mb-6"><BackButton href="/" label="Acasă" /></div>
    <div id="form-feedback" class="mb-3 hidden rounded-xl border border-lime-200/35 bg-lime-300/10 px-3 py-2 text-xs font-semibold text-lime-100" role="status" aria-live="polite"></div>

    <div class="rounded-2xl border border-white/20 bg-white/10 p-4 sm:p-6">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:items-start">
        <div>
          <p class="kicker">Contact</p>
          <h1 class="section-title">{contactSeo.h1}</h1>
          <p class="section-copy">{contactSeo.descriere}</p>
          <p class="mt-3 text-sm text-white/85">
            Dacă sunteți în etapa în care comparați opțiuni și căutați o <strong>formație nuntă preț</strong> sau <strong>prețuri formație nuntă București</strong>,
            trimiteți data, locația și bugetul estimat, iar noi revenim cu o ofertă personalizată, calibrată pe stilul evenimentului dvs.
          </p>

          <div class="lead-wizard mt-4" id="lead-wizard" data-step="1" aria-label="Planificator rapid în 3 pași">
            <p class="lead-wizard-kicker">Planificator rapid</p>
            <h2 class="lead-wizard-title">În 20 secunde pregătim solicitarea ta</h2>

            <div class="lead-wizard-steps" aria-hidden="true">
              <span class="lead-wizard-dot is-active" data-step-dot="1">1</span>
              <span class="lead-wizard-dot" data-step-dot="2">2</span>
              <span class="lead-wizard-dot" data-step-dot="3">3</span>
            </div>

            <div class="lead-step is-active" data-step-panel="1">
              <label class="form-label" for="wizard-event">Tip eveniment</label>
              <select id="wizard-event" class="input-glass mt-1" aria-label="Alege tipul de eveniment">
                <option value="">Alege opțiunea</option>
                <option>Nuntă</option>
                <option>Botez</option>
                <option>Aniversare</option>
                <option>Corporate</option>
                <option>Alt tip</option>
              </select>
              <button type="button" class="btn-outline btn-compact mt-2" data-wizard-next="2">Pasul următor</button>
            </div>

            <div class="lead-step" data-step-panel="2">
              <label class="form-label" for="wizard-date">Data evenimentului</label>
              <input id="wizard-date" class="input-glass mt-1" type="date" aria-label="Alege data evenimentului" />
              <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" class="btn-outline btn-compact" data-wizard-prev="1">Înapoi</button>
                <button type="button" class="btn-outline btn-compact" data-wizard-next="3">Pasul următor</button>
              </div>
            </div>

            <div class="lead-step" data-step-panel="3">
              <label class="form-label" for="wizard-city">Oraș / locație</label>
              <input id="wizard-city" class="input-glass mt-1" type="text" placeholder="Ex: București, Salon Magnolia" maxlength="120" aria-label="Oraș și locație" />
              <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" class="btn-outline btn-compact" data-wizard-prev="2">Înapoi</button>
                <button type="button" class="btn-solid btn-compact" id="wizard-apply">Aplică în formular</button>
              </div>
            </div>

            <p id="wizard-status" class="wizard-status" aria-live="polite"></p>
          </div>

          <a
            href="/oferta-premium/"
            class="premium-offer-link mt-3"
            onclick="window.gtag&&window.gtag('event','click_premium_offer',{event_category:'contact'})"
          >
            Vezi oferta premium 2026-2027 și serviciile incluse
          </a>

          <div class="mt-4 flex min-w-0 flex-wrap gap-2">
            <a class="btn-solid" href={`tel:${contact.phoneRaw}`} onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'contact'})">Telefon: {contact.phoneDisplay}</a>
            <span class="btn-outline ob-email-contact" data-u="contact" data-d="florentinapanaofficial.ro">Email: [email protejat]</span>
          </div>

          <div class="desktop-whatsapp-actions mt-3 flex flex-wrap gap-2" aria-label="Comunicare rapidă desktop">
            <a class="btn-whatsapp" href={whatsappBase} target="_blank" rel="noopener noreferrer" aria-label="Deschide WhatsApp pentru comunicare rapidă" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'contact'})">
              <span class="btn-whatsapp-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" fill="none">
                  <path
                    d="M20 11.89C20 16.31 16.42 19.89 12 19.89C10.7 19.89 9.46 19.58 8.37 19.03L4.67 19.92L5.59 16.35C4.98 15.24 4.63 13.97 4.63 12.63C4.63 8.21 8.21 4.63 12.63 4.63C17.05 4.63 20.63 8.21 20.63 12.63"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M9.55 9.66C9.74 9.22 9.92 9.21 10.12 9.21C10.27 9.21 10.43 9.21 10.58 9.21C10.73 9.21 10.95 9.15 11.13 9.35C11.31 9.55 11.8 10.11 11.87 10.26C11.94 10.41 11.98 10.58 11.87 10.76C11.76 10.94 11.71 11.05 11.6 11.18C11.49 11.31 11.37 11.46 11.52 11.71C11.67 11.96 12.2 12.81 13.02 13.52C14.08 14.44 14.98 14.73 15.24 14.84C15.49 14.95 15.64 14.94 15.75 14.82C15.86 14.7 16.23 14.28 16.36 14.1C16.49 13.92 16.62 13.95 16.83 14.03C17.04 14.1 18.14 14.64 18.37 14.75C18.59 14.86 18.75 14.91 18.8 15.01C18.86 15.12 18.86 15.62 18.63 16.05C18.41 16.48 17.35 16.86 16.86 16.9C16.37 16.94 15.76 17.06 14.12 16.41C12.47 15.76 11.38 14.2 11.17 13.91C10.96 13.62 10 12.35 10 10.97C10 10.56 10.05 10.13 9.55 9.66Z"
                    fill="currentColor"
                  />
                </svg>
              </span>
              <span>WhatsApp: Comunică rapid</span>
            </a>
            <a class="btn-outline" href={`tel:${contact.phoneRaw}`} onclick="window.gtag&&window.gtag('event','click_phone',{event_category:'contact'})">Apelează direct</a>
            <a class="btn-outline" href={whatsappMessageLink} target="_blank" rel="noopener noreferrer" onclick="window.gtag&&window.gtag('event','click_whatsapp',{event_category:'contact'})">Trimite mesaj WhatsApp</a>
          </div>

          <p class="mt-3 text-xs text-white/90">{contactSeo.city}</p>
        </div>

        <form
          id="form-rezervare"
          class="form-shell"
          name="rezervare-rapida"
          method="POST"
          action="/api/rezervare"
          novalidate
        >
          <p class="hidden" aria-hidden="true">
            <label>
              Nu completa acest câmp dacă ești om:
              <input name="bot-field" autocomplete="off" inputmode="none" tabindex="-1" />
            </label>
          </p>
          <input type="hidden" name="PlanificatorEveniment" id="planificator-eveniment" />
          <input type="hidden" name="PlanificatorData" id="planificator-data" />
          <input type="hidden" name="PlanificatorOras" id="planificator-oras" />
          <h2 class="text-sm font-extrabold text-white">Cere o ofertă personalizată</h2>
          <p class="mt-1 text-[11px] text-white/90">Completezi câmpurile esențiale, iar noi revenim rapid cu o ofertă premium, construită pe bugetul indicat și pe specificul evenimentului dvs.</p>

          <div class="form-grid mt-3">
            <label class="form-label">
              Nume complet
              <input class="input-glass" type="text" name="Nume" placeholder="Ex: Ionescu Andreea" autocomplete="name" maxlength="90" required />
            </label>
            <label class="form-label">
              Telefon
              <input
                class="input-glass"
                type="tel"
                name="Telefon"
                placeholder="07xx xxx xxx"
                autocomplete="tel"
                inputmode="tel"
                pattern="^(0[0-9]{9}|\+40[0-9]{9})$"
                title="Introdu un număr valid (ex: 07xxxxxxxx sau +407xxxxxxxx)"
                required
              />
            </label>
            <label class="form-label">
              Tip eveniment
              <select class="input-glass" name="Eveniment" required>
                <option value="">Alege opțiunea</option>
                <option>Nuntă</option>
                <option>Botez</option>
                <option>Aniversare</option>
                <option>Corporate</option>
                <option>Alt tip</option>
              </select>
            </label>
            <label class="form-label">
              Data evenimentului
              <input class="input-glass" type="date" name="Data" required />
            </label>
            <label class="form-label">
              Care este bugetul estimat pentru partea artistică?
              <select class="input-glass" name="Buget">
                <option value="">Îl stabilim împreună</option>
                <option>Până la 4.000 lei</option>
                <option>4.000–6.000 lei</option>
                <option>6.000–8.000 lei</option>
                <option>Peste 8.000 lei</option>
              </select>
              <span class="text-[11px] font-normal normal-case leading-snug text-white/65">
                Ne ajută să alegem formula potrivită de trupă și să vă trimitem o propunere aliniată la bugetul indicat.
              </span>
            </label>
            <label class="form-label form-label-full">
              Mesaj
              <textarea class="input-glass min-h-24 resize-y" name="Mesaj" placeholder="Spune-ne locația și atmosfera dorită" maxlength="1000"></textarea>
            </label>
          </div>

          <label class="gdpr-form-label" for="gdpr-form-consent">
            <input
              type="checkbox"
              id="gdpr-form-consent"
              name="gdpr-consent"
              value="da"
              class="gdpr-form-checkbox"
              required
              aria-required="true"
            />
            <span>
              Am citit și sunt de acord cu
              <a href="/politica-confidentialitate/" class="gdpr-form-link" target="_blank" rel="noopener noreferrer">Politica de confidențialitate</a>.
              Sunt de acord să fiu contactat(ă) în legătură cu solicitarea de rezervare.
              <span aria-hidden="true" style="color:rgba(255,120,120,0.9)"> *</span>
            </span>
          </label>

          <button type="submit" class="btn-solid btn-compact mt-3 w-full justify-center">Cere oferta personalizată</button>
          <p class="mt-2 text-[11px] leading-relaxed text-white/60">
            Datele sunt prelucrate conform
            <a href="/politica-confidentialitate/" class="gdpr-form-link">Politicii de confidențialitate</a>.
            Nu trimitem mesaje promoționale fără acord separat.
          </p>
        </form>
      </div>
    </div>

    <!-- Google Maps -->
    <div class="mt-6 space-y-3">
      <a
        href="https://www.google.com/maps/search/?api=1&query=Calea+Craiovei+nr.152,+Pitesti,+Arges"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm text-[#7dd3fc] underline transition hover:text-[#38bdf8]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Deschide în Google Maps
      </a>
      <iframe
        src="https://www.google.com/maps?q=Calea+Craiovei+nr.152,+Pitesti,+Arges&output=embed"
        width="100%"
        height="300"
        style="border:0; border-radius:0.75rem;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Locație Formația Florentina Pană pe Google Maps"
      ></iframe>
    </div>

    <!-- Zone acoperite — relevant pentru cine vrea să rezerve -->
    <ZoneAcoperite />
  </section>

  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(seo.schema)} />
  </Fragment>

  <script is:inline>
    const feedbackEl = document.getElementById('form-feedback');
    const feedbackType = new URLSearchParams(window.location.search).get('trimis');
    const funnelSessionKey = 'lead_funnel_session_id';
    let existingFunnelSession = null;

    try {
      existingFunnelSession = window.sessionStorage?.getItem(funnelSessionKey);
    } catch {
      existingFunnelSession = null;
    }

    const funnelSessionId = existingFunnelSession || `funnel_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

    if (!existingFunnelSession) {
      try {
        window.sessionStorage?.setItem(funnelSessionKey, funnelSessionId);
      } catch {
        // Storage-ul poate fi blocat pe unele browsere mobile; nu oprim formularul.
      }
    }

    const trackLeadEvent = (eventName, extra = {}) => {
      if (typeof window.gtag !== 'function') return;

      window.gtag('event', eventName, {
        event_category: 'contact',
        funnel_session_id: funnelSessionId,
        page_path: window.location.pathname,
        ...extra,
      });
    };

    if (feedbackEl && feedbackType === 'rezervare') {
      feedbackEl.textContent = 'Solicitarea de rezervare a fost trimisă. Te contactăm în cel mai scurt timp.';
      feedbackEl.classList.remove('hidden');
    }

    const phoneInput = document.querySelector('input[name="Telefon"]');
    const gdprCheckbox = document.getElementById('gdpr-form-consent');
    const gdprLabel = document.querySelector('.gdpr-form-label');

    if (phoneInput instanceof HTMLInputElement) {
      const phoneMessage = 'Numărul trebuie să fie în format 07xxxxxxxx sau +407xxxxxxxx.';

      phoneInput.addEventListener('invalid', () => {
        if (phoneInput.validity.patternMismatch) {
          phoneInput.setCustomValidity(phoneMessage);
        } else {
          phoneInput.setCustomValidity('');
        }
      });

      phoneInput.addEventListener('input', () => {
        phoneInput.setCustomValidity('');
      });
    }

    const form = document.getElementById('form-rezervare');
    const wizard = document.getElementById('lead-wizard');
    let formStarted = false;
    const completedWizardSteps = new Set();

    const clearFormErrorState = () => {
      if (!(form instanceof HTMLFormElement)) return;

      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => {
        field.setAttribute('aria-invalid', 'false');
      });

      if (gdprLabel instanceof HTMLElement) {
        gdprLabel.classList.remove('is-invalid');
      }
    };

    const showFormFeedback = (message, isError = false) => {
      if (!feedbackEl) return;

      feedbackEl.textContent = message;
      feedbackEl.classList.remove('hidden');

      if (isError) {
        feedbackEl.style.borderColor = 'rgba(248,113,113,0.45)';
        feedbackEl.style.background = 'rgba(127,29,29,0.28)';
        feedbackEl.style.color = '#fecaca';
      } else {
        feedbackEl.style.borderColor = '';
        feedbackEl.style.background = '';
        feedbackEl.style.color = '';
      }

      feedbackEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const showSuccessFeedback = (message) => {
      if (!feedbackEl) return;

      feedbackEl.textContent = message;
      feedbackEl.classList.remove('hidden');
      feedbackEl.style.borderColor = 'rgba(74,222,128,0.45)';
      feedbackEl.style.background = 'rgba(20,83,45,0.28)';
      feedbackEl.style.color = '#bbf7d0';
      feedbackEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const validateForm = () => {
      if (!(form instanceof HTMLFormElement)) {
        return { ok: false, message: 'Formularul nu este disponibil.' };
      }

      clearFormErrorState();

      const nameInput = form.querySelector('input[name="Nume"]');
      const eventInput = form.querySelector('select[name="Eveniment"]');
      const dateInput = form.querySelector('input[name="Data"]');
      const messageInput = form.querySelector('textarea[name="Mesaj"]');
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const setInvalid = (field, message) => {
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
          field.setAttribute('aria-invalid', 'true');
        }

        return message;
      };

      if (nameInput instanceof HTMLInputElement && !nameInput.value.trim()) {
        return { ok: false, message: setInvalid(nameInput, 'Completează numele și prenumele.') };
      }

      if (phoneInput instanceof HTMLInputElement) {
        const phoneValue = phoneInput.value.trim();
        if (!phoneValue) {
          return { ok: false, message: setInvalid(phoneInput, 'Completează numărul de telefon.') };
        }

        if (!/^(0[0-9]{9}|\+40[0-9]{9})$/.test(phoneValue)) {
          return { ok: false, message: setInvalid(phoneInput, 'Numărul trebuie să fie în format 07xxxxxxxx sau +407xxxxxxxx.') };
        }
      }

      if (eventInput instanceof HTMLSelectElement && !eventInput.value) {
        return { ok: false, message: setInvalid(eventInput, 'Alege tipul evenimentului.') };
      }

      if (dateInput instanceof HTMLInputElement) {
        const dateValue = dateInput.value.trim();
        if (!dateValue) {
          return { ok: false, message: setInvalid(dateInput, 'Selectează data evenimentului.') };
        }

        const selectedDate = new Date(`${dateValue}T00:00:00`);
        if (Number.isNaN(selectedDate.getTime()) || selectedDate < today) {
          return { ok: false, message: setInvalid(dateInput, 'Data evenimentului nu poate fi în trecut.') };
        }
      }

      if (gdprCheckbox instanceof HTMLInputElement && !gdprCheckbox.checked) {
        if (gdprLabel instanceof HTMLElement) {
          gdprLabel.classList.add('is-invalid');
        }

        gdprCheckbox.setAttribute('aria-invalid', 'true');
        return { ok: false, message: 'Trebuie să accepți Politica de confidențialitate pentru a trimite formularul.' };
      }

      if (messageInput instanceof HTMLTextAreaElement) {
        messageInput.setAttribute('aria-invalid', 'false');
      }

      return { ok: true, message: '' };
    };

    const setWizardStep = (step) => {
      if (!wizard) return;
      wizard.setAttribute('data-step', String(step));

      const panels = wizard.querySelectorAll('[data-step-panel]');
      panels.forEach((panel) => {
        const panelStep = Number(panel.getAttribute('data-step-panel'));
        panel.classList.toggle('is-active', panelStep === step);
      });

      const dots = wizard.querySelectorAll('[data-step-dot]');
      dots.forEach((dot) => {
        const dotStep = Number(dot.getAttribute('data-step-dot'));
        dot.classList.toggle('is-active', dotStep <= step);
      });
    };

    if (wizard) {
      const wizardEvent = document.getElementById('wizard-event');
      const wizardDate = document.getElementById('wizard-date');
      const wizardCity = document.getElementById('wizard-city');
      const wizardStatus = document.getElementById('wizard-status');
      const hiddenEvent = document.getElementById('planificator-eveniment');
      const hiddenDate = document.getElementById('planificator-data');
      const hiddenCity = document.getElementById('planificator-oras');

      wizard.querySelectorAll('[data-wizard-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetStep = Number(btn.getAttribute('data-wizard-next'));

          if (targetStep === 2 && wizardEvent instanceof HTMLSelectElement && !wizardEvent.value) {
            wizardStatus.textContent = 'Alege tipul de eveniment pentru a continua.';
            return;
          }

          if (targetStep === 3 && wizardDate instanceof HTMLInputElement && !wizardDate.value) {
            wizardStatus.textContent = 'Selectează data evenimentului pentru a continua.';
            return;
          }

          wizardStatus.textContent = '';
          setWizardStep(targetStep);

          const completedStep = targetStep - 1;
          if (!completedWizardSteps.has(completedStep)) {
            completedWizardSteps.add(completedStep);
            trackLeadEvent('lead_wizard_step_complete', {
              step: completedStep,
            });
          }
        });
      });

      wizard.querySelectorAll('[data-wizard-prev]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetStep = Number(btn.getAttribute('data-wizard-prev'));
          wizardStatus.textContent = '';
          setWizardStep(targetStep);
        });
      });

      const applyBtn = document.getElementById('wizard-apply');
      if (applyBtn) {
        applyBtn.addEventListener('click', () => {
          if (!(wizardEvent instanceof HTMLSelectElement) || !(wizardDate instanceof HTMLInputElement) || !(wizardCity instanceof HTMLInputElement)) return;

          const eventVal = wizardEvent.value.trim();
          const dateVal = wizardDate.value.trim();
          const cityVal = wizardCity.value.trim();

          if (!eventVal || !dateVal || !cityVal) {
            if (wizardStatus) wizardStatus.textContent = 'Completează toate cele 3 câmpuri pentru a aplica în formular.';
            return;
          }

          const eventSelect = form?.querySelector('select[name="Eveniment"]');
          const dateInput = form?.querySelector('input[name="Data"]');
          const messageInput = form?.querySelector('textarea[name="Mesaj"]');

          if (eventSelect instanceof HTMLSelectElement) {
            eventSelect.value = eventVal;
          }

          if (dateInput instanceof HTMLInputElement) {
            dateInput.value = dateVal;
          }

          if (messageInput instanceof HTMLTextAreaElement) {
            const intro = `Detalii rapide: ${eventVal}, data ${dateVal}, locație ${cityVal}.`;
            if (!messageInput.value.includes(intro)) {
              messageInput.value = `${intro}\n${messageInput.value}`.trim();
            }
          }

          if (hiddenEvent instanceof HTMLInputElement) hiddenEvent.value = eventVal;
          if (hiddenDate instanceof HTMLInputElement) hiddenDate.value = dateVal;
          if (hiddenCity instanceof HTMLInputElement) hiddenCity.value = cityVal;

          if (wizardStatus) {
            wizardStatus.textContent = 'Perfect! Am pregătit formularul. Mai completezi numele și telefonul.';
          }

          trackLeadEvent('lead_wizard_apply');

          const nameInput = form?.querySelector('input[name="Nume"]');
          if (nameInput instanceof HTMLInputElement) {
            nameInput.focus();
          }
        });
      }

      if (wizardEvent instanceof HTMLSelectElement) {
        wizardEvent.addEventListener('focus', () => {
          trackLeadEvent('lead_wizard_start');
        }, { once: true });
      }
    }

    if (form) {
      const trackFormStart = () => {
        if (formStarted) return;
        formStarted = true;
        trackLeadEvent('lead_form_start');
      };

      form.querySelectorAll('input, select, textarea').forEach((el) => {
        el.addEventListener('focus', trackFormStart, { once: true });
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const validation = validateForm();
        if (!validation.ok) {
          showFormFeedback(validation.message, true);

          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid instanceof HTMLElement) {
            firstInvalid.focus({ preventScroll: true });
          }

          trackLeadEvent('lead_submit_validation_error');
          return;
        }

        trackLeadEvent('generate_lead', { event_label: 'form-submit-attempt' });
        trackLeadEvent('lead_submit_attempt');

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Se trimite...';
        }

        if (feedbackEl) {
          feedbackEl.classList.add('hidden');
          feedbackEl.textContent = '';
          feedbackEl.style.borderColor = '';
          feedbackEl.style.background = '';
          feedbackEl.style.color = '';
        }

        try {
          const res = await fetch('/api/rezervare', {
            method: 'POST',
            body: new FormData(form),
          });

          const responseText = await res.text();

          let json = null;
          if (responseText) {
            try {
              json = JSON.parse(responseText);
            } catch {
              json = null;
            }
          }

          if (res.ok && json?.ok) {
            trackLeadEvent('lead_submit_success');
            if (form instanceof HTMLFormElement) {
              form.reset();
            }

            showSuccessFeedback('Mesajul a fost trimis cu succes. Revenim către tine în cel mai scurt timp.');
          } else {
            trackLeadEvent('lead_submit_error');
            const serverMessage = json?.error || responseText.trim() || `Serverul a răspuns cu status ${res.status}.`;
            showFormFeedback(serverMessage, true);
          }
        } catch (error) {
          trackLeadEvent('lead_submit_network_error');

          if (typeof form.submit === 'function') {
            showFormFeedback('Nu am putut trimite prin JavaScript. Folosesc trimiterea clasică a formularului.', true);
            form.submit();
            return;
          }

          console.error('[/contact] submit error:', error);
          showFormFeedback('Nu am putut trimite formularul. Încearcă din nou sau contactează-ne direct.', true);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Trimite solicitarea';
          }
        }
      });
    }
  </script>

