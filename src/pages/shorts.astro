<script>
  type YTPlayer = {
    playVideo: () => void;
    pauseVideo: () => void;
    seekTo: (s: number, allow: boolean) => void;
    mute: () => void;
    unMute: () => void;
    setVolume: (v: number) => void;
    setPlaybackQuality?: (quality: string) => void;
  };

  declare global {
    interface Window {
      YT?: any;
      onYouTubeIframeAPIReady?: () => void;
      Stream?: (el: HTMLIFrameElement) => any;
      FB?: {
        init?: (options: { xfbml: boolean; version: string }) => void;
        XFBML?: { parse: (el?: HTMLElement) => void };
      };
      fbAsyncInit?: () => void;
    }
  }

  // Interfață uniformă peste playerele YouTube și Cloudflare Stream
  type PlayerCtl = {
    play: () => void;
    pause: () => void;
    reset: () => void;
    setMuted: (m: boolean) => void;
  };

  // Sursa de adevăr e window.FPConsent (BaseLayout). Cheia `video_consent` e izolată
  // de analiză/marketing — acordul pentru redare NU pornește GA4, Meta sau TikTok.
  function hasVideoConsent(): boolean {
    try {
      const api = (window as { FPConsent?: { video?: () => boolean } }).FPConsent;
      if (api?.video) return api.video() === true;
      return localStorage.getItem('video_consent') === 'granted';
    } catch {
      return false;
    }
  }

  // Comentariile Meta sunt o suprafață de marketing, nu de conținut video: SDK-ul
  // nu se injectează decât cu `fp_consent.marketing`.
  function hasMarketingConsent(): boolean {
    try {
      const api = (window as { FPConsent?: { read?: () => { marketing?: boolean } | null } }).FPConsent;
      if (api?.read) return api.read()?.marketing === true;
      const raw = localStorage.getItem('fp_consent');
      return raw ? JSON.parse(raw).marketing === true : false;
    } catch {
      return false;
    }
  }

  function initShorts(): void {
    const overlay = document.getElementById('reels-overlay');
    const feed = document.getElementById('reels-feed');
    if (!overlay || !feed || overlay.dataset.shortsInit === 'true') return;
    overlay.dataset.shortsInit = 'true';

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-reel]'));
    if (!cards.length) return;

    const consentAbort = new AbortController();
    const players = new Map<number, PlayerCtl>();
    const ready = new Set<number>();
    let isMuted = true;          // autoplay policy: primul clip pornește pe mute
    let activeIndex = -1;
    let settledIndex = -1;
    let playbackTimer = 0;
    let scrollEndTimer = 0;
    let initialPlaybackTimer = 0;
    let preloadObserver: IntersectionObserver | null = null;
    let isScrolling = false;

    function enforceHDPlayback(player: YTPlayer) {
      if (!player.setPlaybackQuality) return;
      player.setPlaybackQuality('hd1080');
      window.setTimeout(() => player.setPlaybackQuality?.('hd1080'), 700);
    }

    function fitYouTubeFrame(card: HTMLElement) {
      const media = card.querySelector<HTMLElement>('.reel-media--yt');
      if (!media) return;
      const rect = card.getBoundingClientRect();
      const scale = Math.max(rect.width / 1080, rect.height / 1920);
      requestAnimationFrame(() => {
        media.style.setProperty('--reel-yt-scale', String(Math.max(scale, 0.01)));
      });
    }

    const resizeObserver = new ResizeObserver((entries) => {
      entries.forEach((entry) => fitYouTubeFrame(entry.target as HTMLElement));
    });
    cards.forEach((card) => {
      if (card.dataset.provider !== 'cloudflare') resizeObserver.observe(card);
    });

    /* ─── Încarcă YouTube IFrame API o singură dată ─── */
    function loadYouTubeAPI(cb: () => void) {
      if (window.YT && window.YT.Player) { cb(); return; }
      const existing = document.getElementById('youtube-iframe-api');
      const prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => { if (typeof prev === 'function') prev(); cb(); };
      if (existing) return;
      const tag = document.createElement('script');
      tag.id = 'youtube-iframe-api';
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    }

    /* ─── Încarcă Cloudflare Stream SDK o singură dată ─── */
    function loadCloudflareSDK(cb: () => void) {
      if (window.Stream) { cb(); return; }
      const existing = document.getElementById('cf-stream-sdk');
      if (existing) { existing.addEventListener('load', cb); return; }
      const tag = document.createElement('script');
      tag.id = 'cf-stream-sdk';
      tag.src = 'https://embed.cloudflarestream.com/embed/sdk.latest.js';
      tag.addEventListener('load', cb);
      document.head.appendChild(tag);
    }

    /* ─── Creează un singur player YouTube, la cerere (lazy) ─── */
    const builtPlayers = new Set<number>();

    function buildYouTubePlayer(index: number) {
      if (builtPlayers.has(index)) return;
      const card = cards[index];
      if (!card || card.dataset.provider === 'cloudflare') return;
      const videoId = card.dataset.videoId || '';
      const mount = card.querySelector<HTMLElement>('[data-player]');
      if (!mount || !videoId) return;
      builtPlayers.add(index);

      new window.YT.Player(mount.id, {
          videoId,
          width: '1080',
          height: '1920',
          host: 'https://www.youtube-nocookie.com',
          playerVars: {
            autoplay: 1,
            controls: 0,
            enablejsapi: 1,
            modestbranding: 1,
            rel: 0,
            playsinline: 1,
            loop: 1,
            playlist: videoId,   // necesar pentru loop pe un singur clip
            fs: 0,
            disablekb: 1,
            iv_load_policy: 3,
            mute: 1,
            vq: 'hd1080',
            origin: window.location.origin,
          },
          events: {
            onReady: (e: { target: YTPlayer }) => {
              const yt = e.target;
              enforceHDPlayback(yt);
              fitYouTubeFrame(card);
              const ctl: PlayerCtl = {
                play: () => yt.playVideo(),
                pause: () => yt.pauseVideo(),
                reset: () => yt.seekTo(0, true),
                setMuted: (m: boolean) => { if (m) yt.mute(); else { yt.unMute(); yt.setVolume(100); } },
              };
              players.set(index, ctl);
              ready.add(index);
              // Cardul deja vizat (ex: primul, la încărcarea paginii): apelăm play()
              // explicit (fără seekTo, ca să nu forțăm un re-buffer de la zero care
              // arată un cadru negru) — necesar fiindcă yt.mute() de mai sus poate
              // întrerupe autoplay-ul nativ pornit deja de player prin URL.
              if (!isScrolling && index === settledIndex && activeIndex === -1) {
                activeIndex = index;
                ctl.setMuted(isMuted);
                ctl.play();
              } else {
                ctl.pause();
                if (!isScrolling && index === settledIndex) settlePlayback();
              }
            },
            onStateChange: (e: { target: YTPlayer; data: number }) => {
              if (e.data === window.YT.PlayerState.PLAYING) {
                enforceHDPlayback(e.target);
                card.classList.add('is-playing');
              } else if (e.data === window.YT.PlayerState.PAUSED || e.data === window.YT.PlayerState.CUED) {
                card.classList.remove('is-playing');
              }
              // 0 = ENDED → reia (siguranță suplimentară pe lângă loop)
              if (e.data === 0 && index === activeIndex) {
                const p = players.get(index);
                if (p) { p.reset(); p.play(); }
              }
            },
          },
        });
    }

    /* ─── Preîncarcă playerul cardului curent + vecinii, înainte să fie nevoie ─── */
    function initYouTubePlayers() {
      buildYouTubePlayer(0);
      buildYouTubePlayer(1);

      preloadObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = Number((entry.target as HTMLElement).dataset.index);
          buildYouTubePlayer(index);
        });
      }, { root: feed, rootMargin: '150% 0px', threshold: 0 });

      cards.forEach((card) => {
        if (card.dataset.provider !== 'cloudflare') preloadObserver?.observe(card);
      });
    }

    /* ─── Creează playere Cloudflare Stream ─── */
    function buildCloudflarePlayers() {
      if (!window.Stream) return;
      cards.forEach((card) => {
        if (card.dataset.provider !== 'cloudflare') return;
        const index = Number(card.dataset.index);
        const iframe = card.querySelector<HTMLIFrameElement>('[data-cf]');
        if (!iframe) return;
        const cf = window.Stream!(iframe);
        cf.muted = true;
        cf.loop = true;
        const ctl: PlayerCtl = {
          play: () => { const pr = cf.play(); if (pr && typeof pr.catch === 'function') pr.catch(() => {}); },
          pause: () => cf.pause(),
          reset: () => { try { cf.currentTime = 0; } catch { /* noop */ } },
          setMuted: (m: boolean) => { cf.muted = m; },
        };
        players.set(index, ctl);
        ready.add(index);
        if (!isScrolling && index === settledIndex) settlePlayback();
      });
    }

    function startPlayback(index: number) {
      const p = players.get(index);
      if (!p) return;
      cards[index]?.classList.remove('is-playing');
      p.setMuted(isMuted);
      p.reset();
      p.play();
    }

    function stopPlayback(index: number) {
      const p = players.get(index);
      if (!p) return;
      p.pause();
      p.reset();
      cards[index]?.classList.remove('is-playing');
    }

    function settlePlayback() {
      window.clearTimeout(playbackTimer);
      if (settledIndex === -1 || settledIndex === activeIndex) return;
      // Playerul poate să nu fie încă gata (creat) — nu marca activeIndex până
      // nu există efectiv, altfel onReady crede că e deja activ și îl pune pauză.
      if (!players.has(settledIndex)) return;
      if (activeIndex !== -1) stopPlayback(activeIndex);
      activeIndex = settledIndex;
      startPlayback(activeIndex);
    }

    /* ─── IntersectionObserver: selectează cardul la ≥80%; playback după scroll ─── */
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const card = entry.target as HTMLElement;
        const index = Number(card.dataset.index);
        if (entry.isIntersecting && entry.intersectionRatio >= 0.8) {
          settledIndex = index;
        } else if (settledIndex === index && entry.intersectionRatio < 0.8) {
          settledIndex = -1;
        }
        if (activeIndex === index && entry.intersectionRatio < 0.8) {
          stopPlayback(index);
          activeIndex = -1;
        }
      });
    }, { threshold: [0, 0.8, 1] });

    cards.forEach((card) => io.observe(card));

    function onScrollSettled() {
      window.clearTimeout(scrollEndTimer);
      isScrolling = false;
      settlePlayback();
    }

    feed.addEventListener('scroll', () => {
      isScrolling = true;
      window.clearTimeout(playbackTimer);
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(onScrollSettled, 80);
    }, { passive: true });
    feed.addEventListener('scrollend', onScrollSettled, { passive: true });

    /* ─── Sunet global (Mute / Unmute) ─── */
    function applyMuteState() {
      overlay!.dataset.muted = String(isMuted);
      players.forEach((p) => p.setMuted(isMuted));
    }

    /* ─── Like: persistență în localStorage, fără login ─── */
    const likeKey = (id: string) => `liked_shorts_${id}`;

    function initLikes() {
      cards.forEach((card) => {
        const id = card.dataset.id || '';
        const btn = card.querySelector<HTMLElement>('[data-like-btn]');
        const countEl = card.querySelector<HTMLElement>('[data-like-count]');
        if (!btn || !countEl) return;
        const base = Number(card.dataset.likes || 0);
        const liked = localStorage.getItem(likeKey(id)) === '1';
        if (liked) {
          btn.classList.add('is-liked');
          countEl.textContent = (base + 1).toLocaleString('ro-RO');
        }
      });
    }

    function setLike(card: HTMLElement, liked: boolean) {
      const id = card.dataset.id || '';
      const btn = card.querySelector<HTMLElement>('[data-like-btn]');
      const countEl = card.querySelector<HTMLElement>('[data-like-count]');
      if (!btn || !countEl) return;
      const base = Number(card.dataset.likes || 0);
      const already = btn.classList.contains('is-liked');
      if (liked === already) return;
      btn.classList.toggle('is-liked', liked);
      if (liked) {
        localStorage.setItem(likeKey(id), '1');
        countEl.textContent = (base + 1).toLocaleString('ro-RO');
        const actionIcon = btn.querySelector<HTMLElement>('.reel-action-icon');
        if (actionIcon) {
          actionIcon.style.animation = 'none';
          requestAnimationFrame(() => {
            actionIcon.style.animation = '';
          });
        }
      } else {
        localStorage.removeItem(likeKey(id));
        countEl.textContent = base.toLocaleString('ro-RO');
      }
    }

    function triggerHeartBurst(card: HTMLElement) {
      const burst = card.querySelector<HTMLElement>('[data-heart-burst]');
      if (!burst) return;
      burst.classList.remove('is-active');
      requestAnimationFrame(() => burst.classList.add('is-active'));
      const clear = () => burst.classList.remove('is-active');
      burst.addEventListener('animationend', clear, { once: true });
    }

    function flashPlayPause(card: HTMLElement) {
      const icon = card.querySelector<HTMLElement>('[data-playpause]');
      if (!icon) return;
      icon.classList.add('is-visible');
      window.setTimeout(() => icon.classList.remove('is-visible'), 500);
    }

    /* ─── Comentarii Meta: SDK injectat doar cu acord de marketing ─── */
    const commentsPanel = document.getElementById('reels-comments');
    const commentsGate = commentsPanel?.querySelector<HTMLElement>('[data-comments-gate]') ?? null;
    const commentsWidget = commentsPanel?.querySelector<HTMLElement>('[data-comments-widget]') ?? null;
    const commentsStatus = commentsPanel?.querySelector<HTMLElement>('[data-comments-status]') ?? null;
    const commentsFallback = commentsPanel?.querySelector<HTMLElement>('[data-comments-fallback]') ?? null;
    const fbMount = commentsPanel?.querySelector<HTMLElement>('.fb-comments') ?? null;
    const SHEET_SLIDE_MS = 300;
    let fbSdkRequested = false;
    let commentsParseTimer = 0;
    let commentsWatchdog = 0;
    let commentsSettleTimer = 0;

    const logComments = (...args: unknown[]) => console.info('[reels:comments]', ...args);

    logComments('noduri', {
      panel: !!commentsPanel,
      gate: !!commentsGate,
      widget: !!commentsWidget,
      status: !!commentsStatus,
      fallback: !!commentsFallback,
      mount: !!fbMount,
    });

    function showCommentsFallback() {
      if (commentsStatus) commentsStatus.hidden = true;
      if (commentsFallback) commentsFallback.hidden = false;
      logComments('fallback afișat');
    }

    // Plugin-ul randează un <iframe> în .fb-comments; până apare, zona nu rămâne goală.
    function watchCommentsRender() {
      window.clearTimeout(commentsWatchdog);
      const startedAt = Date.now();
      const tick = () => {
        try {
          if (fbMount?.querySelector('iframe')) {
            if (commentsStatus) commentsStatus.hidden = true;
            if (commentsFallback) commentsFallback.hidden = true;
            logComments('iframe randat');
            return;
          }
          if (Date.now() - startedAt > 8000) {
            logComments('8s fără iframe');
            showCommentsFallback();
            return;
          }
          commentsWatchdog = window.setTimeout(tick, 400);
        } catch (err) {
          logComments('watchdog a eșuat', err);
          showCommentsFallback();
        }
      };
      tick();
    }

    function parseComments() {
      try {
        if (window.FB?.XFBML?.parse) {
          logComments('FB.XFBML.parse()');
          window.FB.XFBML.parse(commentsWidget ?? undefined);
        } else {
          logComments('FB.XFBML indisponibil la parsare');
        }
      } catch (err) {
        logComments('parsarea a eșuat', err);
      }
      watchCommentsRender();
    }

    // Parsarea se amână până după culisarea panoului: altfel plugin-ul măsoară
    // containerul în timp ce e încă translatat și randează la lățime greșită.
    function parseCommentsAfterSlide() {
      window.clearTimeout(commentsParseTimer);
      commentsParseTimer = window.setTimeout(parseComments, SHEET_SLIDE_MS);
    }

    function loadFacebookSDK() {
      if (fbSdkRequested) return;
      fbSdkRequested = true;

      try {
        if (!document.getElementById('fb-root')) {
          const root = document.createElement('div');
          root.id = 'fb-root';
          document.body.appendChild(root);
        }

        // `load` pe script garantează doar descărcarea; `fbAsyncInit` e apelat de SDK
        // abia după ce FB.XFBML există efectiv în memorie.
        window.fbAsyncInit = () => {
          try {
            logComments('fbAsyncInit');
            window.FB?.init?.({ xfbml: false, version: 'v21.0' });
            parseCommentsAfterSlide();
          } catch (err) {
            logComments('fbAsyncInit a eșuat', err);
            showCommentsFallback();
          }
        };

        const tag = document.createElement('script');
        tag.id = 'facebook-jssdk';
        tag.src = 'https://connect.facebook.net/ro_RO/sdk.js';
        tag.async = true;
        tag.defer = true;
        tag.crossOrigin = 'anonymous';
        // Blocantele de reclame opresc cererea: afișăm imediat, fără să așteptăm watchdog-ul.
        tag.addEventListener('error', () => {
          logComments('SDK blocat sau indisponibil');
          showCommentsFallback();
        });
        document.body.appendChild(tag);
        logComments('SDK cerut');

        watchCommentsRender();
      } catch (err) {
        logComments('injectarea SDK a eșuat', err);
        showCommentsFallback();
      }
    }

    function syncCommentsConsent() {
      try {
        const granted = hasMarketingConsent();
        logComments('acord marketing', granted);
        if (commentsGate) commentsGate.hidden = granted;
        if (commentsWidget) commentsWidget.hidden = !granted;
        if (!granted) return;
        if (commentsStatus) commentsStatus.hidden = false;
        if (commentsFallback) commentsFallback.hidden = true;
        if (fbSdkRequested) parseCommentsAfterSlide();
        else loadFacebookSDK();
      } catch (err) {
        logComments('sincronizarea stărilor a eșuat', err);
        showCommentsFallback();
      }
    }

    const commentsOpen = () => commentsPanel?.classList.contains('is-open') === true;

    function toggleComments(open: boolean) {
      if (!commentsPanel) {
        logComments('panoul lipsește din DOM');
        return;
      }
      logComments('toggle', open);
      window.clearTimeout(commentsSettleTimer);
      commentsPanel.classList.toggle('is-open', open);
      commentsPanel.setAttribute('aria-hidden', String(!open));

      if (!open) {
        commentsPanel.classList.remove('is-settled');
        return;
      }

      syncCommentsConsent();
      commentsSettleTimer = window.setTimeout(
        () => commentsPanel.classList.add('is-settled'),
        SHEET_SLIDE_MS + 50,
      );
      // Focus doar pe poartă; când widgetul e activ, focusul aparține iframe-ului Meta.
      if (commentsGate && !commentsGate.hidden) {
        commentsPanel.querySelector<HTMLElement>('[data-open-consent]')?.focus({ preventScroll: true });
      }
    }

    // Gesturile din foaie nu ajung la feedul cu scroll-snap și nici la plasa de
    // siguranță care repornește playerul. Interiorul iframe-ului Meta e cross-origin,
    // deci nu propagă nimic — izolarea privește doar elementele proprii ale foii.
    const commentsSheet = commentsPanel?.querySelector<HTMLElement>('.reels-comments-sheet') ?? null;

    (['pointerdown', 'touchstart'] as const).forEach((evt) => {
      commentsSheet?.addEventListener(evt, (ev) => ev.stopPropagation(), {
        passive: true,
        signal: consentAbort.signal,
      });
    });

    commentsSheet?.addEventListener('click', (ev) => {
      ev.stopPropagation();
      const target = ev.target as HTMLElement;
      if (target.closest('[data-comments-close]')) {
        toggleComments(false);
        return;
      }
      if (target.closest('[data-open-consent]')) {
        toggleComments(false);
        window.dispatchEvent(new CustomEvent('fp:open-consent'));
      }
    }, { signal: consentAbort.signal });

    // Acordul dat din bannerul granular activează widgetul fără reîncărcare.
    window.addEventListener('fp:consent-updated', () => {
      if (commentsOpen()) syncCommentsConsent();
    }, { signal: consentAbort.signal });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && commentsOpen()) toggleComments(false);
    }, { signal: consentAbort.signal });

    /* ─── Delegare evenimente pe overlay ─── */
    overlay.addEventListener('click', (ev) => {
      const target = ev.target as HTMLElement;

      const consentBtn = target.closest<HTMLElement>('[data-reels-consent-accept]');
      if (consentBtn) {
        try { localStorage.setItem('video_consent', 'granted'); } catch { /* mod privat strict */ }
        window.dispatchEvent(new CustomEvent('video:granted'));
        return;
      }

      if (target.closest<HTMLElement>('[data-comments-btn]')) {
        toggleComments(true);
        return;
      }

      if (target.closest<HTMLElement>('[data-comments-backdrop]')) {
        toggleComments(false);
        return;
      }

      const likeBtn = target.closest<HTMLElement>('[data-like-btn]');
      if (likeBtn) {
        const card = likeBtn.closest<HTMLElement>('[data-reel]')!;
        setLike(card, !likeBtn.classList.contains('is-liked'));
        return;
      }

      const shareBtn = target.closest<HTMLElement>('[data-share-btn]');
      if (shareBtn) {
        handleShare(shareBtn);
        return;
      }

      const muteBtn = target.closest<HTMLElement>('[data-mute-btn]');
      if (muteBtn) {
        isMuted = !isMuted;
        applyMuteState();
        return;
      }

      const caption = target.closest<HTMLElement>('[data-caption]');
      if (caption) {
        caption.classList.toggle('is-expanded');
        return;
      }
    });

    /* ─── Tap / Double-tap pe zona video ─── */
    let lastTap = 0;
    let tapTimer = 0;
    cards.forEach((card) => {
      const tapLayer = card.querySelector<HTMLElement>('[data-tap]');
      if (!tapLayer) return;
      tapLayer.addEventListener('click', () => {
        const now = Date.now();
        if (now - lastTap < 280) {
          // DOUBLE TAP → like + inimă
          window.clearTimeout(tapTimer);
          lastTap = 0;
          setLike(card, true);
          triggerHeartBurst(card);
        } else {
          // SINGLE TAP → play / pause (după fereastra de dublu-tap)
          lastTap = now;
          tapTimer = window.setTimeout(() => {
            const index = Number(card.dataset.index);
            const p = players.get(index);
            if (!p) return;
            // Toggle simplu: dacă e activ, pune pauză; altfel redă
            if (card.dataset.paused === '1') {
              card.dataset.paused = '0';
              p.play();
            } else {
              card.dataset.paused = '1';
              p.pause();
            }
            flashPlayPause(card);
          }, 280);
        }
      });
    });

    /* ─── Share: Web Share API sau clipboard ─── */
    async function handleShare(btn: HTMLElement) {
      const url = btn.dataset.url || location.href;
      const shareData = {
        title: 'Formația Florentina Pană — Reels',
        text: 'Vezi acest moment live 🎶',
        url,
      };
      try {
        if (navigator.share) {
          await navigator.share(shareData);
          return;
        }
      } catch { /* utilizatorul a anulat — ignoră */ }
      try {
        await navigator.clipboard.writeText(url);
        showToast('Link copiat în clipboard');
      } catch {
        showToast('Nu s-a putut copia linkul');
      }
    }

    let toastTimer = 0;
    function showToast(msg: string) {
      let toast = document.getElementById('reels-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'reels-toast';
        toast.setAttribute('role', 'status');
        toast.style.cssText = 'position:absolute;left:50%;bottom:6rem;transform:translateX(-50%);z-index:30;background:rgba(20,20,20,.92);color:#fff;padding:.6rem 1rem;border-radius:9999px;font-size:.85rem;opacity:0;transition:opacity .2s ease;pointer-events:none;';
        overlay!.appendChild(toast);
      }
      toast.textContent = msg;
      requestAnimationFrame(() => { toast!.style.opacity = '1'; });
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toast!.style.opacity = '0'; }, 1800);
    }

    /* ─── Pornire ─── */
    initLikes();

    const gate = document.getElementById('reels-consent');
    const hasYouTube = cards.some((c) => c.dataset.provider !== 'cloudflare');
    const hasCloudflare = cards.some((c) => c.dataset.provider === 'cloudflare');
    let mediaBooted = false;

    // Plasă de siguranță: dacă browserul blochează silențios play() înainte de
    // orice gest al utilizatorului, reîncercăm la primul tap/scroll/tastă.
    let firstGestureHandled = false;
    function unlockActivePlayback() {
      if (firstGestureHandled) return;
      firstGestureHandled = true;
      const p = activeIndex !== -1 ? players.get(activeIndex) : undefined;
      if (p) p.play();
    }

    // Embed-urile terțe pornesc doar după `video_consent`: iframe-urile Cloudflare
    // primesc src-ul abia aici, nu din HTML-ul livrat de server.
    function bootMedia() {
      if (mediaBooted) return;
      mediaBooted = true;
      if (gate) gate.hidden = true;

      cards.forEach((card) => {
        const iframe = card.querySelector<HTMLIFrameElement>('[data-cf]');
        const src = iframe?.dataset.cfSrc;
        if (iframe && src && !iframe.getAttribute('src')) iframe.setAttribute('src', src);
      });

      if (hasYouTube) loadYouTubeAPI(initYouTubePlayers);
      if (hasCloudflare) loadCloudflareSDK(buildCloudflarePlayers);
      initialPlaybackTimer = window.setTimeout(onScrollSettled, 150);

      (['pointerdown', 'touchstart', 'scroll', 'keydown'] as const).forEach((evt) => {
        overlay!.addEventListener(evt, unlockActivePlayback, { once: true, passive: true });
      });
    }

    window.addEventListener('video:granted', bootMedia, { signal: consentAbort.signal });
    if (hasVideoConsent()) bootMedia();
    else if (gate) gate.hidden = false;

    const cleanup = () => {
      players.forEach((p) => { try { p.pause(); } catch { /* noop */ } });
      window.clearTimeout(playbackTimer);
      window.clearTimeout(scrollEndTimer);
      window.clearTimeout(initialPlaybackTimer);
      window.clearTimeout(tapTimer);
      window.clearTimeout(toastTimer);
      window.clearTimeout(commentsParseTimer);
      window.clearTimeout(commentsWatchdog);
      window.clearTimeout(commentsSettleTimer);
      consentAbort.abort();
      preloadObserver?.disconnect();
      io.disconnect();
      resizeObserver.disconnect();
      overlay.removeAttribute('data-shorts-init');
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    window.addEventListener('pagehide', cleanup, { once: true });
  }

  initShorts();
  document.addEventListener('astro:page-load', initShorts);
</script>


