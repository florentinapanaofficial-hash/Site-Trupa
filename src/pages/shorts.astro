---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import { getReelsFromPlaylist } from '../lib/youtube-reels';

export const prerender = false;

const shortsSeo = seo.shorts;
const SITE_URL = 'https://www.florentinapanaofficial.ro';

type ShortRaw = {
  id: string;
  youtubeVideoId?: string;
  cloudflareUid?: string;
  author: string;
  avatar: string;
  verified?: boolean;
  caption: string;
  hashtags: string;
  song: string;
  likesCount: number;
};

const BRAND = siteContent.brand?.name ?? 'Formația Florentina Pană';
const DEFAULT_AVATAR = '/images/logo-512.png';
const DEFAULT_SONG = `${BRAND} · Moment live`;
const WHATSAPP_HREF = `https://wa.me/${siteContent.contact.phoneRaw.replace('+', '')}?text=${encodeURIComponent(
  'Bună! Am văzut momentele video și aș dori o ofertă pentru evenimentul meu.'
)}`;
const FACEBOOK_PAGE = siteContent.socialLinks?.facebook ?? 'https://www.facebook.com/florentinapanaofficial/';

// Număr de aprecieri pseudo-aleator, dar stabil per clip (nu se schimbă la refresh)
function pseudoLikes(id: string): number {
  let h = 0;
  for (const ch of id) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return 320 + (h % 1580);
}

// Clipuri „fixate” din siteContent.json (montaj Cloudflare + eventuale manuale)
const pinnedShorts = (siteContent.shorts ?? []) as ShortRaw[];

// Shorturi trase automat din playlista YouTube (RSS, cache 30 min)
const reelsPlaylistId = (siteContent.reelsPlaylistId ?? '').trim();
const playlistReels = reelsPlaylistId ? await getReelsFromPlaylist(reelsPlaylistId) : [];

const pinnedYouTubeIds = new Set(
  pinnedShorts.map((s) => s.youtubeVideoId).filter(Boolean) as string[]
);

const playlistShorts: ShortRaw[] = playlistReels
  .filter((r) => !pinnedYouTubeIds.has(r.youtubeVideoId))
  .map((r) => ({
    id: `yt-${r.youtubeVideoId}`,
    youtubeVideoId: r.youtubeVideoId,
    author: BRAND,
    avatar: DEFAULT_AVATAR,
    verified: true,
    caption: r.title || `${BRAND} — moment live`,
    hashtags: '#shorts #nunta #muzicalive #fpband',
    song: DEFAULT_SONG,
    likesCount: pseudoLikes(r.youtubeVideoId),
  }));

const rawShorts = [...pinnedShorts, ...playlistShorts];
const shorts = rawShorts.map((s) => {
  const isCloudflare = Boolean(s.cloudflareUid);
  return {
    ...s,
    provider: isCloudflare ? 'cloudflare' : 'youtube',
    poster: isCloudflare
      ? `https://videodelivery.net/${s.cloudflareUid}/thumbnails/thumbnail.jpg?time=2s&height=1080`
      : `https://img.youtube.com/vi/${s.youtubeVideoId}/maxresdefault.jpg`,
    cfEmbed: isCloudflare
      ? `https://iframe.cloudflarestream.com/${s.cloudflareUid}?muted=true&loop=true&autoplay=false&controls=false&preload=metadata`
      : '',
  };
});
---

<BaseLayout title={shortsSeo.meta.title} description={shortsSeo.meta.description} hideFooter>
  <Fragment slot="head">
    <link rel="preconnect" href="https://www.youtube.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://s.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://embed.cloudflarestream.com" crossorigin />
    <link rel="preconnect" href="https://videodelivery.net" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://s.ytimg.com" />
    <link rel="dns-prefetch" href="https://googlevideo.com" />
    <link rel="dns-prefetch" href="https://embed.cloudflarestream.com" />
    <link rel="dns-prefetch" href="https://videodelivery.net" />
  </Fragment>

  <div class="reels-overlay" id="reels-overlay" data-muted="true">
    <h1 class="sr-only">{shortsSeo.h1}</h1>

    {/* ─── Header minimalist ─── */}
    <div class="reels-topbar">
      <a href="/" class="reels-icon-btn" aria-label="Închide și mergi la pagina principală">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </a>
      <span class="reels-title" aria-hidden="true"></span>
      <span class="reels-icon-btn reels-icon-btn--ghost" aria-hidden="true"></span>
    </div>

    {/* ─── Feed vertical cu scroll-snap ─── */}
    <div class="reels-feed" id="reels-feed">
      {shorts.map((short, index) => (
        <article
          class="reel-card"
          data-reel
          data-index={index}
          data-id={short.id}
          data-provider={short.provider}
          data-video-id={short.youtubeVideoId ?? ''}
          data-likes={short.likesCount}
        >
          <div class="reel-media-wrap">
            <img
              class="reel-poster"
              src={short.poster}
              alt={`Miniatură Reels — ${short.author}: moment live`}
              loading={index <= 1 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding={index <= 1 ? 'sync' : 'async'}
            />
            <div class={`reel-media${short.provider === 'cloudflare' ? ' reel-media--cf' : ' reel-media--yt'}`}>
              {short.provider === 'cloudflare' ? (
                <iframe
                  class="reel-cf"
                  data-cf
                  data-cf-src={short.cfEmbed}
                  title={`Reels — ${short.author}`}
                  loading={index <= 1 ? 'eager' : 'lazy'}
                  allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                  allowfullscreen
                ></iframe>
              ) : (
                <div id={`reel-player-${index}`} data-player></div>
              )}
            </div>

            {/* Strat de interacțiune (tap / double-tap) */}
            <button class="reel-tap-layer" data-tap aria-label="Redă sau pune pauză"></button>

            {/* Inima mare la double-tap */}
            <span class="reel-heart-burst" data-heart-burst aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="120" height="120">
                <path d="M12 21s-7.5-4.6-10.2-9C-0.3 8.4 1.2 4.5 4.7 4.1c2-.2 3.6.9 4.5 2.3.9-1.4 2.5-2.5 4.5-2.3 3.5.4 5 4.3 2.9 7.9C19.5 16.4 12 21 12 21z"/>
              </svg>
            </span>

            {/* Iconiță Play/Pause centrată */}
            <span class="reel-playpause" data-playpause aria-hidden="true">
              <svg class="reel-playpause-play" viewBox="0 0 24 24" fill="currentColor" width="72" height="72">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
          </div>

          {/* ─── Overlay stânga jos: autor + descriere + sunet ─── */}
          <div class="reel-info">
            <div class="reel-author">
              <img class="reel-avatar" src={short.avatar} alt={`Avatar ${short.author}`} width="40" height="40" loading="lazy" decoding="async" />
              <span class="reel-author-name">{short.author}</span>
              {short.verified && (
                <svg class="reel-verified" viewBox="0 0 24 24" width="16" height="16" aria-label="Cont verificat">
                  <path fill="#3897f0" d="M12 1l2.6 2.1 3.3-.3 1 3.2 2.9 1.6-1 3.2 1 3.2-2.9 1.6-1 3.2-3.3-.3L12 23l-2.6-2.1-3.3.3-1-3.2L2.2 15l1-3.2-1-3.2 2.9-1.6 1-3.2 3.3.3z"/>
                  <path fill="#fff" d="M10.3 15.2l-2.8-2.8 1.2-1.2 1.6 1.6 3.8-3.8 1.2 1.2z"/>
                </svg>
              )}
            </div>
            <p class="reel-caption" data-caption>
              <span class="reel-caption-text">{short.caption}</span>
              <span class="reel-hashtags">{short.hashtags}</span>
            </p>
            <div class="reel-song">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M9 17V5l10-2v12" stroke="currentColor" stroke-width="0" />
                <path d="M9 18a3 3 0 11-2-2.8V6l10-2v9.2A3 3 0 1117 16V7.3L11 8.5v6.7A3 3 0 019 18z"/>
              </svg>
              <div class="reel-song-marquee"><span>{short.song}&nbsp;&nbsp;•&nbsp;&nbsp;{short.song}&nbsp;&nbsp;•&nbsp;&nbsp;</span></div>
            </div>
          </div>

          {/* ─── Overlay dreapta: acțiuni ─── */}
          <div class="reel-actions">
            <button class="reel-action" data-like-btn aria-label="Apreciază">
              <span class="reel-action-icon">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
                  <path d="M12 21s-7.5-4.6-10.2-9C-0.3 8.4 1.2 4.5 4.7 4.1c2-.2 3.6.9 4.5 2.3.9-1.4 2.5-2.5 4.5-2.3 3.5.4 5 4.3 2.9 7.9C19.5 16.4 12 21 12 21z"/>
                </svg>
              </span>
              <span class="reel-action-count" data-like-count>{short.likesCount.toLocaleString('ro-RO')}</span>
            </button>

            <button class="reel-action" data-comments-btn aria-label="Deschide comentariile" aria-haspopup="dialog" aria-controls="reels-comments">
              <span class="reel-action-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.4 8.4 0 01-9 8.4 9 9 0 01-4.2-1L3 20l1.2-4.2A8.4 8.4 0 1121 11.5z" />
                </svg>
              </span>
              <span class="reel-action-label">Comentarii</span>
            </button>

            <button class="reel-action" data-share-btn data-url={`${SITE_URL}/shorts/#${short.id}`} aria-label="Distribuie">
              <span class="reel-action-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7" />
                  <path d="M16 6l-4-4-4 4" />
                  <path d="M12 2v13" />
                </svg>
              </span>
              <span class="reel-action-label">Distribuie</span>
            </button>

            <button class="reel-action" data-mute-btn aria-label="Activează sau dezactivează sunetul">
              <span class="reel-action-icon">
                <svg class="reel-icon-muted" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 5L6 9H2v6h4l5 4V5z" />
                  <path d="M23 9l-6 6M17 9l6 6" />
                </svg>
                <svg class="reel-icon-sound" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 5L6 9H2v6h4l5 4V5z" />
                  <path d="M15.5 8.5a5 5 0 010 7M19 5a9 9 0 010 14" />
                </svg>
              </span>
            </button>
          </div>
        </article>
      ))}
    </div>

    {/* ─── Poartă de consimțământ video (video_consent, izolat de marketing) ─── */}
    <div class="reels-consent" id="reels-consent" hidden>
      <div class="reels-consent-card" role="dialog" aria-modal="true" aria-labelledby="reels-consent-title">
        <h2 id="reels-consent-title">Activează redarea momentelor</h2>
        <p>
          Clipurile sunt găzduite pe YouTube și Cloudflare Stream. La redare, aceste servicii pot
          stoca informații pe dispozitivul tău. Acordul se aplică exclusiv conținutului video —
          nu activează analiză sau publicitate.
        </p>
        <button type="button" class="reels-consent-accept" data-reels-consent-accept>
          Activează și redă
        </button>
        <a class="reels-consent-link" href="/politica-cookie/">Politica de cookie-uri</a>
      </div>
    </div>

    {/* ─── Panou comentarii Meta (gat pe categoria `marketing`) ─── */}
    <div class="reels-comments" id="reels-comments" aria-hidden="true">
      <div class="reels-comments-backdrop" data-comments-backdrop></div>
      <div class="reels-comments-sheet" role="dialog" aria-modal="true" aria-labelledby="reels-comments-title">
        <header class="reels-comments-head">
          <h2 id="reels-comments-title">Comentarii</h2>
          <button type="button" class="reels-comments-close" data-comments-close aria-label="Închide comentariile">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
          </button>
        </header>

        <div class="reels-comments-body">
          <div class="reels-comments-gate" data-comments-gate>
            <p>Pentru a vedea și lăsa comentarii, avem nevoie de acordul tău.</p>
            <p class="reels-comments-note">
              Comentariile sunt afișate prin Facebook, care poate stoca informații pe dispozitivul
              tău. Se activează odată cu categoria „Marketing”.
            </p>
            <button type="button" class="reels-comments-accept" data-open-consent>
              Deschide preferințele de cookie-uri
            </button>
          </div>

          <div class="reels-comments-widget" data-comments-widget hidden>
            <p class="reels-comments-status" data-comments-status role="status">Se încarcă comentariile…</p>
            <div
              class="fb-comments"
              data-href={`${SITE_URL}/shorts/`}
              data-width="100%"
              data-numposts="5"
              data-colorscheme="dark"
            ></div>
            <p class="reels-comments-fallback" data-comments-fallback hidden>
              Comentariile nu s-au putut încărca.
              <a href={FACEBOOK_PAGE} target="_blank" rel="noopener noreferrer">Scrie-ne pe pagina de Facebook</a>.
            </p>
          </div>
        </div>
      </div>
    </div>

    {/* ─── CTA fix jos: WhatsApp ─── */}
    <div class="reels-wa">
      <a
        class="reels-wa-btn"
        href={WHATSAPP_HREF}
        target="_blank"
        rel="noopener noreferrer nofollow"
        aria-label="Trimite mesaj pe WhatsApp Formației Florentina Pană"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"/>
          <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1112 20.2z"/>
        </svg>
        <span>Trimite mesaj</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* ═══ Overlay fullscreen — acoperă tot ecranul, inclusiv header-ul global ═══ */
  .reels-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* `svh` = viewportul mic (cu barele browserului vizibile) \u2014 stabil la scroll,
       spre deosebire de `vh`/`dvh` care ascund sau clatin\u0103 ac\u021biunile de jos pe mobil. */
    height: 100vh;
    height: 100svh;
    z-index: 1250;
    background: #000;
    overflow: hidden;
    color: #fff;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .reels-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(env(safe-area-inset-top), 0.75rem) 1rem 2rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .reels-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    width: 40px;
    height: 40px;
  }

  .reels-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.25);
    text-decoration: none;
    pointer-events: auto;
    transition: background 0.2s ease;
  }
  .reels-icon-btn:hover { background: rgba(255, 255, 255, 0.18); }
  .reels-icon-btn--ghost { background: transparent; pointer-events: none; }

  /* ═══ Feed cu scroll-snap vertical ═══ */
  /* Înălțimea se ia din overlay-ul `position: fixed` (viewport vizibil real).
     100vh ar include bara de browser pe mobil și ar tăia acțiunile de jos. */
  .reels-feed {
    height: 100%;
    width: 100%;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: contain;
    scroll-behavior: auto !important;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .reels-feed::-webkit-scrollbar { display: none; width: 0; height: 0; }

  .reel-card {
    position: relative;
    height: 100%;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
    transform: translateZ(0);
    will-change: transform;
  }

  /* ═══ Video — simulare object-fit: cover pentru 9:16 ═══ */
  .reel-media-wrap { position: absolute; inset: 0; overflow: hidden; }
  .reel-media-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: max(4.5rem, calc(env(safe-area-inset-top) + 3.25rem));
    z-index: 4;
    background: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.82) 35%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }
  .reel-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: brightness(0.9);
    transition: opacity 0.12s linear;
    image-rendering: -webkit-optimize-contrast;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .reel-media {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 100%;
    aspect-ratio: 16 / 9;
    min-width: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .reel-media :global(iframe),
  .reel-media > div {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    image-rendering: -webkit-optimize-contrast;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .reel-media :global(iframe) { pointer-events: none; }
  .reel-card.is-playing .reel-poster { opacity: 0; }

  .reel-media--yt {
    width: 1080px;
    height: 1920px;
    aspect-ratio: 9 / 16;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%) scale(var(--reel-yt-scale, 1)) translateZ(0);
    transform-origin: center;
    backface-visibility: hidden;
    will-change: transform;
  }

  .reel-media--yt :global(iframe),
  .reel-media--yt > div {
    width: 1080px !important;
    height: 1920px !important;
    max-width: none;
    max-height: none;
  }

  /* Cloudflare Stream — video vertical 9:16, umple cardul fără crop 16:9 */
  .reel-media--cf {
    top: 0;
    left: 0;
    inset: 0;
    transform: none;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    min-width: 0;
  }
  .reel-cf { width: 100%; height: 100%; border: 0; display: block; }

  /* Zonă de tap (play/pause + double-tap like) */
  .reel-tap-layer {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Inima mare la double-tap */
  .reel-heart-burst {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 8;
    transform: translate(-50%, -50%) scale(0.2);
    color: #fff;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.5));
  }
  .reel-heart-burst.is-active { animation: heartBurst 0.9s ease forwards; }
  @keyframes heartBurst {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    15%  { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
    30%  { transform: translate(-50%, -50%) scale(0.95); }
    45%  { transform: translate(-50%, -50%) scale(1.05); }
    70%  { opacity: 1; transform: translate(-50%, -55%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -75%) scale(1); }
  }

  /* Iconiță play/pause centrată */
  .reel-playpause {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 7;
    transform: translate(-50%, -50%) scale(0.8);
    color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6));
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .reel-playpause.is-visible { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  /* ═══ Overlay stânga jos ═══ */
  .reel-info {
    position: absolute;
    left: 0;
    right: 4.75rem;
    bottom: 0;
    z-index: 10;
    padding: 2.75rem 1rem calc(env(safe-area-inset-bottom, 0px) + 5.75rem);
