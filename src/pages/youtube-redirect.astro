---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import { sanitizeUrl } from '../lib/sanitize-url';

const rawTo = Astro.url.searchParams.get('to') ?? '';
const rawBack = Astro.url.searchParams.get('back') ?? '/galerie-video/';

const safeTo = sanitizeUrl(rawTo);
const safeBack = rawBack.startsWith('/') ? rawBack : '/galerie-video/';

const isYoutubeRedirectAllowed = (url: string) => {
  try {
    const parsed = new URL(url);
    if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') {
      return false;
    }

    const host = parsed.hostname.toLowerCase();
    const allowedHosts = new Set([
      'youtube.com',
      'www.youtube.com',
      'm.youtube.com',
      'music.youtube.com',
      'youtu.be',
      'www.youtu.be',
      'youtube-nocookie.com',
      'www.youtube-nocookie.com',
    ]);

    return allowedHosts.has(host);
  } catch {
    return false;
  }
};

const canContinueToYoutube = isYoutubeRedirectAllowed(safeTo);

const pageTitle = 'Redirecționare YouTube | Formația Florentina Pană';
const pageDescription = 'Confirmă redirecționarea către YouTube sau revino rapid în site-ul Formației Florentina Pană.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section-container py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8">
        <BackButton href={safeBack} label="Înapoi în site" />
      </div>

      <article class="rounded-3xl border border-cyan-300/20 bg-[#071226]/75 p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-300">Ieșire externă</p>
        <h1 class="mt-3 font-['Oswald'] text-3xl text-white sm:text-4xl">Mergi către YouTube</h1>
        <p class="mt-4 text-sm text-white/75 sm:text-base">
          Ești pe punctul de a părăsi site-ul. Poți continua către YouTube sau te poți întoarce imediat în platformă.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            id="youtube-continue-link"
            href={canContinueToYoutube ? safeTo : '#'}
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex items-center rounded-xl border border-amber-300/50 bg-amber-400/10 px-4 py-2.5 font-['Oswald'] text-sm uppercase tracking-[0.08em] text-amber-200 transition hover:-translate-y-0.5 hover:bg-amber-400/20${canContinueToYoutube ? '' : ' hidden'}`}
          >
            Continuă către YouTube
          </a>
          <span
            id="youtube-invalid-link"
            class={`rounded-xl border border-red-300/40 bg-red-500/10 px-4 py-2.5 text-sm text-red-200${canContinueToYoutube ? ' hidden' : ''}`}
          >
            Link invalid sau lipsă.
          </span>

          <a
            href={safeBack}
            class="inline-flex items-center rounded-xl border border-cyan-300/40 bg-cyan-500/10 px-4 py-2.5 font-['Oswald'] text-sm uppercase tracking-[0.08em] text-cyan-100 transition hover:-translate-y-0.5 hover:bg-cyan-500/20"
          >
            Înapoi în site
          </a>
        </div>
      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      var allowedHosts = new Set([
        'youtube.com',
        'www.youtube.com',
        'm.youtube.com',
        'music.youtube.com',
        'youtu.be',
        'www.youtu.be',
        'youtube-nocookie.com',
        'www.youtube-nocookie.com',
      ]);
      var link = document.getElementById('youtube-continue-link');
      var invalidMessage = document.getElementById('youtube-invalid-link');
      var rawTo = new URLSearchParams(window.location.search).get('to') || '';
      var safeClientTo = '';

      try {
        var parsed = new URL(rawTo);
        if ((parsed.protocol === 'https:' || parsed.protocol === 'http:') && allowedHosts.has(parsed.hostname.toLowerCase())) {
          safeClientTo = parsed.href;
        }
      } catch (_) {}

      if (safeClientTo && link) {
        link.href = safeClientTo;
        link.classList.remove('hidden');
        if (invalidMessage) invalidMessage.classList.add('hidden');
        window.location.replace(safeClientTo);
      }
    })();
  </script>
</BaseLayout>