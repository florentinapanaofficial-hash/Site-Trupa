---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import siteContent from '../data/siteContent.json';

const { videos, faq } = siteContent;

const pageTitle = 'Cauți formație de nuntă? Video, repertoriu și ofertă';
const pageDescription = 'Vezi video reale, repertoriu și cere o ofertă în funcție de bugetul alocat. Formația Florentina Pană răspunde rapid pentru nunți și botezuri.';

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const videoSlug = (video: { title: string; youtubeId: string }) => `${slugify(video.title)}-${video.youtubeId.toLowerCase()}`;

const featuredVideo = videos[0];
const ogImage = '/Cauti Formatie/Gemini_Generated_Image_wiap94wiap94wiap.png';
const secondaryVideos = videos.slice(1, 4).map((video) => ({
  ...video,
  slug: videoSlug(video),
  thumbJpg: `https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`,
}));

const shortRepertoire = [
  'Muzică populară de petrecere',
  'Muzică internațională: grecească, arăbească, machedonească',
  'Manele mai vechi și noi',
];

const quickFaq = faq;
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <section class="response-section section-container pt-12 pb-8 sm:pt-16">
    <div class="mb-5">
      <BackButton href="/" label="Acasă" />
    </div>

    <p class="response-top-announcement">Formația Florentina Pană este pregătită pentru evenimentul dvs / vezi oferta de preț pentru sezonul 2027-2028</p>

    <div id="video" class="response-video-feature">
      {featuredVideo && (
        <YoutubeEmbed youtubeId={featuredVideo.youtubeId} title={featuredVideo.title} class="response-featured-embed" />
      )}
    </div>

    <div class="response-video-grid">
      {secondaryVideos.map((video) => (
        <a href={`/video/${video.slug}/`} class="response-video-card" aria-label={`Vezi ${video.title}`}>
          <div class="response-video-thumb">
            <img src={video.thumbJpg} alt={video.title} loading="lazy" decoding="async" />
            <span class="response-video-play" aria-hidden="true">▶</span>
          </div>
          <p>{video.title}</p>
        </a>
      ))}
    </div>

    <div class="response-inline-actions">
        <a href="/contact/" class="btn-solid">Cere ofertă</a>
    </div>
  </section>

  <section class="response-hero section-container py-12 sm:py-16">
    <div class="response-shell">
      <div class="response-shell__glow response-shell__glow--cyan" aria-hidden="true"></div>
      <div class="response-shell__glow response-shell__glow--gold" aria-hidden="true"></div>

      <div class="response-grid">
        <div class="response-copy">
          <h1 class="response-title">Cauți formație de nuntă sau botez? Vezi ce oferim înainte să ceri oferta.</h1>
          <p class="response-lead">
            Suntem trupa de care ai nevoie pentru un eveniment reușit: experiență, profesionalism și adaptabilitate în funcție de publicul tău. Oferim calitate autentică la un preț accesibil, cu video reale, repertoriu variat și o propunere clară, adaptată bugetului tău.
          </p>

          <div class="response-pills" aria-label="Beneficii rapide">
            <span>Video reale</span>
            <span>Repertoriu variat</span>
            <span>Ofertă după buget</span>
            <span>Răspuns rapid</span>
          </div>

          <div class="response-actions">
            <a href="/contact/" class="btn-solid">Cere ofertă</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="response-section section-container pb-8">
    <div class="response-section-head">
      <p class="response-section-kicker">Repertoriu</p>
      <h2>Pe scurt, ce putem cânta</h2>
      <p>Acestea sunt direcțiile principale pe care le abordăm la evenimente.</p>
    </div>

    <ul class="response-repertoire-list" aria-label="Repertoriu pe scurt">
      {shortRepertoire.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="response-section section-container pb-10">
    <div class="response-section-head">
      <p class="response-section-kicker">Întrebări rapide</p>
      <h2>Ca să fie clar de la început</h2>
    </div>

    <div class="response-faq-list">
      {quickFaq.map((item) => (
        <details class="response-faq-item">
          <summary>
            <span>{item.question}</span>
            <span aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="response-footer-cta">
      <p>Dacă ai ajuns aici și vrei o ofertă clară, trimite acum data și bugetul alocat. Îți răspundem cu o propunere concretă, nu cu mesaje generale.</p>
      <div class="response-footer-actions">
        <a href="/contact/" class="btn-solid">Cere ofertă</a>
      </div>
    </div>
  </section>

  <style>
    .response-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 1.5rem;
      padding: clamp(1rem, 2vw, 1.5rem);
      background:
        radial-gradient(circle at 12% 20%, rgba(11, 188, 214, 0.16), transparent 36%),
        radial-gradient(circle at 88% 10%, rgba(245, 166, 35, 0.14), transparent 30%),
        linear-gradient(160deg, rgba(5, 13, 29, 0.98), rgba(9, 20, 44, 0.96));
      box-shadow:
        0 24px 64px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .response-shell__glow {
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      filter: blur(24px);
    }

    .response-shell__glow--cyan {
      top: -1rem;
      left: -1rem;
      width: 8rem;
      height: 8rem;
      background: rgba(11, 188, 214, 0.18);
    }

    .response-shell__glow--gold {
      right: -1rem;
      bottom: -1rem;
      width: 8.5rem;
      height: 8.5rem;
      background: rgba(245, 166, 35, 0.16);
    }

    .response-repertoire-list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.52rem;
    }

    .response-repertoire-list li {
      margin: 0;
      border-radius: 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.72rem 0.9rem;
      color: rgba(235, 244, 255, 0.88);
      line-height: 1.55;
    }

    .response-repertoire-list li::before {
      content: '- ';
      color: #f5a623;
      font-weight: 800;
    }

    .response-title {
      font-size: clamp(2rem, 5vw, 4rem);
      line-height: 0.95;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #f8fbff;
      text-wrap: balance;
    }

    .response-top-announcement {
      margin: 0 0 0.9rem;
      color: #f5fbff;
      font-weight: 700;
      line-height: 1.6;
    }

    .response-lead,
    .response-section-head p,
    .response-faq-item p,
    .response-footer-cta p {
      color: rgba(235, 244, 255, 0.84);
      line-height: 1.7;
    }

    .response-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .response-pills span {
      display: inline-flex;
      align-items: center;
      padding: 0.36rem 0.75rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      color: #f8fdff;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .response-actions,
    .response-inline-actions,
    .response-footer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .response-section-head {
      max-width: 56rem;
      margin: 0 auto 1.25rem;
      text-align: center;
    }

    .response-section-head h2 {
      margin: 0.2rem 0 0;
      font-family: 'Oswald', sans-serif;
      color: #fff;
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .response-video-feature {
      margin: 0 auto;
      max-width: 62rem;
    }

    .response-featured-embed {
      border-radius: 1.25rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
    }

    .response-video-grid {
      margin-top: 1rem;
      display: grid;
      gap: 0.9rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }

    .response-video-card {
      display: grid;
      gap: 0.55rem;
      text-decoration: none;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      padding: 0.75rem;
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    .response-video-card:hover {
      transform: translateY(-3px);
      border-color: rgba(245, 166, 35, 0.45);
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.22);
    }

    .response-video-thumb {
      position: relative;
      overflow: hidden;
      border-radius: 0.85rem;
      aspect-ratio: 16 / 9;
      background: #0b1220;
    }

    .response-video-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .response-video-play {
      position: absolute;
      inset: 50% auto auto 50%;
      transform: translate(-50%, -50%);
      display: inline-grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 999px;
      background: rgba(5, 13, 29, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 24px rgba(11, 188, 214, 0.2);
    }

    .response-video-card p {
      margin: 0;
      color: #f8fbff;
      font-size: 0.92rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .response-repertoire-grid {
      display: grid;
      gap: 0.9rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }

    .response-repertoire-card {
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      padding: 1rem;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.16);
    }

    .response-repertoire-icon {
      margin: 0 0 0.35rem;
      font-size: 1.5rem;
    }

    .response-repertoire-card h3 {
      margin: 0;
      color: #fff;
      font-size: 1.02rem;
      line-height: 1.35;
    }

    .response-repertoire-card p {
      margin: 0.45rem 0 0;
      font-size: 0.88rem;
      white-space: pre-line;
    }

    .response-faq-list {
      display: grid;
      gap: 0.7rem;
      max-width: 62rem;
      margin: 0 auto;
    }

    .response-faq-item {
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      padding: 0.15rem 0.95rem;
    }

    .response-faq-item summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.9rem 0;
      color: #fff;
      font-weight: 700;
    }

    .response-faq-item summary::-webkit-details-marker {
      display: none;
    }

    .response-faq-item p {
      margin: 0 0 0.9rem;
      font-size: 0.92rem;
    }

    .response-footer-cta {
      max-width: 62rem;
      margin: 1.25rem auto 0;
      padding: 1rem 1.1rem;
      border-radius: 1rem;
      border: 1px solid rgba(245, 166, 35, 0.24);
      background: linear-gradient(135deg, rgba(245, 166, 35, 0.12), rgba(11, 188, 214, 0.08));
      text-align: center;
    }

    .response-footer-cta p {
      margin: 0;
      max-width: 56ch;
      margin-inline: auto;
    }

    .response-footer-actions {
      margin-top: 0.85rem;
      justify-content: center;
    }
  </style>
</BaseLayout>