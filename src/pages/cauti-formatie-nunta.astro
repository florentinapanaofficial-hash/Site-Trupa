---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import siteContent from '../data/siteContent.json';
import couplesData from '../data/couples.json';

const { faq } = siteContent;
const featuredCouple = couplesData.couples[0];

const pageTitle = 'Cauți formație de nuntă? Video, repertoriu și ofertă';
const pageDescription = 'Vezi video reale, repertoriu și cere o ofertă în funcție de bugetul alocat. Formația Florentina Pană răspunde rapid pentru nunți și botezuri.';

const ogImage = '/images/og-cauti-formatie-custom.webp';
const whatsappBudgetOfferHref = 'https://wa.me/40767369658?text=Buna%21%20Spune-ne%20ce%20buget%20ai%20si%20noi%20iti%20facem%20o%20oferta%20pentru%20eveniment.';
const featuredPlaylist = siteContent.youtubePlaylists?.cautiFormatie;
const hasFeaturedPlaylist = Boolean(featuredPlaylist?.playlistId);
const featuredPlaylistUrl = featuredPlaylist?.playlistId
  ? `https://www.youtube.com/playlist?list=${featuredPlaylist.playlistId}`
  : siteContent.youtubePlaylists?.channelPlaylistsUrl || siteContent.socialLinks.youtube;
const featuredPlaylistThumb = featuredPlaylist?.thumbnailVideoId
  ? `https://img.youtube.com/vi/${featuredPlaylist.thumbnailVideoId}/hqdefault.jpg`
  : '/images/logo-fp-stage.svg';
const featuredPlaylistRedirectHref = `/youtube-redirect/?to=${encodeURIComponent(featuredPlaylistUrl)}&back=${encodeURIComponent('/cauti-formatie-nunta/')}`;

const processCards = [
  {
    title: 'Personalizăm Experiența',
    text: 'Playlist dedicat, momente speciale, detalii tehnice impecabile.',
  },
  {
    title: 'Plan Clar Al Serii',
    text: 'Construim ritmul evenimentului cu accentele voastre preferate.',
  },
  {
    title: 'Coordonare Live',
    text: 'Ne sincronizăm cu organizatorii pentru tranziții fără blocaje.',
  },
  {
    title: 'Energie Controlată',
    text: 'Alternăm inteligent momentele tari cu secvențe elegante.',
  },
  {
    title: 'Final Memorabil',
    text: 'Închidem seara în forță, pe piesele care rămân în minte.',
  },
];

const visibleProcessCards = processCards.slice(0, 4);

const shortRepertoire = [
  'Muzică populară de petrecere',
  'Muzică internațională: grecească, arăbească, machedonească, latino',
  'Muzică românească și manele',
];

const splitRepertoireItem = (item: string) => {
  const [main, ...rest] = item.split(':');
  return {
    main: main.trim(),
    detail: rest.join(':').trim(),
  };
};

const quickFaq = [
  ...faq,
  {
    question: 'Aveți oferte și pentru buget redus?',
    answer: 'Da. Avem pachete flexibile și putem configura un program adaptat bugetului vostru, fără compromis la energie și profesionalism.',
  },
  {
    question: 'Asigurați și obiceiurile de zi?',
    answer: 'Da, asigurăm și obiceiurile de zi, alături de sonorizare și coordonare, pentru un program complet cap-coadă.',
  },
  {
    question: 'Cântați și manele?',
    answer: 'Da. La cerere, includem manele vechi și noi în repertoriu, dozate corect în funcție de invitați și de dinamica petrecerii.',
  },
];

const topTickerText = 'Dacă ești în căutarea unei Formații Nuntă & Cover Band Live care știe să facă atmosferă, iată ce îți oferim pentru o seară memorabilă: Show Live 100% cu energie pură, voci remarcabile și conexiune directă; repertoriu complet care include muzică populară de petrecere, grecească, arăbească, machedonească, latino, muzică românească și manele; cântăm fără pauze, alternăm programele artistice în funcție de eveniment și nu avem DJ sau MC. Hai să scriem împreună soundtrack-ul nunții tale! Contactează-ne și hai să transformăm petrecerea voastră într-o amintire de neuitat.';
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <section class="response-hero response-ref section-container pt-12 pb-10 sm:pt-16 sm:pb-12">
    <div class="mb-5">
      <BackButton href="/" label="Acasă" />
    </div>

    <div class="response-shell">
      <div class="response-shell__glow response-shell__glow--cyan" aria-hidden="true"></div>
      <div class="response-shell__glow response-shell__glow--gold" aria-hidden="true"></div>

      <div class="response-top-announcement-wrap" aria-label="Mesaj informativ">
        <div class="response-top-announcement-track" data-ticker-track>
          <p class="response-top-announcement" data-ticker-item>{topTickerText}</p>
        </div>
      </div>

      <div class="response-grid">
        <div class="response-copy">
          <p class="response-kicker">Formație live pentru nuntă, botez și evenimente private</p>
          <h1 class="response-title">Vrei să facem Show și să ne distrăm împreună?</h1>
          <p class="response-lead">
            Îți oferim o formulă clară, echilibrată și profesionistă, construită pentru un eveniment reușit cap-coadă.
          </p>

          <div class="response-offer-highlight" aria-label="Repertoriu și preț orientativ">
            <p class="response-offer-highlight__genres"><strong>Cântăm toate genurile muzicale</strong>, adaptate pe invitații voștri și pe energia evenimentului.</p>
            <p class="response-offer-highlight__genres">Program live fără pauze, alternat după specificul evenimentului, fără DJ sau MC.</p>
            <p class="response-offer-highlight__price">Preț orientativ: <span>2.500€ - 4.000€</span>, în funcție de numărul de membri din formulă.</p>
          </div>

          <div class="response-pills" aria-label="Servicii și pachete">
            <div class="response-pill-card">
              <strong class="response-pill-card__title">Solistă principală</strong>
              <p class="response-pill-card__text">Toate genurile. Florentina Pană susține diversitatea muzicală pe tot parcursul nopții: populară de petrecere, grecească, arăbească, machedonească, latino, muzică românească și manele.</p>
            </div>
            <div class="response-pill-card">
              <strong class="response-pill-card__title">Muzică populară de petrecere</strong>
              <p class="response-pill-card__text">Cătălin Matei, membru al trupei, interpretează programe de muzică populară și folclor autentic, construite pentru momente cu identitate și energie românească.</p>
            </div>
            <div class="response-pill-card">
              <strong class="response-pill-card__title">Acompaniament live</strong>
              <p class="response-pill-card__text">Orchestră completă, cu orgă, vioară și acordeon, plus sonorizare profesională cu inginer de sunet propriu, fără DJ sau MC.</p>
            </div>
          </div>

          <div class="response-actions">
            <a href="tel:+40767369658" class="btn-call"><span aria-hidden="true">☎</span><span>Sună Acum</span></a>
            <a href="https://wa.me/40767369658" class="btn-wa"><span aria-hidden="true">◉</span><span>WhatsApp</span></a>
            <a href={whatsappBudgetOfferHref} class="btn-solid" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">◇</span><span>Buget pe WhatsApp</span></a>
          </div>

          <div class="response-members-cta">
            <a href="/membri/" class="response-members-link"><span aria-hidden="true">✦</span><span>Vezi Membri Formației</span></a>
          </div>

          {featuredCouple && (
            <div class="response-proof-card" aria-label="Dovadă socială mirii noștri">
              <p class="response-proof-card__kicker">Dovadă Socială</p>
              <h2 class="response-proof-card__title">Vezi cum a fost la nunta lui {featuredCouple.names}</h2>
              <p class="response-proof-card__text">Poveste reală, recomandare autentică și materiale din eveniment, gata de distribuit pe Facebook.</p>
              <a href={`/comunitate/${featuredCouple.slug}/`} class="response-proof-card__link">Deschide pagina mirilor →</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="response-section section-container pb-8" id="video">
    <div class="response-section-head">
      <p class="response-section-kicker">Flow de eveniment</p>
      <h2>Playlist YouTube actualizat automat</h2>
    </div>

    {hasFeaturedPlaylist ? (
      <div class="response-playlist-wrap">
        <YoutubeEmbed
          playlistId={featuredPlaylist?.playlistId}
          title={featuredPlaylist?.title || 'Playlist Formația Florentina Pană'}
          thumbnailSrc={featuredPlaylistThumb}
          youtubeUrl={featuredPlaylistUrl}
          class="response-featured-embed"
        />

        <div class="response-playlist-meta">
          <p class="response-playlist-note">Actualizezi playlist-ul pe YouTube și selecția apare automat și în această pagină.</p>
          <a href={featuredPlaylistRedirectHref} class="response-playlist-link">Deschide playlistul pe YouTube</a>
        </div>

        <div class="response-process-grid" role="list" aria-label="Pașii experienței noastre">
          {visibleProcessCards.map((item, index) => (
            <article class="response-process-card" role="listitem" style={`--card-delay:${index * 80}ms`}>
              <span class="response-process-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="response-playlist-wrap">
        <p class="response-playlist-note">Playlistul principal este în curs de configurare pe YouTube. După setarea ID-ului, secțiunea se actualizează automat.</p>
      </div>
    )}

    <div class="response-more-videos">
      <a href="/galerie-video/" class="response-more-videos-link">Vezi toate videoclipurile</a>
    </div>

    <div class="response-inline-actions">
      <a href={whatsappBudgetOfferHref} class="btn-solid" target="_blank" rel="noopener noreferrer">Spune-ne bugetul și îți facem oferta pe WhatsApp</a>
    </div>
  </section>

  <section class="response-section section-container pb-8">
    <div class="response-section-head">
      <p class="response-section-kicker">Repertoriu</p>
      <h2>Ce putem cânta pe scurt</h2>
      <p>Adaptăm seara pe profilul invitaților, nu cântăm mecanic aceeași listă.</p>
    </div>

    <div class="response-scroll-shell" data-scroll-shell>
      <button class="response-scroll-btn response-scroll-btn--prev" type="button" data-scroll-prev aria-label="Element anterior">‹</button>
      <ul class="response-repertoire-list" aria-label="Repertoriu pe scurt, scroll orizontal">
        {shortRepertoire.map((item, index) => {
          const parts = splitRepertoireItem(item);
          return (
            <li style={`--rep-delay:${index * 90}ms`}>
              <span class="response-repertoire-main">{parts.main}</span>
              {parts.detail && <span class="response-repertoire-sub">{parts.detail}</span>}
            </li>
          );
        })}
      </ul>
      <button class="response-scroll-btn response-scroll-btn--next" type="button" data-scroll-next aria-label="Element următor">›</button>
    </div>
  </section>

  <section class="response-section section-container pb-10">
    <div class="response-section-head">
      <p class="response-section-kicker">Întrebări rapide</p>
      <h2>Detalii utile înainte să ne contactezi</h2>
    </div>

    <div class="response-faq-list">
      {quickFaq.map((item) => (
        <details class="response-faq-item">
          <summary>
            <span>{item.question}</span>
            <span aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="response-footer-cta">
      <p>Dacă ți se potrivește direcția noastră, trimite data evenimentului și intervalul de buget. Revenim rapid cu o propunere clară și realistă.</p>
      <div class="response-footer-actions">
        <a
          href={whatsappBudgetOfferHref}
          class="btn-solid"
          target="_blank"
          rel="noopener noreferrer"
        >Spune-ne bugetul și îți facem oferta pe WhatsApp</a>
      </div>
    </div>
  </section>

  <style>
    .response-hero,
    .response-section {
      position: relative;
      z-index: 1;
    }

    .response-ref {
      background: linear-gradient(180deg, rgba(3, 7, 15, 0.96), rgba(3, 7, 15, 0.52));
      border-radius: 1.25rem;
      margin-top: 0.4rem;
    }

    .response-kicker {
      margin: 0;
      color: #f5a623;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .response-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 1.5rem;
      padding: clamp(1rem, 2vw, 1.65rem);
      background:
        radial-gradient(circle at 12% 20%, rgba(11, 188, 214, 0.18), transparent 38%),
        radial-gradient(circle at 88% 10%, rgba(245, 166, 35, 0.16), transparent 31%),
        linear-gradient(155deg, rgba(5, 13, 29, 0.98), rgba(9, 20, 44, 0.96));
      box-shadow:
        0 24px 64px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .response-shell::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(circle at 50% 45%, rgba(0, 0, 0, 0.72), transparent 80%);
      opacity: 0.6;
    }

    .response-shell__glow {
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      filter: blur(24px);
    }

    .response-shell__glow--cyan {
      top: -1rem;
      left: -1rem;
      width: 8rem;
      height: 8rem;
      background: rgba(11, 188, 214, 0.18);
    }

    .response-shell__glow--gold {
      right: -1rem;
      bottom: -1rem;
      width: 8.5rem;
      height: 8.5rem;
      background: rgba(245, 166, 35, 0.16);
    }

    .response-grid {
      position: relative;
      display: grid;
      gap: 0.8rem;
      grid-template-columns: 1fr;
      isolation: isolate;
    }

    .response-proof-card {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.05);
      padding: 0.9rem;
      display: grid;
      gap: 0.45rem;
    }

    .response-proof-card__kicker {
      margin: 0;
      font-size: 0.75rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      font-weight: 700;
      color: #f5a623;
    }

    .response-proof-card__title {
      margin: 0;
      font-size: clamp(1rem, 2.3vw, 1.2rem);
      color: #f7fbff;
      line-height: 1.35;
    }

    .response-proof-card__text {
      margin: 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.92rem;
      line-height: 1.52;
    }

    .response-proof-card__link {
      width: fit-content;
      color: #0bbcd6;
      font-weight: 700;
      text-decoration: none;
    }

    .response-proof-card__link:hover {
      color: #7fe6f2;
      text-decoration: underline;
    }

    .response-copy {
      display: grid;
      gap: 0.85rem;
      max-width: 58rem;
      margin-inline: auto;
      text-align: center;
      animation: rise-fade 600ms ease both;
    }

    .response-repertoire-list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: rgba(245, 166, 35, 0.55) rgba(255, 255, 255, 0.08);
      padding-top: 0.35rem;
      padding-bottom: 0.4rem;
    }

    .response-repertoire-list li {
      flex: 0 0 clamp(14.5rem, 30vw, 20rem);
      scroll-snap-align: start;
      margin: 0;
      display: grid;
      place-items: center;
      gap: 0.34rem;
      position: relative;
      isolation: isolate;
      --rep-neon: rgba(0, 224, 255, 0.9);
      --rep-neon-soft: rgba(0, 224, 255, 0.45);
      border-radius: 0.9rem;
      border: 1px solid var(--rep-neon-soft);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.72rem 0.9rem;
      color: rgba(235, 244, 255, 0.88);
      line-height: 1.55;
      overflow-wrap: anywhere;
      word-break: break-word;
      text-align: center;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.08),
        0 0 24px var(--rep-neon-soft),
        0 10px 24px rgba(0, 0, 0, 0.2);
      animation: rise-fade 680ms ease both;
      animation-delay: var(--rep-delay, 0ms);
    }

    .response-repertoire-list li::before {
      content: '';
      position: absolute;
      inset: -12px;
      border-radius: 1.08rem;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 50%, var(--rep-neon) 0%, transparent 64%);
      filter: blur(16px) saturate(1.25);
      opacity: 0.95;
      animation: neon-pulse-soft 2.8s ease-in-out infinite;
    }

    .response-repertoire-list li:nth-child(6n + 1) { --rep-neon: rgba(0, 224, 255, 0.9); --rep-neon-soft: rgba(0, 224, 255, 0.45); }
    .response-repertoire-list li:nth-child(6n + 2) { --rep-neon: rgba(255, 210, 74, 0.9); --rep-neon-soft: rgba(255, 210, 74, 0.45); }
    .response-repertoire-list li:nth-child(6n + 3) { --rep-neon: rgba(255, 106, 186, 0.9); --rep-neon-soft: rgba(255, 106, 186, 0.45); }
    .response-repertoire-list li:nth-child(6n + 4) { --rep-neon: rgba(167, 112, 255, 0.9); --rep-neon-soft: rgba(167, 112, 255, 0.45); }
    .response-repertoire-list li:nth-child(6n + 5) { --rep-neon: rgba(82, 255, 166, 0.9); --rep-neon-soft: rgba(82, 255, 166, 0.45); }
    .response-repertoire-list li:nth-child(6n + 6) { --rep-neon: rgba(255, 134, 66, 0.9); --rep-neon-soft: rgba(255, 134, 66, 0.45); }

    @media (hover: hover) and (pointer: fine) {
      .response-repertoire-list li:hover {
        border-color: var(--rep-neon);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.14),
          0 0 34px var(--rep-neon),
          0 12px 30px rgba(0, 0, 0, 0.24);
      }

      .response-repertoire-list li:hover::before {
        filter: blur(20px) saturate(1.36);
        opacity: 1;
      }

      .response-repertoire-list li.is-center {
        border-color: var(--rep-neon);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.16),
          0 0 40px var(--rep-neon),
          0 0 84px var(--rep-neon-soft),
          0 14px 30px rgba(0, 0, 0, 0.24);
        transform: none;
      }

      .response-repertoire-list li.is-center::before {
        filter: blur(22px) saturate(1.42);
        opacity: 1;
      }
    }

    .response-repertoire-main {
      display: block;
      font-weight: 700;
      color: #f1f6ff;
      letter-spacing: 0.01em;
      line-height: 1.4;
      text-wrap: balance;
    }

    .response-repertoire-sub {
      display: block;
      color: rgba(209, 224, 248, 0.86);
      font-size: 0.93em;
      line-height: 1.45;
      text-wrap: pretty;
      text-align: center;
    }

    .response-title {
      margin: 0;
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2.15rem, 6.6vw, 4.35rem);
      line-height: 0.92;
      letter-spacing: 0.01em;
      text-transform: none;
      color: #f6f8fc;
      text-wrap: balance;
      max-width: 14ch;
      margin-inline: auto;
    }

    .response-title span {
      color: #ff5a1e;
      text-shadow: 0 0 18px rgba(255, 90, 30, 0.2);
    }

    .response-top-announcement-wrap {
      margin: 0 0 1rem;
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: 999px;
      border: 1px solid rgba(245, 166, 35, 0.45);
      background: linear-gradient(140deg, rgba(245, 166, 35, 0.18), rgba(8, 20, 44, 0.92));
      box-shadow:
        inset 0 0 0 1px rgba(0, 216, 255, 0.12),
        0 0 26px rgba(245, 166, 35, 0.2);
    }

    .response-top-announcement-wrap::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 3.4rem;
      pointer-events: none;
      z-index: 2;
    }

    .response-top-announcement-wrap::before {
      left: 0;
      background: linear-gradient(to right, rgba(7, 17, 37, 0.98), rgba(7, 17, 37, 0));
    }

    .response-top-announcement-track {
      display: block;
      width: 100%;
      overflow: hidden;
      will-change: transform;
    }

    .response-top-announcement {
      margin: 0;
      display: inline-block;
      color: #f5fbff;
      font-weight: 700;
      line-height: 1.2;
      white-space: nowrap;
      padding: 0.62rem 1.2rem;
      letter-spacing: 0.01em;
      text-shadow: 0 0 10px rgba(245, 166, 35, 0.16), 0 1px 0 rgba(0, 0, 0, 0.4);
      will-change: transform;
    }

    .response-lead,
    .response-section-head p,
    .response-faq-item p,
    .response-footer-cta p {
      color: rgba(235, 244, 255, 0.84);
      line-height: 1.55;
      font-size: 0.98rem;
    }

    .response-pills {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.8rem;
      width: min(100%, 58rem);
      margin-inline: auto;
    }

    .response-offer-highlight {
      width: min(100%, 44rem);
      margin-inline: auto;
      padding: 0.75rem 0.95rem;
      border-radius: 1rem;
      border: 1px solid rgba(245, 166, 35, 0.42);
      background: linear-gradient(150deg, rgba(245, 166, 35, 0.16), rgba(10, 24, 52, 0.82));
      box-shadow:
        inset 0 0 0 1px rgba(0, 224, 255, 0.14),
        0 0 24px rgba(245, 166, 35, 0.2);
      text-align: center;
    }

    .response-offer-highlight__genres,
    .response-offer-highlight__price {
      margin: 0;
      color: rgba(242, 248, 255, 0.94);
      font-size: 0.92rem;
      line-height: 1.48;
    }

    .response-offer-highlight__genres {
      margin-bottom: 0.28rem;
    }

    .response-offer-highlight__price span {
      color: #ffd16e;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-shadow: 0 0 16px rgba(245, 166, 35, 0.2);
    }

    .response-pill-card {
      display: grid;
      align-content: start;
      gap: 0.46rem;
      min-height: 100%;
      padding: 0.95rem 1rem;
      border-radius: 1.15rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.04));
      color: #f8fdff;
      text-align: left;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 10px 24px rgba(0, 0, 0, 0.18);
      animation: rise-fade 700ms ease both;
    }

    .response-pill-card__title {
      display: block;
      color: #ffd16e;
      font-size: 0.84rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      line-height: 1.28;
      text-transform: uppercase;
    }

    .response-pill-card__text {
      margin: 0;
      color: rgba(245, 251, 255, 0.92);
      font-size: 0.92rem;
      font-weight: 600;
      line-height: 1.58;
      letter-spacing: 0;
      text-wrap: pretty;
    }

    .response-actions,
    .response-inline-actions,
    .response-footer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      justify-content: center;
    }

    .response-actions {
      width: min(100%, 33rem);
      margin-inline: auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.55rem;
      background: rgba(5, 10, 20, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0.95rem;
      padding: 0.45rem;
    }

    .response-actions > a {
      display: grid;
      place-items: center;
      text-align: center;
      text-wrap: balance;
      animation: rise-fade 620ms ease both;
      min-height: 3.25rem;
    }

    .response-actions > a:nth-child(1) { animation-delay: 40ms; }
    .response-actions > a:nth-child(2) { animation-delay: 110ms; }
    .response-actions > a:nth-child(3) { animation-delay: 180ms; }
    .response-actions > a:nth-child(4) { animation-delay: 250ms; }

    .response-members-cta {
      margin-top: 0.75rem;
      display: flex;
      justify-content: center;
    }

    .response-members-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      min-height: 2.8rem;
      padding: 0.68rem 1rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: linear-gradient(135deg, rgba(245, 166, 35, 0.28), rgba(255, 209, 102, 0.18));
      color: #fff7df;
      text-decoration: none;
      font-family: 'Oswald', sans-serif;
      font-size: 0.88rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      animation: rise-fade 700ms ease both;
      animation-delay: 320ms;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
    }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.8rem;
      padding: 0.68rem 1.25rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #f8fbff;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.02em;
      background: rgba(255, 255, 255, 0.03);
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .btn-call,
    .btn-wa {
      display: grid;
      grid-auto-flow: column;
      place-items: center;
      min-height: 2.58rem;
      padding: 0.64rem 0.74rem;
      border-radius: 0.82rem;
      text-decoration: none;
      font-family: 'Oswald', sans-serif;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      border: 1px solid rgba(255, 255, 255, 0.24);
      color: #eff6ff;
      font-size: 0.97rem;
      gap: 0.34rem;
    }

    .btn-call {
      background: rgba(10, 36, 86, 0.68);
    }

    .btn-wa {
      background: linear-gradient(135deg, rgba(22, 212, 125, 0.98), rgba(89, 255, 170, 0.88));
      color: #02140e;
      border-color: rgba(89, 255, 170, 0.5);
    }

    .btn-call span:first-child,
    .btn-wa span:first-child,
    .btn-solid span:first-child {
      font-size: 0.95rem;
      line-height: 1;
    }

    .btn-solid {
      display: grid;
      grid-auto-flow: column;
      place-items: center;
      gap: 0.34rem;
      min-height: 2.58rem;
      border-radius: 0.82rem;
      font-family: 'Oswald', sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-size: 0.97rem;
      padding: 0.64rem 0.74rem;
    }

    .btn-call span:last-child,
    .btn-wa span:last-child,
    .btn-solid span:last-child {
      display: block;
      text-align: center;
      line-height: 1.12;
      max-width: 100%;
      white-space: normal;
    }

    .btn-ghost:hover {
      transform: translateY(-2px);
      border-color: rgba(245, 166, 35, 0.5);
      background: rgba(245, 166, 35, 0.09);
    }

    .response-section-head {
      max-width: 56rem;
      margin: 0 auto 0.8rem;
      text-align: center;
    }

    .response-section-head h2 {
      margin: 0.2rem 0 0;
      font-family: 'Oswald', sans-serif;
      color: #fff;
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .response-video-feature {
      margin: 0 auto;
      max-width: 62rem;
    }

    .response-featured-embed {
      border-radius: 1.25rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
    }

    .response-playlist-wrap {
      max-width: 62rem;
      margin: 0 auto;
      display: grid;
      gap: 1rem;
    }

    .response-playlist-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .response-playlist-note {
      margin: 0;
      color: rgba(235, 244, 255, 0.78);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .response-playlist-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.85rem;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      border: 1px solid rgba(245, 166, 35, 0.42);
      background: rgba(245, 166, 35, 0.08);
      color: #ffe4a5;
      text-decoration: none;
      font-family: 'Oswald', sans-serif;
      font-size: 0.86rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
    }

    .response-playlist-link:hover {
      transform: translateY(-1px);
      background: rgba(245, 166, 35, 0.14);
      border-color: rgba(245, 166, 35, 0.64);
    }

    .response-process-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .response-process-card {
      position: relative;
      display: grid;
      gap: 0.45rem;
      padding: 0.9rem 0.95rem;
      border-radius: 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: linear-gradient(180deg, rgba(9, 20, 44, 0.86), rgba(4, 10, 24, 0.96));
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
      animation: rise-fade 500ms ease both;
      animation-delay: var(--card-delay, 0ms);
    }

    .response-process-card__index {
      color: rgba(245, 166, 35, 0.92);
      font-family: 'Oswald', sans-serif;
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .response-process-card h3 {
      margin: 0;
      color: #f8fdff;
      font-size: 1rem;
      line-height: 1.3;
    }

    .response-process-card p {
      margin: 0;
      color: rgba(235, 244, 255, 0.78);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .response-video-grid {
      margin-top: 0.1rem;
      display: flex;
      gap: 0.9rem;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding-top: 0.55rem;
      padding-bottom: 0.7rem;
      padding-inline: 0.65rem;
      scroll-padding-inline: 0.65rem;
      border-radius: 1.55rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: linear-gradient(170deg, rgba(7, 16, 34, 0.88), rgba(4, 10, 24, 0.94));
      box-shadow:
        inset 0 0 0 1px rgba(109, 173, 255, 0.08),
        0 10px 24px rgba(0, 0, 0, 0.22);
      scrollbar-width: thin;
      scrollbar-color: rgba(245, 166, 35, 0.55) rgba(255, 255, 255, 0.08);
    }

    .response-video-card {
      flex: 0 0 clamp(14.5rem, 42vw, 19rem);
      scroll-snap-align: start;
      display: grid;
      gap: 0.55rem;
      position: relative;
      isolation: isolate;
      --card-neon: rgba(0, 224, 255, 0.92);
      --card-neon-soft: rgba(0, 224, 255, 0.5);
      text-decoration: none;
      border-radius: 1.45rem;
      border: 1px solid var(--card-neon-soft);
      background: linear-gradient(180deg, rgba(6, 10, 19, 0.96), rgba(3, 7, 14, 0.99));
      padding: 0.68rem;
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
      animation: rise-fade 500ms ease both;
      animation-delay: var(--card-delay, 0ms);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.1),
        0 0 28px var(--card-neon-soft),
        0 14px 30px rgba(0, 0, 0, 0.3);
    }

    .response-video-card::before {
      content: '';
      position: absolute;
      inset: -16px;
      border-radius: 1.75rem;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 15%, var(--card-neon) 0%, transparent 48%),
        radial-gradient(circle at 50% 90%, var(--card-neon-soft) 0%, transparent 66%);
      filter: blur(18px) saturate(1.24);
      opacity: 0.95;
      transform: translateY(2px) scale(1);
      transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease;
      animation: neon-pulse-strong 2.4s ease-in-out infinite;
    }

    .response-video-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      z-index: 1;
      background:
        linear-gradient(115deg, transparent 0%, rgba(255, 255, 255, 0.16) 46%, transparent 58%);
      transform: translateX(-125%);
      opacity: 0;
      transition: opacity 220ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .response-video-card:nth-child(6n + 1) { --card-neon: rgba(0, 224, 255, 0.92); --card-neon-soft: rgba(0, 224, 255, 0.5); }
    .response-video-card:nth-child(6n + 2) { --card-neon: rgba(255, 210, 74, 0.92); --card-neon-soft: rgba(255, 210, 74, 0.5); }
    .response-video-card:nth-child(6n + 3) { --card-neon: rgba(255, 106, 186, 0.92); --card-neon-soft: rgba(255, 106, 186, 0.5); }
    .response-video-card:nth-child(6n + 4) { --card-neon: rgba(167, 112, 255, 0.92); --card-neon-soft: rgba(167, 112, 255, 0.5); }
    .response-video-card:nth-child(6n + 5) { --card-neon: rgba(82, 255, 166, 0.92); --card-neon-soft: rgba(82, 255, 166, 0.5); }
    .response-video-card:nth-child(6n + 6) { --card-neon: rgba(255, 134, 66, 0.92); --card-neon-soft: rgba(255, 134, 66, 0.5); }

    .response-video-card:hover {
      transform: translateY(-3px);
      border-color: var(--card-neon);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.14),
        0 0 34px var(--card-neon),
        0 0 70px var(--card-neon-soft),
        0 16px 34px rgba(0, 0, 0, 0.26);
    }

    .response-video-card:hover::before {
      filter: blur(22px) saturate(1.38);
      opacity: 1;
      transform: translateY(0) scale(1.02);
    }

    .response-video-card.is-center {
      border-color: var(--card-neon);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.16),
        0 0 44px var(--card-neon),
        0 0 92px var(--card-neon-soft),
        0 18px 38px rgba(0, 0, 0, 0.3);
      transform: scale(1.015);
    }

    .response-video-card.is-center::before {
      filter: blur(26px) saturate(1.48);
      opacity: 1;
      transform: translateY(0) scale(1.04);
    }

    .response-video-card:hover::after {
      opacity: 1;
      transform: translateX(125%);
    }

    .response-video-thumb {
      position: relative;
      overflow: hidden;
      border-radius: 1.05rem;
      aspect-ratio: 4 / 5;
      background: #0b1220;
    }

    .response-video-thumb::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(4, 8, 16, 0.1) 35%, rgba(4, 8, 16, 0.78) 100%);
      pointer-events: none;
    }

    .response-video-index {
      position: absolute;
      top: 0.4rem;
      left: 0.5rem;
      color: rgba(255, 255, 255, 0.78);
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2.6rem, 8vw, 3.6rem);
      line-height: 1;
      letter-spacing: 0.03em;
      text-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
      z-index: 1;
    }

    .response-video-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .response-video-image {
      opacity: 1;
    }

    .response-video-play {
      position: absolute;
      inset: auto 0.65rem 0.65rem auto;
      transform: none;
      display: inline-grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 999px;
      background: rgba(5, 13, 29, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 24px rgba(11, 188, 214, 0.2);
      z-index: 2;
    }

    .response-video-card p {
      margin: 0;
      color: #ff6a1a;
      font-size: 1.02rem;
      font-weight: 800;
      line-height: 1.45;
      overflow-wrap: anywhere;
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 2.65em;
    }

    .response-video-copy {
      color: rgba(238, 245, 255, 0.92);
      font-size: 0.89rem;
      line-height: 1.55;
      overflow-wrap: anywhere;
      word-break: break-word;
      min-height: 3.1em;
      display: block;
    }

    .response-inline-actions {
      margin-top: 1rem;
      justify-content: center;
    }

    .response-scroll-shell {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.9rem;
    }

    .response-scroll-btn {
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.24);
      background: rgba(5, 13, 29, 0.82);
      color: #fff;
      font-size: 1.55rem;
      line-height: 1;
      display: inline-grid;
      place-items: center;
      cursor: pointer;
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .response-scroll-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(245, 166, 35, 0.62);
    }

    .response-video-grid::-webkit-scrollbar,
    .response-repertoire-list::-webkit-scrollbar {
      height: 0.48rem;
    }

    .response-video-grid::-webkit-scrollbar-track,
    .response-repertoire-list::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
    }

    .response-video-grid::-webkit-scrollbar-thumb,
    .response-repertoire-list::-webkit-scrollbar-thumb {
      background: linear-gradient(90deg, rgba(11, 188, 214, 0.9), rgba(245, 166, 35, 0.92));
      border-radius: 999px;
    }

    .response-faq-list {
      display: grid;
      gap: 0.55rem;
      max-width: 62rem;
      margin: 0 auto;
    }

    .response-faq-item {
      position: relative;
      isolation: isolate;
      --faq-neon: rgba(111, 197, 255, 0.76);
      border-radius: 0.95rem;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: linear-gradient(180deg, rgba(12, 20, 46, 0.78), rgba(10, 18, 40, 0.84));
      box-shadow:
        inset 0 0 0 1px rgba(126, 155, 255, 0.08),
        0 0 20px rgba(126, 155, 255, 0.24);
      padding: 0.08rem 0.9rem;
    }

    .response-faq-item::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 1rem;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(circle at 50% 50%, var(--faq-neon) 0%, transparent 68%);
      filter: blur(14px);
      opacity: 0.82;
      animation: neon-pulse-soft 3s ease-in-out infinite;
    }

    .response-faq-item summary {
      text-shadow: 0 0 12px rgba(255, 255, 255, 0.08);
    }

    .response-faq-item:nth-child(6n + 1) { --faq-neon: rgba(0, 224, 255, 0.72); }
    .response-faq-item:nth-child(6n + 2) { --faq-neon: rgba(255, 210, 74, 0.72); }
    .response-faq-item:nth-child(6n + 3) { --faq-neon: rgba(255, 106, 186, 0.72); }
    .response-faq-item:nth-child(6n + 4) { --faq-neon: rgba(167, 112, 255, 0.72); }
    .response-faq-item:nth-child(6n + 5) { --faq-neon: rgba(82, 255, 166, 0.72); }
    .response-faq-item:nth-child(6n + 6) { --faq-neon: rgba(255, 134, 66, 0.72); }

    .response-faq-item summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.78rem 0;
      color: #fff;
      font-weight: 700;
      font-size: 0.97rem;
    }

    .response-faq-item summary::-webkit-details-marker {
      display: none;
    }

    .response-faq-item p {
      margin: 0 0 0.82rem;
      font-size: 0.9rem;
    }

    .response-footer-cta {
      max-width: 62rem;
      margin: 1rem auto 0;
      padding: 1.05rem 1rem;
      border-radius: 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: inset 0 0 0 1px rgba(112, 146, 255, 0.08);
      background: linear-gradient(170deg, rgba(21, 65, 127, 0.42), rgba(12, 43, 96, 0.58));
      text-align: center;
    }

    .response-footer-cta p {
      margin: 0;
      max-width: 43ch;
      margin-inline: auto;
      font-size: 1.02rem;
      font-weight: 700;
      color: rgba(241, 246, 255, 0.94);
    }

    .response-footer-actions {
      margin-top: 0.92rem;
      justify-content: center;
    }

    @keyframes rise-fade {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes neon-pulse-strong {
      0%, 100% {
        opacity: 0.85;
        filter: blur(16px) saturate(1.15);
      }
      50% {
        opacity: 1;
        filter: blur(24px) saturate(1.45);
      }
    }

    @keyframes neon-pulse-soft {
      0%, 100% {
        opacity: 0.72;
        filter: blur(13px) saturate(1.1);
      }
      50% {
        opacity: 0.95;
        filter: blur(18px) saturate(1.32);
      }
    }

    @media (min-width: 64rem) {
      .response-grid {
        grid-template-columns: 1fr;
        align-items: center;
      }

      .response-copy {
        padding-right: 0;
        text-align: center;
        margin-inline: auto;
      }

      .response-title {
        margin-inline: auto;
      }

      .response-pills,
      .response-actions {
        justify-content: center;
      }

      .response-top-announcement-wrap {
        margin-inline: auto;
      }
    }

    @media (max-width: 48rem) {
      .response-shell {
        border-radius: 1.1rem;
      }

      .response-pills {
        grid-template-columns: 1fr;
        gap: 0.72rem;
      }

      .response-playlist-meta {
        align-items: stretch;
      }

      .response-playlist-link {
        width: 100%;
      }

      .response-process-grid {
        grid-template-columns: 1fr;
      }

      .response-pill-card {
        padding: 0.88rem 0.92rem;
        border-radius: 1rem;
      }

      .response-pill-card__title {
        font-size: 0.8rem;
        letter-spacing: 0.035em;
      }

      .response-pill-card__text {
        font-size: 0.88rem;
        line-height: 1.5;
      }

      .btn-call,
      .btn-wa,
      .response-actions .btn-solid {
        min-height: 2.45rem;
        padding: 0.58rem 0.34rem;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        gap: 0.2rem;
      }

      .response-actions a span:last-child {
        line-height: 1.04;
        text-wrap: balance;
      }

      .response-actions > a {
        min-height: 3.35rem;
      }

      .response-actions > a:nth-child(4) {
        grid-column: 1 / -1;
      }

      .response-actions .btn-solid {
        min-height: 3rem;
      }

      .btn-wa span:last-child {
        font-size: 0.76rem;
      }

      .response-scroll-shell {
        grid-template-columns: 1fr;
      }

      .response-scroll-btn {
        display: none;
      }

      .response-video-card {
        flex-basis: min(78vw, 16.5rem);
      }

      .response-video-grid {
        padding-inline: 0.58rem;
        scroll-padding-inline: 0.58rem;
        border-radius: 1.25rem;
      }

      .response-video-card:nth-child(n + 4) {
        display: none;
      }

      .response-more-videos {
        margin-top: 0.65rem;
        display: flex;
        justify-content: center;
      }

      .response-more-videos-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.65rem;
        padding: 0.65rem 1rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.06);
        color: #f8fbff;
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-size: 0.86rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .response-actions {
        width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .response-members-cta {
        margin-top: 0.85rem;
      }

      .response-members-link {
        width: 100%;
        min-height: 3rem;
        font-size: 0.84rem;
      }

      .response-repertoire-list li {
        flex-basis: min(85vw, 18rem);
      }

      .response-repertoire-list li:nth-child(n) {
        animation-delay: calc(var(--rep-delay, 0ms) + 40ms);
      }

      .response-offer-highlight {
        padding: 0.66rem 0.72rem;
        border-radius: 0.9rem;
      }

      .response-offer-highlight__genres,
      .response-offer-highlight__price {
        font-size: 0.86rem;
      }

      .response-top-announcement {
        font-size: 0.88rem;
      }

      .response-video-card::before {
        opacity: 1;
        filter: blur(20px) saturate(1.34);
      }

      .response-video-card,
      .response-video-card:hover,
      .response-video-card.is-center {
        transform: none;
      }

      .response-video-card::after,
      .response-video-card:hover::after {
        opacity: 0;
        transform: none;
      }

      .response-video-thumb {
        aspect-ratio: 16 / 11;
      }

      .response-video-thumb img {
        object-position: center top;
      }

      .response-video-play {
        width: 2.1rem;
        height: 2.1rem;
      }

      .response-video-index {
        font-size: clamp(2.15rem, 11vw, 3rem);
      }

      .response-repertoire-list li::before,
      .response-faq-item::before {
        opacity: 0.92;
      }
    }

    @media (hover: none) and (pointer: coarse) {
      .response-video-grid {
        touch-action: auto;
      }

      .response-video-card,
      .response-video-card:hover,
      .response-video-card:active,
      .response-video-card:focus,
      .response-video-card:focus-visible {
        transform: none !important;
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        user-select: none;
        -webkit-user-select: none;
      }

      .response-video-thumb img {
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
      }
    }

    @media (max-width: 24rem) {
      .btn-call,
      .btn-wa,
      .response-actions .btn-solid {
        font-size: 0.74rem;
        padding-inline: 0.25rem;
      }

      .btn-call span:first-child,
      .btn-wa span:first-child,
      .response-actions .btn-solid span:first-child {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .response-copy,
      .response-video-card,
      .response-pill-card {
        animation: none;
      }

      .response-top-announcement-track {
        transform: none !important;
        width: 100%;
        display: block;
      }

      .response-top-announcement {
        white-space: normal;
        padding: 0.62rem 0.9rem;
      }

      .response-video-card::before,
      .response-video-card::after,
      .response-repertoire-list li::before,
      .response-faq-item::before {
        animation: none;
      }
    }
  </style>

  <script>
    const tickerTrack = document.querySelector('[data-ticker-track]');

    if (tickerTrack && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const tickerItem = tickerTrack.querySelector('[data-ticker-item]');

      if (tickerItem) {
        let rafId = 0;
        let resizeRaf = 0;
        let lastTime = performance.now();
        let offset = 0;
        let loopDistance = 0;
        let startOffset = 0;
        const speedPxPerSecond = 96;

        const measureTicker = () => {
          const wrapWidth = tickerTrack.clientWidth;
          const itemWidth = tickerItem.scrollWidth;
          if (!wrapWidth || !itemWidth) {
            return;
          }

          startOffset = wrapWidth;
          loopDistance = itemWidth;
          offset = startOffset;
          tickerItem.style.transform = `translateX(${offset}px)`;
          lastTime = performance.now();
        };

        const tick = (time) => {
          const dt = (time - lastTime) / 1000;
          lastTime = time;

          if (loopDistance > 0) {
            offset -= speedPxPerSecond * dt;
            if (offset <= -loopDistance - 12) {
              offset = startOffset;
            }
            tickerItem.style.transform = `translateX(${offset}px)`;
          }

          rafId = requestAnimationFrame(tick);
        };

        measureTicker();
        rafId = requestAnimationFrame(tick);

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => {
            measureTicker();
          });
        }

        window.addEventListener('resize', () => {
          if (resizeRaf) {
            cancelAnimationFrame(resizeRaf);
          }
          resizeRaf = requestAnimationFrame(measureTicker);
        }, { passive: true });

        if ('ResizeObserver' in window) {
          const ro = new ResizeObserver(() => {
            if (resizeRaf) {
              cancelAnimationFrame(resizeRaf);
            }
            resizeRaf = requestAnimationFrame(measureTicker);
          });
          ro.observe(tickerTrack);
          ro.observe(tickerItem);
        }
      }
    }

    const shells = document.querySelectorAll('[data-scroll-shell]');

    function initCenterHighlight(lane) {
      if (window.matchMedia('(max-width: 48rem)').matches) {
        return;
      }

      const cards = lane.matches('.response-video-grid')
        ? Array.from(lane.querySelectorAll('.response-video-card'))
        : Array.from(lane.querySelectorAll('li'));

      if (!cards.length) {
        return;
      }

      let rafId = 0;

      const updateCenterCard = () => {
        rafId = 0;
        const laneRect = lane.getBoundingClientRect();
        const laneCenter = laneRect.left + laneRect.width / 2;

        let closest = null;
        let minDistance = Number.POSITIVE_INFINITY;

        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const cardCenter = rect.left + rect.width / 2;
          const distance = Math.abs(cardCenter - laneCenter);
          if (distance < minDistance) {
            minDistance = distance;
            closest = card;
          }
        });

        cards.forEach((card) => card.classList.remove('is-center'));
        if (closest) {
          closest.classList.add('is-center');
        }
      };

      const requestUpdate = () => {
        if (rafId) {
          return;
        }
        rafId = requestAnimationFrame(updateCenterCard);
      };

      lane.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });
      requestUpdate();
    }

    shells.forEach((shell) => {
      const lane = shell.querySelector('.response-video-grid, .response-repertoire-list');
      const prev = shell.querySelector('[data-scroll-prev]');
      const next = shell.querySelector('[data-scroll-next]');

      if (!lane || !prev || !next) {
        return;
      }

      const step = () => Math.max(260, lane.clientWidth * 0.75);

      prev.addEventListener('click', () => {
        lane.scrollBy({ left: -step(), behavior: 'smooth' });
      });

      next.addEventListener('click', () => {
        lane.scrollBy({ left: step(), behavior: 'smooth' });
      });

      initCenterHighlight(lane);
    });
  </script>
</BaseLayout>