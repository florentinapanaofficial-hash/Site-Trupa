</style>

<script is:inline>
  // ── Modal detalii carduri ──
  (function () {
    const modal    = document.getElementById('dp-card-modal');
    const backdrop = document.getElementById('dp-modal-backdrop');
    const closeBtn = document.getElementById('dp-modal-close');
    const titleEl  = document.getElementById('dp-modal-title');
    const iconEl   = document.getElementById('dp-modal-icon');
    const bodyEl   = document.getElementById('dp-modal-body');

    if (!modal || !titleEl || !bodyEl) return;

    function openModal(title, icon, details) {
      titleEl.textContent = title;
      if (iconEl) iconEl.textContent = icon;
      bodyEl.textContent = details || 'Nicio descriere adăugată încă.';
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeModal() {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('button.dp-card[data-card-title]').forEach(btn => {
      btn.addEventListener('click', () => {
        openModal(
          btn.dataset.cardTitle   || '',
          btn.dataset.cardIcon    || '',
          btn.dataset.cardDetails || ''
        );
      });
    });

    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();

  // ── Montaj cinematic membrii ──
  (function() {
    var slides  = Array.from(document.querySelectorAll('.cine-slide'));
    var dots    = Array.from(document.querySelectorAll('.cine-dot'));
    var infoEl  = document.getElementById('cine-info');
    var nameEl  = document.getElementById('cine-name');
    var roleEl  = document.getElementById('cine-role');
    if (!slides.length) return;

    var members = slides.map(function(s) {
      return { name: s.dataset.name || '', role: s.dataset.role || '' };
    });
    var current = 0;
    var INTERVAL = 4600;
    var timer = null;

    function reveal() {
      if (infoEl) infoEl.classList.add('is-visible');
    }
    function goTo(idx) {
      slides[current].classList.remove('is-active');
      if (dots[current]) dots[current].classList.remove('is-active');
      if (infoEl) infoEl.classList.remove('is-visible');
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');
      if (nameEl) nameEl.textContent = members[current].name;
      if (roleEl) roleEl.textContent = members[current].role;
      setTimeout(reveal, 750);
    }
    // Init overlay
    if (nameEl) nameEl.textContent = members[0].name;
    if (roleEl) roleEl.textContent = members[0].role;
    setTimeout(reveal, 600);
    // Dots click
    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        clearInterval(timer);
        goTo(i);
        timer = setInterval(function() { goTo(current + 1); }, INTERVAL);
      });
    });
    // Auto advance
    timer = setInterval(function() { goTo(current + 1); }, INTERVAL);
    // Pause on hover
    var montage = document.querySelector('.cine-montage');
    if (montage) {
      montage.addEventListener('mouseenter', function() { clearInterval(timer); });
      montage.addEventListener('mouseleave', function() {
        timer = setInterval(function() { goTo(current + 1); }, INTERVAL);
      });
    }
    // Save resources when tab hidden
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) { clearInterval(timer); }
      else { timer = setInterval(function() { goTo(current + 1); }, INTERVAL); }
    });
  })();
</script>
