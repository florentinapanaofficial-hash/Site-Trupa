---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import BackButton from '../components/BackButton.astro';

const { membri, colaboratori: colaboratoriData } = siteContent as any;
const allMembri: any[] = membri ?? [];
const solisti        = allMembri.filter((m: any) => m.categorie === 'solisti');
const instrumentisti = allMembri.filter((m: any) => m.categorie === 'instrumentisti');
const colaboratori: any[] = (colaboratoriData ?? []).filter(
  (c: any) => c.nume && !c.nume.toLowerCase().includes('în curând')
);

/** Verifică dacă un membru are galerie foto reală (array non-gol). */
function areGalerieFoto(m: any): boolean {
  return Array.isArray(m.galpisFoto) && m.galpisFoto.length > 0;
}

function initiale(name: string): string {
  return name.split(' ').filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
}
---

<BaseLayout
  title="Membrii Formației Florentina Pană | Trupă Profesionistă Nuntă Pitești, Argeș"
  description="Cunoaște echipa formației Florentina Pană — soliști vocali și instrumentiști cu experiență de peste 20 ani. Formație nuntă Pitești și Argeș, disponibilă pentru nunți, botezuri și evenimente în toată România."
>
  <section class="membri-page-wrap">
  <div class="mb-6 px-4 pt-6 max-w-6xl mx-auto">
    <BackButton href="/" label="Acasă" />
  </div>

  <!-- ═══ HEADER PAGINĂ ═══ -->
  <header class="section-head mx-auto text-center mb-10 pt-8 anim-on-scroll max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="kicker">Echipa noastră</p>
    <h1 class="section-title">Membrii Formației — Formație Nuntă Pitești</h1>
    <p class="section-copy">Soliști vocali, instrumentiști și colaboratori cu experiență de peste 10 ani, disponibili pentru nunți, botezuri și evenimente în Pitești, Argeș și toată România.</p>
  </header>

  <!-- ═══ SOLIȘTI VOCALI ═══ -->
  <section class="mem-section" aria-labelledby="sec-solisti">
    <div class="mem-sec-head">
      <h2 class="mem-sec-title" id="sec-solisti">Soliști Vocali</h2>
      <div class="mem-sec-line" aria-hidden="true"></div>
    </div>

    {solisti.map((m: any, i: number) => (
      <div class="member-card-wrap anim-on-scroll" data-index={i} style={`transition-delay: ${i * 0.12}s`}>
        <article class="member-card">
          <!-- FOTO -->
          <div class="mc-photo-col">
            {m.imagine && m.imagine.trim() !== '' ? (
              <img
                src={m.imagine}
                alt={`${m.nume} - ${m.rol} - Formația Florentina Pană Pitești`}
                class="mc-photo-img anim-img-hover"
                loading="lazy"
                decoding="async"
                width="400"
                height="800"
              />
            ) : (
              <div class="mc-photo-ph" aria-hidden="true">
                <span class="mc-initials">{initiale(m.nume)}</span>
                <span class="mc-ph-label">Foto în curând</span>
              </div>
            )}
          </div>

          <!-- CONȚINUT -->
          <div class="mc-content-col">
            <span class="mc-cat-badge mc-cat-badge--solist">Solist Vocal</span>
            <h3 class="mc-name">{m.nume}</h3>
            <p class="mc-spec">{m.specialitate}</p>
            {m.experienta && m.experienta.trim() !== '' && (
              <p class="mc-exp">⭐ {m.experienta}</p>
            )}

            <!-- Galerie foto -->
            {areGalerieFoto(m) ? (
              <div class="mc-gallery-wrap">
                <div class="mc-gallery" role="list" aria-label={`Galerie foto ${m.nume}`}>
                  {m.galpisFoto.map((foto: any, n: number) => (
                    <div
                      class="mc-gallery-ph gallery-thumb"
                      role="listitem"
                      data-fx={String((n % 6) + 1)}
                      data-src={foto.src}
                      data-alt={foto.alt ?? `${m.nume} la eveniment - Formația Florentina Pană`}
                      tabindex="0"
                      title="Click pentru previzualizare"
                    >
                      <img src={foto.src} alt={foto.alt ?? `${m.nume} la eveniment`} class="mc-gal-thumb-img" loading="lazy" width="300" height="200" />
                      <span class="mc-gal-overlay" aria-hidden="true">🔍</span>
                    </div>
                  ))}
                </div>
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-indicator" aria-hidden="true">
                    {m.galpisFoto.map((_: any, n: number) => (
                      <span class={`dot${n === 0 ? ' active' : ''}`}></span>
                    ))}
                  </div>
                )}
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-hint" aria-hidden="true">
                    <span>Glisează</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </div>
                )}
              </div>
            ) : (
              <div class="mc-gallery mc-gallery--soon" aria-label="Galerie foto în curând">
                <div class="mc-gallery-coming">
                  <span class="mc-gal-icon" aria-hidden="true">📸</span>
                  <small class="mc-gal-soon-label">Galerie foto în curând</small>
                </div>
              </div>
            )}

            <!-- Buton BIO circular -->
            <button
              class="bio-btn"
              type="button"
              aria-expanded="false"
              aria-controls={`bio-panel-s${i}`}
              aria-label={`Biografie ${m.nume}`}
            >
              <span class="bio-btn-text">BIO</span>
            </button>
          </div>
        </article>

        <!-- Panel biografie -->
        <div class="bio-panel" id={`bio-panel-s${i}`} aria-hidden="true">
          {m.citat && (
            <blockquote class="bio-quote">
              <p>{m.citat}</p>
            </blockquote>
          )}
          <p class="bio-text">{m.bio}</p>
          {m.taguri && m.taguri.length > 0 && (
            <div class="bio-tags" aria-label="Specializări">
              {m.taguri.map((tag: string) => (
                <span class="bio-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- ═══ HINT SCROLL ═══ -->
  <div class="scroll-hint-wrap" aria-hidden="true">
    <a href="#sec-instr" class="scroll-hint-btn">
      <span class="scroll-hint-text">Instrumentiști</span>
      <svg class="scroll-hint-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </a>
  </div>

  <!-- ═══ DIVIDER ═══ -->
  <div class="mem-divider" aria-hidden="true"></div>

  <!-- ═══ INSTRUMENTIȘTI ═══ -->
  <section class="mem-section" aria-labelledby="sec-instr">
    <div class="mem-sec-head">
      <h2 class="mem-sec-title" id="sec-instr">Instrumentiști</h2>
      <div class="mem-sec-line" aria-hidden="true"></div>
    </div>

    {instrumentisti.map((m: any, i: number) => (
      <div class="member-card-wrap anim-on-scroll" data-index={i} style={`transition-delay: ${i * 0.12}s`}>
        <article class="member-card">
          <!-- FOTO -->
          <div class="mc-photo-col">
            {m.imagine && m.imagine.trim() !== '' ? (
              <img
                src={m.imagine}
                alt={`${m.nume} - ${m.rol} - ${m.specialitate} - Formația Florentina Pană Pitești`}
                class="mc-photo-img anim-img-hover"
                loading="lazy"
                decoding="async"
                width="400"
                height="800"
              />
            ) : (
              <div class="mc-photo-ph" aria-hidden="true">
                <span class="mc-initials">{initiale(m.nume)}</span>
                <span class="mc-ph-label">Foto în curând</span>
              </div>
            )}
          </div>

          <!-- CONȚINUT -->
          <div class="mc-content-col">
            <span class="mc-cat-badge mc-cat-badge--instr">Instrumentist</span>
            <h3 class="mc-name">{m.nume}</h3>
            <p class="mc-spec">{m.specialitate}</p>

            <!-- Galerie foto -->
            {areGalerieFoto(m) ? (
              <div class="mc-gallery-wrap">
                <div class="mc-gallery" role="list" aria-label={`Galerie foto ${m.nume}`}>
                  {m.galpisFoto.map((foto: any, n: number) => (
                    <div
                      class="mc-gallery-ph gallery-thumb"
                      role="listitem"
                      data-fx={String((n % 6) + 1)}
                      data-src={foto.src}
                      data-alt={foto.alt ?? `${m.nume} la eveniment - Formația Florentina Pană`}
                      tabindex="0"
                      title="Click pentru previzualizare"
                    >
                      <img src={foto.src} alt={foto.alt ?? `${m.nume} la eveniment`} class="mc-gal-thumb-img" loading="lazy" width="300" height="200" />
                      <span class="mc-gal-overlay" aria-hidden="true">🔍</span>
                    </div>
                  ))}
                </div>
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-indicator" aria-hidden="true">
                    {m.galpisFoto.map((_: any, n: number) => (
                      <span class={`dot${n === 0 ? ' active' : ''}`}></span>
                    ))}
                  </div>
                )}
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-hint" aria-hidden="true">
                    <span>Glisează</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </div>
                )}
              </div>
            ) : (
              <div class="mc-gallery mc-gallery--soon" aria-label="Galerie foto în curând">
                <div class="mc-gallery-coming">
                  <span class="mc-gal-icon" aria-hidden="true">📸</span>
                  <small class="mc-gal-soon-label">Galerie foto în curând</small>
                </div>
              </div>
            )}

            <!-- Buton BIO circular -->
            <button
              class="bio-btn"
              type="button"
              aria-expanded="false"
              aria-controls={`bio-panel-in${i}`}
              aria-label={`Biografie ${m.nume}`}
            >
              <span class="bio-btn-text">BIO</span>
            </button>
          </div>
        </article>

        <!-- Panel biografie -->
        <div class="bio-panel" id={`bio-panel-in${i}`} aria-hidden="true">
          {m.citat && (
            <blockquote class="bio-quote">
              <p>{m.citat}</p>
            </blockquote>
          )}
          <p class="bio-text">{m.bio}</p>
          {m.taguri && m.taguri.length > 0 && (
            <div class="bio-tags" aria-label="Specializări">
              {m.taguri.map((tag: string) => (
                <span class="bio-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- ═══ HINT SCROLL ═══ -->
  <div class="scroll-hint-wrap" aria-hidden="true">
    <a href="#sec-colab" class="scroll-hint-btn">
      <span class="scroll-hint-text">Colaboratori</span>
      <svg class="scroll-hint-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </a>
  </div>

  <!-- ═══ DIVIDER ═══ -->
  <div class="mem-divider" aria-hidden="true"></div>

  <!-- ═══ COLABORATORI ═══ -->
  <section class="mem-section" aria-labelledby="sec-colab">
    <div class="mem-sec-head">
      <h2 class="mem-sec-title" id="sec-colab">Colaboratori</h2>
      <div class="mem-sec-line" aria-hidden="true"></div>
    </div>
    {colaboratori.map((m: any, i: number) => (
      <div class="member-card-wrap" data-index={i}>
        <article class="member-card">
          <!-- FOTO -->
          <div class="mc-photo-col">
            {m.imagine && m.imagine.trim() !== '' ? (
              <img
                src={m.imagine}
                alt={`${m.nume} - ${m.specialitate} - Formația Florentina Pană Pitești`}
                class="mc-photo-img"
                loading="lazy"
                decoding="async"
                width="400"
                height="800"
              />
            ) : (
              <div class="mc-photo-ph" aria-hidden="true">
                <span class="mc-initials">{initiale(m.nume)}</span>
                <span class="mc-ph-label">Foto în curând</span>
              </div>
            )}
          </div>

          <!-- CONȚINUT -->
          <div class="mc-content-col">
            <span class="mc-cat-badge mc-cat-badge--colab">Colaborator</span>
            <h3 class="mc-name">{m.nume}</h3>
            <p class="mc-spec">{m.specialitate}</p>
            {m.experienta && m.experienta.trim() !== '' && (
              <p class="mc-exp">⭐ {m.experienta}</p>
            )}

            <!-- Galerie foto -->
            {areGalerieFoto(m) ? (
              <div class="mc-gallery-wrap">
                <div class="mc-gallery" role="list" aria-label={`Galerie foto ${m.nume}`}>
                  {m.galpisFoto.map((foto: any, n: number) => (
                    <div
                      class="mc-gallery-ph gallery-thumb"
                      role="listitem"
                      data-fx={String((n % 6) + 1)}
                      data-src={foto.src}
                      data-alt={foto.alt ?? `${m.nume} la eveniment - Formația Florentina Pană`}
                      tabindex="0"
                      title="Click pentru previzualizare"
                    >
                      <img src={foto.src} alt={foto.alt ?? `${m.nume} la eveniment`} class="mc-gal-thumb-img" loading="lazy" width="300" height="200" />
                      <span class="mc-gal-overlay" aria-hidden="true">🔍</span>
                    </div>
                  ))}
                </div>
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-indicator" aria-hidden="true">
                    {m.galpisFoto.map((_: any, n: number) => (
                      <span class={`dot${n === 0 ? ' active' : ''}`}></span>
                    ))}
                  </div>
                )}
                {m.galpisFoto.length > 1 && (
                  <div class="mc-gallery-hint" aria-hidden="true">
                    <span>Glisează</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </div>
                )}
              </div>
            ) : (
              <div class="mc-gallery mc-gallery--soon" aria-label="Galerie foto în curând">
                <div class="mc-gallery-coming">
                  <span class="mc-gal-icon" aria-hidden="true">📸</span>
                  <small class="mc-gal-soon-label">Galerie foto în curând</small>
                </div>
              </div>
            )}

            <!-- Buton BIO circular -->
            <button
              class="bio-btn"
              type="button"
              aria-expanded="false"
              aria-controls={`bio-panel-co${i}`}
              aria-label={`Biografie ${m.nume}`}
            >
              <span class="bio-btn-text">BIO</span>
            </button>
          </div>
        </article>

        <!-- Panel biografie -->
        <div class="bio-panel" id={`bio-panel-co${i}`} aria-hidden="true">
          {m.citat && (
            <blockquote class="bio-quote">
              <p>{m.citat}</p>
            </blockquote>
          )}
          <p class="bio-text">{m.bio}</p>
          {m.taguri && m.taguri.length > 0 && (
            <div class="bio-tags" aria-label="Specializări">
              {m.taguri.map((tag: string) => (
                <span class="bio-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- ═══ GALLERY POPUP OVERLAY ═══ -->
  <div id="gallery-popup" role="dialog" aria-modal="true" aria-label="Foto mărit">
    <button id="gallery-popup-close" type="button" aria-label="Închide galeria">✕</button>
    <div id="gallery-popup-inner">
      <img id="gallery-popup-img" src="" alt="" />
    </div>
  </div>
  </section>
</BaseLayout>

<script is:inline>
  // ═══ Mut popup-ul galerie la <body> — evită containment-ul
  // backdrop-filter/overflow care blochează position:fixed ═══
  (function() {
    const popup = document.getElementById('gallery-popup');
    if (popup && popup.parentElement !== document.body) {
      document.body.appendChild(popup);
    }
  })();

  document.querySelectorAll('.bio-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wrap = btn.closest('.member-card-wrap');
      if (!wrap) return;
      const panel = wrap.querySelector('.bio-panel');
      if (!panel) return;
      const isOpen = panel.classList.contains('open');

      // Închide toate celelalte paneluri
      document.querySelectorAll('.bio-panel.open').forEach((p) => {
        p.classList.remove('open');
        p.setAttribute('aria-hidden', 'true');
      });
      document.querySelectorAll('.bio-btn.active').forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        panel.classList.add('open');
        panel.setAttribute('aria-hidden', 'false');
        btn.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Click în afara închide panelul
  document.addEventListener('click', () => {
    document.querySelectorAll('.bio-panel.open').forEach((p) => {
      p.classList.remove('open');
      p.setAttribute('aria-hidden', 'true');
    });
    document.querySelectorAll('.bio-btn.active').forEach((b) => {
      b.classList.remove('active');
      b.setAttribute('aria-expanded', 'false');
    });
  });

  // ═══ GALLERY POPUP FX ═══
  const fxMap = {
    '1': { enter: 'fx-pop-in',      leave: 'fx-pop-out'      },
    '2': { enter: 'fx-warp-in',     leave: 'fx-warp-out'     },
    '3': { enter: 'fx-rubber-in',   leave: 'fx-rubber-out'   },
    '4': { enter: 'fx-flip-in',     leave: 'fx-flip-out'     },
    '5': { enter: 'fx-splat-in',    leave: 'fx-splat-out'    },
    '6': { enter: 'fx-spindrop-in', leave: 'fx-spindrop-out' },
  };

  const popup    = document.getElementById('gallery-popup');
  const popupImg = document.getElementById('gallery-popup-img');
  const popupClose = document.getElementById('gallery-popup-close');
  let currentFx  = '1';
  let lastFocusedThumb = null;

  function openPopup(src, alt, fx) {
    const anim = fxMap[fx] ?? fxMap['1'];
    lastFocusedThumb = document.activeElement;
    popupImg.src = src;
    popupImg.alt = alt;
    popupImg.classList.remove(...Object.values(fxMap).flatMap((v) => [v.enter, v.leave]));
    popup.classList.add('active');
    popupImg.classList.add(anim.enter);
    // Adaugă intrare în history — butonul Back va închide popup-ul
    history.pushState({ galleryOpen: true }, '');
    // Focus pe butonul de închidere pentru accesibilitate
    requestAnimationFrame(() => popupClose.focus());
  }

  function closePopup(fx = currentFx, { fromPopstate = false } = {}) {
    if (!popup.classList.contains('active')) return;
    const anim = fxMap[fx] ?? fxMap['1'];
    popupImg.classList.remove(...Object.values(fxMap).flatMap((v) => [v.enter, v.leave]));
    popupImg.classList.add(anim.leave);
    // Dacă nu vine din popstate, scoatem intrarea din history
    if (!fromPopstate) {
      history.back();
    }
    popupImg.addEventListener('animationend', () => {
      popup.classList.remove('active');
      popupImg.src = '';
      popupImg.alt = '';
      popupImg.classList.remove(anim.leave);
      // Restabilește focus pe thumbnail-ul care a deschis popup-ul
      if (lastFocusedThumb && lastFocusedThumb.focus) {
        lastFocusedThumb.focus();
        lastFocusedThumb = null;
      }
    }, { once: true });
  }

  // Butonul fizic Back închide popup-ul dacă e deschis
  window.addEventListener('popstate', (e) => {
    if (popup.classList.contains('active')) {
      closePopup(currentFx, { fromPopstate: true });
    }
  });

  // ═══ GALLERY SLIDER — dots + mouse drag ═══
  let galleryDragged = false;

  document.querySelectorAll('.gallery-thumb').forEach((thumb) => {
    function activateThumb() {
      const fx  = thumb.dataset.fx  ?? '1';
      const src = thumb.dataset.src ?? '';
      const alt = thumb.dataset.alt ?? '';
      currentFx = fx;
      openPopup(src, alt, fx);
    }

    thumb.addEventListener('click', (e) => {
      e.stopPropagation();
      if (galleryDragged) { galleryDragged = false; return; }
      activateThumb();
    });

    // Activare cu tastatura (Enter / Space) pentru accesibilitate
    thumb.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();
        activateThumb();
      }
    });
  });

  popup.addEventListener('click', () => closePopup(currentFx));

  document.getElementById('gallery-popup-close').addEventListener('click', (e) => {
    e.stopPropagation();
    closePopup(currentFx);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popup.classList.contains('active')) closePopup(currentFx);
  });

  // ═══ GALLERY SLIDER — dots + mouse drag ═══
  document.querySelectorAll('.mc-gallery-wrap').forEach((wrap) => {
    const gallery = wrap.querySelector('.mc-gallery');
    const indicator = wrap.querySelector('.mc-gallery-indicator');
    const hint = wrap.querySelector('.mc-gallery-hint');
    if (!gallery) return;

    const dots = indicator ? indicator.querySelectorAll('.dot') : [];
    const thumbs = gallery.querySelectorAll('.mc-gallery-ph');

    let hintHidden = false;

    // ── Actualizare dots la scroll ──
    function updateDots() {
      if (dots.length < 2) return;
      const scrollLeft = gallery.scrollLeft;

      let activeIdx = 0;
      let minDist = Infinity;
      thumbs.forEach((thumb, idx) => {
        const thumbCenter = thumb.offsetLeft + thumb.offsetWidth / 2;
        const galCenter = scrollLeft + gallery.clientWidth / 2;
        const dist = Math.abs(thumbCenter - galCenter);
        if (dist < minDist) {
          minDist = dist;
          activeIdx = idx;
        }
      });

      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIdx);
      });
    }

    gallery.addEventListener('scroll', () => {
      // Ascunde hint-ul după primul scroll
      if (!hintHidden && gallery.scrollLeft > 10 && hint) {
        hint.style.opacity = '0';
        hint.style.transition = 'opacity 0.3s';
        hintHidden = true;
      }
      updateDots();
    }, { passive: true });

    // ── Mouse drag scroll (pentru desktop cu mouse) ──
    let isDragging = false;
    let startX = 0;
    let scrollStart = 0;
    let dragMoved = false;

    gallery.addEventListener('mousedown', (e) => {
      // Doar click stânga
      if (e.button !== 0) return;
      isDragging = true;
      dragMoved = false;
      startX = e.pageX;
      scrollStart = gallery.scrollLeft;
      gallery.style.cursor = 'grabbing';
      gallery.style.userSelect = 'none';
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.pageX - startX;
      if (Math.abs(dx) > 5) dragMoved = true;
      gallery.scrollLeft = scrollStart - dx;
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      gallery.style.cursor = '';
      gallery.style.userSelect = '';
      if (dragMoved) galleryDragged = true;
    });
  });
</script>

