---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoupleHero from '../../components/CoupleHero.astro';
import CoupleGallery from '../../components/CoupleGallery.astro';
import CoupleRecommendation from '../../components/CoupleRecommendation.astro';
import BackButton from '../../components/BackButton.astro';
import siteContent from '../../data/siteContent.json';
import couplesData from '../../data/couples.json';

export const prerender = true;

interface Couple {
  slug: string;
  names: string;
  city: string;
  date: string;
  isoDate: string;
  locationName: string;
  locationAddress: string;
  coverPhoto: string;
  accentColor: string;
  accentGlow: string;
  loveStory: string;
  recommendation: string;
  recommendationSource: string;
  danceVideoUrl: string;
  capcutMontageUrl?: string;
  photos: string[];
  blogSlug: string;
  uploadToken: string;
}

export function getStaticPaths() {
  return (couplesData.couples as Couple[]).map((couple) => ({
    params: { slug: couple.slug },
    props: { couple },
  }));
}

const { couple } = Astro.props as { couple: Couple };

const { brand } = siteContent;

let youtubeId = '';
if (couple.danceVideoUrl) {
  try {
    const url = new URL(couple.danceVideoUrl);
    youtubeId = url.searchParams.get('v') || url.pathname.split('/').filter(Boolean).pop() || '';
  } catch {
    youtubeId = '';
  }
}

let montageEmbedUrl = '';
let montageOpenUrl = couple.capcutMontageUrl || '';
let montageOpenLabel = 'Deschide în aplicație';
if (couple.capcutMontageUrl) {
  try {
    const montageUrl = new URL(couple.capcutMontageUrl);
    const host = montageUrl.hostname.toLowerCase().replace('www.', '');
    let montageId = '';

    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtu.be') {
      montageOpenLabel = 'Deschide pe YouTube';
      if (host === 'youtu.be') {
        montageId = montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      } else if (montageUrl.pathname.startsWith('/shorts/')) {
        montageId = montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      } else {
        montageId = montageUrl.searchParams.get('v') || montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      }
    }

    if (montageId) {
      montageEmbedUrl = `https://www.youtube.com/embed/${montageId}?rel=0&modestbranding=1`;
      montageOpenUrl = `https://www.youtube.com/watch?v=${montageId}`;
    } else {
      montageEmbedUrl = couple.capcutMontageUrl;
    }
  } catch {
    montageEmbedUrl = couple.capcutMontageUrl;
  }
}

const pageTitle = `${couple.names} — Povestea lor | ${brand.name}`;
const pageDescription = `Descoperă povestea de dragoste a perechii ${couple.names} din ${couple.city}. Recomandare, galerie foto și dansul mirilor — ${brand.name}.`;

const SITE = 'https://www.florentinapanaofficial.ro';
const pageUrl = `${SITE}/comunitate/${couple.slug}/`;
const coupleOgImage = couple.coverPhoto
  ? encodeURI(decodeURI(couple.coverPhoto.startsWith('http') ? couple.coverPhoto : `${SITE}${couple.coverPhoto}`))
  : undefined;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Nuntă ${couple.names}`,
  startDate: couple.isoDate,
  location: {
    '@type': 'Place',
    name: couple.locationName,
    address: couple.locationAddress,
  },
  performer: {
    '@type': 'MusicGroup',
    name: brand.name,
  },
  description: pageDescription,
};

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  reviewBody: couple.recommendation,
  author: { '@type': 'Person', name: couple.names },
  itemReviewed: {
    '@type': 'MusicGroup',
    name: brand.name,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: '5',
    bestRating: '5',
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={coupleOgImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {coupleOgImage && <meta property="og:image" content={coupleOgImage} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="article" />
  </Fragment>

  <main class="couple-page">
    <BackButton href="/comunitate/" label="← Comunitate" />

    <!-- Hero -->
    <CoupleHero
      names={couple.names}
      city={couple.city}
      date={couple.date}
      locationName={couple.locationName}
      coverPhoto={couple.coverPhoto}
      accentColor={couple.accentColor}
      accentGlow={couple.accentGlow}
    />

    <!-- Nav intern -->
    <nav class="couple-page__nav" aria-label="Secțiuni">
      <a href="#poveste" class="couple-page__nav-link" style={`--nav-accent: ${couple.accentColor};`}>💕 Povestea</a>
      <a href="#recomandare" class="couple-page__nav-link" style={`--nav-accent: ${couple.accentColor};`}>💬 Recomandare</a>
      <a href="#galerie" class="couple-page__nav-link" style={`--nav-accent: ${couple.accentColor};`}>📸 Galerie</a>
      <a href="#dans" class="couple-page__nav-link" style={`--nav-accent: ${couple.accentColor};`}>💃 Dansul Mirilor</a>
      <a href="#montaj" class="couple-page__nav-link" style={`--nav-accent: ${couple.accentColor};`}>📱 Montaj Foto</a>
    </nav>

    <!-- 1. Povestea de dragoste -->
    <section class="couple-section" id="poveste" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">💕 Povestea lor de dragoste</h2>
      <div class="couple-section__content">
        <p>{couple.loveStory}</p>
      </div>
    </section>

    <!-- 2. Recomandare -->
    <CoupleRecommendation
      recommendation={couple.recommendation}
      names={couple.names}
      recommendationSource={couple.recommendationSource}
      accentColor={couple.accentColor}
      accentGlow={couple.accentGlow}
    />

    <!-- 3. Galerie Foto -->
    <CoupleGallery
      photos={couple.photos}
      names={couple.names}
      accentColor={couple.accentColor}
    />

    <!-- 4. Dansul Mirilor -->
    <section class="couple-section" id="dans" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">💃 Dansul Mirilor</h2>

      {youtubeId ? (
        <div class="couple-dance__video">
          <iframe
            src={`https://www.youtube.com/embed/${youtubeId}?rel=0`}
            title={`Dansul Mirilor — ${couple.names}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      ) : (
        <div class="couple-dance__empty">
          <p>🎵 Videoclipul cu dansul mirilor va fi adăugat în curând.</p>
        </div>
      )}
    </section>

    <section class="couple-section" id="montaj" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">📱 Montaj Foto (Format Reels)</h2>

      {couple.capcutMontageUrl ? (
        <div class="couple-montage" data-montage-wrapper>
          <div class="couple-montage__phone">
            <iframe
              src={montageEmbedUrl}
              title={`Montaj foto — ${couple.names}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              webkitallowfullscreen
              mozallowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              loading="lazy"
            ></iframe>
          </div>
          <div class="couple-montage__actions">
            <button type="button" class="couple-montage__fullscreen" data-montage-fullscreen>
              Vezi fullscreen
            </button>
            <a href={montageOpenUrl} target="_blank" rel="noopener noreferrer" class="couple-montage__open">
              {montageOpenLabel}
            </a>
          </div>
        </div>
      ) : (
        <div class="couple-dance__empty">
          <p>📷 Montajul foto vertical va fi adăugat în curând.</p>
        </div>
      )}
    </section>

    <!-- CTA -->
    {couple.blogSlug && (
      <div class="couple-page__cta">
        <a href={`/blog/${couple.blogSlug}/`} class="couple-page__cta-link" style={`--cta-accent: ${couple.accentColor};`}>
          📰 Citește articolul dedicat → {couple.names}
        </a>
      </div>
    )}

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewLd)} />
    <script is:inline>
      (function () {
        var button = document.querySelector('[data-montage-fullscreen]');
        var wrapper = document.querySelector('[data-montage-wrapper]');
        var iframe = wrapper ? wrapper.querySelector('iframe') : null;
        var openLink = wrapper ? wrapper.querySelector('.couple-montage__open') : null;
        if (!button || !wrapper) return;

        var isMobile = window.matchMedia('(max-width: 767px)').matches;
        var inlineFullscreenClass = 'couple-montage--inline-fullscreen';

        function setButtonLabel() {
          var nativeFs = document.fullscreenElement === wrapper;
          var inlineFs = wrapper.classList.contains(inlineFullscreenClass);
          button.textContent = nativeFs || inlineFs ? 'Ieși din fullscreen' : 'Vezi fullscreen';
        }

        function requestFs(el) {
          if (!el) return false;
          if (el.requestFullscreen) {
            el.requestFullscreen().catch(function () {});
            return true;
          }
          if (el.webkitRequestFullscreen) {
            el.webkitRequestFullscreen();
            return true;
          }
          if (el.msRequestFullscreen) {
            el.msRequestFullscreen();
            return true;
          }
          return false;
        }

        function exitFs() {
          if (document.fullscreenElement && document.exitFullscreen) {
            document.exitFullscreen().catch(function () {});
            return true;
          }
          return false;
        }

        function toggleInlineFullscreen() {
          var willOpen = !wrapper.classList.contains(inlineFullscreenClass);
          wrapper.classList.toggle(inlineFullscreenClass, willOpen);
          document.body.classList.toggle('couple-inline-fs-open', willOpen);
          setButtonLabel();
        }

        document.addEventListener('fullscreenchange', setButtonLabel);

        button.addEventListener('click', function () {
          if (document.fullscreenElement === wrapper) {
            exitFs();
            return;
          }

          if (wrapper.classList.contains(inlineFullscreenClass)) {
            toggleInlineFullscreen();
            return;
          }

          var opened = requestFs(wrapper) || requestFs(iframe);
          if (!opened && isMobile) {
            toggleInlineFullscreen();
            return;
          }
          if (!opened && openLink && openLink.href) {
            window.location.href = openLink.href;
          }
        });

        setButtonLabel();
      })();
    </script>
  </main>
</BaseLayout>

<style>
  .couple-page {
    padding-bottom: 3rem;
  }

  /* Nav intern */
  .couple-page__nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    flex-wrap: wrap;
    max-width: 720px;
    margin: 0 auto;
  }

  .couple-page__nav-link {
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .couple-page__nav-link:hover {
    color: var(--nav-accent);
    border-color: var(--nav-accent);
    background: rgba(255, 255, 255, 0.08);
  }

  /* Sections */
  .couple-section {
    padding: 3rem 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .couple-section__title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--section-accent);
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .couple-section__content {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 2rem;
  }

  .couple-section__content p {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.8;
    font-size: 1.05rem;
    margin: 0;
  }

  /* Dance Video */
  .couple-dance__video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 1rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .couple-dance__video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 1rem;
  }

  .couple-montage {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .couple-montage__phone {
    width: min(100%, 380px);
    aspect-ratio: 9 / 16;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.25);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
  }

  .couple-montage__phone iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .couple-montage__actions {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .couple-montage__fullscreen,
  .couple-montage__open {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    border-radius: 999px;
    padding: 0.5rem 0.95rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .couple-montage__fullscreen:hover,
  .couple-montage__open:hover {
    border-color: var(--section-accent);
    color: var(--section-accent);
  }

  .couple-montage.couple-montage--inline-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .couple-montage.couple-montage--inline-fullscreen .couple-montage__phone {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    aspect-ratio: auto;
    border-radius: 0;
    border: none;
    box-shadow: none;
  }

  .couple-montage.couple-montage--inline-fullscreen .couple-montage__actions {
    position: fixed;
    bottom: max(12px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
  }

  :global(body.couple-inline-fs-open) {
    overflow: hidden;
  }

  .couple-dance__empty {
    text-align: center;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* CTA Blog */
  .couple-page__cta {
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .couple-page__cta-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--cta-accent);
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.25s ease;
  }

  .couple-page__cta-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--cta-accent);
  }

  @media (max-width: 767px) {
    .couple-section {
      padding: 2rem 1rem;
    }

    .couple-section__content {
      padding: 1.25rem;
    }

    .couple-page__nav {
      gap: 0.35rem;
      padding: 0.75rem 1rem;
    }

    .couple-page__nav-link {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
  }
</style>
