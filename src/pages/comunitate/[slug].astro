---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoupleHero from '../../components/CoupleHero.astro';
import CoupleRecommendation from '../../components/CoupleRecommendation.astro';
import BackButton from '../../components/BackButton.astro';
import siteContent from '../../data/siteContent.json';
import couplesData from '../../data/couples.json';

export const prerender = true;

interface Couple {
  slug: string;
  names: string;
  city: string;
  date: string;
  isoDate: string;
  locationName: string;
  locationAddress: string;
  coverPhoto: string;
  accentColor: string;
  accentGlow: string;
  loveStory: string;
  recommendation: string;
  recommendationSource: string;
  danceVideoUrl: string;
  capcutMontageUrl?: string;
  photos: string[];
  blogSlug: string;
  uploadToken: string;
}

export function getStaticPaths() {
  return (couplesData.couples as Couple[]).map((couple) => ({
    params: { slug: couple.slug },
    props: { couple },
  }));
}

const { couple } = Astro.props as { couple: Couple };

const { brand } = siteContent;

function extractYouTubeId(input: string) {
  if (!input) return '';
  try {
    const url = new URL(input);
    const host = url.hostname.toLowerCase().replace('www.', '');
    if (host === 'youtu.be') {
      return url.pathname.split('/').filter(Boolean).pop() || '';
    }
    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'music.youtube.com' || host === 'youtube-nocookie.com') {
      if (url.pathname.startsWith('/shorts/')) {
        return url.pathname.split('/').filter(Boolean).pop() || '';
      }
      return url.searchParams.get('v') || url.pathname.split('/').filter(Boolean).pop() || '';
    }
    return '';
  } catch {
    return '';
  }
}

const youtubeId = extractYouTubeId(couple.danceVideoUrl || '');

let montageEmbedUrl = '';
let montageYoutubeId = '';
if (couple.capcutMontageUrl) {
  try {
    const montageUrl = new URL(couple.capcutMontageUrl);
    const host = montageUrl.hostname.toLowerCase().replace('www.', '');
    let montageId = '';

    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtu.be') {
      if (host === 'youtu.be') {
        montageId = montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      } else if (montageUrl.pathname.startsWith('/shorts/')) {
        montageId = montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      } else {
        montageId = montageUrl.searchParams.get('v') || montageUrl.pathname.split('/').filter(Boolean).pop() || '';
      }
    }

    if (montageId) {
      montageYoutubeId = montageId;
      montageEmbedUrl = `https://www.youtube.com/embed/${montageId}?rel=0&modestbranding=1`;
    } else {
      montageEmbedUrl = couple.capcutMontageUrl;
    }
  } catch {
    montageEmbedUrl = couple.capcutMontageUrl;
  }
}

function buildDanceSources(videoId: string) {
  if (!videoId) return [];
  return [
    `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1&playsinline=1&enablejsapi=1`,
    `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1&playsinline=1&enablejsapi=1`,
    `https://www.youtube.com/embed/${videoId}?rel=0&playsinline=1&enablejsapi=1`,
  ];
}

const danceCandidateIds = [youtubeId];
if (montageYoutubeId && montageYoutubeId !== youtubeId) {
  danceCandidateIds.push(montageYoutubeId);
}

const danceEmbedCandidates = danceCandidateIds.flatMap(buildDanceSources);
const danceEmbedSrc = danceEmbedCandidates[0] || '';
const danceFallbackThumb = (youtubeId || montageYoutubeId)
  ? `https://i.ytimg.com/vi/${youtubeId || montageYoutubeId}/hqdefault.jpg`
  : '';

const pageTitle = `${couple.names} — Povestea lor | ${brand.name}`;
const pageDescription = `Descoperă povestea de dragoste a perechii ${couple.names} din ${couple.city}. Recomandare, galerie foto și dansul mirilor — ${brand.name}.`;

const SITE = 'https://www.florentinapanaofficial.ro';
const pageUrl = `${SITE}/comunitate/${couple.slug}/`;
const coupleOgImage = couple.coverPhoto
  ? encodeURI(decodeURI(couple.coverPhoto.startsWith('http') ? couple.coverPhoto : `${SITE}${couple.coverPhoto}`))
  : undefined;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Nuntă ${couple.names}`,
  startDate: couple.isoDate,
  location: {
    '@type': 'Place',
    name: couple.locationName,
    address: couple.locationAddress,
  },
  performer: {
    '@type': 'MusicGroup',
    name: brand.name,
  },
  description: pageDescription,
};

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  reviewBody: couple.recommendation,
  author: { '@type': 'Person', name: couple.names },
  itemReviewed: {
    '@type': 'MusicGroup',
    name: brand.name,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: '5',
    bestRating: '5',
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={coupleOgImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {coupleOgImage && <meta property="og:image" content={coupleOgImage} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="article" />
  </Fragment>

  <main class="couple-page">
    <BackButton href="/comunitate/" label="← Comunitate" />

    <!-- Hero -->
    <CoupleHero
      names={couple.names}
      city={couple.city}
      date={couple.date}
      locationName={couple.locationName}
      coverPhoto={couple.coverPhoto}
      accentColor={couple.accentColor}
      accentGlow={couple.accentGlow}
    />

    <div class="couple-page__share-wrap" style={`--share-accent: ${couple.accentColor};`}>
      <button
        type="button"
        class="couple-page__share-btn"
        data-page-share
        aria-label="Distribuie povestea acestui cuplu"
      >
        📤 Distribuie pagina mirilor
      </button>
      <p class="couple-page__share-status" data-page-share-status aria-live="polite"></p>
    </div>

    <!-- 1. Dansul Mirilor -->
    <section class="couple-section" id="dans" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">💃 Dansul Mirilor</h2>

      {youtubeId ? (
        <div class="couple-dance" data-dance-wrapper data-dance-sources={danceEmbedCandidates.join('|||')}>
          <div class="couple-dance__video">
            <iframe
              src={danceEmbedSrc}
              title={`Dansul Mirilor — ${couple.names}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              loading="lazy"
              data-dance-iframe
            ></iframe>
          </div>
          <div class="couple-dance__fallback" data-dance-fallback hidden>
            {danceFallbackThumb && (
              <img
                src={danceFallbackThumb}
                alt={`Preview video dans — ${couple.names}`}
                loading="lazy"
                decoding="async"
                class="couple-dance__fallback-thumb"
              />
            )}
            <p class="couple-dance__fallback-text">Videoclipul întâmpină o problemă temporară de redare.</p>
            <button type="button" class="couple-dance__retry" data-dance-retry>
              Reîncearcă redarea
            </button>
          </div>
          <p class="couple-dance__status" data-dance-status aria-live="polite"></p>
          <button
            type="button"
            class="couple-dance__fullscreen"
            data-dance-fullscreen
            aria-label="Umple ecranul pentru dansul mirilor"
            title="Umple ecranul"
          >
            ⤢
          </button>
        </div>
      ) : (
        <div class="couple-dance__empty">
          <p>🎵 Videoclipul cu dansul mirilor va fi adăugat în curând.</p>
        </div>
      )}
    </section>

    <!-- 2. Album Foto -->
    <section class="couple-section" id="montaj" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">📱 Album Foto</h2>

      {couple.capcutMontageUrl ? (
        <div class="couple-montage" data-montage-wrapper>
          <div class="couple-montage__phone">
            <iframe
              src={montageEmbedUrl}
              title={`Montaj foto — ${couple.names}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              loading="lazy"
            ></iframe>
          </div>
          <div class="couple-montage__actions">
            <button type="button" class="couple-montage__fullscreen" data-montage-fullscreen>
              Vezi fullscreen
            </button>
          </div>
        </div>
      ) : (
        <div class="couple-dance__empty">
          <p>📷 Montajul foto vertical va fi adăugat în curând.</p>
        </div>
      )}
    </section>

    <!-- 3. Povestea lor de dragoste -->
    <section class="couple-section" id="poveste" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">💕 Povestea lor de dragoste</h2>
      <div class="couple-section__content">
        {couple.blogSlug ? (
          <a href={`/blog/${couple.blogSlug}/`} class="couple-story__link">
            Citește povestea lor completă
          </a>
        ) : (
          <p>{couple.loveStory}</p>
        )}
      </div>
    </section>

    <!-- 4. Recomandarea lor -->
    <CoupleRecommendation
      recommendation={couple.recommendation}
      names={couple.names}
      recommendationSource={couple.recommendationSource}
      accentColor={couple.accentColor}
      accentGlow={couple.accentGlow}
    />

    <!-- 5. Elemente promoționale -->
    <section class="couple-section" id="promovare" style={`--section-accent: ${couple.accentColor};`}>
      <h2 class="couple-section__title">🎵 Descoperă Formația Florentina Pană</h2>
      <div class="couple-promo">
        <a class="couple-promo__card" href="/despre/">
          <h3>Despre noi</h3>
          <p>Vezi povestea formației, experiența live și momentele care ne definesc.</p>
        </a>
        <a class="couple-promo__card" href="/galerie-video/">
          <h3>Galerie video</h3>
          <p>Urmărește clipuri reale de la nunți, dansuri și energie autentică pe ring.</p>
        </a>
        <a class="couple-promo__card" href="/cauti-formatie-nunta/">
          <h3>Cauți formație de nuntă?</h3>
          <p>Solicită o ofertă personalizată pentru evenimentul tău din Argeș sau din țară.</p>
        </a>
      </div>
    </section>

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewLd)} />
    <script is:inline>
      (function () {
        var pageShareButton = document.querySelector('[data-page-share]');
        var pageShareStatus = document.querySelector('[data-page-share-status]');

        function setShareStatus(message, isError) {
          if (!pageShareStatus) return;
          pageShareStatus.textContent = message;
          pageShareStatus.classList.toggle('is-error', !!isError);
        }

        if (pageShareButton) {
          pageShareButton.addEventListener('click', function () {
            var shareUrl = window.location.href;
            var shareText = 'Povestea noastră de nuntă';
            var shareTitle = document.title;

            if (navigator.share) {
              navigator.share({
                title: shareTitle,
                text: shareText,
                url: shareUrl,
              }).then(function () {
                setShareStatus('Linkul a fost distribuit cu succes.');
              }).catch(function () {
                setShareStatus('Distribuirea a fost anulată.');
              });
              return;
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(shareUrl).then(function () {
                setShareStatus('Linkul paginii a fost copiat. Îl poți distribui imediat.');
              }).catch(function () {
                setShareStatus('Nu am putut copia linkul. Copiază URL-ul din bară.', true);
              });
              return;
            }

            setShareStatus('Copiază URL-ul din bară pentru distribuire.', true);
          });
        }

        var danceButton = document.querySelector('[data-dance-fullscreen]');
        var danceWrapper = document.querySelector('[data-dance-wrapper]');
        var danceIframe = danceWrapper ? danceWrapper.querySelector('[data-dance-iframe]') : null;
        var danceSourcesRaw = danceWrapper ? danceWrapper.getAttribute('data-dance-sources') : '';
        var danceSources = danceSourcesRaw ? danceSourcesRaw.split('|||').filter(Boolean) : [];
        var danceSourceIndex = 0;
        var dancePlaybackOk = false;
        var danceFallbackTimer = null;
        var danceStatus = danceWrapper ? danceWrapper.querySelector('[data-dance-status]') : null;
        var danceFallback = danceWrapper ? danceWrapper.querySelector('[data-dance-fallback]') : null;
        var danceRetryButton = danceWrapper ? danceWrapper.querySelector('[data-dance-retry]') : null;

        var button = document.querySelector('[data-montage-fullscreen]');
        var wrapper = document.querySelector('[data-montage-wrapper]');
        var iframe = wrapper ? wrapper.querySelector('iframe') : null;
        var hasDance = danceButton && danceWrapper;
        var hasMontage = button && wrapper;
        if (!hasDance && !hasMontage) return;

        var isMobile = window.matchMedia('(max-width: 767px)').matches;
        var inlineFullscreenClass = 'couple-montage--inline-fullscreen';
        var danceFsClass = 'couple-dance--inline-fullscreen';
        var orientationLocked = false;

        function clearDanceFallbackTimer() {
          if (danceFallbackTimer) {
            window.clearTimeout(danceFallbackTimer);
            danceFallbackTimer = null;
          }
        }

        function withOrigin(src) {
          if (!src) return '';
          var hasOrigin = src.indexOf('origin=') !== -1;
          if (hasOrigin) return src;
          return src + (src.indexOf('?') === -1 ? '?' : '&') + 'origin=' + encodeURIComponent(window.location.origin);
        }

        function setDanceStatus(message, isError) {
          if (!danceStatus) return;
          danceStatus.textContent = message || '';
          danceStatus.classList.toggle('is-error', !!isError);
        }

        function setDanceFallbackVisible(show) {
          if (!danceFallback || !danceIframe) return;
          danceFallback.hidden = !show;
          danceIframe.style.visibility = show ? 'hidden' : 'visible';
        }

        function pushDanceEventSubscriptions() {
          if (!danceIframe || !danceIframe.contentWindow) return;
          var target = '*';
          try {
            danceIframe.contentWindow.postMessage(JSON.stringify({ event: 'listening' }), target);
            danceIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onReady'] }), target);
            danceIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onStateChange'] }), target);
            danceIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onError'] }), target);
          } catch (err) {}
        }

        function scheduleDanceFallback() {
          clearDanceFallbackTimer();
          danceFallbackTimer = window.setTimeout(function () {
            if (dancePlaybackOk) return;
            if (danceSourceIndex < danceSources.length - 1) {
              applyDanceSource(danceSourceIndex + 1);
            } else {
              setDanceStatus('Videoclipul este indisponibil momentan. Încercăm din nou mai târziu.', true);
              setDanceFallbackVisible(true);
            }
          }, 2200);
        }

        function applyDanceSource(nextIndex) {
          if (!danceIframe || !danceSources[nextIndex]) return false;
          danceSourceIndex = nextIndex;
          dancePlaybackOk = false;
          setDanceStatus(nextIndex > 0 ? 'Reîncărcăm videoclipul...' : '');
          setDanceFallbackVisible(false);
          danceIframe.src = withOrigin(danceSources[danceSourceIndex]);
          window.setTimeout(pushDanceEventSubscriptions, 280);
          scheduleDanceFallback();
          return true;
        }

        function setDanceButtonLabel() {
          if (!danceButton || !danceWrapper) return;
          var nativeFs = document.fullscreenElement === danceWrapper || document.fullscreenElement === danceIframe;
          var inlineFs = danceWrapper.classList.contains(danceFsClass);
          danceButton.textContent = nativeFs || inlineFs ? '✕' : '⤢';
          danceButton.setAttribute('aria-label', nativeFs || inlineFs ? 'Ieși din ecran complet' : 'Umple ecranul pentru dansul mirilor');
          danceButton.setAttribute('title', nativeFs || inlineFs ? 'Ieși din ecran complet' : 'Umple ecranul');
        }

        function setButtonLabel() {
          if (!button || !wrapper) return;
          var nativeFs = document.fullscreenElement === wrapper;
          var inlineFs = wrapper.classList.contains(inlineFullscreenClass);
          button.textContent = nativeFs || inlineFs ? 'Ieși din fullscreen' : 'Vezi fullscreen';
        }

        function requestFs(el) {
          if (!el) return false;
          if (el.requestFullscreen) {
            el.requestFullscreen().catch(function () {});
            return true;
          }
          if (el.webkitRequestFullscreen) {
            el.webkitRequestFullscreen();
            return true;
          }
          if (el.msRequestFullscreen) {
            el.msRequestFullscreen();
            return true;
          }
          return false;
        }

        function exitFs() {
          if (document.fullscreenElement && document.exitFullscreen) {
            document.exitFullscreen().catch(function () {});
            return true;
          }
          return false;
        }

        function lockLandscape() {
          if (!isMobile || !screen.orientation || !screen.orientation.lock) return;
          screen.orientation.lock('landscape').then(function () {
            orientationLocked = true;
          }).catch(function () {});
        }

        function unlockLandscape() {
          if (!orientationLocked || !screen.orientation || !screen.orientation.unlock) return;
          screen.orientation.unlock();
          orientationLocked = false;
        }

        function toggleDanceInlineFullscreen() {
          if (!danceWrapper) return;
          var willOpen = !danceWrapper.classList.contains(danceFsClass);
          danceWrapper.classList.toggle(danceFsClass, willOpen);
          document.body.classList.toggle('couple-inline-fs-open', willOpen);
          if (willOpen) {
            lockLandscape();
          } else {
            unlockLandscape();
          }
          setDanceButtonLabel();
        }

        function toggleInlineFullscreen() {
          var willOpen = !wrapper.classList.contains(inlineFullscreenClass);
          wrapper.classList.toggle(inlineFullscreenClass, willOpen);
          document.body.classList.toggle('couple-inline-fs-open', willOpen);
          setButtonLabel();
        }

        document.addEventListener('fullscreenchange', function () {
          if (!document.fullscreenElement) {
            unlockLandscape();
          }
          setButtonLabel();
          setDanceButtonLabel();
        });

        window.addEventListener('message', function (e) {
          if (!hasDance || !danceIframe || e.source !== danceIframe.contentWindow) return;
          if (typeof e.origin !== 'string' || (e.origin.indexOf('youtube.com') === -1 && e.origin.indexOf('youtube-nocookie.com') === -1)) return;

          var data;
          try {
            data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
          } catch (err) {
            return;
          }

          if (!data) return;

          if (data.event === 'onReady') {
            dancePlaybackOk = true;
            clearDanceFallbackTimer();
            setDanceStatus('');
            setDanceFallbackVisible(false);
            return;
          }

          if (data.event === 'onError') {
            if (danceSourceIndex < danceSources.length - 1) {
              applyDanceSource(danceSourceIndex + 1);
            } else {
              setDanceStatus('Videoclipul este indisponibil momentan. Încercăm din nou mai târziu.', true);
              setDanceFallbackVisible(true);
            }
            return;
          }

          if (data.event === 'infoDelivery' && data.info && typeof data.info.playerState === 'number') {
            var st = data.info.playerState;
            if (st === 1 || st === 2 || st === 3) {
              dancePlaybackOk = true;
              clearDanceFallbackTimer();
              setDanceStatus('');
              setDanceFallbackVisible(false);
            }
          }
        });

        if (hasDance) {
          if (danceIframe) {
            danceIframe.addEventListener('load', function () {
              pushDanceEventSubscriptions();
            });
          }

          if (danceSources.length > 0) {
            applyDanceSource(0);
          }

          if (danceRetryButton) {
            danceRetryButton.addEventListener('click', function () {
              clearDanceFallbackTimer();
              applyDanceSource(0);
            });
          }

          danceButton.addEventListener('click', function () {
            var inNativeFs = document.fullscreenElement === danceWrapper || document.fullscreenElement === danceIframe;
            if (inNativeFs) {
              exitFs();
              return;
            }

            if (danceWrapper.classList.contains(danceFsClass)) {
              toggleDanceInlineFullscreen();
              return;
            }

            var opened = requestFs(danceWrapper) || requestFs(danceIframe);
            if (opened) {
              lockLandscape();
              setDanceButtonLabel();
              return;
            }

            if (isMobile) {
              toggleDanceInlineFullscreen();
            }
          });
        }

        if (hasMontage) {
          button.addEventListener('click', function () {
            if (document.fullscreenElement === wrapper) {
              exitFs();
              return;
            }

            if (wrapper.classList.contains(inlineFullscreenClass)) {
              toggleInlineFullscreen();
              return;
            }

            var opened = requestFs(wrapper) || requestFs(iframe);
            if (!opened && isMobile) {
              toggleInlineFullscreen();
              return;
            }
          });

          setButtonLabel();
        }

        if (hasDance) {
          setDanceButtonLabel();
        }

        window.addEventListener('orientationchange', function () {
          if (hasDance && danceWrapper && danceWrapper.classList.contains(danceFsClass) && window.innerWidth > window.innerHeight) {
            setDanceButtonLabel();
          }
        });

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var revealItems = document.querySelectorAll('.couple-page__share-wrap, .couple-section, .couple-rec');

        if (!reduceMotion && 'IntersectionObserver' in window && revealItems.length > 0) {
          var revealObserver = new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            });
          }, {
            threshold: 0.12,
            rootMargin: '0px 0px -8% 0px',
          });

          revealItems.forEach(function (item, index) {
            item.style.setProperty('--reveal-delay', Math.min(index * 55, 280) + 'ms');
            revealObserver.observe(item);
          });
        } else {
          revealItems.forEach(function (item) {
            item.classList.add('is-revealed');
          });
        }
      })();
    </script>
  </main>
</BaseLayout>

<style>
  .couple-page {
    --ui-text: rgba(255, 255, 255, 0.94);
    --ui-muted: rgba(255, 255, 255, 0.7);
    --ui-border: rgba(255, 255, 255, 0.16);
    --ui-border-strong: rgba(255, 255, 255, 0.24);
    --ui-card-bg: linear-gradient(165deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.035));
    --ui-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    position: relative;
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    background:
      radial-gradient(circle at 16% 10%, rgba(70, 120, 255, 0.17), transparent 38%),
      radial-gradient(circle at 86% 12%, rgba(120, 190, 255, 0.13), transparent 36%),
      radial-gradient(circle at 54% 98%, rgba(52, 84, 170, 0.2), transparent 44%),
      linear-gradient(180deg, #070d24 0%, #050a1d 52%, #030714 100%);
    overflow: hidden;
  }

  .couple-page::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
