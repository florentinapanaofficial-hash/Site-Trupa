---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoFacade from '../components/VideoFacade.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import BackButton from '../components/BackButton.astro';
import evenimentLiveImg from '../assets/hp-eveniment-live.webp';
import scenaPanoramicaImg from '../assets/hp-scena-panoramica.webp';
import anaFlorentinaImg from '../assets/hp-ana-florentina.webp';
import claudiuScenaImg from '../assets/hp-claudiu-scena.webp';

const videoSeo = seo.galerieVideo;
const coverImages = [evenimentLiveImg, scenaPanoramicaImg, anaFlorentinaImg, claudiuScenaImg];
/* Slugify identic cu src/pages/video/[slug].astro — necesar ca linkurile generate aici să corespundă rutelor reale */
const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const videos = siteContent.videos.map((video, index) => ({
  id: `${video.youtubeId}-${index}`,
  title: video.title,
  category: video.category,
  youtubeId: video.youtubeId,
  youtubeUrl: video.youtubeUrl,
  uploadDate: (video as any).uploadDate as string | undefined,
  description: video.description,
  slug: `${slugify(video.title)}-${video.youtubeId.toLowerCase()}`,
  imageSrc: coverImages[index % coverImages.length],
}));

type PlaylistSectionConfig = { title?: string; playlistId?: string; thumbnailVideoId?: string };
const categoryLabels: Record<string, string> = {
  petrecere: 'Petrecere',
  'usoara-diverse': 'Ușoară-Diverse',
  'tineret-manele': 'Tineret-Manele',
  instrumentala: 'Instrumentală',
};
const videoCategories = [...new Set(videos.map((video) => video.category))].map((id) => ({
  id,
  title: categoryLabels[id] || id,
}));
const videoFilters = [
  { id: 'all', title: 'Toate' },
  ...videoCategories.map(({ id, title }) => ({ id, title })),
  { id: 'playlists', title: 'Playlist-uri' },
];
const playlistLabels: Record<string, string> = {
  populara: 'Muzică Populară', usoara: 'Muzică Ușoară', tineret: 'Tineret',
  instrumentala: 'Instrumentală',
};
const playlistConfig = (siteContent.youtubePlaylists?.galerieVideo ?? {}) as Record<string, PlaylistSectionConfig>;
const playlists = Object.entries(playlistConfig)
  .filter(([, playlist]) => playlist.playlistId)
  .map(([id, playlist], index) => ({
    id, title: playlist.title || id, category: playlistLabels[id] || 'Playlist',
    playlistId: playlist.playlistId || '', thumbnailYtId: playlist.thumbnailVideoId || '', videoCount: 'Playlist YouTube',
    imageSrc: coverImages[index % coverImages.length],
  }));

const SITE = 'https://www.florentinapanaofficial.ro';
/* Fallback ISO valid pentru clipurile fără uploadDate în siteContent.json (cerut strict de Google Video Schema) */
const FALLBACK_UPLOAD_DATE = '2024-01-01';
const videoCollectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: videoSeo.meta.title,
  description: videoSeo.meta.description,
  url: `${SITE}/galerie-video/`,
  about: {
    '@type': 'MusicGroup',
    name: seo.schema.name,
    url: SITE,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: videos.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoObject',
        name: v.title,
        description: v.description,
        thumbnailUrl: [
          `https://img.youtube.com/vi/${v.youtubeId}/maxresdefault.jpg`,
          `https://img.youtube.com/vi/${v.youtubeId}/hqdefault.jpg`,
        ],
        uploadDate: v.uploadDate ?? FALLBACK_UPLOAD_DATE,
        contentUrl: v.youtubeUrl,
        embedUrl: `https://www.youtube.com/embed/${v.youtubeId}`,
      },
    })),
  },
};
---

<BaseLayout title={videoSeo.meta.title} description={videoSeo.meta.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(videoCollectionLd)} />
  </Fragment>
  <section class="min-h-screen bg-gray-950 py-12 text-white sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8"><BackButton href="/cauti-formatie-nunta/" label="Cauți formație" direct /></div>
      <header class="section-head mx-auto text-center">
        <p class="kicker">Galerie Video</p>
        <h1 class="section-title">{videoSeo.h1}</h1>
        <p class="section-copy">{videoSeo.subtitle}</p>
      </header>

      <section class="mx-auto mt-10 max-w-7xl" aria-label="Premiera video">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-amber-300">În prim-plan</h2>
        <VideoFacade
          imageSrc={videos[0].imageSrc}
          title={videos[0].title}
          subtitle="Formația Florentina Pană · Muzică live"
          logoSrc="/images/logo-fp-stage.svg"
          videoUrl={`https://www.youtube-nocookie.com/embed/${videos[0].youtubeId}`}
          description={videos[0].description}
          loading="eager"
          class="rounded-3xl shadow-2xl shadow-black/50"
        />
      </section>

      <div class="mt-12" data-video-gallery>
        <div class="no-scrollbar flex gap-2 overflow-x-auto pb-3" role="group" aria-label="Filtrează videoclipurile după categorie">
          {videoFilters.map((filter, index) => (
            <button
              type="button"
              class="shrink-0 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white/75 transition-colors hover:border-amber-300/70 hover:text-white"
              data-video-filter={filter.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {filter.title}
            </button>
          ))}
        </div>

        <div class="mt-6 space-y-10">
          {videoCategories.map((category) => (
            <section class="video-category-row" data-video-category={category.id} data-visible="true" aria-label={category.title}>
              <h2 class="mb-4 text-2xl font-bold text-white">{category.title}</h2>
              <div class="no-scrollbar flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4">
                {videos.filter((video) => video.category === category.id).map((video) => (
                  <div class="relative w-[min(82vw,400px)] shrink-0 snap-start transition-transform duration-300 hover:z-10 hover:scale-105">
                    <VideoFacade
                      imageSrc={video.imageSrc}
                      title={video.title}
                      subtitle={`${category.title} · Formația Florentina Pană`}
                      logoSrc="/images/logo-fp-stage.svg"
                      videoUrl={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                      description={video.description}
                      class="rounded-2xl shadow-2xl shadow-black/50"
                    />
                  </div>
                ))}
              </div>
            </section>
          ))}

          {playlists.length > 0 && (
            <section class="video-category-row" data-video-category="playlists" data-visible="true" aria-label="Playlist-uri YouTube">
              <h2 class="mb-4 text-2xl font-bold text-white">Playlist-uri YouTube</h2>
              <div class="no-scrollbar flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4">
                {playlists.map((playlist) => (
                  <div class="relative w-[min(82vw,400px)] shrink-0 snap-start transition-transform duration-300 hover:z-10 hover:scale-105">
                    <VideoFacade
                      imageSrc={playlist.imageSrc}
                      title={playlist.title}
                      subtitle={`${playlist.category} · ${playlist.videoCount}`}
                      logoSrc="/images/logo-fp-stage.svg"
                      videoUrl={`https://www.youtube-nocookie.com/embed/videoseries?list=${playlist.playlistId}`}
                      class="rounded-2xl shadow-2xl shadow-black/50"
                    />
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>

      <!-- Linkuri directe către paginile dedicate /video/[slug]/ — indexabile individual în Google -->
      <div class="mt-16 border-t border-white/10 pt-10">
        <h2 class="section-title text-center">Toate clipurile, pagină cu pagină</h2>
        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {videos.map((video) => (
            <a href={`/video/${video.slug}/`} class="group block overflow-hidden rounded-xl border border-white/10 bg-white/5 transition-colors hover:border-yellow-500/40" aria-label={`Vezi pagina dedicată: ${video.title}`}>
              <img
                src={`https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`}
                alt={video.title}
                class="aspect-video w-full object-cover"
                loading="lazy"
                decoding="async"
                width="480"
                height="270"
              />
              <p class="p-2 text-xs font-medium text-white/80 group-hover:text-yellow-400">{video.title}</p>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-12 flex justify-center">
        <a href="/aparitii-tv/" class="btn-outline">Vezi și apariții TV</a>
      </div>
    </div>
  </section>

  <style>
    .video-category-row {
      transition: opacity 220ms ease, transform 220ms ease;
    }

    .video-category-row.is-filtering-out {
      opacity: 0;
      pointer-events: none;
      transform: translateY(0.5rem);
    }

    [data-video-filter][aria-pressed='true'] {
      border-color: rgb(252 211 77 / 0.75);
      background-color: rgb(252 211 77 / 0.16);
      color: white;
    }

    @media (prefers-reduced-motion: reduce) {
      .video-category-row {
        transition: none;
      }
    }
  </style>

  <script>
    function bindVideoFilters(): void {
      document.querySelectorAll<HTMLElement>('[data-video-gallery]').forEach((gallery) => {
        if (gallery.dataset.filterBound === 'true') return;
        gallery.dataset.filterBound = 'true';

        const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-video-filter]');
        const rows = gallery.querySelectorAll<HTMLElement>('[data-video-category]');

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const selected = button.dataset.videoFilter || 'all';
            buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));

            rows.forEach((row) => {
              const visible = selected === 'all' || row.dataset.videoCategory === selected;
              row.dataset.visible = String(visible);

              if (visible) {
                row.hidden = false;
                window.requestAnimationFrame(() => {
                  if (row.dataset.visible === 'true') row.classList.remove('is-filtering-out');
                });
                return;
              }

              row.classList.add('is-filtering-out');
              window.setTimeout(() => {
                if (row.dataset.visible === 'false') row.hidden = true;
              }, 240);
            });
          });
        });
      });
    }

    bindVideoFilters();
    document.addEventListener('astro:page-load', bindVideoFilters);
  </script>
</BaseLayout>