---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/siteContent.json';
import seo from '../data/seo-content.json';
import BackButton from '../components/BackButton.astro';
import SmartTvVideoPlayer from '../components/SmartTvVideoPlayer.astro';

const videoSeo = seo.galerieVideo;
const videos = siteContent.videos.map((video, index) => ({
  id: `${video.youtubeId}-${index}`,
  title: video.title,
  category: video.category,
  youtubeId: video.youtubeId,
  youtubeUrl: video.youtubeUrl,
  uploadDate: (video as any).uploadDate as string | undefined,
}));

type PlaylistSectionConfig = { title?: string; playlistId?: string; thumbnailVideoId?: string };
const playlistLabels: Record<string, string> = {
  populara: 'Muzică Populară', usoara: 'Muzică Ușoară', tineret: 'Tineret',
  instrumentala: 'Instrumentală', 'dans-miri': 'Dansul Mirilor',
};
const playlistConfig = (siteContent.youtubePlaylists?.galerieVideo ?? {}) as Record<string, PlaylistSectionConfig>;
const playlists = Object.entries(playlistConfig)
  .filter(([, playlist]) => playlist.playlistId)
  .map(([id, playlist]) => ({
    id, title: playlist.title || id, category: playlistLabels[id] || 'Playlist',
    playlistId: playlist.playlistId || '', thumbnailYtId: playlist.thumbnailVideoId || '', videoCount: 'Playlist YouTube',
  }));

const SITE = 'https://www.florentinapanaofficial.ro';
/* Fallback ISO valid pentru clipurile fără uploadDate în siteContent.json (cerut strict de Google Video Schema) */
const FALLBACK_UPLOAD_DATE = '2024-01-01';
const videoCollectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: videoSeo.meta.title,
  description: videoSeo.meta.description,
  url: `${SITE}/galerie-video/`,
  about: {
    '@type': 'MusicGroup',
    name: seo.schema.name,
    url: SITE,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: videos.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoObject',
        name: v.title,
        description: `${v.title} — Formația Florentina Pană, muzică live la nunți și evenimente.`,
        thumbnailUrl: [
          `https://img.youtube.com/vi/${v.youtubeId}/maxresdefault.jpg`,
          `https://img.youtube.com/vi/${v.youtubeId}/hqdefault.jpg`,
        ],
        uploadDate: v.uploadDate ?? FALLBACK_UPLOAD_DATE,
        contentUrl: v.youtubeUrl,
        embedUrl: `https://www.youtube.com/embed/${v.youtubeId}`,
      },
    })),
  },
};
---

<BaseLayout title={videoSeo.meta.title} description={videoSeo.meta.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(videoCollectionLd)} />
  </Fragment>
  <section class="section-container py-16">
    <div class="mb-8"><BackButton href="/cauti-formatie-nunta/" label="Cauți formație" direct /></div>
    <header class="section-head mx-auto text-center">
      <p class="kicker">Galerie Video</p>
      <h1 class="section-title">{videoSeo.h1}</h1>
      <p class="section-copy">{videoSeo.subtitle}</p>
    </header>

    <SmartTvVideoPlayer initialVideo={videos[0]} videos={videos} playlists={playlists} />

    <div class="mt-12 flex justify-center">
      <a href="/aparitii-tv/" class="btn-outline">Vezi și apariții TV</a>
    </div>
  </section>
</BaseLayout>