---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import AudioPlaylistPlayer from '../components/AudioPlaylistPlayer.astro';
import audioCatalog from '../data/audio-catalog.generated.json';
import remoteAudioCatalog from '../data/audio-catalog-remote.json';

type CatalogSong = { name: string; artist?: string; file: string; url?: string };
type CatalogCategory = { id: string; title: string; songs: CatalogSong[] };
const pageTitle = 'Muzică de Petrecere Non-Stop | Streaming Audio';
const pageDescription = 'Ascultă repertoriul live non-stop: muzică populară de petrecere, grecească, arăbească, machedonească, latino, muzică românească și manele. Fără DJ/MC.';
const defaultArtist = 'Formația Florentina Pană';
const catalogData = audioCatalog as { categories?: CatalogCategory[] };
const remoteCatalogData = remoteAudioCatalog as { categories?: CatalogCategory[] };
const categories = [
  ...(Array.isArray(remoteCatalogData.categories) ? remoteCatalogData.categories : []),
  ...(Array.isArray(catalogData.categories) ? catalogData.categories : []),
];
const configuredR2BaseUrl = import.meta.env.PUBLIC_R2_MUSIC_BASE_URL?.trim().replace(/\/$/, '') || '';
const resolveSongUrl = (song: CatalogSong) => {
  if (song.url) return song.url;
  const encodedPath = song.file.split('/').map((segment) => encodeURIComponent(segment)).join('/');
  return configuredR2BaseUrl ? `${configuredR2BaseUrl}/${encodedPath}` : `/Audio/${encodedPath}`;
};
const tracks = categories.flatMap((category) => category.songs.map((song) => ({
  name: song.name,
  artist: song.artist || defaultArtist,
  category: category.title,
  url: resolveSongUrl(song),
})));
const audioTracks = [
  {
    id: "hore-2026-fp-band",
    title: "Hore 2026",
    artist: "FP Band",
    duration: "Live",
    plays: 0,
    createdAt: "30 Aug 2026",
    audioUrl: "https://pub-990252095ed1490dbf610cd678419215.r2.dev/Hore%202026%20FP%20Band.mp3"
  },
  {
    id: "muzica-arabeasca-cover-fp-band",
    title: "Muzică Arăbească Cover",
    artist: "FP Band",
    duration: "Live",
    plays: 0,
    createdAt: "30 Aug 2026",
    audioUrl: "https://pub-990252095ed1490dbf610cd678419215.r2.dev/Muzica%20Arabeasca%20Cover%20FP%20BAnd.mp3"
  },
  {
    id: "aperitiv-fp-band",
    title: "Colaj Cântece de Masă - Aperitiv",
    artist: "FP Band",
    duration: "Live",
    plays: 0,
    createdAt: "27 Aug 2026",
    audioUrl: "https://pub-990252095ed1490dbf610cd678419215.r2.dev/Colaj%20Cantece%20de%20mas%C4%83%20-%20Aperetiv%20FP%20Band/Colaj%20Cantece%20%20-%20Aperetiv%20-%20FP%20Band.mp3"
  }
];
const musicPlaylistSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicPlaylist',
  name: 'Muzică de Petrecere Non-Stop',
  description: pageDescription,
  numTracks: tracks.length,
  track: tracks.slice(0, 60).map((track) => ({
    '@type': 'MusicRecording', name: track.name, url: track.url,
    byArtist: { '@type': 'MusicGroup', name: track.artist },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage="/images/og-default-1200x630.jpg">
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(musicPlaylistSchema)}></script></Fragment>
  <main class="audio-page">
    <div class="audio-page__topbar">
      <BackButton href="/cauti-formatie-nunta/" label="Cauți formație" direct />
      <a href="/cauti-formatie-nunta/" class="audio-page__close-link">Închide biblioteca audio</a>
    </div>
    <h1 class="audio-page__title">Biblioteca Audio Formația Florentina Pană</h1>
    <AudioPlaylistPlayer tracks={audioTracks} playlistTitle="Repertoriu & Mostre Live" />
    <section class="audio-seo-copy" aria-labelledby="audio-seo-title">
      <h2 id="audio-seo-title">Muzică populară și de petrecere pentru nunți și evenimente</h2>
      <p>Ascultă selecții live ale Formației Florentina Pană: muzică populară, muzică de petrecere și repertoriu pentru aperitiv, nuntă, botez sau eveniment privat. Formația oferă un program muzical variat în Pitești, Argeș, București și în toată România.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .audio-page { max-width: 860px; margin: 0 auto; padding: 2rem 1rem 5rem; color: #e8edf5; }
  .audio-page__topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .audio-page__close-link { border: 1px solid rgba(245, 166, 35, 0.42); border-radius: 999px; padding: 0.55rem 0.85rem; color: #ffd26f; font-size: 0.78rem; font-weight: 800; text-decoration: none; transition: background 180ms ease, border-color 180ms ease; }
  .audio-page__close-link:hover, .audio-page__close-link:focus-visible { border-color: rgba(245, 166, 35, 0.75); background: rgba(245, 166, 35, 0.12); }
  .audio-page__title { margin: 0 0 1rem; color: #fff; font-family: 'Oswald', sans-serif; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .audio-player { display: grid; grid-template-columns: minmax(0, 1fr) 310px; overflow: hidden; border: 1px solid #526d89; border-radius: 5px; background: #111923; box-shadow: 0 18px 48px rgb(0 0 0 / 32%); }
  .audio-window-titlebar { display: flex; grid-column: 1 / -1; align-items: center; gap: .55rem; min-height: 32px; padding: .35rem .65rem; background: linear-gradient(#3b5873, #1d3045); color: #edf5fc; font-size: .78rem; box-shadow: inset 0 1px rgb(255 255 255 / 18%); }
  .audio-window-icon { display: grid; width: 19px; height: 19px; place-items: center; border: 1px solid #91b3d1; border-radius: 3px; background: #1b354f; color: #dcecf9; font-size: .85rem; }
  .audio-window-actions { display: flex; gap: .25rem; margin-left: auto; }
  .audio-window-actions span { display: grid; width: 24px; height: 20px; place-items: center; border: 1px solid rgb(255 255 255 / 16%); border-radius: 2px; color: #dcecf9; font-size: .75rem; }
  .audio-player__header, .audio-playlist__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid #30445f; background: #1b2a3b; }
  .audio-player__header { grid-column: 1 / -1; }
  .audio-player__eyebrow, .audio-player__now-label { margin: 0 0 .3rem; color: #91a7c1; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }
  .audio-player h1 { margin: 0; color: #fff; font-family: 'Oswald', sans-serif; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .audio-player__status, .audio-playlist__bar span { color: #a8c6df; font-size: .8rem; }
  .audio-player__screen { min-height: 125px; padding: 1.5rem 1.25rem; background: #0b1119; }
  .audio-player__now { margin: 0; color: #fff; font-size: 1.25rem; font-weight: 700; }
  .audio-player__artist { margin: .45rem 0 0; color: #9eafc2; }
  .audio-player__controls { display: flex; grid-column: 1 / 2; align-items: center; gap: .55rem; padding: .8rem 1.25rem; border-bottom: 1px solid #30445f; background: #172333; }
  .audio-control, .audio-track__play, .audio-track__share { padding: .55rem .7rem; border: 1px solid #536b86; border-radius: 3px; background: #26394e; color: #fff; cursor: pointer; font-size: .8rem; }
  .audio-track__actions { display: flex; flex-shrink: 0; gap: .35rem; }
  .audio-track__share { border-color: #3e829d; color: #b9e7f5; }
  .audio-control:hover, .audio-control:focus-visible, .audio-track__play:hover, .audio-track__share:hover { background: #34506d; }
  .audio-control--main { min-width: 5.5rem; border-color: #d3a53d; background: #b88722; color: #111923; font-weight: 800; }
  .audio-volume { display: flex; align-items: center; gap: .5rem; margin-left: auto; color: #aebed0; font-size: .8rem; }
  .audio-volume input { width: 100px; accent-color: #d3a53d; }
  .audio-player__playlist { grid-column: 2; grid-row: 3 / span 3; min-width: 0; border-left: 1px solid #30445f; background: #101a25; }
  .audio-player ol { max-height: 455px; overflow-y: auto; margin: 0; padding: 0; list-style: none; }
  .audio-track { display: flex; align-items: center; gap: .7rem; padding: .7rem 1.25rem; border-bottom: 1px solid #273749; background: #121d2a; }
  .audio-track:hover, .audio-track.is-selected { background: #20354a; }
  .audio-track.is-playing { border-left: 3px solid #56d88a; background: #174936; box-shadow: inset 0 0 0 1px rgb(86 216 138 / 24%); }
  .audio-track.is-playing .audio-track__number, .audio-track.is-playing .audio-track__details strong { color: #baf7ce; }
  .audio-track.is-playing::after { content: '● Redare'; margin-left: .25rem; color: #72eca0; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .audio-track label { display: flex; align-items: center; gap: .7rem; min-width: 0; flex: 1; cursor: pointer; }
  .audio-track__check { width: 1rem; height: 1rem; accent-color: #d3a53d; }
  .audio-track__number { width: 1.8rem; color: #71869e; font: .75rem monospace; }
  .audio-track__details { display: flex; min-width: 0; flex-direction: column; gap: .2rem; }
  .audio-track__details strong, .audio-track__details small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .audio-track__details strong { color: #f3f7fb; }
  .audio-track__details small { color: #91a7bc; }
  .audio-seo-copy { padding: 2.5rem .25rem 0; color: #8798aa; font-size: .9rem; line-height: 1.7; }
  .audio-seo-copy h2 { color: #cbd8e6; font-size: 1.25rem; }
  @media (max-width: 760px) { .audio-player { display: block; } .audio-window-titlebar, .audio-player__header { display: flex; } .audio-player__playlist { border-top: 1px solid #30445f; border-left: 0; } .audio-player ol { max-height: none; } }
  @media (max-width: 520px) { .audio-page { padding-inline: .65rem; } .audio-player__controls { flex-wrap: wrap; } .audio-volume { width: 100%; margin-left: 0; } .audio-track { padding-inline: .7rem; } }
</style>