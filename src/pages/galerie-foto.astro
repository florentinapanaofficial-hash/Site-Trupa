---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import EmbedSnippet from '../components/EmbedSnippet.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

/* ── Date galerie: toate pozele din colecție ── */
const base = "/images/Galerie Foto Site";
const photos = [
  { src: `${base}/Galerie Evenimente 1.jpg`, alt: "Eveniment live cu Formația Florentina Pană", cat: "evenimente" },
  { src: `${base}/Galerie Evenimente 2.jpg`, alt: "Scenă completă la eveniment live", cat: "evenimente" },
  { src: `${base}/Florentina Pan%C4%83 1.jpg`, alt: "Florentina Pană — moment de scenă", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 2.jpg`, alt: "Florentina Pană — interpretare live", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 3.jpg`, alt: "Florentina Pană — recital vocal", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 4.jpg`, alt: "Florentina Pană pe scenă", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 5.jpg`, alt: "Florentina Pană — moment artistic", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 6.jpg`, alt: "Florentina Pană — spectacol live", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 7.jpg`, alt: "Florentina Pană — portret scenic", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 8.jpg`, alt: "Florentina Pană — performanță vocală", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 09.jpg`, alt: "Florentina Pană — show live", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 10.jpg`, alt: "Florentina Pană — energie pe scenă", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 11.jpg`, alt: "Florentina Pană — concert live", cat: "solista" },
  { src: `${base}/Florentina Pan%C4%83 12.jpg`, alt: "Florentina Pană — moment de suflet", cat: "solista" },
  { src: `${base}/Claudiu 1.jpg`, alt: "Claudiu Pană — artist pe scenă", cat: "formatie" },
  { src: `${base}/Claudiu 2.jpg`, alt: "Claudiu Pană — interpretare live", cat: "formatie" },
  { src: `${base}/Claudiu 3.jpg`, alt: "Claudiu Pană — moment muzical", cat: "formatie" },
  { src: `${base}/Claudiu 4.jpg`, alt: "Claudiu Pană — recital", cat: "formatie" },
  { src: `${base}/Claudiu 5.jpg`, alt: "Claudiu Pană — performanță scenică", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 2.jpg`, alt: "Claudiu și Florentina Pană — duo pe scenă", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 3.jpg`, alt: "Claudiu și Florentina Pană — moment live", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 4.jpg`, alt: "Claudiu și Florentina Pană — spectacol de nuntă", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 5.jpg`, alt: "Claudiu și Florentina Pană — energie pe ring", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 6.jpg`, alt: "Claudiu și Florentina Pană — dans și muzică", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 7.jpg`, alt: "Claudiu și Florentina Pană — show complet", cat: "formatie" },
  { src: `${base}/Galerie Foto Claudiu %26 Florentina Pan%C4%83 8.jpg`, alt: "Claudiu și Florentina Pană — emoție pe scenă", cat: "formatie" },
  { src: `${base}/Imagine Miri 1.jpeg`, alt: "Momente cu mirii — emoție și bucurie", cat: "miri" },
  { src: `${base}/Imagine Miri 2.jpeg`, alt: "Momente cu mirii — dansul mirilor", cat: "miri" },
  { src: `${base}/Card 1 panoramica.jpg`, alt: "Formația Florentina Pană — panoramică de scenă", cat: "formatie" },
  { src: `${base}/IMG_9895.jpg`, alt: "Formația Florentina Pană — fotografie de la eveniment", cat: "evenimente" },
];


---

<BaseLayout
  title="Galerie Foto | Formația Florentina Pană — Evenimente Live"
  description="Fotografii autentice de la nunți, botezuri și evenimente live. Energie, emoție și dans pe scenele din toată România — Formația Florentina Pană."
>
  <section class="gal-page" aria-label="Galerie foto">

    <!-- Back -->
    <div class="gal-back"><BackButton href="/" label="Acasă" /></div>

    <!-- ═══ HEADER ═══ -->
    <header class="gal-header">
      <span class="gal-badge">Galerie Foto</span>
      <h1 class="gal-title">Evenimente Live — Galerie Foto</h1>
      <p class="gal-subtitle">Momente autentice de dans, energie și emoție, surprinse la evenimentele noastre din toată România</p>
    </header>

    <!-- ═══ GRID MASONRY ═══ -->
    <div class="gal-masonry" role="list" aria-label="Galerie fotografii">
      {photos.map((p, i) => (
        <figure
          class="gal-item"
          role="listitem"
          data-category={p.cat}
          data-fx={String((i % 6) + 1)}
          data-index={i}
          data-src={p.src}
          tabindex="0"
        >
          <img
            src={p.src}
            alt={p.alt}
            class="gal-photo-img"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <figcaption class="gal-caption">{p.alt}</figcaption>
          {/* Hover overlay */}
          <div class="gal-hover" aria-hidden="true">
            <svg class="gal-zoom-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/>
              <path d="M11 8v6M8 11h6"/>
            </svg>
            <span class="gal-hover-text">Click pentru previzualizare</span>
          </div>
        </figure>
      ))}
    </div>

    <!-- ═══ GALERIE VIRALĂ — distribuire & backlinks ═══ -->
    <div style="margin-top: 2rem;">
      <h2 class="gal-title" style="font-size:1.15rem;margin-bottom:0.75rem;">Galeria Virală — Distribuie Momentele</h2>
      <p style="font-size:0.85rem;color:rgba(255,255,255,0.7);margin-bottom:1rem;">Fiecare fotografie are link unic. Distribuie pe WhatsApp sau Facebook, sau copiază link-ul pentru a genera backlinks!</p>
      <PhotoGallery
        images={photos.map((p) => ({ src: p.src, alt: p.alt, caption: p.alt }))}
        pagePath="/galerie-foto"
      />
    </div>

    <!-- ═══ EMBED SNIPPET — backlink automat pt. partajare imagine ═══ -->
    <div class="section-container py-8">
      <h2 class="gal-title" style="font-size:1.15rem;margin-bottom:0.75rem;">Distribuie fotografiile noastre</h2>
      <p style="font-size:0.85rem;color:rgba(255,255,255,0.7);margin-bottom:1rem;">Folosește butoanele de mai jos pentru a include o fotografie autentică de la evenimentele noastre pe site-ul tău, cu credit și backlink automat.</p>
      <EmbedSnippet
        imageSrc="/images/Galerie Foto Site/Galerie Evenimente 1.jpg"
        imageAlt="Formație nuntă Pitești — eveniment live cu Formația Florentina Pană"
        pageUrl="https://www.florentinapanaofficial.ro/galerie-foto"
        credit="Formația Florentina Pană"
      />
    </div>

  </section>

  <!-- ═══ LIGHTBOX — în afara <section> pentru a evita problemele cu position:fixed pe mobil ═══ -->
  <div id="gal-lightbox" role="dialog" aria-modal="true" aria-label="Previzualizare fotografie">
    <div class="lb-counter" aria-live="polite"></div>
    <button class="lb-close" type="button" aria-label="Închide">&times;</button>
    <button class="lb-prev" type="button" aria-label="Fotografia anterioară">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="lb-next" type="button" aria-label="Fotografia următoare">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <div class="lb-img-wrap">
      <img id="lb-img" src="" alt="" />
    </div>
  </div>

</BaseLayout>

<!-- ═══════════════════════════════════════════
     SCRIPT — Filtre, Lightbox, Swipe, Keyboard
═══════════════════════════════════════════ -->
<script is:inline>
  const items = document.querySelectorAll('.gal-item');

  // ── Lightbox ──
  const lb = document.getElementById('gal-lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCounter = lb.querySelector('.lb-counter');
  const lbClose = lb.querySelector('.lb-close');
  const lbPrev = lb.querySelector('.lb-prev');
  const lbNext = lb.querySelector('.lb-next');

  function getVisibleItems() {
    return Array.from(items).filter((it) => it.style.display !== 'none');
  }

  let currentIdx = 0;

  function showPhoto(idx) {
    const visible = getVisibleItems();
    if (idx < 0 || idx >= visible.length) return;
    currentIdx = idx;
    const item = visible[idx];
    const src = item.dataset.src ?? '';
    const alt = item.querySelector('figcaption')?.textContent ?? '';
    lbImg.src = src;
    lbImg.alt = alt;
    lbCounter.textContent = `${idx + 1} / ${visible.length}`;
    lbImg.classList.remove('lb-fade-in');
    void lbImg.offsetWidth; /* force reflow for re-trigger */
    lbImg.classList.add('lb-fade-in');
  }

  function openLightbox(idx) {
    lb.classList.add('active');
    document.body.style.overflow = 'hidden';
    // Pe mobil, secțiunea galeriei are scroll propriu — oprim și pe ea
    const galSection = document.querySelector('.gal-page');
    if (galSection) galSection.style.overflow = 'hidden';
    showPhoto(idx);
  }

  let closing = false;

  function closeLightbox() {
    if (closing) return;
    closing = true;
    lb.classList.add('lb-closing');
    setTimeout(() => {
      lb.classList.remove('active', 'lb-closing');
      document.body.style.overflow = '';
      const galSection = document.querySelector('.gal-page');
      if (galSection) galSection.style.overflow = '';
      lbImg.classList.remove('lb-fade-in');
      lbImg.src = '';
      lbImg.alt = '';
      closing = false;
    }, 500);
  }

  function navPrev() {
    const visible = getVisibleItems();
    const next = (currentIdx - 1 + visible.length) % visible.length;
    showPhoto(next);
  }

  function navNext() {
    const visible = getVisibleItems();
    const next = (currentIdx + 1) % visible.length;
    showPhoto(next);
  }

  // Click pe item → deschide lightbox
  items.forEach((item) => {
    item.addEventListener('click', () => {
      const visible = getVisibleItems();
      const idx = visible.indexOf(item);
      if (idx >= 0) openLightbox(idx);
    });
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const visible = getVisibleItems();
        const idx = visible.indexOf(item);
        if (idx >= 0) openLightbox(idx);
      }
    });
  });

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); navPrev(); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); navNext(); });

  // Tap pe fundal sau imagine → închide (pe mobil mai ales)
  lb.addEventListener('click', (e) => {
    const t = e.target;
    // Nu închide dacă user-ul a dat pe butoanele prev/next
    if (t.closest('.lb-prev') || t.closest('.lb-next')) return;
    closeLightbox();
  });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navPrev();
    if (e.key === 'ArrowRight') navNext();
  });

  // ── Swipe touch pe mobile ──
  let touchStartX = 0;
  let touchEndX = 0;

  lb.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) {
      diff > 0 ? navNext() : navPrev();
    }
  }, { passive: true });
</script>

<!-- ═══════════════════════════════════════════
     STYLES
═══════════════════════════════════════════ -->
<style>
  /* ══════════════════════════════════════════
     PAGINĂ
  ══════════════════════════════════════════ */
  .gal-page {
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem);
    max-width: 72rem;
    margin-inline: auto;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .gal-back {
    margin-bottom: 1.5rem;
  }

  /* ══════════════════════════════════════════
     HEADER
  ══════════════════════════════════════════ */
  .gal-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gal-badge {
    display: inline-block;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.28em 0.85em;
    border-radius: 9999px;
    background: rgba(0, 200, 255, 0.08);
    color: rgba(0, 220, 255, 0.85);
    border: 1px solid rgba(0, 200, 255, 0.22);
    margin-bottom: 0.85rem;
  }

  .gal-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  .gal-subtitle {
    font-size: 0.88rem;
    color: rgba(180, 200, 235, 0.60);
    margin: 0;
    line-height: 1.5;
  }



  /* ══════════════════════════════════════════
     MASONRY GRID
  ══════════════════════════════════════════ */
  .gal-masonry {
    columns: 3;
    column-gap: 1rem;
    max-width: 100%;
  }

  @media (max-width: 767px) and (min-width: 480px) {
    .gal-masonry { columns: 2; }
  }

  @media (max-width: 479px) {
    .gal-masonry { columns: 1; }
  }

  /* ══════════════════════════════════════════
     ITEM (FIGURE)
  ══════════════════════════════════════════ */
  .gal-item {
    display: inline-block;
    width: 100%;
    max-width: 100%;
    margin: 0 0 1rem;
    break-inside: avoid;
    border-radius: 1rem;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: opacity 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .gal-item:focus-visible {
    outline: 2px solid rgba(0, 200, 255, 0.60);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .gal-item:hover {
      border-color: rgba(0, 200, 255, 0.40);
      box-shadow: 0 0 18px rgba(0, 200, 255, 0.18), 0 8px 24px rgba(0, 60, 120, 0.25);
    }
  }

  /* Conținut centrat interior */
  .gal-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .gal-photo-img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: top;
    border-radius: 1rem;
  }

  .gal-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    padding: 1.5rem 1rem 0.6rem;
    line-height: 1.4;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .gal-item:hover .gal-caption {
    opacity: 1;
  }

  /* Hover overlay */
  .gal-hover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: rgba(0, 30, 60, 0.55);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 220ms ease;
    pointer-events: none;
  }

  .gal-item:hover .gal-hover,
  .gal-item:focus .gal-hover {
    opacity: 1;
  }

  .gal-zoom-icon {
    width: 28px;
    height: 28px;
    color: rgba(0, 220, 255, 0.85);
  }

  .gal-hover-text {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 220, 255, 0.75);
  }

  /* ══════════════════════════════════════════
     BUTON ÎNCARCĂ MAI MULTE
  ══════════════════════════════════════════ */
  .gal-load-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gal-load-btn {
    position: relative;
    font-family: 'Oswald', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    padding: 0.65em 1.8em;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(200, 215, 240, 0.45);
    cursor: not-allowed;
    opacity: 0.6;
  }

  .gal-load-tooltip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
    padding: 0.3em 0.75em;
    border-radius: 0.4rem;
    background: rgba(0, 0, 0, 0.85);
    color: rgba(0, 220, 255, 0.80);
    border: 1px solid rgba(0, 200, 255, 0.22);
  }

  .gal-load-btn:hover .gal-load-tooltip {
    display: block;
  }

  /* ══════════════════════════════════════════
     LIGHTBOX
  ══════════════════════════════════════════ */
  #gal-lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(8px);
  }

  #gal-lightbox.active {
    display: flex;
  }

  .lb-img-wrap {
    max-width: 90vw;
    max-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lb-img {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    border-radius: 0.75rem;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.8), 0 0 20px rgba(232, 200, 91, 0.25);
    border: 1px solid rgba(232, 200, 91, 0.3);
    object-fit: contain;
  }

  /* Counter */
  .lb-counter {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Oswald', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.55);
    z-index: 10;
  }

  /* Close */
  .lb-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .lb-close:hover {
    background: rgba(255, 60, 80, 0.18);
    border-color: rgba(255, 60, 80, 0.45);
  }

  /* Nav prev/next */
  .lb-prev, .lb-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }

  .lb-prev:hover, .lb-next:hover {
    background: rgba(0, 200, 255, 0.12);
    border-color: rgba(0, 200, 255, 0.40);
  }

  .lb-prev svg, .lb-next svg {
    width: 22px;
    height: 22px;
  }

  /* ══════════════════════════════════════════
     LIGHTBOX — Animație fade simplă & fiabilă
  ══════════════════════════════════════════ */
  @keyframes lb-fade-scale-in {
    0%   { transform: scale(0.92); opacity: 0; }
    100% { transform: scale(1);    opacity: 1; }
  }

  .lb-fade-in {
    animation: lb-fade-scale-in 0.8s cubic-bezier(.25,.46,.45,.94) both;
  }

  /* Închidere — fade out pe tot overlay-ul */
  #gal-lightbox.lb-closing {
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  /* ══════════════════════════════════════════
     MOBILE — lightbox nav mai strâns
  ══════════════════════════════════════════ */
  @media (max-width: 767px) {
    .lb-prev { left: 0.25rem; width: 44px; height: 44px; }
    .lb-next { right: 0.25rem; width: 44px; height: 44px; }
    .lb-close { top: 0.75rem; right: 0.75rem; width: 44px; height: 44px; }
    .lb-counter { top: 0.85rem; font-size: 0.68rem; }

    #lb-img {
      max-height: 70vh;
    }
  }
</style>
