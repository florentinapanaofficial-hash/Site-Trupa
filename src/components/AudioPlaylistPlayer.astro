---
import TrackPlaysBadge from './TrackPlaysBadge.astro';

export interface Track {
  id: string;
  title: string;
  artist?: string;
  audioUrl: string;
  duration?: string;
  plays?: number;
  createdAt?: string;
}

interface Props {
  tracks: Track[];
  playlistTitle?: string;
}

const { tracks, playlistTitle = "Repertoriu & Mostre Audio" } = Astro.props;
const initialTrack = tracks[0] || { id: '0', title: 'Nicio piesă', audioUrl: '', artist: '', plays: 0 };
---

<div
  class="playlist-player bg-slate-900 border border-slate-800/80 rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-2xl max-w-3xl mx-auto my-4 sm:my-8 text-white font-sans w-full"
  transition:persist
  transition:name="fp-audio-player"
>
  <div class="flex flex-col items-center text-center gap-1 mb-3 sm:mb-4">
    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-indigo-400">Acum se redă</span>
    <div class="current-track-title select-none cursor-default text-base sm:text-xl font-bold text-slate-100 mx-auto"><span class="current-track-title__text">{initialTrack.title}</span></div>
    <p class="current-track-artist select-none cursor-default text-xs sm:text-sm text-slate-400 truncate">{initialTrack.artist || "Live"}</p>
  </div>

  <div class="playlist-progress" data-playlist-progress role="slider" aria-label="Poziție redare" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
    <div class="playlist-progress-track">
      <div class="playlist-progress-fill" data-playlist-progress-fill></div>
    </div>
    <div class="playlist-progress-time">
      <span class="time-current">0:00</span>
      <span class="time-total">0:00</span>
    </div>
  </div>

  <div class="flex items-center justify-between mt-2 sm:mt-3 pt-2 sm:pt-3 border-t border-slate-800/80">
    <div class="flex items-center gap-2 sm:gap-3">
      <button class="btn-prev p-2.5 sm:p-2 text-slate-400 hover:text-white active:scale-95 transition-all" title="Piesa anterioară" aria-label="Previous Track">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
      </button>

      <button class="btn-play-pause bg-indigo-600 hover:bg-indigo-500 active:scale-90 text-white w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center transition-all shadow-lg shadow-indigo-600/30 shrink-0" aria-label="Play or Pause">
        <svg class="icon-play w-5 h-5 sm:w-6 sm:h-6 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg class="icon-pause w-5 h-5 sm:w-6 sm:h-6 fill-current hidden" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <button class="btn-next p-2.5 sm:p-2 text-slate-400 hover:text-white active:scale-95 transition-all" title="Piesa următoare" aria-label="Next Track">
        <svg class="w-5 h-5 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
      </button>
    </div>

    <div class="hidden sm:flex items-center gap-2">
      <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
      <input type="range" class="volume-slider w-20 h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-indigo-500" min="0" max="1" step="0.05" value="0.8" aria-label="Volum audio">
    </div>
  </div>

  <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-800/80">
    <div class="text-xs sm:text-sm font-semibold text-slate-400 mb-2 sm:mb-3">{playlistTitle}</div>

    <div class="space-y-1.5 max-h-72 sm:max-h-64 overflow-y-auto pr-1 -mr-1">
      {tracks.map((track, idx) => (
        <div
          class="track-item flex items-center justify-between p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-800/60 active:bg-slate-800 transition-all border border-transparent gap-2"
          data-track-idx={idx}
          data-track-id={track.id}
          data-audio-url={track.audioUrl}
          data-title={track.title}
          data-artist={track.artist || "Live"}
        >
          <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1">
            <span class="track-index flex items-center justify-center text-xs font-mono text-slate-400 bg-slate-800/80 border border-slate-700/60 rounded-full w-6 h-6 shrink-0">{idx + 1}</span>
            <div class="min-w-0 flex-1">
              <div class="track-name font-medium text-xs sm:text-sm text-slate-200"><span class="track-name__text">{track.title}</span></div>
              <div class="text-[11px] sm:text-xs text-slate-500 truncate">{track.artist}</div>
            </div>
          </div>

          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            {track.createdAt && (
              <div class="relative group/info flex items-center">
                <button
                  type="button"
                  class="text-slate-400 hover:text-indigo-400 p-1 rounded-full transition-colors focus:outline-none"
                  title="Detalii dată"
                  aria-label="Informații dată"
                  data-track-date
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                </button>
                <div class="absolute bottom-full right-0 mb-1.5 hidden group-hover/info:flex items-center gap-1 text-[10px] font-medium text-slate-200 bg-slate-800/95 backdrop-blur-sm border border-slate-700/80 px-2 py-1 rounded-md shadow-xl whitespace-nowrap z-20 pointer-events-none">
                  <span class="text-indigo-400 font-semibold">Dată:</span> {track.createdAt}
                </div>
              </div>
            )}

            <div class="flex items-center gap-1 text-[11px] sm:text-xs font-medium text-slate-400 bg-slate-800/80 px-2 py-0.5 sm:py-1 rounded-md border border-slate-700/50" title="Număr ascultări">
              <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-indigo-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <TrackPlaysBadge trackId={track.id} server:defer>
                <span slot="fallback" class="play-count-badge font-mono animate-pulse" aria-hidden="true">···</span>
              </TrackPlaysBadge>
            </div>

            <span class="text-[11px] sm:text-xs font-mono text-slate-400 w-8 text-right">{track.duration || "Demo"}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .current-track-title {
    position: relative;
    display: block;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    isolation: isolate;
    contain: paint;
    clip-path: inset(0);
  }

  .playlist-progress {
    width: 100%;
    max-width: 420px;
    margin: 0.4rem auto 0;
    padding: 8px 0;
    cursor: pointer;
    touch-action: none;
  }

  .playlist-progress-track {
    position: relative;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 10%);
    overflow: visible;
  }

  .playlist-progress-fill {
    position: absolute;
    inset: 0;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, #6366f1, #22e6ff);
    transition: width 100ms linear;
  }

  .playlist-progress-fill::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 40%);
    transform: translateY(-50%) scale(0);
    transition: transform 120ms ease;
  }

  .playlist-progress:hover .playlist-progress-fill::after,
  .playlist-progress.is-seeking .playlist-progress-fill::after {
    transform: translateY(-50%) scale(1);
  }

  .playlist-progress.is-seeking .playlist-progress-fill {
    transition: none;
  }

  .playlist-progress-time {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    color: #93a3b8;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .current-track-title__text {
    display: inline-block;
    width: max-content;
    vertical-align: bottom;
  }

  .current-track-title__text.is-static {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .current-track-title__text.is-marquee {
    padding-right: 2.5rem;
    text-overflow: clip;
    animation: audio-title-marquee 9s linear infinite;
  }

  .track-name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .track-name__text {
    display: inline-block;
    width: max-content;
    vertical-align: bottom;
  }

  .track-name__text.is-static {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-name__text.is-marquee {
    padding-right: 2.5rem;
    animation: audio-title-marquee 8s linear infinite;
  }

  @keyframes audio-title-marquee {
    0%, 18% { transform: translateX(0); }
    82%, 100% { transform: translateX(calc(-1 * var(--marquee-distance))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .current-track-title__text.is-marquee,
    .track-name__text.is-marquee {
      animation: none;
      width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

<script>
  const formatTime = (seconds: number) => {
    if (isNaN(seconds) || seconds === 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  };

  // Reintra pe astro:page-load (View Transitions); dataset.fpInit evita rebindarea
  // listenerilor daca nodul a supraviețuit navigării prin transition:persist.
  function initAudioPlayer() {
    const root = document.querySelector<HTMLElement>('.playlist-player');
    if (!root || root.dataset.fpInit === '1') return;
    root.dataset.fpInit = '1';

    const trackItems = root.querySelectorAll<HTMLElement>('.track-item');
    const titleEl = root.querySelector<HTMLElement>('.current-track-title__text');
    const titleViewport = root.querySelector<HTMLElement>('.current-track-title');
    const artistEl = root.querySelector('.current-track-artist');
    const timeCurrent = root.querySelector('.time-current');
    const timeTotal = root.querySelector('.time-total');
    const playBtn = root.querySelector('.btn-play-pause');
    const iconPlay = root.querySelector('.icon-play');
    const iconPause = root.querySelector('.icon-pause');
    const btnNext = root.querySelector('.btn-next');
    const btnPrev = root.querySelector('.btn-prev');
    const volumeSlider = root.querySelector<HTMLInputElement>('.volume-slider');
    const progressEl = root.querySelector<HTMLElement>('[data-playlist-progress]');
    const progressFill = root.querySelector<HTMLElement>('[data-playlist-progress-fill]');

    let titleMeasureRaf = 0;
    const updateTitleMarquee = () => {
      if (titleMeasureRaf) cancelAnimationFrame(titleMeasureRaf);
      titleMeasureRaf = requestAnimationFrame(() => {
        titleMeasureRaf = 0;
        if (!titleEl || !titleViewport) return;
        const isOverflowing = titleViewport.scrollWidth > titleViewport.clientWidth + 1;
        if (isOverflowing) {
          titleEl.style.setProperty('--marquee-distance', `${titleViewport.scrollWidth - titleViewport.clientWidth + 40}px`);
        } else {
          titleEl.style.removeProperty('--marquee-distance');
        }
        titleEl.classList.toggle('is-marquee', isOverflowing);
        titleEl.classList.toggle('is-static', !isOverflowing);
      });
    };

    let trackNameMeasureRaf = 0;
    const updateTrackNameMarquee = (index: number) => {
      if (trackNameMeasureRaf) cancelAnimationFrame(trackNameMeasureRaf);
      trackNameMeasureRaf = requestAnimationFrame(() => {
        trackNameMeasureRaf = 0;
        const activeTrack = trackItems[index];
        const viewport = activeTrack?.querySelector<HTMLElement>('.track-name');
        const text = activeTrack?.querySelector<HTMLElement>('.track-name__text');
        if (!viewport || !text) return;
        const isOverflowing = viewport.scrollWidth > viewport.clientWidth + 1;
        if (isOverflowing) {
          text.style.setProperty('--marquee-distance', `${viewport.scrollWidth - viewport.clientWidth + 40}px`);
        } else {
          text.style.removeProperty('--marquee-distance');
        }
        text.classList.toggle('is-marquee', isOverflowing);
        text.classList.toggle('is-static', !isOverflowing);
      });
    };

    let currentIndex = 0;
    const trackedTracks = new Set<string>();
    const initialUrl = trackItems[0]?.dataset.audioUrl || '';

    const audio = new Audio();
    audio.preload = 'metadata';
    audio.crossOrigin = 'anonymous';
    if (initialUrl) audio.src = initialUrl;

    // shared with the fullscreen circular visualizer modal
    (window as any).__fpAudio = audio;

    const announceTrack = (title?: string, artist?: string) => {
      window.dispatchEvent(new CustomEvent('fp-track-change', { detail: { title, artist } }));
    };

    const updateActiveUI = (index: number) => {
      trackItems.forEach((el, i) => {
        if (i === index) {
          el.classList.add('bg-indigo-950/40', 'border-indigo-500/40');
          el.querySelector('.track-name')?.classList.add('text-indigo-400');
          el.querySelector('.track-name__text')?.classList.remove('is-static');
          el.querySelector('.track-index')?.classList.add('bg-indigo-600', 'text-white', 'border-indigo-400');
        } else {
          el.classList.remove('bg-indigo-950/40', 'border-indigo-500/40');
          el.querySelector('.track-name')?.classList.remove('text-indigo-400');
          el.querySelector('.track-index')?.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-400');
          const text = el.querySelector<HTMLElement>('.track-name__text');
          text?.classList.remove('is-marquee');
          text?.classList.add('is-static');
          text?.style.removeProperty('--marquee-distance');
        }
      });
      updateTrackNameMarquee(index);
    };

    const loadTrack = (index: number, playImmediately = true) => {
      if (index < 0 || index >= trackItems.length) return;
      currentIndex = index;
      const target = trackItems[currentIndex];
      const url = target.dataset.audioUrl;
      const title = target.dataset.title;
      const artist = target.dataset.artist;

      if (titleEl && title) titleEl.textContent = title;
      if (artistEl && artist) artistEl.textContent = artist;
      updateTitleMarquee();
      announceTrack(title, artist);

      updateActiveUI(currentIndex);

      if (url) {
        audio.src = url;
        audio.load();
        if (playImmediately) {
          audio.play().catch(console.error);
        }
      }
    };

    updateActiveUI(0);
    updateTitleMarquee();
    announceTrack(trackItems[0]?.dataset.title, trackItems[0]?.dataset.artist);
    window.addEventListener('resize', updateTitleMarquee, { passive: true });
    // Numărul de ascultări vine deja randat de server (TrackPlaysBadge, server island) —
    // nu mai e nevoie de fetch GET la /api/track-plays la montare.

    audio.addEventListener('loadedmetadata', () => {
      if (timeTotal) timeTotal.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (isSeeking) return;
      if (timeCurrent) timeCurrent.textContent = formatTime(audio.currentTime);
      if (audio.duration && Number.isFinite(audio.duration) && progressFill) {
        const ratio = Math.min(1, Math.max(0, audio.currentTime / audio.duration));
        progressFill.style.width = `${ratio * 100}%`;
        progressEl?.setAttribute('aria-valuenow', Math.round(ratio * 100).toString());
      }
    });

    // Drag-to-seek pe bara de progres — funcționează cu degetul (touch) și mouse
    // prin Pointer Events; ratio-ul se recalculează live la fiecare mișcare.
    let isSeeking = false;

    const ratioFromClientX = (clientX: number) => {
      const rect = progressEl!.getBoundingClientRect();
      return Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
    };

    const previewSeek = (clientX: number) => {
      if (!audio.duration || !Number.isFinite(audio.duration)) return;
      const ratio = ratioFromClientX(clientX);
      if (progressFill) progressFill.style.width = `${ratio * 100}%`;
      if (timeCurrent) timeCurrent.textContent = formatTime(ratio * audio.duration);
      progressEl?.setAttribute('aria-valuenow', Math.round(ratio * 100).toString());
    };

    progressEl?.addEventListener('pointerdown', (event) => {
      if (!audio.duration || !Number.isFinite(audio.duration)) return;
      isSeeking = true;
      progressEl.classList.add('is-seeking');
      progressEl.setPointerCapture(event.pointerId);
      previewSeek(event.clientX);
      event.preventDefault();
    });

    progressEl?.addEventListener('pointermove', (event) => {
      if (!isSeeking) return;
      previewSeek(event.clientX);
    });

    const endSeek = (event: PointerEvent) => {
      if (!isSeeking) return;
      isSeeking = false;
      progressEl?.classList.remove('is-seeking');
      if (audio.duration && Number.isFinite(audio.duration)) {
        audio.currentTime = ratioFromClientX(event.clientX) * audio.duration;
      }
    };

    progressEl?.addEventListener('pointerup', endSeek);
    progressEl?.addEventListener('pointercancel', endSeek);

    progressEl?.addEventListener('keydown', (event) => {
      if (!audio.duration || !Number.isFinite(audio.duration)) return;
      const step = audio.duration * 0.02;
      if (event.key === 'ArrowRight') {
        audio.currentTime = Math.min(audio.duration, audio.currentTime + step);
      } else if (event.key === 'ArrowLeft') {
        audio.currentTime = Math.max(0, audio.currentTime - step);
      } else {
        return;
      }
      event.preventDefault();
    });

    audio.addEventListener('play', () => {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');

      const currentTrackEl = trackItems[currentIndex];
      const trackId = currentTrackEl?.dataset.trackId;
      if (trackId && !trackedTracks.has(trackId)) {
        trackedTracks.add(trackId);
        const badge = currentTrackEl.querySelector('.play-count-badge');

        fetch('/api/track-plays/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trackId }),
        })
          .then((res) => (res.ok ? res.json() : null))
          .then((data: { plays?: number } | null) => {
            if (badge && typeof data?.plays === 'number') {
              badge.textContent = data.plays.toString();
            } else if (badge) {
              // API indisponibil — fallback local, doar pentru UI-ul curent
              const currentVal = parseInt(badge.textContent || '0', 10);
              badge.textContent = (currentVal + 1).toString();
            }
          })
          .catch(() => {
            if (badge) {
              const currentVal = parseInt(badge.textContent || '0', 10);
              badge.textContent = (currentVal + 1).toString();
            }
          });
      }
    });

    audio.addEventListener('pause', () => {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
    });

    audio.addEventListener('ended', () => {
      if (currentIndex < trackItems.length - 1) {
        loadTrack(currentIndex + 1, true);
      } else {
        loadTrack(0, false);
      }
    });

    playBtn?.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(console.error);
      } else {
        audio.pause();
      }
    });

    btnNext?.addEventListener('click', () => loadTrack((currentIndex + 1) % trackItems.length, true));
    btnPrev?.addEventListener('click', () => loadTrack((currentIndex - 1 + trackItems.length) % trackItems.length, true));

    trackItems.forEach((item, idx) => {
      item.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-track-date]')) return;
        loadTrack(idx, true);
      });
    });

    volumeSlider?.addEventListener('input', (e) => {
      audio.volume = parseFloat((e.target as HTMLInputElement).value);
    });

    document.addEventListener('astro:before-swap', () => {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      cancelAnimationFrame(titleMeasureRaf);
      cancelAnimationFrame(trackNameMeasureRaf);
      window.removeEventListener('resize', updateTitleMarquee);
      if ((window as any).__fpAudio === audio) {
        delete (window as any).__fpAudio;
      }
      root.removeAttribute('data-fp-init');
    }, { once: true });
  }

  initAudioPlayer();
  document.addEventListener('astro:page-load', initAudioPlayer);
</script>