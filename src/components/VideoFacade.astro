---
/**
 * VideoFacade.astro — fațadă video pentru PageSpeed + SEO
 *
 * Randează o imagine optimizată (astro:assets) cu titlu/subtitlu native în DOM,
 * vizibile pentru Google. Iframe-ul (Cloudflare Stream / YouTube) se injectează
 * DOAR la click — zero JS terț și zero cookie-uri până la acțiunea utilizatorului.
 *
 * @example
 *   <VideoFacade
 *     imageSrc={coverNunta}
 *     title="Formație nuntă Pitești — recital live"
 *     subtitle="Muzică populară și de petrecere • Florentina Pană"
 *     logoSrc="/images/logo-fp-stage.svg"
 *     videoUrl="https://www.youtube-nocookie.com/embed/aDB9Aa9cFLY"
 *   />
 */
import { Image } from 'astro:assets';
import { sanitizeUrl } from '../lib/sanitize-url';

interface Props {
  /** Imaginea de fundal importată din `src/assets/`. */
  imageSrc: ImageMetadata;
  /** Titlu SEO principal (randat în `<h3>`). */
  title: string;
  /** Text SEO secundar (randat în `<p>`). */
  subtitle?: string;
  /** Siglă opțională afișată dreapta-sus (cale din `public/`). */
  logoSrc?: string;
  /** Sursa iframe-ului injectat la click. */
  videoUrl: string;
  /** Clase Tailwind suplimentare pe container. */
  class?: string;
}

const {
  imageSrc,
  title,
  subtitle,
  logoSrc,
  videoUrl,
  class: className = '',
} = Astro.props;

const safeVideoUrl = sanitizeUrl(videoUrl, '');
const safeLogoSrc = logoSrc ? sanitizeUrl(logoSrc, '') : '';
const brandName = 'Formația Florentina Pană';
---

<div
  class:list={[
    'video-facade group relative aspect-video w-full cursor-pointer overflow-hidden rounded-2xl bg-black shadow-xl',
    className,
  ]}
  data-video-facade
  data-video-url={safeVideoUrl}
  data-video-title={title}
  role="button"
  tabindex="0"
  aria-label={`Redă videoclipul: ${title}`}
>
  <Image
    src={imageSrc}
    alt={title}
    widths={[480, 800, 1280]}
    sizes="(max-width: 768px) 100vw, 800px"
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
  />

  <div
    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"
    aria-hidden="true"
  >
  </div>

  <div class="absolute right-4 top-4 z-10">
    {safeLogoSrc ? (
      <img
        src={safeLogoSrc}
        alt={brandName}
        width="56"
        height="56"
        loading="lazy"
        decoding="async"
        class="h-10 w-auto opacity-90 drop-shadow-lg sm:h-12"
      />
    ) : (
      <span class="rounded-full bg-black/30 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-200/90 backdrop-blur-sm sm:text-xs">
        {brandName}
      </span>
    )}
  </div>

  <div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center">
    <span
      class="flex h-16 w-16 items-center justify-center rounded-full bg-black/40 ring-1 ring-amber-300/60 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 sm:h-20 sm:w-20"
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="ml-1 h-7 w-7 text-amber-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)] sm:h-9 sm:w-9"
      >
        <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.14-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
      </svg>
    </span>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-10 p-4 sm:p-6">
    <h3 class="text-lg font-bold leading-snug text-white drop-shadow-md sm:text-2xl">
      {title}
    </h3>
    {subtitle && (
      <p class="mt-1 text-sm text-amber-200/90 sm:text-base">
        {subtitle}
      </p>
    )}
  </div>

  <div
    class="absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3 bg-black/85 p-4 text-center backdrop-blur-sm"
    data-video-consent
    role="group"
    aria-label="Consimțământ cookie-uri video"
    hidden
  >
    <p class="max-w-sm text-xs leading-relaxed text-white/90 sm:text-sm">
      <strong class="text-amber-300">Cookie-uri video</strong><br />
      Redarea activează cookie-uri de la furnizorul video.
    </p>
    <button
      type="button"
      data-video-consent-accept
      class="rounded-full bg-amber-400 px-5 py-2 text-sm font-semibold text-black transition-colors hover:bg-amber-300"
    >
      Acceptă și vizionează
    </button>
    <a
      href="/politica-cookie/"
      class="text-xs text-white/70 underline underline-offset-2 hover:text-white"
    >
      Detalii cookie-uri
    </a>
  </div>
</div>

<script>
  const ALLOWED_HOSTS = [
    'www.youtube-nocookie.com',
    'youtube-nocookie.com',
    'www.youtube.com',
    'youtube.com',
    'player.vimeo.com',
    'iframe.videodelivery.net',
    'customer-*.cloudflarestream.com',
  ];

  function isAllowedHost(host: string): boolean {
    return ALLOWED_HOSTS.some((pattern) => {
      if (!pattern.includes('*')) return host === pattern;
      const [prefix, suffix] = pattern.split('*');
      return host.startsWith(prefix) && host.endsWith(suffix);
    });
  }

  function buildAutoplayUrl(raw: string): string | null {
    try {
      const url = new URL(raw, window.location.origin);
      if (url.protocol !== 'https:' || !isAllowedHost(url.hostname)) return null;
      url.searchParams.set('autoplay', '1');
      return url.toString();
    } catch {
      return null;
    }
  }

  function activate(facade: HTMLElement): void {
    if (facade.dataset.videoActive === 'true') return;
    const src = buildAutoplayUrl(facade.dataset.videoUrl || '');
    if (!src) return;

    facade.dataset.videoActive = 'true';
    facade.classList.remove('cursor-pointer', 'group');
    facade.removeAttribute('role');
    facade.removeAttribute('tabindex');
    facade.removeAttribute('aria-label');

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = facade.dataset.videoTitle || 'Videoclip';
    iframe.loading = 'lazy';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'absolute inset-0 h-full w-full border-0';

    facade.replaceChildren(iframe);
    iframe.focus();
  }

  function hasConsent(): boolean {
    try {
      return localStorage.getItem('cookie_consent') === 'granted';
    } catch {
      return false;
    }
  }

  function toggleConsentPanel(facade: HTMLElement, show: boolean): void {
    const panel = facade.querySelector<HTMLElement>('[data-video-consent]');
    if (!panel) return;
    panel.hidden = !show;
    panel.classList.toggle('hidden', !show);
    panel.classList.toggle('flex', show);
    if (show) panel.querySelector<HTMLButtonElement>('[data-video-consent-accept]')?.focus();
  }

  function requestPlay(facade: HTMLElement): void {
    if (facade.dataset.videoActive === 'true') return;
    if (hasConsent()) {
      activate(facade);
      return;
    }
    facade.dataset.videoPending = 'true';
    toggleConsentPanel(facade, true);
  }

  function grantConsent(facade: HTMLElement): void {
    try {
      localStorage.setItem('cookie_consent', 'granted');
    } catch {
      // localStorage indisponibil — consimțământul rămâne valabil doar pentru această redare
    }
    window.dispatchEvent(new CustomEvent('cookie:granted'));
    activate(facade);
  }

function bindFacades(): void {
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    if (facade.dataset.videoBound === 'true') return;
    facade.dataset.videoBound = 'true';

    facade.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-video-consent]')) {
        if (target.closest('[data-video-consent-accept]')) grantConsent(facade);
        return;
      }
      requestPlay(facade);
    });

    facade.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        requestPlay(facade);
      }
    });
  });
}

// Acceptarea din CookieBanner redă fațadele care așteptau consimțământ.
window.addEventListener('cookie:granted', () => {
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    if (facade.dataset.videoPending === 'true') activate(facade);
  });
});

bindFacades();
// ClientRouter nu re-execută modulele la navigare — refacem legăturile la fiecare pagină.
document.addEventListener('astro:page-load', bindFacades);
</script>
