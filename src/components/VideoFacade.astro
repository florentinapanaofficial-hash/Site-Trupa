---
/**
 * VideoFacade.astro — fațadă video pentru PageSpeed + SEO
 *
 * Randează o imagine optimizată (astro:assets) cu titlu/subtitlu native în DOM,
 * vizibile pentru Google. Iframe-ul (Cloudflare Stream / YouTube) se injectează
 * DOAR la click — zero JS terț și zero cookie-uri până la acțiunea utilizatorului.
 *
 * @example
 *   <VideoFacade
 *     imageSrc={coverNunta}
 *     title="Formație nuntă Pitești — recital live"
 *     subtitle="Muzică populară și de petrecere • Florentina Pană"
 *     logoSrc="/images/logo-fp-stage.svg"
 *     videoUrl="https://www.youtube-nocookie.com/embed/aDB9Aa9cFLY"
 *   />
 */
import { Image } from 'astro:assets';
import { sanitizeUrl } from '../lib/sanitize-url';

interface Props {
  /** Imagine din `src/assets/` sau cale URL din `public/`. */
  imageSrc: ImageMetadata | string;
  /** Titlu SEO principal (randat în `<h3>`). */
  title: string;
  /** Text SEO secundar (randat în `<p>`). */
  subtitle?: string;
  /** Siglă opțională afișată dreapta-sus (cale din `public/`). */
  logoSrc?: string;
  /** Sursa iframe-ului injectat la click. */
  videoUrl: string;
  /** ID stabil pentru contorul de vizualizări; implicit derivat din `videoUrl`. */
  videoId?: string;
  /** Descriere bogată (SEO), randată nativ în DOM în panoul „Informații”. */
  description?: string;
  /** Strategia de încărcare a imaginii de fațadă. */
  loading?: 'lazy' | 'eager';
  /** Clase Tailwind suplimentare pe container. */
  class?: string;
}

const {
  imageSrc,
  title,
  subtitle,
  logoSrc,
  videoUrl,
  videoId,
  description,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const infoId = `vf-info-${Math.random().toString(36).slice(2, 10)}`;

const safeVideoUrl = sanitizeUrl(videoUrl, '');
const safeLogoSrc = logoSrc ? sanitizeUrl(logoSrc, '') : '';
const brandName = 'Formația Florentina Pană';

function deriveVideoId(raw: string): string {
  try {
    const url = new URL(raw, 'https://local.invalid');
    const candidate = url.searchParams.get('list') || url.pathname.split('/').filter(Boolean).pop() || '';
    return /^[A-Za-z0-9_-]{1,64}$/.test(candidate) ? candidate : '';
  } catch {
    return '';
  }
}

const viewsId = videoId && /^[A-Za-z0-9_-]{1,64}$/.test(videoId) ? videoId : deriveVideoId(safeVideoUrl);
---

<div
  class:list={[
    'video-facade group relative aspect-video w-full cursor-pointer overflow-hidden rounded-2xl bg-[#050a18] shadow-xl',
    className,
  ]}
  data-video-facade
  data-video-url={safeVideoUrl}
  data-video-title={title}
  data-video-id={viewsId || undefined}
  role="button"
  tabindex="0"
  aria-label={`Redă videoclipul: ${title}`}
>
  <!-- Schelet neutru: acoperă cerul albastru până se decodează imaginea -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-[#0d1428] to-[#050a18]"
    aria-hidden="true"
  >
  </div>

  {typeof imageSrc === 'string' ? (
    <img
      src={imageSrc}
      alt={title}
      loading={loading}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  ) : (
    <Image
      src={imageSrc}
      alt={title}
      widths={[480, 640, 800, 1280]}
      sizes="(max-width: 768px) 100vw, (max-width: 1280px) 46vw, 620px"
      format="webp"
      quality={80}
      loading={loading}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  )}

  <div
    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"
    aria-hidden="true"
  >
  </div>

  {description && (
    <button
      type="button"
      data-video-info-open
      aria-controls={infoId}
      aria-expanded="false"
      aria-label={`Informații despre videoclip: ${title}`}
      class="absolute left-3 top-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/40 text-white ring-1 ring-white/40 backdrop-blur-sm transition-colors hover:bg-black/60 hover:ring-amber-300/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 md:left-4 md:top-4 md:h-10 md:w-10"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-4 w-4 md:h-5 md:w-5">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5M12 8h.01" />
      </svg>
    </button>
  )}

  <div class="absolute right-3 top-3 z-10 md:right-4 md:top-4">
    {safeLogoSrc ? (
      <img
        src={safeLogoSrc}
        alt={brandName}
        width="56"
        height="56"
        loading="lazy"
        decoding="async"
        class="h-8 w-auto opacity-90 drop-shadow-lg md:h-12"
      />
    ) : (
      <span class="rounded-full bg-black/30 px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-amber-200/90 backdrop-blur-sm md:px-3 md:text-xs">
        {brandName}
      </span>
    )}
  </div>

  <span
    class="pointer-events-none absolute left-1/2 top-1/2 z-10 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 transform items-center justify-center transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 md:h-20 md:w-20"
  >
    <span
      class="absolute inset-0 rounded-full bg-red-600/50 motion-safe:animate-ping"
      aria-hidden="true"
    >
    </span>
    <span
      class="vf-play-heartbeat relative flex h-full w-full items-center justify-center rounded-full bg-gradient-to-b from-red-500 to-red-700 shadow-[0_8px_24px_rgba(220,38,38,0.55)] ring-2 ring-white/20 transition-colors duration-300 group-hover:from-red-500 group-hover:to-red-600"
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="ml-1 h-6 w-6 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.35)] md:h-9 md:w-9"
      >
        <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.14-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
      </svg>
    </span>
  </span>

  <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 p-3 md:p-6">
    <div class="min-w-0 flex-1">
      <h3 class="line-clamp-1 text-base font-bold leading-snug text-white drop-shadow-md md:text-2xl">
        {title}
      </h3>
      {subtitle && (
        <p class="mt-1 line-clamp-1 text-xs text-amber-200/90 md:text-sm">
          {subtitle}
        </p>
      )}
    </div>
    {viewsId && (
      <span
        data-video-views
        hidden
        class="flex shrink-0 items-center gap-1.5 rounded-full bg-[#0a1630]/70 px-2.5 py-1 text-[11px] font-medium tabular-nums text-white/90 ring-1 ring-amber-300/30 backdrop-blur-md md:px-3 md:text-xs"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5 text-amber-300 md:h-4 md:w-4">
          <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <span data-video-views-count>0</span>
        <span class="sr-only">vizualizări</span>
      </span>
    )}
  </div>

  <div
    class="absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3 bg-black/85 p-4 text-center backdrop-blur-sm"
    data-video-consent
    role="group"
    aria-label="Consimțământ cookie-uri video"
    hidden
  >
    <p class="max-w-sm text-xs leading-relaxed text-white/90 sm:text-sm">
      <strong class="text-amber-300">Cookie-uri video</strong><br />
      Redarea activează cookie-uri de la furnizorul video.
    </p>
    <button
      type="button"
      data-video-consent-accept
      class="rounded-full bg-amber-400 px-5 py-2 text-sm font-semibold text-black transition-colors hover:bg-amber-300"
    >
      Acceptă și vizionează
    </button>
    <a
      href="/politica-cookie/"
      class="text-xs text-white/70 underline underline-offset-2 hover:text-white"
    >
      Detalii cookie-uri
    </a>
  </div>

  {description && (
    <div
      id={infoId}
      data-video-info-panel
      role="dialog"
      aria-modal="false"
      aria-labelledby={`${infoId}-label`}
      inert
      class="pointer-events-none absolute inset-0 z-30 flex cursor-default flex-col bg-black/90 p-4 text-left text-white opacity-0 transition-opacity duration-300 sm:p-6"
    >
      <div class="mb-3 flex items-start justify-between gap-3">
        <p id={`${infoId}-label`} class="text-base font-semibold leading-snug text-amber-300 sm:text-lg">
          {title}
        </p>
        <button
          type="button"
          data-video-info-close
          aria-label="Închide informațiile"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-5 w-5">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <p class="overflow-y-auto whitespace-pre-line pr-1 text-sm leading-relaxed text-white/90 sm:text-base">
        {description}
      </p>
    </div>
  )}
</div>

<style>
  @keyframes vf-heartbeat {
    0%, 40%, 100% { transform: scale(1); }
    15% { transform: scale(1.08); }
    28% { transform: scale(1.03); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .vf-play-heartbeat {
      animation: vf-heartbeat 1.8s ease-in-out infinite;
      will-change: transform;
    }
  }
</style>

<script>
  const ALLOWED_HOSTS = [
    'www.youtube-nocookie.com',
    'youtube-nocookie.com',
    'www.youtube.com',
    'youtube.com',
    'player.vimeo.com',
    'iframe.videodelivery.net',
    'iframe.cloudflarestream.com',
    'customer-*.cloudflarestream.com',
  ];

  function isAllowedHost(host: string): boolean {
    return ALLOWED_HOSTS.some((pattern) => {
      if (!pattern.includes('*')) return host === pattern;
      const [prefix, suffix] = pattern.split('*');
      return host.startsWith(prefix) && host.endsWith(suffix);
    });
  }

  function buildAutoplayUrl(raw: string): string | null {
    try {
      const url = new URL(raw, window.location.origin);
      if (url.protocol !== 'https:' || !isAllowedHost(url.hostname)) return null;
      url.searchParams.set('autoplay', '1');
      return url.toString();
    } catch {
      return null;
    }
  }

  const VIEWS_ENDPOINT = '/api/views/';
  const viewsFormatter = new Intl.NumberFormat('ro-RO', { notation: 'compact', maximumFractionDigits: 1 });
  // Copertele originale, restaurate când alt video preia redarea.
  const coverNodes = new WeakMap<HTMLElement, Node[]>();

  function renderViews(facade: HTMLElement, views: number): void {
    facade.dataset.videoViews = String(views);
    const badge = facade.querySelector<HTMLElement>('[data-video-views]');
    if (!badge) return;
    const count = badge.querySelector<HTMLElement>('[data-video-views-count]');
    if (count) count.textContent = viewsFormatter.format(views);
    badge.hidden = false;
    badge.setAttribute('aria-label', `${views} vizualizări`);
  }

  async function loadViews(facades: HTMLElement[]): Promise<void> {
    const ids = [...new Set(facades.map((f) => f.dataset.videoId).filter((id): id is string => !!id))];
    if (ids.length === 0) return;
    try {
      const res = await fetch(`${VIEWS_ENDPOINT}?ids=${encodeURIComponent(ids.join(','))}`, {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      });
      if (!res.ok) return;
      const data = (await res.json()) as { views?: Record<string, number> };
      facades.forEach((facade) => {
        const value = data.views?.[facade.dataset.videoId || ''];
        if (typeof value === 'number') renderViews(facade, value);
      });
    } catch {
      // Contorul e decorativ — eșecul rețelei nu afectează redarea.
    }
  }

  async function trackView(facade: HTMLElement): Promise<void> {
    const videoId = facade.dataset.videoId;
    if (!videoId) return;
    try {
      const res = await fetch(VIEWS_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ videoId }),
        keepalive: true,
      });
      if (!res.ok) return;
      const data = (await res.json()) as { views?: number };
      if (typeof data.views !== 'number') return;
      // Sincronizează toate cardurile cu același video (ex: aceeași piesă în mai multe secțiuni).
      document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((f) => {
        if (f.dataset.videoId === videoId) renderViews(f, data.views as number);
      });
    } catch {
      // Ignorat intenționat — vezi loadViews.
    }
  }

  function resetFacade(facade: HTMLElement): void {
    const nodes = coverNodes.get(facade);
    if (!nodes) return;
    facade.replaceChildren(...nodes);
    coverNodes.delete(facade);
    delete facade.dataset.videoActive;
    facade.classList.add('cursor-pointer', 'group');
    facade.setAttribute('role', 'button');
    facade.setAttribute('tabindex', '0');
    facade.setAttribute('aria-label', `Redă videoclipul: ${facade.dataset.videoTitle || 'Videoclip'}`);
    if (facade.dataset.videoViews) renderViews(facade, Number(facade.dataset.videoViews));
  }

  function stopOthers(current: HTMLElement): void {
    document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
      if (facade === current) return;
      if (facade.dataset.videoActive === 'true') resetFacade(facade);
      if (facade.dataset.videoPending === 'true') {
        delete facade.dataset.videoPending;
        toggleConsentPanel(facade, false);
      }
    });
  }

  function activate(facade: HTMLElement): void {
    if (facade.dataset.videoActive === 'true') return;
    const src = buildAutoplayUrl(facade.dataset.videoUrl || '');
    if (!src) return;

    stopOthers(facade);
    delete facade.dataset.videoPending;
    toggleConsentPanel(facade, false);
    coverNodes.set(facade, Array.from(facade.childNodes));
    facade.dataset.videoActive = 'true';
    facade.classList.remove('cursor-pointer', 'group');
    facade.removeAttribute('role');
    facade.removeAttribute('tabindex');
    facade.removeAttribute('aria-label');

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = facade.dataset.videoTitle || 'Videoclip';
    iframe.loading = 'lazy';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'absolute inset-0 h-full w-full border-0';

    facade.replaceChildren(iframe);
    iframe.focus();
    void trackView(facade);
  }

  function hasConsent(): boolean {
    try {
      return localStorage.getItem('cookie_consent') === 'granted';
    } catch {
      return false;
    }
  }

  function toggleConsentPanel(facade: HTMLElement, show: boolean): void {
    const panel = facade.querySelector<HTMLElement>('[data-video-consent]');
    if (!panel) return;
    panel.hidden = !show;
    panel.classList.toggle('hidden', !show);
    panel.classList.toggle('flex', show);
    if (show) panel.querySelector<HTMLButtonElement>('[data-video-consent-accept]')?.focus();
  }

  function requestPlay(facade: HTMLElement): void {
    if (facade.dataset.videoActive === 'true') return;
    if (hasConsent()) {
      activate(facade);
      return;
    }
    stopOthers(facade);
    facade.dataset.videoPending = 'true';
    toggleConsentPanel(facade, true);
  }

  function grantConsent(facade: HTMLElement): void {
    try {
      localStorage.setItem('cookie_consent', 'granted');
    } catch {
      // localStorage indisponibil — consimțământul rămâne valabil doar pentru această redare
    }
    window.dispatchEvent(new CustomEvent('cookie:granted'));
    activate(facade);
  }

  function setInfoPanel(facade: HTMLElement, open: boolean): void {
    const panel = facade.querySelector<HTMLElement>('[data-video-info-panel]');
    const trigger = facade.querySelector<HTMLButtonElement>('[data-video-info-open]');
    if (!panel || !trigger) return;
    panel.inert = !open;
    panel.classList.toggle('opacity-0', !open);
    panel.classList.toggle('pointer-events-none', !open);
    panel.classList.toggle('opacity-100', open);
    trigger.setAttribute('aria-expanded', String(open));
    if (open) panel.querySelector<HTMLButtonElement>('[data-video-info-close]')?.focus();
    else trigger.focus();
  }

  function bindInfo(facade: HTMLElement): void {
    const trigger = facade.querySelector<HTMLButtonElement>('[data-video-info-open]');
    const panel = facade.querySelector<HTMLElement>('[data-video-info-panel]');
    if (!trigger || !panel) return;

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      setInfoPanel(facade, true);
    });

    panel.addEventListener('click', (event) => {
      event.stopPropagation();
      if ((event.target as HTMLElement | null)?.closest('[data-video-info-close]')) {
        setInfoPanel(facade, false);
      }
    });

    panel.addEventListener('keydown', (event) => {
      event.stopPropagation();
      if (event.key === 'Escape') setInfoPanel(facade, false);
    });
  }

function bindFacades(): void {
  const fresh: HTMLElement[] = [];
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    if (facade.dataset.videoBound === 'true') return;
    facade.dataset.videoBound = 'true';
    fresh.push(facade);
    bindInfo(facade);

    facade.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-video-consent]')) {
        if (target.closest('[data-video-consent-accept]')) grantConsent(facade);
        return;
      }
      requestPlay(facade);
    });

    facade.addEventListener('keydown', (event) => {
      // Enter/Space pe butoanele interne (Info, consimțământ) nu trebuie să pornească redarea.
      if (event.target !== facade) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        requestPlay(facade);
      }
    });
  });
  void loadViews(fresh);
}

// Acceptarea din CookieBanner redă fațadele care așteptau consimțământ.
window.addEventListener('cookie:granted', () => {
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    if (facade.dataset.videoPending === 'true') activate(facade);
  });
});

bindFacades();
// ClientRouter nu re-execută modulele la navigare — refacem legăturile la fiecare pagină.
document.addEventListener('astro:page-load', bindFacades);
</script>
