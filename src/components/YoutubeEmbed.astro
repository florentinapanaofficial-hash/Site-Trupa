---
/**
 * YoutubeEmbed.astro
 * ──────────────────────────────────────────────────────────────────
 * Embed YouTube cu poartă de consimțământ GDPR
 *
 * Temeiul legal:
 *   • Rec. 30 & 32 RGPD + Directiva ePrivacy 2002/58/CE, art. 5 alin. 3
 *   • Cookie-urile YouTube (VISITOR_PRIVACY_METADATA, VISITOR_INFO1_LIVE)
 *     sunt instalate de iframe-ul YouTube LA ÎNCĂRCARE, înainte ca
 *     utilizatorul să apese play — deci necesită consimțământ PREALABIL.
 *
 * Comportament:
 *   – Înainte de consimțământ: afișează thumbnail (img.youtube.com,
 *     fără cookie-uri) + overlay cu două opțiuni.
 *   – După „Acceptă cookie-urile" (CookieBanner) → toate embed-urile
 *     de pe pagină se activează automat (event cookie:granted).
 *   – Butonul „Acceptă și vizionează" per video → activează consimțământul
 *     global și deschide acel video specific.
 *   – Dacă consimțământul e deja „granted" în localStorage → iframe
 *     se injectează imediat la încărcarea paginii, fără banner.
 *
 * Utilizare:
 *   <YoutubeEmbed youtubeId="aDB9Aa9cFLY" title="Titlul videoclipului" />
 *   <YoutubeEmbed playlistId="PL_xxx" title="Playlist YouTube" thumbnailSrc="/images/logo-fp-stage.svg" />
 *
 *   Cu clase Tailwind pe wrapper (ex. pentru aspect-video w-full):
 *   <YoutubeEmbed youtubeId="..." title="..." class="aspect-video w-full rounded-xl" />
 *
 * Notă: folosim youtube-nocookie.com (Privacy Enhanced Mode) ca strat
 * suplimentar — dar consimțământul rămâne OBLIGATORIU indiferent de domeniu.
 */

interface Props {
  youtubeId?: string;
  playlistId?: string;
  title: string;
  class?: string;
  miniOnScroll?: boolean;
  thumbnailSrc?: string;
  youtubeUrl?: string;
  globalConsentOnly?: boolean;
}

const {
  youtubeId,
  playlistId,
  title,
  class: className = '',
  miniOnScroll = false,
  thumbnailSrc,
  youtubeUrl,
  globalConsentOnly = false,
} = Astro.props;

const hasPlaylist = typeof playlistId === 'string' && playlistId.length > 0;
const hasVideo = typeof youtubeId === 'string' && youtubeId.length > 0;
const consentButtonLabel = 'Acceptă și vizionează';

const thumbJpg = thumbnailSrc || (hasVideo
  ? `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`
  : '/images/logo-fp-stage.svg');
const embedSrc = hasPlaylist
  ? `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}&rel=0`
  : `https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`;
const ytLink = youtubeUrl || (hasPlaylist
  ? `https://www.youtube.com/playlist?list=${playlistId}`
  : `https://www.youtube.com/watch?v=${youtubeId}`);
---

<div
  class={`yt-gate${hasPlaylist ? ' yt-gate--playlist' : ''}${className ? ' ' + className : ''}`}
  data-yt-id={youtubeId}
  data-yt-title={title}
  data-yt-src={embedSrc}
  data-yt-mini-on-scroll={miniOnScroll ? 'true' : undefined}
  role="figure"
  aria-label={title}
>
  <!-- ─── Placeholder: thumbnail + overlay de consimțământ ─── -->
  <!-- img.youtube.com NU setează cookie-uri — folosit în siguranță înainte de consimțământ -->
  <div class="yt-gate__placeholder">
    <img
      class="yt-gate__thumb"
      src={thumbJpg}
      alt={`Previzualizare: ${title}`}
      loading="lazy"
      decoding="async"
      width="480"
      height="360"
      onerror="this.style.display='none'"
    />
    {!globalConsentOnly && (
      <div class="yt-gate__consent" role="group" aria-label="Consimțământ cookie-uri YouTube">
        <button class="yt-gate__btn-accept yt-gate__play-icon" type="button" aria-label={consentButtonLabel}>
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="23" fill="rgba(0,0,0,0.65)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
            <polygon points="19,15 37,24 19,33" fill="white"/>
          </svg>
        </button>

        {!hasPlaylist && (
          <p class="yt-gate__msg">
            <strong>Cookie-uri YouTube</strong><br>
            Vizionarea activează cookie-uri de urmărire<br>
            (<code>VISITOR_INFO1_LIVE</code>, <code>VISITOR_PRIVACY_METADATA</code>).
          </p>
        )}

        {!hasPlaylist && (
          <a href={ytLink} class="yt-gate__btn-yt" target="_blank" rel="noopener noreferrer">
            Deschide pe YouTube ↗
          </a>
        )}
      </div>
    )}
  </div>

  {miniOnScroll && (
    <button class="yt-gate__mini-return" type="button" aria-label="Revino la videoclip">
      Revino la video
    </button>
  )}
</div>

<script is:inline>
  (function () {
    if (window.__ytGateInit) return;
    window.__ytGateInit = true;

    // ── Inițializare YouTube IFrame API + PostMessage Mutual Exclusion ────────────
    // Asigură că un singur player YouTube este activ pe pagină la orice moment
    
    var YT_PAUSE = JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] });
    var YT_PLAY = JSON.stringify({ event: 'command', func: 'playVideo', args: [] });
    var YT_LISTEN = JSON.stringify({ event: 'listening' });
    var YT_ADD_STATE_LISTENER = JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onStateChange'] });
    var YT_ORIGINS = ['https://www.youtube-nocookie.com', 'https://www.youtube.com'];
    var MINI_GATE_SELECTOR = '.yt-gate[data-yt-mini-on-scroll="true"]';
    var miniObserver = null;
    var videoHoverAudioCtx = null;
    var lastVideoHoverToneAt = 0;

    function playVideoHoverTone() {
      if (!window.matchMedia('(min-width: 1025px)').matches) return;

      var AudioCtor = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtor) return;
      if (!videoHoverAudioCtx) videoHoverAudioCtx = new AudioCtor();

      var now = performance.now();
      if (now - lastVideoHoverToneAt < 260) return;
      lastVideoHoverToneAt = now;

      var ctx = videoHoverAudioCtx;
      if (ctx.state === 'suspended') void ctx.resume();

      var oscillator = ctx.createOscillator();
      var gain = ctx.createGain();
      var start = ctx.currentTime;
      var duration = 0.1;
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(240, start);
      oscillator.frequency.exponentialRampToValueAtTime(360, start + duration);
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(0.011, start + 0.018);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
      oscillator.connect(gain);
      gain.connect(ctx.destination);
      oscillator.start(start);
      oscillator.stop(start + duration);
    }

    document.addEventListener('pointerover', function (event) {
      var target = event.target;
      var gate = target && target.closest ? target.closest('.yt-gate') : null;
      if (!gate) return;
      if (event.relatedTarget && gate.contains(event.relatedTarget)) return;
      playVideoHoverTone();
    }, { passive: true });

    function hasMiniOnScroll(gate) {
      return gate && gate.getAttribute('data-yt-mini-on-scroll') === 'true';
    }

    function isTrustedYouTubeOrigin(origin) {
      return origin === 'https://www.youtube-nocookie.com' || origin === 'https://www.youtube.com';
    }

    function postYouTubeMessage(targetWindow, payload) {
      if (!targetWindow) return;
      var serialized = typeof payload === 'string' ? payload : JSON.stringify(payload);

      // Unele iframe-uri răspund doar pe origine strictă, altele pe wildcard.
      YT_ORIGINS.forEach(function (origin) {
        try {
          targetWindow.postMessage(serialized, origin);
        } catch (err) {}
      });

      try {
        targetWindow.postMessage(serialized, '*');
      } catch (err) {}
    }

    function pauseAllNativeMediaExcept(activeMedia) {
      document.querySelectorAll('audio, video').forEach(function (media) {
        if (media !== activeMedia && !media.paused) {
          media.pause();
        }
      });
    }

    function extractPlayerState(messageData) {
      if (!messageData || typeof messageData !== 'object') return null;

      // infoDelivery format: { event: 'infoDelivery', info: { playerState: 1 } }
      if (messageData.info && typeof messageData.info.playerState === 'number') {
        return messageData.info.playerState;
      }

      // onStateChange format: { event: 'onStateChange', info: 1 }
      if (messageData.event === 'onStateChange' && typeof messageData.info === 'number') {
        return messageData.info;
      }

      return null;
    }

    function findMiniGateBySource(sourceWindow) {
      if (!sourceWindow) return null;
      var miniIframes = document.querySelectorAll(MINI_GATE_SELECTOR + ' iframe[src*="youtube"]');
      for (var i = 0; i < miniIframes.length; i += 1) {
        var iframe = miniIframes[i];
        if (iframe.contentWindow === sourceWindow) {
          return iframe.closest('.yt-gate');
        }
      }
      return null;
    }

    /** Găsește gate-ul (oricare, nu doar mini) căruia îi aparține un contentWindow */
    function findGateBySource(sourceWindow) {
      if (!sourceWindow) return null;
      var iframes = document.querySelectorAll('.yt-gate iframe[src*="youtube"]');
      for (var i = 0; i < iframes.length; i += 1) {
        if (iframes[i].contentWindow === sourceWindow) {
          return iframes[i].closest('.yt-gate');
        }
      }
      return null;
    }

    function syncMiniDocumentState() {
      var hasMini = document.querySelector('.yt-gate--mini') !== null;
      document.documentElement.classList.toggle('yt-mini-active', hasMini);
    }

    function syncMiniGate(gate) {
      if (!hasMiniOnScroll(gate)) return;
      var isPlaying = gate.getAttribute('data-yt-playing') === 'true';
      var isOutOfView = gate.getAttribute('data-yt-out-of-view') === 'true';
      gate.classList.toggle('yt-gate--mini', isPlaying && isOutOfView);
      syncMiniDocumentState();
    }

    function ensureMiniObserver() {
      if (miniObserver || !('IntersectionObserver' in window)) return;

      miniObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var gate = entry.target;
          var outOfView = !entry.isIntersecting || entry.intersectionRatio < 0.35;
          gate.setAttribute('data-yt-out-of-view', outOfView ? 'true' : 'false');
          syncMiniGate(gate);
        });
      }, {
        threshold: [0, 0.35, 0.7, 1],
      });
    }

    function registerMiniGate(gate) {
      if (!hasMiniOnScroll(gate)) return;

      if (!gate.hasAttribute('data-yt-playing')) {
        gate.setAttribute('data-yt-playing', 'false');
      }
      if (!gate.hasAttribute('data-yt-out-of-view')) {
        gate.setAttribute('data-yt-out-of-view', 'false');
      }

      ensureMiniObserver();
      if (miniObserver) {
        miniObserver.observe(gate);
      }
    }

    /**
     * Pauzează TOȚI playerele YouTube de pe pagină mai puțin cel activ
     * @param {Window} activeSource - contentWindow-ul playerului activ
     */
    function pauseAllExcept(activeSource) {
      document.querySelectorAll('iframe[src*="youtube"]').forEach(function (iframe) {
        try {
          if (iframe.contentWindow && iframe.contentWindow !== activeSource) {
            postYouTubeMessage(iframe.contentWindow, YT_PAUSE);
          }
        } catch (err) {
          console.warn('Error pausing YouTube player:', err);
        }
      });
    }

    /**
     * Reacționează la mesajele YouTube Player API
     * Când un player start playback (playerState === 1), pauza toți ceilalți
     */
    window.addEventListener('message', function (e) {
      if (!e.data || !e.source) return;
      if (!isTrustedYouTubeOrigin(e.origin)) return;

      var data;
      try {
        data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      } catch (err) {
        return;
      }

      var playerState = extractPlayerState(data);
      if (typeof playerState === 'number') {
        var sourceGate = findGateBySource(e.source);
        if (sourceGate) {
          sourceGate.setAttribute('data-yt-playing', playerState === 1 ? 'true' : 'false');
        }

        var activeMiniGate = findMiniGateBySource(e.source);

        if (activeMiniGate) {
          activeMiniGate.setAttribute('data-yt-playing', playerState === 1 ? 'true' : 'false');
          syncMiniGate(activeMiniGate);
        }

        if (playerState === 1) {
          pauseAllExcept(e.source);
          pauseAllNativeMediaExcept(null);

          document.querySelectorAll(MINI_GATE_SELECTOR).forEach(function (gate) {
            if (gate !== activeMiniGate) {
              gate.setAttribute('data-yt-playing', 'false');
              syncMiniGate(gate);
            }
          });
        }
      }
    });

    /** Înlocuiește placeholder-ul cu iframe-ul real YouTube */
    function activateGate(gate) {
      if (gate.querySelector('iframe')) return; // deja activat

      var src = gate.getAttribute('data-yt-src');
      var title = gate.getAttribute('data-yt-title') ?? '';
      if (!src) return;

      var placeholder = gate.querySelector('.yt-gate__placeholder');
      if (placeholder) placeholder.remove();

      var iframe = document.createElement('iframe');
      // Adaugă enablejsapi=1 pentru YouTube IFrame API și postMessage support
      var separator = src.includes('?') ? '&' : '?';
      var embedOrigin = encodeURIComponent(window.location.origin);
      iframe.src = src + separator + 'enablejsapi=1&playsinline=1&origin=' + embedOrigin;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('referrerpolicy', 'origin');
      iframe.setAttribute('loading', 'lazy');
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      iframe.addEventListener('load', function () {
        if (!iframe.contentWindow) return;
        postYouTubeMessage(iframe.contentWindow, YT_LISTEN);
        postYouTubeMessage(iframe.contentWindow, YT_ADD_STATE_LISTENER);
      });
      gate.appendChild(iframe);
      gate.setAttribute('data-yt-playing', 'false');

      // ── Overlay peste iframe: click oriunde pe video = play/pauză ──
      // Evită să mai caute clienții butonul mic din player-ul YouTube.
      var clickOverlay = document.createElement('button');
      clickOverlay.type = 'button';
      clickOverlay.className = 'yt-gate__click-overlay';
      clickOverlay.setAttribute('aria-label', 'Redă sau pune pauză video');
      gate.appendChild(clickOverlay);

      // ── Buton dedicat de fullscreen: overlay-ul de mai sus acoperă tot
      // iframe-ul, deci butonul de „ecran complet” din player-ul nativ
      // YouTube nu mai poate fi accesat de click — oferim unul propriu.
      var fullscreenBtn = document.createElement('button');
      fullscreenBtn.type = 'button';
      fullscreenBtn.className = 'yt-gate__fullscreen-btn';
      fullscreenBtn.setAttribute('aria-label', 'Mărește video pe tot ecranul');
      fullscreenBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>';
      gate.appendChild(fullscreenBtn);

      registerMiniGate(gate);
    }

    /** Comută fullscreen pentru gate: iese dacă e deja în fullscreen, altfel intră */
    function toggleGateFullscreen(gate) {
      var isThisGateFullscreen = document.fullscreenElement === gate
        || document.webkitFullscreenElement === gate;

      if (isThisGateFullscreen) {
        (document.exitFullscreen || document.webkitExitFullscreen)?.call(document);
        return;
      }

      enterFullscreenAndRotate(gate);
    }

    /** Comută play/pauză pentru gate-ul dat, pe baza ultimei stări cunoscute */
    function toggleGatePlayback(gate) {
      var iframe = gate.querySelector('iframe');
      if (!iframe || !iframe.contentWindow) return;

      var isPlaying = gate.getAttribute('data-yt-playing') === 'true';
      postYouTubeMessage(iframe.contentWindow, isPlaying ? YT_PAUSE : YT_PLAY);

      // Feedback optimist imediat — starea reală vine oricum prin postMessage.
      gate.setAttribute('data-yt-playing', isPlaying ? 'false' : 'true');
      flashGateIcon(gate, isPlaying ? 'pause' : 'play');

      // La pornire (nu la pauză): fullscreen automat + rotire landscape,
      // ca pe aplicațiile moderne. Browserele fără suport ignoră silențios.
      if (!isPlaying) {
        enterFullscreenAndRotate(gate);
      }
    }

    /** Cere fullscreen pentru gate și, dacă e posibil, blochează orientarea pe landscape */
    function enterFullscreenAndRotate(gate) {
      if (document.fullscreenElement === gate) return;
      if (document.fullscreenElement) {
        (document.exitFullscreen || document.webkitExitFullscreen)?.call(document);
      }

      var request = gate.requestFullscreen
        || gate.webkitRequestFullscreen
        || gate.mozRequestFullScreen
        || gate.msRequestFullscreen;
      if (!request) return;

      try {
        var result = request.call(gate);
        if (result && typeof result.then === 'function') {
          result.then(lockLandscapeOrientation).catch(function () {});
        } else {
          lockLandscapeOrientation();
        }
      } catch (err) { /* fullscreen nesuportat — ignorăm silențios */ }
    }

    function lockLandscapeOrientation() {
      try {
        if (screen.orientation && screen.orientation.lock) {
          screen.orientation.lock('landscape').catch(function () {});
        }
      } catch (err) { /* orientare blocată de browser — ignorăm silențios */ }
    }

    // ── La ieșirea din fullscreen, deblochează orientarea ──
    ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange'].forEach(function (evt) {
      document.addEventListener(evt, function () {
        if (!document.fullscreenElement) {
          try {
            if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock();
          } catch (err) {}
        }
      });
    });

    /** Afișează scurt o iconiță play/pauză ca feedback vizual la click */
    function flashGateIcon(gate, kind) {
      var flash = document.createElement('div');
      flash.className = 'yt-gate__flash-icon';
      flash.innerHTML = kind === 'play'
        ? '<svg width="40" height="40" viewBox="0 0 48 48"><polygon points="17,13 37,24 17,35" fill="white"/></svg>'
        : '<svg width="40" height="40" viewBox="0 0 48 48"><rect x="14" y="12" width="7" height="24" fill="white"/><rect x="27" y="12" width="7" height="24" fill="white"/></svg>';
      gate.appendChild(flash);
      window.setTimeout(function () { flash.remove(); }, 420);
    }

    /** Activează TOATE embed-urile de pe pagină */
    function activateAllGates() {
      document.querySelectorAll('.yt-gate').forEach(activateGate);
    }

    // ── La încărcarea paginii: așteaptă DOM-ul complet pentru toate embed-urile ──
    function activateGrantedGates() {
      try {
        if (localStorage.getItem('cookie_consent') === 'granted') {
          activateAllGates();
        }
      } catch (_) { /* localStorage indisponibil */ }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', activateGrantedGates, { once: true });
    } else {
      activateGrantedGates();
    }

    // ── Reacționează la acceptarea din CookieBanner ──
    window.addEventListener('cookie:granted', activateAllGates);

    // ── Butonul „Acceptă și vizionează" per video (delegare de eveniment) ──
    document.addEventListener('click', function (e) {
      var btn = (e.target).closest?.('.yt-gate__btn-accept');
      if (!btn) return;

      // Când utilizatorul pornește alt clip, oprim imediat celelalte surse.
      pauseAllExcept(null);
      pauseAllNativeMediaExcept(null);

      try { localStorage.setItem('cookie_consent', 'granted'); } catch (_) {}
      window.dispatchEvent(new CustomEvent('cookie:granted'));
    });

    document.addEventListener('click', function (e) {
      var overlay = (e.target).closest?.('.yt-gate__click-overlay');
      if (!overlay) return;

      var gate = overlay.closest('.yt-gate');
      if (!gate) return;

      toggleGatePlayback(gate);
    });

    document.addEventListener('click', function (e) {
      var fsBtn = (e.target).closest?.('.yt-gate__fullscreen-btn');
      if (!fsBtn) return;
      e.stopPropagation();

      var gate = fsBtn.closest('.yt-gate');
      if (!gate) return;

      toggleGateFullscreen(gate);
    });

    document.addEventListener('click', function (e) {
      var returnBtn = (e.target).closest?.('.yt-gate__mini-return');
      if (!returnBtn) return;

      var gate = returnBtn.closest('.yt-gate');
      if (!gate) return;

      gate.classList.remove('yt-gate--mini');
      gate.setAttribute('data-yt-out-of-view', 'false');
      syncMiniDocumentState();
      gate.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

<style>
  /* ── Wrapper ─────────────────────────────────────────────── */
  .yt-gate {
    position: relative;
    overflow: hidden;
    display: block;
    /* Asigurăm aspect-ratio 16/9 când nu e furnizat din exterior */
    aspect-ratio: 16 / 9;
    background: #0a0d1c;
  }

  /* ── Fullscreen (declanșat la click, vezi enterFullscreenAndRotate) ── */
  .yt-gate:fullscreen,
  .yt-gate:-webkit-full-screen {
    aspect-ratio: unset;
    width: 100vw;
    height: 100vh;
  }

  .yt-gate__mini-return {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 20;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    background: rgba(7, 14, 32, 0.8);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .yt-gate__mini-return:hover {
    background: rgba(9, 20, 44, 0.95);
  }

  /* ── Overlay click-to-toggle peste iframe-ul YouTube ─────── */
  .yt-gate__click-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  /* ── Buton fullscreen propriu (overlay-ul de mai sus blochează
     butonul nativ YouTube, deci oferim unul vizibil, mereu funcțional) ── */
  .yt-gate__fullscreen-btn {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(7, 14, 32, 0.72);
    color: #fff;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .yt-gate__fullscreen-btn:hover {
    opacity: 1;
    background: rgba(9, 20, 44, 0.92);
    transform: scale(1.05);
  }

  /* ── Iconiță play/pauză, flash scurt la click ────────────── */
  .yt-gate__flash-icon {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.28);
    animation: yt-gate-flash 420ms ease forwards;
  }

  @keyframes yt-gate-flash {
    0% { opacity: 0; transform: scale(0.85); }
    18% { opacity: 1; transform: scale(1); }
    75% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.05); }
  }

  .yt-gate--mini {
    position: fixed;
    right: max(0.8rem, env(safe-area-inset-right));
