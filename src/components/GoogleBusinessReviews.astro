---
type GoogleReviewItem = {
  author: string;
  context: string;
  text: string;
  sourceUrl?: string;
  profilePhotoUrl?: string;
  rating?: number;
  publishedAt?: string;
  publishedLabel?: string;
};

interface Props {
  title?: string;
  subtitle?: string;
  googleProfileUrl: string;
  googleWriteUrl: string;
  reviews: GoogleReviewItem[];
}

type GooglePlacesResponse = {
  status?: string;
  result?: {
    rating?: number;
    user_ratings_total?: number;
    reviews?: Array<{
      author_name?: string;
      author_url?: string;
      profile_photo_url?: string;
      rating?: number;
      relative_time_description?: string;
      text?: string;
      time?: number;
    }>;
  };
};

const {
  title = 'Recenzii Google Business',
  subtitle = 'Recenzii reale de la clienți care au lucrat cu noi la evenimente.',
  googleProfileUrl,
  googleWriteUrl,
  reviews,
} = Astro.props;

const fallbackReviews = Array.isArray(reviews) ? reviews : [];
let googleRating: number | undefined;
let googleRatingsTotal: number | undefined;
let apiReviews: GoogleReviewItem[] = [];

const googlePlacesApiKey = (import.meta.env.GOOGLE_PLACES_API_KEY ?? '').trim();
const googlePlaceId = (import.meta.env.GOOGLE_PLACE_ID ?? '').trim();

if (googlePlacesApiKey && googlePlaceId) {
  try {
    const params = new URLSearchParams({
      place_id: googlePlaceId,
      fields: 'reviews,rating,user_ratings_total',
      key: googlePlacesApiKey,
      reviews_sort: 'newest',
      language: 'ro',
    });
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    const response = await fetch(`https://maps.googleapis.com/maps/api/place/details/json?${params}`, {
      signal: controller.signal,
    });
    clearTimeout(timeout);

    if (response.ok) {
      const payload = await response.json() as GooglePlacesResponse;
      const result = payload.status === 'OK' ? payload.result : undefined;
      googleRating = typeof result?.rating === 'number' ? result.rating : undefined;
      googleRatingsTotal = typeof result?.user_ratings_total === 'number'
        ? result.user_ratings_total
        : undefined;
      apiReviews = (result?.reviews ?? [])
        .filter((review) => review.author_name && review.text)
        .map((review) => ({
          author: review.author_name as string,
          context: review.relative_time_description || 'Recenzie Google verificată',
          text: review.text as string,
          sourceUrl: review.author_url,
          profilePhotoUrl: review.profile_photo_url,
          rating: review.rating,
          publishedAt: typeof review.time === 'number' ? new Date(review.time * 1000).toISOString() : undefined,
          publishedLabel: typeof review.time === 'number'
            ? new Intl.DateTimeFormat('ro-RO', { dateStyle: 'medium' }).format(new Date(review.time * 1000))
            : undefined,
        }))
        .slice(0, 3);
    }
  } catch {
    // Build-ul continuă cu fallback-ul static dacă Google este indisponibil.
  }
}

const activeReviews = apiReviews.length > 0 ? apiReviews : fallbackReviews;
const usingGoogleReviews = apiReviews.length > 0;
const visibleReviews = activeReviews
  .filter((item) => item?.author && item?.text)
  .slice(0, 3);
const displayedRating = usingGoogleReviews ? googleRating : undefined;
const reviewSchema = usingGoogleReviews ? visibleReviews.map((review) => ({
  '@type': 'Review',
  author: { '@type': 'Person', name: review.author },
  reviewBody: review.text,
  ...(review.publishedAt ? { datePublished: review.publishedAt } : {}),
  ...(review.rating ? { reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 } } : {}),
})) : [];
const displayTitle = usingGoogleReviews ? title : 'Testimoniale de la clienți';
const displaySubtitle = usingGoogleReviews
  ? subtitle
  : 'Recenziile Google sunt temporar indisponibile la build; afișăm separat testimoniale publicate pe site, fără să le prezentăm ca recenzii Google.';
const reviewsSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Formația Florentina Pană',
  ...(displayedRating && googleRatingsTotal
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: displayedRating.toFixed(1), bestRating: 5, ratingCount: googleRatingsTotal } }
    : {}),
  ...(reviewSchema.length > 0 ? { review: reviewSchema } : {}),
};
---

<section class="gb-reviews" aria-label={usingGoogleReviews ? 'Recenzii Google Business' : 'Testimoniale publicate pe site'}>
  <div class="gb-reviews__head">
    <p class="gb-reviews__kicker">{usingGoogleReviews ? 'Încredere verificabilă' : 'Fallback transparent'}</p>
    <h2>{displayTitle}</h2>
    <p>{displaySubtitle}</p>
  </div>

  {visibleReviews.length > 0 ? (
    <div class="gb-reviews__grid">
      {visibleReviews.map((review) => (
        <article class="gb-reviews__card">
          {review.profilePhotoUrl && <img class="gb-reviews__avatar" src={review.profilePhotoUrl} alt={`Fotografie profil ${review.author}`} loading="lazy" width="40" height="40" />}
          {usingGoogleReviews ? (
            <div class="gb-reviews__stars" aria-label={`${review.rating ?? 5} stele din 5`}>{'★'.repeat(Math.max(1, Math.min(5, Math.round(review.rating ?? 5))))}</div>
          ) : (
            <div class="gb-reviews__fallback-label">Testimonial public pe site</div>
          )}
          <blockquote>
            <p>„{review.text}”</p>
          </blockquote>
          <footer>
            <strong>{review.author}</strong>
            <span>{review.context}</span>
            {review.publishedLabel && <span>{review.publishedLabel}</span>}
            {review.sourceUrl && (
              <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`Vezi recenzia Google de la ${review.author}`}>Vezi recenzia pe Google</a>
            )}
          </footer>
        </article>
      ))}
    </div>
  ) : (
    <p class="gb-reviews__empty">Recenziile Google vor apărea aici imediat ce sunt publicate sau sincronizate.</p>
  )}

  {displayedRating && (
    <div class="gb-reviews__rating" aria-label={`Evaluare Google de ${displayedRating.toFixed(1)} stele din 5`}>
    <span class="gb-reviews__rating-stars" aria-hidden="true">★★★★★</span>
      <span class="gb-reviews__rating-label">{displayedRating.toFixed(1)} / 5{googleRatingsTotal ? ` • ${googleRatingsTotal} evaluări` : ''}</span>
    </div>
  )}

  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />

  <div class="gb-reviews__actions">
    <a href={googleWriteUrl} target="_blank" rel="noopener noreferrer" class="gb-reviews__btn gb-reviews__btn--primary gb-reviews__btn--pulse">
      <span class="gb-reviews__btn-stars" aria-hidden="true">★★★★★</span>
      Lasă o recenzie în 10 secunde
    </a>
    <a href={googleProfileUrl} target="_blank" rel="noopener noreferrer" class="gb-reviews__btn gb-reviews__btn--ghost">Vezi toate recenziile pe Google</a>
  </div>
</section>

<style>
  .gb-reviews {
    margin: 0 auto 2rem;
    padding: 1.15rem 1rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.05rem;
    background: linear-gradient(160deg, rgba(9, 20, 40, 0.86), rgba(8, 16, 32, 0.72));
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
  }

  .gb-reviews__head {
    margin-bottom: 0.9rem;
  }

  .gb-reviews__kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 224, 154, 0.92);
    font-weight: 700;
  }

  .gb-reviews__head h2 {
    margin: 0.35rem 0 0.35rem;
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    color: #ffffff;
  }

  .gb-reviews__head p {
    margin: 0;
    color: rgba(236, 245, 255, 0.88);
    line-height: 1.62;
  }

  .gb-reviews__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .gb-reviews__card {
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.9rem;
    padding: 0.75rem 0.78rem;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.03));
  }

  .gb-reviews__stars {
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    color: #ffd36f;
    margin-bottom: 0.35rem;
  }

  .gb-reviews__fallback-label {
    margin-bottom: 0.35rem;
    color: rgba(192, 222, 255, 0.9);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gb-reviews__avatar {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.45rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .gb-reviews__card blockquote {
    margin: 0 0 0.62rem;
  }

  .gb-reviews__card blockquote p {
    margin: 0;
    color: rgba(246, 250, 255, 0.96);
    line-height: 1.58;
    font-size: 0.95rem;
  }

  .gb-reviews__card footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .gb-reviews__card strong {
    color: #ffffff;
    font-size: 0.92rem;
  }

  .gb-reviews__card span {
    color: rgba(192, 222, 255, 0.9);
    font-size: 0.8rem;
  }

  .gb-reviews__card a {
    color: #ffd989;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-top: 0.1rem;
  }

  .gb-reviews__empty {
    margin: 0;
    color: rgba(233, 246, 255, 0.88);
    line-height: 1.56;
    padding: 0.5rem 0;
  }

  .gb-reviews__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    margin-top: 0.85rem;
    padding: 0.42rem 0.7rem;
    border: 1px solid rgba(255, 211, 111, 0.2);
    border-radius: 999px;
    background: rgba(255, 211, 111, 0.07);
  }

  .gb-reviews__rating-stars {
    color: #ffd36f;
    font-size: 1.1rem;
    letter-spacing: 0.13em;
    line-height: 1;
    text-shadow: 0 0 12px rgba(255, 211, 111, 0.42);
  }

  .gb-reviews__rating-label {
    color: rgba(255, 239, 193, 0.92);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .gb-reviews__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .gb-reviews__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem 1.05rem;
    border-radius: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.92rem;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .gb-reviews__btn:hover,
  .gb-reviews__btn:focus-visible {
    transform: translateY(-2px) scale(1.02);
  }

  .gb-reviews__btn-stars {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: #1f1200;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .gb-reviews__btn--primary {
    color: #1f1200;
    background: linear-gradient(135deg, #ffe08a, #ffd36f, #f5a623);
    box-shadow: 0 10px 26px rgba(245, 166, 35, 0.4);
  }

  .gb-reviews__btn--pulse {
    animation: gb-reviews-pulse 2.4s ease-in-out infinite;
  }

  .gb-reviews__btn--pulse:hover,
  .gb-reviews__btn--pulse:focus-visible {
    animation-play-state: paused;
  }

  @keyframes gb-reviews-pulse {
    0%, 100% { box-shadow: 0 10px 26px rgba(245, 166, 35, 0.4), 0 0 0 0 rgba(255, 211, 111, 0.5); }
    50% { box-shadow: 0 10px 26px rgba(245, 166, 35, 0.4), 0 0 0 9px rgba(255, 211, 111, 0); }
  }

  .gb-reviews__btn--ghost {
    color: #f6fbff;
    border: 1px solid rgba(203, 233, 255, 0.38);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .gb-reviews__btn--pulse {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .gb-reviews {
      padding: 1rem 0.85rem;
      border-radius: 0.95rem;
    }

    .gb-reviews__head p {
      font-size: 0.94rem;
    }

    .gb-reviews__rating {
      max-width: 100%;
    }

    .gb-reviews__rating-label {
      font-size: 0.73rem;
    }
  }
</style>