---
/**
 * Poster-first: imaginea statică este elementul LCP, video-ul se încarcă abia
 * după `load`, doar pe desktop, fără saveData și fără prefers-reduced-motion.
 */
interface Props {
  /** Implicit sursa R2 cu custom domain (cache CDN). Nu folosi MP4 local. */
  videoUrl?: string;
  /** Copie servită din `public/`, folosită dacă obiectul R2 lipsește (404). */
  fallbackVideoUrl?: string;
  title: string;
  subtitle: string;
  showReviews?: boolean;
  posterImage?: string;
  /** Variantă servită sub breakpoint-ul mobil. Preload-urile din pagină
      folosesc aceleași media queries, ca LCP-ul să se descarce o singură dată. */
  posterImageMobile?: string;
  posterAlt?: string;
  posterWidth?: number;
  posterHeight?: number;
  /** h1 implicit; h2 când pagina are deja un H1 propriu; p când H1-ul paginii
      apare mai jos în DOM (păstrează ierarhia headings corectă, stil identic). */
  titleTag?: 'h1' | 'h2' | 'p';
}

const R2_HERO_VIDEO = 'https://media.florentinapanaofficial.ro/bg-nunta-live-2027.mp4';
const LOCAL_HERO_VIDEO = '/videos/bg-nunta-live-2027.mp4';

const {
  videoUrl = R2_HERO_VIDEO,
  fallbackVideoUrl = LOCAL_HERO_VIDEO,
  title,
  subtitle,
  showReviews = false,
  posterImage,
  posterImageMobile,
  posterAlt = 'Formația Florentina Pană cântând live pe scenă la o nuntă',
  posterWidth,
  posterHeight,
  titleTag = 'h1',
} = Astro.props;
const TitleTag = titleTag;
const POSTER_MOBILE_MEDIA = '(max-width: 767px)';
---

<section
  class="hero-video relative w-full min-h-[80vh] md:min-h-screen flex items-center justify-center overflow-hidden"
  data-hero-video
>
  {/* `contents` scoate <picture> din fluxul flex; <img> rămâne absolut poziționat față de secțiune. */}
  {posterImage && (
    <picture class="contents">
      {posterImageMobile && <source media={POSTER_MOBILE_MEDIA} srcset={posterImageMobile} type="image/webp" />}
      <img
        src={posterImage}
        alt={posterAlt}
        width={posterWidth}
        height={posterHeight}
        fetchpriority="high"
        decoding="sync"
        loading="eager"
        data-hero-poster
        class="hero-video__poster absolute inset-0 z-0 h-full w-full object-cover"
      />
    </picture>
  )}

  <video
    data-hero-media
    data-src={videoUrl}
    data-fallback-src={fallbackVideoUrl}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    class="hero-video__media absolute inset-0 z-0 h-full w-full object-cover"
  ></video>

  <div class="absolute inset-0 bg-black/50 bg-gradient-to-t from-[#0a0f1a] to-transparent z-10" aria-hidden="true"></div>

  <div class="relative z-20 text-center px-4 max-w-4xl mx-auto flex flex-col items-center gap-6">
    {showReviews && (
      <a
        href="/momente-cu-mirii/"
        class="inline-flex items-center gap-2 rounded-full border border-amber-300/40 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur-sm transition hover:bg-white/20"
      >
        <span class="text-amber-300" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span>Citiți recenziile clienților</span>
      </a>
    )}

    <TitleTag class="text-4xl md:text-6xl font-bold text-white drop-shadow-lg">{title}</TitleTag>
    <p class="text-lg md:text-2xl text-amber-100/90">{subtitle}</p>

    <slot />
  </div>
</section>

<style>
  /* Doar opacity/transform: schimbarea de strat nu produce reflow, deci CLS = 0. */
  .hero-video__media {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero-video[data-hero-state='playing'] .hero-video__media {
    opacity: 1;
  }

  .hero-video__poster {
    opacity: 1;
    transition: opacity 600ms ease;
  }

  .hero-video[data-hero-state='playing'] .hero-video__poster {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video__media,
    .hero-video__poster {
      transition: none;
    }
  }
</style>

<script>
  const heroes = document.querySelectorAll<HTMLElement>('[data-hero-video]');
  if (heroes.length > 0) {
    const canPlayBackground = () => {
      if (!window.matchMedia('(min-width: 768px)').matches) return false;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
      const connection = (navigator as any).connection;
      if (connection?.saveData) return false;
      return true;
    };

    const activate = (hero: HTMLElement) => {
      const video = hero.querySelector<HTMLVideoElement>('[data-hero-media]');
      const primary = video?.dataset.src;
      if (!video || !primary || video.dataset.loaded === 'true') return;

      const fallback = video.dataset.fallbackSrc;
      let attempt = 0;
      let triedFallback = false;

      video.dataset.loaded = 'true';
      video.addEventListener(
        'playing',
        () => {
          hero.dataset.heroState = 'playing';
        },
        { once: true },
      );

      function giveUp() {
        video!.removeEventListener('error', onFailure);
        video!.removeAttribute('src');
        video!.load();
        delete video!.dataset.loaded;
      }

      // Sursa de pe CDN poate lipsi (404) fără ca posterul să semnaleze ceva:
      // încercăm copia locală înainte de a abandona redarea.
      function onFailure() {
        if (hero.dataset.heroState === 'playing') return;
        if (!triedFallback && fallback && fallback !== primary) {
          triedFallback = true;
          start(fallback);
          return;
        }
        giveUp();
      }

      function start(src: string) {
        const current = ++attempt;
        video!.src = src;
        video!.load();
        // Ignorăm respingerile sursei abandonate la schimbarea de `src`.
        video!.play().catch(() => {
          if (current === attempt) onFailure();
        });
      }

      video.addEventListener('error', onFailure);
      start(primary);
    };

    const start = () => {
      if (!canPlayBackground()) return;
      heroes.forEach(activate);
    };

    // Amânăm după `load` + idle: video-ul nu concurează cu posterul LCP.
    const schedule = () => {
      const idle = (window as any).requestIdleCallback;
      if (typeof idle === 'function') {
        idle(start, { timeout: 3000 });
      } else {
        window.setTimeout(start, 1200);
      }
    };

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  }
</script>
