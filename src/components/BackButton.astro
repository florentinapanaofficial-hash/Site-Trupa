---
interface Props {
  href?: string;
  label?: string;
}

const { href = '/', label = 'Înapoi' } = Astro.props;
---

<a href={href} class="back-btn" aria-label={`Înapoi — ${label}`} data-back-href={href}>
  <svg class="back-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5M12 5l-7 7 7 7"/>
  </svg>
  <span class="back-label">{label}</span>
</a>

<style>
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem 0.45rem 0.65rem;
    border-radius: 9999px;
    border: 1.5px solid rgba(120, 200, 255, 0.35);
    background: rgba(80, 180, 255, 0.07);
    text-decoration: none;
    color: rgba(180, 225, 255, 0.92);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 220ms ease, border-color 220ms ease, box-shadow 220ms ease, color 220ms ease;
  }

  .back-btn:hover,
  .back-btn:active {
    background: rgba(100, 200, 255, 0.15);
    border-color: rgba(160, 220, 255, 0.65);
    box-shadow: 0 0 14px rgba(100, 200, 255, 0.3);
    color: #fff;
  }

  .back-btn:active {
    transform: scale(0.96);
  }

  .back-arrow {
    flex-shrink: 0;
    color: rgba(160, 220, 255, 0.85);
    transition: transform 200ms ease;
  }

  .back-btn:hover .back-arrow {
    transform: translateX(-3px);
  }

  .back-label {
    white-space: nowrap;
  }
</style>

<script>
  document.addEventListener('click', function (e) {
    var btn = (e.target as HTMLElement).closest?.('.back-btn');
    if (!btn) return;
    var fallback = btn.getAttribute('data-back-href') || '/';
    // Only use history.back() if we have real in-site history
    if (document.referrer && document.referrer.includes(location.hostname) && history.length > 1) {
      e.preventDefault();
      history.back();
    }
    // Otherwise follow the href naturally (fallback link)
  });
</script>
