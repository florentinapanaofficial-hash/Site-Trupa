---
interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  nume: string;
  rol: string;
  imagine: string;
  bio: string;
  specialitate?: string;
  socialLinks?: SocialLink[];
  class?: string;
}

const {
  nume,
  rol,
  imagine,
  bio,
  specialitate,
  socialLinks = [],
  class: className = '',
} = Astro.props;

/** id unic — permite mai multe instanțe MembruCard pe aceeași pagină fără coliziuni ARIA */
const uid = `mc-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['membru-card-3d group relative w-full max-w-xs mx-auto [perspective:1200px]', className]}
  data-tilt-wrap
>
  <div
    class="relative w-full aspect-[3/4] [transform-style:preserve-3d] transition-transform duration-200 ease-out will-change-transform"
    data-tilt-target
  >
    <div
      class="absolute inset-0 [transform-style:preserve-3d] transition-transform duration-700"
      style="transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);"
      data-flip-inner
    >
      <!-- ═══ FRONT FACE ═══ -->
      <div
        class="absolute inset-0 rounded-2xl [backface-visibility:hidden] [transform-style:preserve-3d]"
        data-face="front"
      >
        <!-- Layer 1 — Card Body (Z = 20px) -->
        <div
          class="absolute inset-0 rounded-2xl border border-yellow-500/50 bg-gradient-to-br from-[#0a1230] via-[#0c1740] to-[#050813] backdrop-blur-md shadow-[0_25px_60px_-20px_rgba(0,0,0,0.7)] [transform:translateZ(20px)]"
          aria-hidden="true"
        ></div>

        <!-- Glare — specular highlight, urmărește cursorul -->
        <div
          class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-200 [transform:translateZ(21px)]"
          data-glare
          aria-hidden="true"
        ></div>

        <!-- Layer 2 — Portret (Z = 45px) -->
        <div
          class="absolute left-4 right-4 top-4 h-[58%] overflow-hidden rounded-xl ring-1 ring-yellow-500/25 [transform:translateZ(45px)]"
        >
          <img
            src={imagine}
            alt={`${nume} — ${rol}, Formația Florentina Pană`}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="480"
            height="600"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050813]/70 via-transparent to-transparent" aria-hidden="true"></div>
        </div>

        <!-- Layer 3 — Nume + buton BIO (Z = 65px) -->
        <div
          class="absolute inset-x-0 bottom-0 flex flex-col items-center gap-2 p-4 text-center [transform:translateZ(65px)]"
        >
          <h3 class="font-display text-lg font-bold leading-tight text-yellow-400 drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]">
            {nume}
          </h3>
          <p class="text-xs uppercase tracking-[0.15em] text-white/70">{rol}</p>
          <button
            type="button"
            class="mt-1 rounded-full border border-yellow-500/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-yellow-400 transition-colors duration-200 hover:bg-yellow-500 hover:text-[#0a1230] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400"
            data-flip-btn
            aria-expanded="false"
            aria-controls={`${uid}-back`}
          >
            Bio
          </button>
        </div>
      </div>

      <!-- ═══ BACK FACE ═══ -->
      <div
        id={`${uid}-back`}
        class="absolute inset-0 flex flex-col rounded-2xl border border-yellow-500/50 bg-gradient-to-br from-[#0a1230] via-[#0c1740] to-[#050813] p-5 backdrop-blur-md [backface-visibility:hidden] [transform:rotateY(180deg)_translateZ(20px)]"
        data-face="back"
      >
        <h3 class="font-display text-base font-bold text-yellow-400">{nume}</h3>
        <p class="mb-2 text-[0.7rem] uppercase tracking-[0.15em] text-white/60">{rol}</p>
        {specialitate && (
          <p class="mb-2 text-xs italic text-yellow-200/80">{specialitate}</p>
        )}
        <p class="flex-1 overflow-y-auto text-sm leading-relaxed text-white/85">{bio}</p>

        {socialLinks.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-yellow-500/40 px-3 py-1 text-[0.7rem] font-medium text-yellow-300/90 transition-colors hover:bg-yellow-500/20"
              >
                {s.label}
              </a>
            ))}
          </div>
        )}

        <button
          type="button"
          class="mt-3 self-center rounded-full border border-yellow-500/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-yellow-400 transition-colors duration-200 hover:bg-yellow-500 hover:text-[#0a1230] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400"
          data-flip-btn
          aria-expanded="true"
          aria-controls={`${uid}-back`}
        >
          Înapoi
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Fizica 3D pentru MembruCard: tilt (pitch/yaw) pe mousemove, glare dinamic
   * și flip 3D pe click. Rulează pentru toate instanțele `[data-tilt-wrap]`
   * de pe pagină, inclusiv după navigări Astro View Transitions.
   */
  const MAX_TILT_DEG = 15;
  const BOUND_ATTR = 'data-tilt-bound';

  interface TiltRefs {
    wrap: HTMLElement;
    target: HTMLElement;
    glare: HTMLElement | null;
    flipInner: HTMLElement | null;
    flipBtns: HTMLButtonElement[];
    flipped: boolean;
  }

  function clamp(value: number, min: number, max: number): number {
    return Math.max(min, Math.min(max, value));
  }

  function handleMove(refs: TiltRefs, event: MouseEvent): void {
    const rect = refs.wrap.getBoundingClientRect();
    const relX = event.clientX - rect.left;
    const relY = event.clientY - rect.top;

    // percent: -0.5 .. 0.5 față de centrul cardului
    const percentX = clamp(relX / rect.width - 0.5, -0.5, 0.5);
    const percentY = clamp(relY / rect.height - 0.5, -0.5, 0.5);

    const rotateY = percentX * (MAX_TILT_DEG * 2); // yaw
    const rotateX = -percentY * (MAX_TILT_DEG * 2); // pitch

    // zero-latency tracking: fără tranziție în timpul mousemove
    refs.target.style.transitionDuration = '0ms';
    refs.target.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;

    if (refs.glare) {
      const bearingDeg = Math.atan2(percentY, percentX) * (180 / Math.PI);
      const glareAngle = bearingDeg + 180 + 45; // highlight opus cursorului, la 45°
      const magnitude = Math.min(Math.hypot(percentX, percentY) * 1.6, 1);
      refs.glare.style.background = `linear-gradient(${glareAngle}deg, rgba(255,255,255,${(0.4 * magnitude).toFixed(3)}) 0%, rgba(255,255,255,0) 60%)`;
      refs.glare.style.opacity = magnitude.toFixed(3);
    }
  }

  function resetTilt(refs: TiltRefs): void {
    refs.target.style.transitionDuration = '';
    refs.target.style.transform = 'rotateX(0deg) rotateY(0deg)';
    if (refs.glare) {
      refs.glare.style.opacity = '0';
    }
  }

  function toggleFlip(refs: TiltRefs): void {
    refs.flipped = !refs.flipped;
    if (refs.flipInner) {
      refs.flipInner.style.transform = refs.flipped ? 'rotateY(180deg)' : 'rotateY(0deg)';
    }
    refs.flipBtns.forEach((btn) => btn.setAttribute('aria-expanded', String(refs.flipped)));
  }

  function initCard(wrap: HTMLElement): void {
    if (wrap.hasAttribute(BOUND_ATTR)) return;
    wrap.setAttribute(BOUND_ATTR, 'true');

    const target = wrap.querySelector<HTMLElement>('[data-tilt-target]');
    if (!target) return;

    const refs: TiltRefs = {
      wrap,
      target,
      glare: wrap.querySelector<HTMLElement>('[data-glare]'),
      flipInner: wrap.querySelector<HTMLElement>('[data-flip-inner]'),
      flipBtns: Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-flip-btn]')),
      flipped: false,
    };

    wrap.addEventListener('mousemove', (e) => handleMove(refs, e));
    wrap.addEventListener('mouseleave', () => resetTilt(refs));
    wrap.addEventListener('mouseenter', () => {
      target.style.transitionDuration = '';
    });

    refs.flipBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFlip(refs);
      });
    });
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>('[data-tilt-wrap]').forEach(initCard);
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
