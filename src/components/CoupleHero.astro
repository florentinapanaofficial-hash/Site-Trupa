---
interface Props {
  names: string;
  city: string;
  date: string;
  locationName: string;
  coverPhoto: string;
  accentColor: string;
  accentGlow: string;
}

const { names, city, date, locationName, coverPhoto, accentColor, accentGlow } = Astro.props;

const initials = names
  .split('&')
  .map((n) => n.trim().charAt(0).toUpperCase())
  .join(' & ');
---

<section class="couple-hero" style={`--hero-accent: ${accentColor}; --hero-glow: ${accentGlow};`}>
  <div class="couple-hero__bg" aria-hidden="true"></div>
  <div class="couple-hero__content">
    <nav class="couple-hero__breadcrumb" aria-label="Navigare">
      <a href="/">Acasă</a>
      <span aria-hidden="true">›</span>
      <a href="/comunitate/">Comunitate</a>
      <span aria-hidden="true">›</span>
      <span>{names}</span>
    </nav>

    <div class="couple-hero__avatar">
      {coverPhoto ? (
        <img src={coverPhoto} alt={`${names}`} width="160" height="160" />
      ) : (
        <div class="couple-hero__initials">{initials}</div>
      )}
    </div>

    <h1 class="couple-hero__title">{names}</h1>
    <p class="couple-hero__badge">Poveste reală • Nuntă {date}</p>
    <p class="couple-hero__meta">
      <span>📍 {city}</span>
      <span>📅 {date}</span>
      {locationName && <span>🏛️ {locationName}</span>}
    </p>
  </div>
</section>

<style>
  .couple-hero {
    position: relative;
    padding: 4rem 1.5rem 3rem;
    text-align: center;
    overflow: hidden;
  }

  .couple-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center top, var(--hero-glow), transparent 70%);
    pointer-events: none;
  }

  .couple-hero__content {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
  }

  .couple-hero__breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.5);
    flex-wrap: wrap;
  }

  .couple-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .couple-hero__breadcrumb a:hover {
    color: var(--hero-accent);
  }

  .couple-hero__breadcrumb span:last-child {
    color: var(--hero-accent);
    font-weight: 600;
  }

  .couple-hero__avatar {
    width: 140px;
    height: 140px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--hero-accent);
    box-shadow: 0 0 30px var(--hero-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
  }

  .couple-hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .couple-hero__initials {
    font-family: 'Oswald', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--hero-accent);
    letter-spacing: 0.05em;
  }

  .couple-hero__title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.05rem, 5.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.05;
    color: transparent;
    background: linear-gradient(180deg, #fff7d6 0%, #ffe79a 38%, #e7c66f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0.5px rgba(19, 30, 62, 0.45);
    margin: 0 0 1rem;
    text-shadow:
      0 0 12px color-mix(in srgb, var(--hero-glow) 72%, transparent),
      0 3px 10px rgba(0, 0, 0, 0.32);
    position: relative;
    display: inline-block;
    padding: 0 0.3rem 0.2rem;
  }

  .couple-hero__title::after {
    content: '';
    display: block;
    width: min(190px, 72%);
    height: 2px;
    margin: 0.45rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--hero-accent) 62%, #ffe49e), transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--hero-glow) 56%, transparent);
  }

  .couple-hero__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    flex-wrap: wrap;
  }

  .couple-hero__badge {
    margin: 0 auto 0.85rem;
    width: fit-content;
    max-width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.38rem 0.78rem;
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(247, 235, 197, 0.96);
    background: linear-gradient(135deg, rgba(14, 24, 52, 0.75), rgba(18, 30, 62, 0.72));
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
  }

  @media (max-width: 767px) {
    .couple-hero {
      padding: 3rem 1rem 2rem;
    }

    .couple-hero__avatar {
      width: 110px;
      height: 110px;
    }

    .couple-hero__meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .couple-hero__badge {
      font-size: 0.7rem;
      padding: 0.34rem 0.68rem;
    }

    .couple-hero__title {
      letter-spacing: 0.015em;
      padding-inline: 0.15rem;
    }
  }
</style>
