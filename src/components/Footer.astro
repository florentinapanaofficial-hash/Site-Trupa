---
import siteContent from '../data/siteContent.json';
import { sanitizeUrl } from '../lib/sanitize-url';
import ZoneAcoperite from './ZoneAcoperite.astro';

const year = new Date().getFullYear();
const { brand, contact } = siteContent;
const socialLinks = {
  youtube: siteContent.socialLinks?.youtube ? sanitizeUrl(siteContent.socialLinks.youtube) : null,
  facebook: siteContent.socialLinks?.facebook ? sanitizeUrl(siteContent.socialLinks.facebook) : null,
  instagram: siteContent.socialLinks?.instagram ? sanitizeUrl(siteContent.socialLinks.instagram) : null,
  tiktok: siteContent.socialLinks?.tiktok ? sanitizeUrl(siteContent.socialLinks.tiktok) : null,
};
const isHomePage = Astro.url.pathname === '/';
---

<footer class={`border-t border-white/10 bg-[#0C080F] text-white/90 ${isHomePage ? '' : 'footer--accordion'}`}>
  <!-- Navigare site — rezolvă pagini orfane -->
  <div class={`ftr-section ${isHomePage ? '' : 'ftr-section--collapsed'}`} data-ftr-section>
    <button class="ftr-tab" type="button" data-ftr-toggle aria-expanded={isHomePage ? 'true' : 'false'}>
      <span class="ftr-tab-icon">🗺️</span>
      <span class="ftr-tab-text">Hartă site</span>
      <svg class="ftr-tab-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="ftr-content" data-ftr-content>
      <nav class="section-container py-3" aria-label="Hartă site">
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-white/80">
          <a href="/despre/" class="ftr-map-link">Despre noi</a>
          <a href="/membri/" class="ftr-map-link">Membri</a>
          <a href="/galerie-video/" class="ftr-map-link">Galerie Video</a>
          <a href="/galerie-foto/" class="ftr-map-link">Galerie Foto</a>
          <a href="/blog/" class="ftr-map-link">Blog</a>
          <a href="/aparitii-tv/" class="ftr-map-link">Apariții TV</a>
          <a href="/comunitate/" class="ftr-map-link">Comunitate</a>
          <a href="/momente-cu-mirii/" class="ftr-map-link">Momente cu mirii</a>
          <a href="/publicatii/" class="ftr-map-link">Publicații</a>
          <a href="/oferta-premium/" class="ftr-map-link">Ofertă Premium</a>
          <a href="/contact/" class="ftr-map-link">Contact</a>
          <a href="/colaboratori/saxofon/" class="ftr-map-link">Saxofonist</a>
          <a href="/colaboratori/tambal/" class="ftr-map-link">Țambalist</a>
        </div>
      </nav>

      <!-- Ghid evenimente — internal linking SEO -->
      <nav class="section-container pb-2" aria-label="Ghid evenimente">
        <p class="text-center text-xs text-white/70">
          Ghid Evenimente:
          <a href="/publicatii/?cat=locatii" class="transition hover:text-[#F5A623] text-white/80">Locații de Poveste</a>
          <span aria-hidden="true" class="text-white/40"> | </span>
          <a href="/publicatii/?cat=sfaturi" class="transition hover:text-[#F5A623] text-white/80">Sfaturi Miri</a>
          <span aria-hidden="true" class="text-white/40"> | </span>
          <a href="/publicatii/?cat=jurnal" class="transition hover:text-[#F5A623] text-white/80">Jurnal FP Band</a>
        </p>
      </nav>
    </div>
  </div>

  <!-- Date legale firmă + ANPC -->
  <div class={`ftr-section ${isHomePage ? '' : 'ftr-section--collapsed'}`} data-ftr-section>
    <button class="ftr-tab" type="button" data-ftr-toggle aria-expanded={isHomePage ? 'true' : 'false'}>
      <span class="ftr-tab-icon">⚖️</span>
      <span class="ftr-tab-text">Date firmă &amp; ANPC</span>
      <svg class="ftr-tab-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="ftr-content" data-ftr-content>
      <address class="section-container py-3 text-xs text-white/60 leading-relaxed not-italic">
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-center">
          <span>Pană Claudiu-Gheorghe Întreprindere Individuală</span>
          <span aria-hidden="true">·</span>
          <span>CUI: 34528125</span>
          <span aria-hidden="true">·</span>
          <span>Nr. Reg. Com.: F3/581/2015</span>
          <span aria-hidden="true">·</span>
          <span>Sediu: Calea Craiovei nr. 152, Bl. TG1, Sc. B, Et. 6, Ap. 24, Pitești, jud. Argeș, România</span>
          <span aria-hidden="true">·</span>
          <span>Email: <span class="ob-email" data-u="contact" data-d="florentinapanaofficial.ro">[email protejat]</span></span>
          <span aria-hidden="true">·</span>
          <span>Tel: <a href="tel:+40767369658" class="transition hover:text-white/80 underline">0767 369 658</a></span>
        </div>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-center">
          <a href="https://anpc.ro/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition hover:text-white/80 underline">
            <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/></svg>
            ANPC — Protecția Consumatorilor
          </a>
          <span aria-hidden="true">·</span>
          <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="transition hover:text-white/80 underline">
            SAL / ODR — Soluționarea Online a Litigiilor
          </a>
          <span aria-hidden="true">·</span>
          <span>Entitate SAL: <a href="https://anpc.ro/categorie/sal/" target="_blank" rel="noopener noreferrer" class="transition hover:text-white/80 underline">Lista entități SAL — ANPC</a></span>
        </div>
      </address>
    </div>
  </div>

  <!-- Zone acoperite — internal linking automat -->
  <ZoneAcoperite />

  <div class="section-container grid gap-4 py-4 sm:gap-5 md:gap-4 text-sm md:grid-cols-3 md:items-center md:text-sm sm:text-xs">
    {/* Coloana 1: Logo + copyright */}
    <div class="flex flex-col items-start gap-2 sm:items-start md:items-start">
      <img
        src="/images/sigla-fp-band.webp"
        alt="Sigla Formația Florentina Pană (FP Band)"
        class="h-10 w-auto max-w-[96px] rounded-lg object-contain"
        loading="lazy"
        decoding="async"
        width="180"
        height="97"
      />
      <p class="text-xs sm:text-sm text-white/60">© {year} {brand.name}. Toate drepturile rezervate.</p>
    </div>

    {/* Coloana 2: Butoane sociale + link "Înapoi sus" */}
    <div class="flex flex-col items-center gap-2 md:items-center">
      <a href={isHomePage ? '#acasa' : '/#acasa'} class="text-xs sm:text-sm transition hover:text-[#F5A623] text-white/80 underline">
        ↑ Înapoi sus
      </a>
      <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
        {socialLinks.youtube && (
        <a href={socialLinks.youtube}
          class="social-btn social-btn--yt h-9 w-9 sm:h-10 sm:w-10"
          target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" aria-hidden="true">
            <rect x="2" y="6" width="20" height="13" rx="4" fill="#fff"/>
            <polygon points="9.5,9.5 9.5,15.5 16.5,12.5" fill="#FF0000"/>
          </svg>
          <span class="sr-only">YouTube Formația Florentina Pană</span>
        </a>
        )}
        {socialLinks.facebook && (
        <a href={socialLinks.facebook}
          class="social-btn social-btn--fb h-9 w-9 sm:h-10 sm:w-10"
          target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" aria-hidden="true">
            <path d="M13.5 21V14.3H16l.4-2.85H13.5V9.7c0-.82.38-1.2 1.38-1.2H16.5V5.85C16.05 5.77 15.1 5.7 14 5.7c-2.65 0-4.05 1.4-4.05 4.15v1.6H8v2.85h1.95V21H13.5z" fill="#fff"/>
          </svg>
          <span class="sr-only">Facebook Formația Florentina Pană</span>
        </a>
        )}
        {socialLinks.instagram && (
        <a href={socialLinks.instagram}
          class="social-btn social-btn--ig h-9 w-9 sm:h-10 sm:w-10"
          target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="#fff" stroke-width="2.1"/>
            <circle cx="12" cy="12" r="4.2" stroke="#fff" stroke-width="2"/>
            <circle cx="17.2" cy="6.8" r="1.1" fill="#fff"/>
          </svg>
          <span class="sr-only">Instagram Formația Florentina Pană</span>
        </a>
        )}
        {socialLinks.tiktok && (
        <a href={socialLinks.tiktok}
          class="social-btn social-btn--tt h-9 w-9 sm:h-10 sm:w-10"
          target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" aria-hidden="true">
            <path d="M16.5 3h-2.8v11.8a2.7 2.7 0 1 1-2.7-2.7c.25 0 .49.03.72.09V9.3a5.5 5.5 0 1 0 4.78 5.5V8.5a7.9 7.9 0 0 0 4.6 1.47V7.18A4.62 4.62 0 0 1 16.5 3z" fill="#fff"/>
          </svg>
          <span class="sr-only">TikTok Formația Florentina Pană</span>
        </a>
        )}
      </div>
    </div>

    {/* Coloana 3: Email + telefon + linkuri legale */}
    <div class="justify-self-center md:justify-self-end text-center md:text-right text-xs sm:text-sm">
      <div class="flex flex-col items-center md:items-end gap-1">
        <span id="footer-email-js" class="transition hover:text-[#F5A623] text-white/80"></span>
        <span aria-hidden="true" class="text-white/40"> | </span>
        <a href={`tel:${contact.phoneRaw}`} class="transition hover:text-[#F5A623] text-white/80">{contact.phoneDisplay}</a>
      </div>
      <div class="mt-2 flex flex-wrap justify-center md:justify-end gap-x-2 md:gap-x-3 gap-y-1 text-xs" style="color:rgba(255,255,255,0.6);">
        <a href="/politica-confidentialitate/" class="transition hover:text-white/90 text-white/70">Confidențialitate</a>
        <span aria-hidden="true" class="text-white/40">·</span>
        <a href="/politica-cookie/" class="transition hover:text-white/90 text-white/70">Cookie</a>
        <span aria-hidden="true" class="text-white/40">·</span>
        <a href="/termeni-conditii/" class="transition hover:text-white/90 text-white/70">Termeni</a>
        <span aria-hidden="true" class="text-white/40">·</span>
        <button
          id="cookie-prefs-btn"
          type="button"
          class="transition hover:text-white/90 text-white/70 cursor-pointer"
          style="background:none;border:0;padding:0;font-size:inherit;color:inherit;"
          aria-label="Gestionează preferințele de cookie-uri"
        >Preferințe</button>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.getElementById('cookie-prefs-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      try { localStorage.removeItem('cookie_consent'); } catch (_) {}
      var banner = document.getElementById('cookie-banner');
      if (banner) {
        banner.hidden = false;
        banner.removeAttribute('hidden');
        banner.removeAttribute('aria-hidden');
      }
    });
  })();
</script>

<script is:inline>
  (function () {
    var el = document.getElementById('footer-email-js');
    if (!el) return;
    var u = 'contact';
    var d = 'florentinapanaofficial.ro';
    var addr = u + '@' + d;
    el.innerHTML = '<a href="mai' + 'lto:' + addr + '" class="transition hover:text-[#F5A623]">' + addr + '</a>';
  })();
  // Obfuscare email în secțiunea address (date legale)
  (function () {
    document.querySelectorAll('.ob-email').forEach(function (el) {
      var u = el.getAttribute('data-u');
      var d = el.getAttribute('data-d');
      if (!u || !d) return;
      var addr = u + '@' + d;
      el.innerHTML = '<a href="mai' + 'lto:' + addr + '" class="transition hover:text-white/80 underline">' + addr + '</a>';
    });
  })();

  /* ═══ Footer acordeon — doar pe subpagini ═══ */
  (function () {
    var footer = document.querySelector('.footer--accordion');
    if (!footer) return; /* pe homepage nu există clasa → nu se execută */

    var sections = footer.querySelectorAll('[data-ftr-section]');
    sections.forEach(function (sec) {
      var toggle = sec.querySelector('[data-ftr-toggle]');
      if (!toggle) return;

      toggle.addEventListener('click', function () {
        var isOpen = !sec.classList.contains('ftr-section--collapsed');
        if (isOpen) {
          sec.classList.add('ftr-section--collapsed');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          sec.classList.remove('ftr-section--collapsed');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

<style>
  /* Extinde culoarea ink a footer-ului dincolo de marginea de jos,
     ca să nu se vadă SkyBackground-ul (position: fixed) pe sub
     safe-area-inset sau bara browserului mobil. */
  footer {
    position: relative;
    box-shadow: 0 100vh 0 100vh #0C080F;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px));
  }

  /* ─── Footer acordeon (doar pe subpagini) ───────────────────────── */
  .ftr-section {
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  /* Linkuri „Hartă site" — tap-target ≥24px (Lighthouse a11y) */
  .ftr-map-link {
    display: inline-block;
    padding: 0.4rem 0.5rem;
    line-height: 1.2;
    border-radius: 0.25rem;
    transition: color 180ms ease, background 180ms ease;
  }
  .ftr-map-link:hover {
    color: #F5A623;
  }
  .ftr-map-link:focus-visible {
    outline: 2px solid #F5A623;
    outline-offset: 2px;
  }

  /* Tab-ul — vizibil doar pe subpagini */
  .ftr-tab {
    display: none;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: background 180ms ease;
  }

  .ftr-tab:hover {
    background: rgba(255,255,255,0.04);
  }

  .footer--accordion .ftr-tab {
    display: flex;
  }

  .ftr-tab-icon {
    font-size: 0.85rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .ftr-tab-text {
    flex: 1;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }

  .ftr-tab-chevron {
    flex-shrink: 0;
    color: rgba(255,255,255,0.4);
    transition: transform 250ms ease;
  }

  .ftr-section--collapsed .ftr-tab-chevron {
    transform: rotate(0deg);
  }

  .ftr-section:not(.ftr-section--collapsed) .ftr-tab-chevron {
    transform: rotate(180deg);
  }

  /* Conținut — pe homepage e mereu vizibil */
  .ftr-content {
    overflow: hidden;
    transition: max-height 300ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease;
  }

  .footer--accordion .ftr-section--collapsed .ftr-content {
    max-height: 0;
    opacity: 0;
  }

  .footer--accordion .ftr-section:not(.ftr-section--collapsed) .ftr-content {
    max-height: 30rem;
    opacity: 1;
  }

  /* Borduri subtile pe secțiuni pe subpagini */
  .footer--accordion .ftr-section {
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 0.6rem;
    margin: 0.25rem 0.5rem;
    background: rgba(255,255,255,0.015);
  }

  .footer--accordion .ftr-section:not(.ftr-section--collapsed) {
    border-color: rgba(245,166,35,0.15);
    background: rgba(245,166,35,0.02);
  }
</style>

