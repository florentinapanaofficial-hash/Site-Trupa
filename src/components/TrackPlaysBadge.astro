---
/**
 * Server Island — interogheaza MySQL (track_plays) per-request, izolat de restul
 * paginii statice. Se foloseste cu directiva `server:defer` din AudioPlaylistPlayer,
 * astfel incat TTFB-ul paginii nu asteapta dupa conexiunea la baza de date.
 */
import { query } from '../lib/db.js';

interface Props {
  trackId: string;
}

const { trackId } = Astro.props;

let plays = 0;
try {
  const rows = (await query(
    'SELECT play_count FROM track_plays WHERE track_id = ?',
    [trackId],
  )) as Array<{ play_count: number }>;
  plays = rows[0]?.play_count ?? 0;
} catch {
  // MySQL indisponibil - badge-ul ramane 0, nu blocheaza restul insulei
}
---

<span class="play-count-badge font-mono">{plays}</span>
