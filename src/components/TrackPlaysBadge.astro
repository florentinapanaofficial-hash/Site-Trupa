---
/**
 * Server Island — interogheaza Supabase (track_plays) per-request, izolat de restul
 * paginii statice. Se foloseste cu directiva `server:defer` din AudioPlaylistPlayer,
 * astfel incat TTFB-ul paginii nu asteapta dupa conexiunea la baza de date.
 */
import { getSupabasePublic } from '../lib/supabase';

interface Props {
  trackId: string;
}

const { trackId } = Astro.props;

let plays = 0;
try {
  const supabase = getSupabasePublic();
  if (supabase) {
    const { data } = await supabase
      .from('track_plays')
      .select('play_count')
      .eq('track_id', trackId)
      .maybeSingle();
    plays = data?.play_count ?? 0;
  }
} catch {
  // Supabase indisponibil - badge-ul ramane 0, nu blocheaza restul insulei
}
---

<span class="play-count-badge font-mono">{plays}</span>
