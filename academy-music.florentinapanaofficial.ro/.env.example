# Copiază în `.env` și completează cu valorile proiectului Supabase.
# ATENȚIE: tot ce începe cu VITE_ ajunge în bundle-ul din browser.
# Cheia `service_role` NU se pune niciodată aici.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secunde de valabilitate pentru URL-urile semnate de streaming (implicit 300).
VITE_SIGNED_URL_TTL=300
