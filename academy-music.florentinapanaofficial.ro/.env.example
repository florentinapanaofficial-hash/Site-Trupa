# Copiază în `.env` și completează cu valorile proiectului Supabase.
# ATENȚIE: tot ce începe cu VITE_ ajunge în bundle-ul din browser.
# Cheia `service_role` NU se pune niciodată aici.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secunde de valabilitate pentru materialele private (PDF/imagini), nu audio CDN.
VITE_SIGNED_URL_TTL=300

# Server-only: originea audio permisă în CSP. Fără slash final sau cale.
MEDIA_ORIGIN=https://media.florentinapanaofficial.ro

# Server Academy only: hostname Jitsi autorizat in CSP si Permissions-Policy.
# Aceeasi valoare ca secretul JITSI_DOMAIN din Edge Function class-access.
JITSI_DOMAIN=

# Server-only Google Drive. Never use a VITE_ or PUBLIC_ prefix for credentials.
# Enable Drive API and give the service account Contributor access to a Shared Drive folder.
# Paste the complete Service Account JSON here (server-only).
GOOGLE_CREDENTIALS=
# Legacy alternative: remove GOOGLE_CREDENTIALS entirely before using these:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# Academy security - SERVER ONLY. Never prefix the service key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Production requires a header overwritten/appended by trusted infrastructure.
# Verify proxy topology first; a client-supplied leftmost IP is NOT trusted.
ACADEMY_TRUSTED_IP_HEADER=
ACADEMY_TRUSTED_PROXY_HOPS=
# Optional exact Railway public origin; read at build time for Astro allowedDomains.
ACADEMY_PUBLIC_ORIGIN=

# Server-only OpenAI for /api/games/generate/. Never use VITE_ or PUBLIC_.
# Configure project budget/usage limits in OpenAI before enabling for students.
OPENAI_API_KEY=
