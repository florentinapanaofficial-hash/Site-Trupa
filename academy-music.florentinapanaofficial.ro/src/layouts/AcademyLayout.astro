---
import '../index.css';
interface Props { title?: string; description?: string; }
const { title = 'Academy Music: cursuri de orgă și canto pentru elevi', description = 'Descoperă mini-cursuri de orgă și canto la Academy Music, Palatul Copiilor Pitești. Exersează notele și verifică-ți cunoștințele online.' } = Astro.props;
---
<!doctype html>
<html lang="ro">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="theme-color" content="#0d0c11" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" />
    </head>
    <body><slot /></body>
</html>