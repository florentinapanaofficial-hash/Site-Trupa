---
import AcademyLayout from '../layouts/AcademyLayout.astro';
const pathname = Astro.url.pathname;
if (pathname.startsWith('/api/')) {
    return new Response(JSON.stringify({ error: 'Endpoint inexistent.' }), {
        status: 404, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
    });
}
if (/^\/(revista|studio)(\/|$)/.test(pathname) || pathname.split('/').pop().includes('.')) {
    return new Response('Not found', { status: 404 });
}
---
<AcademyLayout {...(Astro.params.app === 'cursuri-online' ? {
    title: 'Cursuri online și grupe de elevi | Academy Music Pitești',
    description: 'Participă la cursurile online Academy Music din Pitești. Consultă orarul grupei tale și intră în sala video pentru lecții de orgă și canto.',
} : {})}>
    <div id="root"></div>
    <script>
        import '../main.jsx';
    </script>
</AcademyLayout>