{
    "name": "academy-music",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-10-22",
    "vars": {
        "NODE_ENV": "production"
    },
    "routes": [
        {
            "pattern": "academy-music.florentinapanaofficial.ro",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    }
}