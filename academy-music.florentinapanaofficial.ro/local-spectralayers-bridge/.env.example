# Copy to .env and use a service-role key only on the trusted Windows workstation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Verify actual command-line/scripting support for your installed SpectraLayers 12 version.
SPECTRALAYERS_EXECUTABLE=C:\Program Files\Steinberg\SpectraLayers 12\SpectraLayers.exe
# Replace every angle-bracket placeholder with documented arguments before starting the bridge.
SPECTRALAYERS_ARGS_JSON=["<VERIFIED_INPUT_OPTION>","{input}","<VERIFIED_SEPARATION_AND_EXPORT_OPTIONS>","<VERIFIED_OUTPUT_OPTION>","{output}"]
SPECTRALAYERS_OUTPUT_EXTENSION=wav
SPECTRALAYERS_TIMEOUT_MS=3600000
AUDIO_SOURCE_ALLOWED_HOSTS=
AUDIO_MAX_FILE_BYTES=524288000
