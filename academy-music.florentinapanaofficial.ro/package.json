{
    "name": "academy-music.florentinapanaofficial.ro",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.22.0"
    },
    "overrides": {
        "@tailwindcss/typography": {
            "postcss-selector-parser": "^7.1.6"
        }
    },
    "scripts": {
        "dev": "astro dev --host 127.0.0.1 --port 5180",
        "build": "astro build",
        "preview": "wrangler dev --local --ip 127.0.0.1 --port 5180",
        "deploy": "npm run build && wrangler deploy",
        "test:worker": "npm run build && node scripts/worker.check.mjs && wrangler deploy --dry-run",
        "test": "node --test src/lib/unlock-user.check.mjs src/lib/learning.check.mjs src/lib/security.check.mjs src/lib/canto.check.mjs src/lib/studyLevels.check.mjs src/lib/studyLevels.sql.check.mjs src/lib/studio.check.mjs src/lib/audio-processing.check.mjs src/lib/games.check.mjs src/lib/aiGames.check.mjs",
        "test:browser": "node scripts/verify-learning.mjs",
        "test:login:dev": "node scripts/verify-login-dev.mjs",
        "test:landing": "node scripts/verify-landing.mjs",
        "test:navigation": "node scripts/verify-navigation.mjs",
        "test:admin": "node scripts/verify-admin.mjs",
        "test:canto": "node scripts/verify-canto.mjs",
        "test:games": "node scripts/verify-games.mjs"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.4.2",
        "@astrojs/mdx": "^8.1.0",
        "@astrojs/react": "^7.1.0",
        "@jitsi/react-sdk": "^1.4.4",
        "@supabase/supabase-js": "^2.105.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tonejs/midi": "^2.0.28",
        "@vexflow-fonts/academico": "^1.0.1",
        "@vexflow-fonts/bravura": "^1.0.2",
        "astro": "^7.4.0",
        "html-midi-player": "^1.6.0",
        "lucide-react": "^1.59.0",
        "midi-writer-js": "^3.2.1",
        "pdfjs-dist": "^4.10.38",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.4",
        "tone": "14.9.17",
        "vexflow": "^5.0.0"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.10",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^4.3.4",
        "tailwindcss": "^4.3.3",
        "vite": "^6.0.7",
        "wrangler": "^4.151.3"
    }
