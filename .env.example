# Database
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=3306
MYSQL_URL=

# Runtime
SITE_URL=https://www.florentinapanaofficial.ro
PORT=4321
HOST=0.0.0.0

# Public analytics & verification
PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GSC_VERIFICATION=

# Public site/CORS
PUBLIC_SITE_URL=https://florentinapanaofficial.ro
PUBLIC_SITE_URL_WWW=https://www.florentinapanaofficial.ro

# OpenAI / Gemini / YouTube
OPENAI_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Google service account (Indexing API)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_LIVE_INPUT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_REPLAY_VIDEO_UID=
# UID videoclip montaj (colaj) afișat pe pagina Despre — embed Cloudflare Stream
PUBLIC_ABOUT_MONTAGE_CLOUDFLARE_UID=

# YouTube Data API v3 — pentru feed-ul automat de Reels din playlistă (/shorts/)
YOUTUBE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Audio / R2
AUDIO_DEFAULT_ARTIST=Formația Florentina Pană
PUBLIC_R2_MUSIC_BASE_URL=

# GDPR hashing
IP_HASH_SALT=# Google Search Console / Indexing API (Service Account)
# Copiaza acest fisier in .env si completeaza valorile reale.

GOOGLE_CLIENT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----"
# Configurare bază de date MySQL
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=3306

# Google Analytics 4 (lasă gol pentru a dezactiva tracking)
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Origini permise pentru CORS (API endpoints)
# Dacă lipsesc, fallback-ul hardcodat (florentinapanaofficial.ro) rămâne activ
PUBLIC_SITE_URL=https://florentinapanaofficial.ro
PUBLIC_SITE_URL_WWW=https://www.florentinapanaofficial.ro
