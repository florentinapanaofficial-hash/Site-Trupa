{
  "name": "landing-ul-meu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/compress.mjs",
    "test": "jest --runInBand",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "update-seo": "node scripts/update-seo.js",
    "update-seo:dry": "node scripts/update-seo.js --dry-run",
    "check-links": "node scripts/check-links.mjs",
    "check-links:fix": "node scripts/check-links.mjs --fix",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:check": "npm run build && npm run seo:audit",
    "seo:submit": "node seo-agent/submit-all-to-gsc.js",
    "seo:submit:dry": "node seo-agent/submit-all-to-gsc.js --dry-run",
    "seo:submit:sitemap": "node seo-agent/submit-all-to-gsc.js --sitemap",
    "seo:analyze": "node seo-agent/seo-analyzer.js",
    "seo:harvest": "node seo-agent/keyword-harvester.js",
    "seo:errors": "node seo-agent/gsc-errors.js",
    "seo:errors:dry": "node seo-agent/gsc-errors.js --dry-run",
    "seo:errors:only": "node seo-agent/gsc-errors.js --only-errors",
    "audio:sync": "node scripts/sync-audio-catalog.mjs",
    "ferrari": "node ferrari.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^9.5.5",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.105.4",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "googleapis": "^171.4.0",
    "isomorphic-dompurify": "^3.1.0",
    "mysql2": "^3.11.3",
    "nanoid": "^5.0.8",
    "openai": "^6.34.0",
    "sharp": "^0.35.3",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "jest": "^30.4.2",
    "lightningcss": "^1.32.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  }
}